    "lines": [
      {
        "sp": "A",
        "t": "Guten Tag! Was möchten Sie?",
        "s": "Hello! What would you like?"
      },
      {
        "sp": "B",
        "t": "Guten Tag! Ich möchte eine Suppe, bitte.",
        "s": "Hello! I'd like some soup, please."
      },
      {
        "sp": "A",
        "t": "Gern. Möchten Sie auch Brot?",
        "s": "Sure. Would you like some bread, too?"
      },
      {
        "sp": "B",
        "t": "Ja, bitte. Haben Sie auch Hähnchen?",
        "s": "Yes, please. Do you have chicken, too?"
      },
      {
        "sp": "A",
        "t": "Nein, wir haben kein Hähnchen. Aber wir haben Salat.",
        "s": "No, we don't have chicken. But we have salad."
      },
      {
        "sp": "B",
        "t": "Nein, danke. Aber ich habe Durst. Ein Wasser, bitte.",
        "s": "No, thank you. But I'm thirsty. A water, please."
      },
      {
        "sp": "A",
        "t": "Also: eine Suppe, Brot und ein Wasser?",
        "s": "So: soup, bread and a water?"
      },
      {
        "sp": "B",
        "t": "Ja, richtig. Danke!",
        "s": "Yes, that's right. Thank you!"
      },
      {
        "sp": "A",
        "t": "Bitte schön. Guten Appetit!",
        "s": "Here you are. Enjoy your meal!"
      },
      {
        "sp": "B",
        "t": "Danke! Die Suppe ist lecker!",
        "s": "Thanks! The soup is delicious!"
      }
    ]
  },
  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "ein, eine – kein, keine",
        "s": "\"a\" and \"no / not a\""
      },
      "explain": "**ein** / **eine** means *a* / *an*. Use **ein** with der- and das-nouns, and **eine** with die-nouns: **ein** Apfel, **eine** Banane, **ein** Ei. In the plural there is no *a*: Äpfel.\nTo say *no* / *not a*, just put a **k** in front: **kein**, **keine**. In the plural, always use **keine**: Wir haben **keine** Äpfel. With things you can't count, use kein/keine as well: Ich habe **keine** Milch.\nTip: after **haben** and **möchte**, a der-noun changes: Ich möchte **einen** Apfel. You'll practice this in Unit 5.",
      "table": [
        [
          "der Apfel",
          "ein Apfel",
          "kein Apfel"
        ],
        [
          "die Banane",
          "eine Banane",
          "keine Banane"
        ],
        [
          "das Ei",
          "ein Ei",
          "kein Ei"
        ],
        [
          "die Äpfel",
          "Äpfel",
          "keine Äpfel"
        ]
      ],
      "examples": [
        {
          "t": "Das ist ein Apfel.",
          "s": "This is an apple."
        },
        {
          "t": "Das ist eine Banane.",
          "s": "This is a banana."
        },
        {
          "t": "Das ist kein Ei.",
          "s": "This is not an egg."
        },
        {
          "t": "Ich habe keine Milch.",
          "s": "I have no milk."
        },
        {
          "t": "Wir haben keine Äpfel.",
          "s": "We don't have any apples."
        }
      ],
