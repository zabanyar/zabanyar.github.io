  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "Zahlen 0–20 und Alter",
        "s": "Numbers 0–20 and age"
      },
      "explain": "Learn **0–12** by heart. From 13 to 19, just say the small number and add **-zehn**: **drei + zehn = dreizehn**, **vier + zehn = vierzehn**.\nTwo small changes: **sechzehn** (no s) and **siebzehn** (no -en). Twenty is **zwanzig**.\nWhen you count, say **eins**. Before a noun, say **ein** (or **eine** – more in Unit 4): **ein Jahr**.\nTo talk about age, use **sein** + number + **Jahre alt**: **Ich bin zehn Jahre alt.** You can also just say **Ich bin zehn.**",
      "table": [
        [
          "0 null",
          "7 sieben",
          "14 vierzehn"
        ],
        [
          "1 eins",
          "8 acht",
          "15 fünfzehn"
        ],
        [
          "2 zwei",
          "9 neun",
          "16 sechzehn"
        ],
        [
          "3 drei",
          "10 zehn",
          "17 siebzehn"
        ],
        [
          "4 vier",
          "11 elf",
          "18 achtzehn"
        ],
        [
          "5 fünf",
          "12 zwölf",
          "19 neunzehn"
        ],
        [
          "6 sechs",
          "13 dreizehn",
          "20 zwanzig"
        ]
      ],
      "examples": [
        {
          "t": "Wie alt bist du? – Ich bin elf.",
          "s": "How old are you? – I'm eleven."
        },
        {
          "t": "Sara ist sechzehn Jahre alt.",
          "s": "Sara is sixteen years old."
        },
        {
          "t": "Das Baby ist ein Jahr alt.",
          "s": "The baby is one year old."
        },
        {
          "t": "Zwölf plus acht ist zwanzig.",
          "s": "Twelve plus eight is twenty."
        }
      ],
