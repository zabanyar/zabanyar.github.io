  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "der, die, das – mein, meine",
        "s": "Articles and \"my\" / \"your\""
      },
      "explain": "Every German noun has a gender: **der** (masculine), **die** (feminine) or **das** (neuter). You often can't guess it, so always learn a noun together with its article: **der Vater**, **die Mutter**, **das Kind**.\nIn the plural, the article is always **die**: **die Kinder**, **die Brüder**.\nFor *my* and *your* (informal), use **mein** / **dein** with der- and das-nouns, and **meine** / **deine** with die-nouns and all plurals.\nThe polite *your* (for **Sie**) is **Ihr** / **Ihre**, with a capital I: **Wie heißt Ihre Tochter?**",
      "table": [
        [
          "der Vater",
          "mein Vater",
          "dein Vater"
        ],
        [
          "die Mutter",
          "meine Mutter",
          "deine Mutter"
        ],
        [
          "das Kind",
          "mein Kind",
          "dein Kind"
        ],
        [
          "die Kinder",
          "meine Kinder",
          "deine Kinder"
        ]
      ],
      "examples": [
        {
          "t": "Das ist mein Vater.",
          "s": "This is my father."
        },
        {
          "t": "Meine Schwester heißt Sara.",
          "s": "My sister's name is Sara."
        },
        {
          "t": "Wie heißt dein Bruder?",
          "s": "What's your brother's name?"
        },
        {
          "t": "Meine Eltern wohnen in Teheran.",
          "s": "My parents live in Tehran."
        },
        {
          "t": "Wie heißt Ihr Sohn, Frau Müller?",
          "s": "What's your son's name, Ms. Müller?"
        }
      ],
