  "dialogue": {
    "title": { "t": "Wo ist die Apotheke?", "s": "Where is the pharmacy?" },
    "speakers": { "A": { "name": "Ali", "voice": "m" }, "B": { "name": "Frau Müller", "voice": "f" } },
    "lines": [
      { "sp": "A", "t": "Entschuldigung! Wo ist die Apotheke, bitte?", "s": "Excuse me! Where is the pharmacy, please?" },
      { "sp": "B", "t": "Die Apotheke? Gehen Sie hier geradeaus.", "s": "The pharmacy? Go straight ahead here." },
      { "sp": "A", "t": "Geradeaus. Und dann?", "s": "Straight ahead. And then?" },
      { "sp": "B", "t": "Dann gehen Sie nach links. Die Apotheke ist in der Goethestraße.", "s": "Then go left. The pharmacy is on Goethe Street." },
      { "sp": "A", "t": "Ist das weit?", "s": "Is it far?" },
      { "sp": "B", "t": "Nein, das ist nicht weit.", "s": "No, it's not far." },
      { "sp": "A", "t": "Gibt es dort auch einen Supermarkt?", "s": "Is there a supermarket there too?" },
      { "sp": "B", "t": "Ja, rechts ist ein Supermarkt.", "s": "Yes, there's a supermarket on the right." },
      { "sp": "A", "t": "Vielen Dank!", "s": "Thank you very much!" },
      { "sp": "B", "t": "Bitte schön!", "s": "You're welcome!" }
    ]
  },
  "grammar": [
    {
      "id": "g01",
      "title": { "t": "Gehen Sie geradeaus!", "s": "Polite commands (Sie-imperative)" },
      "explain": "To give directions or polite instructions, use the **Sie-imperative**. It's easy: take the **Sie** form of the verb and put the verb **first**: Sie gehen → **Gehen Sie!**\nAdd **bitte** to sound friendly: **Gehen Sie bitte geradeaus.**\nSeparable verbs work the same way – the prefix goes to the end: **Rufen Sie bitte Frau Müller an!**\nUseful direction words: **geradeaus** (straight ahead), **nach links** (to the left), **nach rechts** (to the right). For *where* something is, just say **links** or **rechts**: **Die Bank ist links.**",
      "table": [
        ["Sie gehen …", "Gehen Sie …!"],
        ["Sie kommen …", "Kommen Sie …!"],
        ["Sie rufen … an", "Rufen Sie … an!"],
        ["Sie kaufen … ein", "Kaufen Sie … ein!"]
      ],
      "examples": [
        { "t": "Gehen Sie geradeaus!", "s": "Go straight ahead!" },
        { "t": "Gehen Sie bitte nach rechts.", "s": "Please go to the right." },
        { "t": "Gehen Sie hier nach links, dann geradeaus.", "s": "Go left here, then straight ahead." },
        { "t": "Rufen Sie bitte Frau Müller an.", "s": "Please call Ms. Müller." }
      ],
      "exercises": [
        { "type": "choice", "t": "___ Sie geradeaus!", "options": ["Geht", "Gehen", "Gehst"], "answer": 1, "s": "Go straight ahead!" },
        { "type": "choice", "t": "Gehen Sie ___ links.", "options": ["im", "um", "nach"], "answer": 2, "s": "Go to the left." },
        { "type": "type", "t": "Gehen ___ geradeaus!", "answer": ["Sie"], "s": "Go straight ahead!" },
        { "type": "type", "t": "Rufen Sie bitte Frau Müller ___!", "answer": ["an"], "s": "Please call Ms. Müller!" },
        { "type": "choice", "t": "Sie kommen. → ___ Sie bitte!", "options": ["Kommen", "Kommt", "Komme"], "answer": 0, "s": "Please come!" },
        { "type": "order", "t": "Gehen Sie bitte nach rechts.", "s": "Please go to the right." },
        { "type": "order", "t": "Gehen Sie hier nach links.", "s": "Go left here." }
      ]
    },
    {
      "id": "g02",
      "title": { "t": "im Park, in der Stadt", "s": "Where? – in der / im" },
      "explain": "To say **where** someone or something is, use **in**. After **in**, the article changes:\n**der → im**: der Park → **im Park**\n**das → im**: das Krankenhaus → **im Krankenhaus**\n**die → in der**: die Schule → **in der Schule**\n(**im** is short for *in dem*.) This form is called the **dative**. For now, just learn these patterns.",
      "table": [
        ["der Park", "im Park"],
        ["der Supermarkt", "im Supermarkt"],
        ["das Krankenhaus", "im Krankenhaus"],
        ["die Stadt", "in der Stadt"],
        ["die Apotheke", "in der Apotheke"]
      ],
      "examples": [
        { "t": "Ali ist im Park.", "s": "Ali is in the park." },
        { "t": "Wir kaufen im Supermarkt ein.", "s": "We shop at the supermarket." },
        { "t": "Reza arbeitet im Krankenhaus.", "s": "Reza works at the hospital." },
        { "t": "Ich wohne in der Goethestraße.", "s": "I live on Goethe Street." }
      ],
      "exercises": [
        { "type": "choice", "t": "Sara ist ___ Schule.", "options": ["im", "in der", "in die"], "answer": 1, "s": "Sara is at school." },
        { "type": "choice", "t": "Wir sind ___ Park.", "options": ["im", "in der", "in"], "answer": 0, "s": "We are in the park." },
        { "type": "type", "t": "Lukas ist ___ Supermarkt.", "answer": ["im"], "s": "Lukas is at the supermarket." },
        { "type": "type", "t": "Reza arbeitet ___ Krankenhaus.", "answer": ["im"], "s": "Reza works at the hospital." },
        { "type": "choice", "t": "Frau Müller ist ___ Bank.", "options": ["im", "in den", "in der"], "answer": 2, "s": "Ms. Müller is at the bank." },
        { "type": "type", "t": "Maryam ist in ___ Apotheke.", "answer": ["der"], "s": "Maryam is at the pharmacy." },
        { "type": "order", "t": "Ich wohne in der Goethestraße.", "s": "I live on Goethe Street." }
      ]
    }
  ],
