  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "sein: ich bin, du bist …",
        "s": "The verb \"to be\""
      },
      "explain": "The verb **sein** means *to be*. It is irregular, so just learn the forms by heart.\nUse **ich bin** for yourself, **du bist** for a friend or a child, and **er ist** / **sie ist** for another person (er = he, sie = she, es = it).\n**Sie sind** is the polite *you* for adults you don't know well. Polite **Sie** always starts with a capital S.\nWith **sein** you can say who you are and where you are from: **Ich bin Sara. Ich bin aus dem Iran.**",
      "table": [
        [
          "ich",
          "bin",
          "Ich bin Sara."
        ],
        [
          "du",
          "bist",
          "Du bist Lukas."
        ],
        [
          "er / sie / es",
          "ist",
          "Er ist aus Berlin."
        ],
        [
          "Sie",
          "sind",
          "Sind Sie Frau Müller?"
        ]
      ],
      "examples": [
        {
          "t": "Ich bin Reza.",
          "s": "I'm Reza."
        },
        {
          "t": "Du bist Anna.",
          "s": "You are Anna."
        },
        {
          "t": "Das ist Maryam. Sie ist aus dem Iran.",
          "s": "This is Maryam. She is from Iran."
        },
        {
          "t": "Sind Sie Herr Schmidt?",
          "s": "Are you Mr. Schmidt?"
        }
      ],
