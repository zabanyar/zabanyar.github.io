  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "es gibt + einen, eine, ein",
        "s": "\"there is / there are\" + accusative"
      },
      "explain": "**Es gibt** means *there is* or *there are*. It is always **gibt**, also with plurals: **Es gibt zwei Zimmer.**\nThe noun after **es gibt** is in the **accusative** case. Good news: only der-nouns change! **ein → einen**, **kein → keinen**. Die- and das-nouns stay the same.\nThe same happens after **haben** and **möchte**: Ich habe **einen** Bruder. Ich möchte **einen** Tee.\nTo ask, put **gibt** first: **Gibt es** ein Bad?",
      "table": [
        [
          "der Tisch",
          "Es gibt einen Tisch.",
          "Es gibt keinen Tisch."
        ],
        [
          "die Lampe",
          "Es gibt eine Lampe.",
          "Es gibt keine Lampe."
        ],
        [
          "das Bett",
          "Es gibt ein Bett.",
          "Es gibt kein Bett."
        ],
        [
          "die Stühle",
          "Es gibt Stühle.",
          "Es gibt keine Stühle."
        ]
      ],
      "examples": [
        {
          "t": "Es gibt einen Tisch in der Küche.",
          "s": "There is a table in the kitchen."
        },
        {
          "t": "Es gibt eine Lampe im Wohnzimmer.",
          "s": "There is a lamp in the living room."
        },
        {
          "t": "Es gibt zwei Schlafzimmer.",
          "s": "There are two bedrooms."
        },
        {
          "t": "Es gibt keinen Fernseher.",
          "s": "There is no TV."
        },
        {
          "t": "Gibt es einen Schrank im Schlafzimmer?",
          "s": "Is there a closet in the bedroom?"
        }
      ],
