  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "Ich nehme den Mantel.",
        "s": "The accusative: den / einen"
      },
      "explain": "In **Ich nehme den Mantel**, the coat is the *object* – the thing you take, buy, want or have. Objects are in the **accusative** case.\nGood news: only **masculine** (der) words change! **der → den**, **ein → einen**, **kein → keinen**. Feminine, neuter and plural words stay the same.\nYou already know this from **Es gibt einen …**. It works the same way with **haben, möchten, kaufen, nehmen**: **Ich kaufe einen Schal.**\nThe table shows: the word → *the* (accusative) → *a* (accusative).\nNote: **nehmen** is irregular: ich nehme, du **nimmst**, er/sie **nimmt**.",
      "table": [
        [
          "der Mantel",
          "den Mantel",
          "einen Mantel"
        ],
        [
          "die Hose",
          "die Hose",
          "eine Hose"
        ],
        [
          "das Hemd",
          "das Hemd",
          "ein Hemd"
        ],
        [
          "die Schuhe",
          "die Schuhe",
          "Schuhe"
        ]
      ],
      "examples": [
        {
          "t": "Ich nehme den Mantel.",
          "s": "I'll take the coat."
        },
        {
          "t": "Maryam kauft einen Schal.",
          "s": "Maryam buys a scarf."
        },
        {
          "t": "Ich möchte eine Tasche.",
          "s": "I'd like a bag."
        },
        {
          "t": "Ali hat keinen Mantel.",
          "s": "Ali doesn't have a coat."
        },
        {
          "t": "Wir kaufen das Kleid.",
          "s": "We're buying the dress."
        }
      ],
