  "dialogue": {
    "title": { "t": "Wie ist das Wetter in Teheran?", "s": "What's the weather like in Tehran?" },
    "speakers": { "A": { "name": "Anna", "voice": "f" }, "B": { "name": "Reza", "voice": "m" } },
    "lines": [
      { "sp": "A", "t": "Hallo, Reza! Wie ist das Wetter in Teheran?", "s": "Hi Reza! What's the weather like in Tehran?" },
      { "sp": "B", "t": "Hallo, Anna! Hier ist es sonnig und warm. Es ist zwanzig Grad.", "s": "Hi Anna! Here it's sunny and warm. It's twenty degrees." },
      { "sp": "A", "t": "Toll! In Berlin regnet es. Es ist kalt und windig.", "s": "Great! In Berlin it's raining. It's cold and windy." },
      { "sp": "B", "t": "Oh nein! Wie kalt ist es?", "s": "Oh no! How cold is it?" },
      { "sp": "A", "t": "Es ist fünf Grad.", "s": "It's five degrees." },
      { "sp": "B", "t": "Der Frühling in Teheran ist schön. Und im März ist Nouruz!", "s": "Spring in Tehran is beautiful. And in March it's Nowruz!" },
      { "sp": "A", "t": "Nouruz? Was ist das?", "s": "Nowruz? What's that?" },
      { "sp": "B", "t": "Das ist das Neujahrsfest im Iran.", "s": "It's the New Year festival in Iran." },
      { "sp": "A", "t": "Schön! Dann frohes neues Jahr, Reza!", "s": "How nice! Then happy New Year, Reza!" },
      { "sp": "B", "t": "Danke, Anna! Tschüss!", "s": "Thanks, Anna! Bye!" }
    ]
  },
  "grammar": [
    {
      "id": "g01",
      "title": { "t": "Es regnet. Es ist kalt.", "s": "Talking about the weather with es" },
      "explain": "German weather sentences use **es** (it) – just like in English.\nWith an adjective, use **es ist**: **Es ist sonnig. Es ist kalt. Es ist windig.**\nWith a weather verb, use **es** + verb: **Es regnet** (it's raining), **Es schneit** (it's snowing). German has no -ing form, so **es regnet** means both *it rains* and *it is raining*.\nRemember the verb-second rule: **Heute regnet es. Im Winter ist es kalt.**",
      "table": [
        ["sonnig", "Es ist sonnig."],
        ["warm / heiß", "Es ist warm. / Es ist heiß."],
        ["kalt", "Es ist kalt."],
        ["windig", "Es ist windig."],
        ["regnen", "Es regnet."],
        ["schneien", "Es schneit."]
      ],
      "examples": [
        { "t": "Heute ist es sonnig.", "s": "It's sunny today." },
        { "t": "Es regnet und es ist kalt.", "s": "It's raining and it's cold." },
        { "t": "Im Winter schneit es.", "s": "It snows in winter." },
        { "t": "Wie ist das Wetter? – Es ist warm.", "s": "What's the weather like? – It's warm." }
      ],
      "exercises": [
        { "type": "choice", "t": "Es ___ sonnig.", "options": ["regnet", "ist", "hat"], "answer": 1, "s": "It's sunny." },
        { "type": "choice", "t": "Heute ___ es.", "options": ["regnet", "ist", "regnen"], "answer": 0, "s": "It's raining today." },
        { "type": "type", "t": "___ schneit.", "answer": ["Es"], "s": "It's snowing." },
        { "type": "choice", "t": "Im Sommer ist ___ heiß.", "options": ["er", "sie", "es"], "answer": 2, "s": "It's hot in summer." },
        { "type": "type", "t": "Es ___ kalt.", "answer": ["ist"], "s": "It's cold." },
        { "type": "choice", "t": "Im Winter ___.", "options": ["es schneit", "schneit es", "schneien es"], "answer": 1, "s": "It snows in winter." },
        { "type": "order", "t": "Heute ist es kalt.", "s": "It's cold today." },
        { "type": "order", "t": "Die Sonne scheint.", "s": "The sun is shining." }
      ]
    },
    {
      "id": "g02",
      "title": { "t": "im Juli, im Sommer", "s": "Months, seasons and im" },
      "explain": "All months and seasons are **masculine**: **der Juli, der Sommer**.\nTo say *in* a month or a season, use **im** (= in dem): **im Juli, im Winter**.\nThe months look a lot like English, so they're easy to learn. Watch the spelling: **März, Mai, Juni, Juli, Oktober, Dezember**.\nBirthdays: **Ich habe im Mai Geburtstag.** (My birthday is in May.)",
      "table": [
        ["der Frühling", "März · April · Mai"],
        ["der Sommer", "Juni · Juli · August"],
        ["der Herbst", "September · Oktober · November"],
        ["der Winter", "Dezember · Januar · Februar"]
      ],
      "examples": [
        { "t": "Im Juli ist es heiß.", "s": "It's hot in July." },
        { "t": "Im Dezember schneit es.", "s": "It snows in December." },
        { "t": "Ich habe im Mai Geburtstag.", "s": "My birthday is in May." },
        { "t": "Im Herbst ist es windig.", "s": "It's windy in the fall." }
      ],
      "exercises": [
        { "type": "choice", "t": "Ich habe ___ Juni Geburtstag.", "options": ["in der", "im", "um"], "answer": 1, "s": "My birthday is in June." },
        { "type": "choice", "t": "Im Frühling: März, April und ___.", "options": ["Juli", "Oktober", "Mai"], "answer": 2, "s": "In spring: March, April and May." },
        { "type": "type", "t": "Januar, Februar, ___, April", "answer": ["März", "Maerz"], "s": "January, February, March, April" },
        { "type": "type", "t": "Im Juni, Juli und August ist ___.", "answer": ["Sommer"], "s": "In June, July and August it's summer." },
        { "type": "choice", "t": "___ Herbst regnet es.", "options": ["Im", "In der", "Am"], "answer": 0, "s": "It rains in the fall." },
        { "type": "choice", "t": "Dezember, Januar und Februar sind im ___.", "options": ["Sommer", "Winter", "Frühling"], "answer": 1, "s": "December, January and February are in winter." },
        { "type": "order", "t": "Im Winter ist es kalt.", "s": "It's cold in winter." }
      ]
    }
  ],
  "reading": {
