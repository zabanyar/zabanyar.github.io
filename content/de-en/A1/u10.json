  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "Ich kann schwimmen.",
        "s": "können (can) + verb at the end"
      },
      "explain": "**können** means *can*. It's a little irregular: **ich kann** and **er/sie kann** have no ending.\nThe second verb goes to the **end** of the sentence in its basic form (the infinitive): **Ich kann gut schwimmen.** / **Maryam kann nicht Rad fahren.**\nThis is a typical German pattern: **kann** in position 2, the infinitive at the very end.\n**möchten** works the same way: **Ich möchte Fußball spielen.**",
      "table": [
        [
          "ich",
          "kann"
        ],
        [
          "du",
          "kannst"
        ],
        [
          "er / sie / es",
          "kann"
        ],
        [
          "wir",
          "können"
        ],
        [
          "ihr",
          "könnt"
        ],
        [
          "sie / Sie",
          "können"
        ]
      ],
      "examples": [
        {
          "t": "Ich kann schwimmen.",
          "s": "I can swim."
        },
        {
          "t": "Reza kann gut Fußball spielen.",
          "s": "Reza can play soccer well."
        },
        {
          "t": "Sara kann nicht Rad fahren.",
          "s": "Sara can't ride a bike."
        },
        {
          "t": "Ich möchte am Abend lesen.",
          "s": "I'd like to read in the evening."
        }
      ],
