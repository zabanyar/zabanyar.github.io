      { "sp": "A", "t": "دو، دو، سه، چهار، پنج، شش، هفت، هشت.", "pr": "Do, do, se, çahâr, panc, şeş, haft, haşt.", "s": "İki, iki, üç, dört, beş, altı, yedi, sekiz." },
      { "sp": "B", "t": "یک لحظه… دوباره، لطفاً.", "pr": "Yek lahze… Dobâre, lotfan.", "s": "Bir dakika… Tekrar, lütfen." },
      { "sp": "A", "t": "دو، دو، سه، چهار، پنج، شش، هفت، هشت.", "pr": "Do, do, se, çahâr, panc, şeş, haft, haşt.", "s": "İki, iki, üç, dört, beş, altı, yedi, sekiz." },
