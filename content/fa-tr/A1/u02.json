    "lines": [
      { "sp": "A", "t": "سلام امره! چند سال داری؟", "pr": "Salâm Emre! Çand sâl dâri?", "s": "Merhaba Emre! Kaç yaşındasın?" },
      { "sp": "B", "t": "سلام ندا! بیست سال دارم. تو چند سال داری؟", "pr": "Salâm Nedâ! Bist sâl dâram. To çand sâl dâri?", "s": "Merhaba Neda! Yirmi yaşındayım. Sen kaç yaşındasın?" },
