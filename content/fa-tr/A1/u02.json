        { "type": "choice", "t": "دو ___، لطفاً.", "options": ["چای", "چای‌ها", "چایان"], "answer": 0, "pr": "Do çây, lotfan.", "s": "İki çay, lütfen." },
        { "type": "type", "t": "من ___ سال دارم.", "answer": ["بیست"], "pr": "Man bist sâl dâram.", "s": "Ben yirmi yaşındayım." },
