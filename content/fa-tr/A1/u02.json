        { "type": "choice", "t": "آن‌ها دانشجو ___.", "options": ["هستیم", "است", "هستند"], "answer": 2, "pr": "Ânhâ dâneşcu hastand.", "s": "Onlar öğrenci." },
        { "type": "order", "t": "کتاب‌ها خوب هستند.", "pr": "Ketâbhâ xub hastand.", "s": "Kitaplar iyi." },
        { "type": "order", "t": "مریم و علی دانشجو هستند.", "pr": "Maryam va Ali dâneşcu hastand.", "s": "Maryam ve Ali öğrenci." }
