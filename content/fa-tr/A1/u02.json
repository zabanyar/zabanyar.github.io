        { "t": "دو سیب، لطفاً.", "pr": "Do sib, lotfan.", "s": "İki elma, lütfen." },
        { "t": "سه تا چای، لطفاً.", "pr": "Se tâ çây, lotfan.", "s": "Üç tane çay, lütfen." },
        { "t": "من پانزده سال دارم.", "pr": "Man pânzdah sâl dâram.", "s": "Ben on beş yaşındayım." },
        { "t": "هفده، هجده، نوزده، بیست!", "pr": "Hefdah, hecdah, nuzdah, bist!", "s": "On yedi, on sekiz, on dokuz, yirmi!" }
      ],
