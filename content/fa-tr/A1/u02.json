        { "type": "choice", "t": "سه ___، لطفاً.", "options": ["سیب‌ها", "سیب", "سیبان"], "answer": 1, "pr": "Se sib, lotfan.", "s": "Üç elma, lütfen." },
        { "type": "type", "t": "این ___ ایرانی هستند.", "answer": ["دانشجوها", "دانشجویان"], "pr": "İn dâneşcuhâ İrâni hastand.", "s": "Bu öğrenciler İranlı." },
