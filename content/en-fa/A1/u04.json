  "grammar": [
    {
      "id": "g01",
      "title": {
        "t": "a / an / some",
        "s": "a، an و some"
      },
      "explain": "**a** و **an** یعنی «یک» و قبل از اسمِ مفرد می‌آیند.\nاگر کلمهٔ بعدی با صدای صدادار (مثل a، e، i، o) شروع شود، **an** می‌گوییم: **an** apple، **an** egg، **an** orange. بقیه با **a** می‌آیند: **a** banana، **a** son.\nبعضی چیزها شمردنی نیستند، مثل water، tea، rice و milk. با آن‌ها **a** نمی‌گوییم، بلکه **some** (کمی، مقداری): **some** water، **some** rice.\nبا اسم جمع هم **some** می‌آید: **some** apples (چند سیب).",
      "table": [
        [
          "a",
          "a banana",
          "a son"
        ],
        [
          "an",
          "an apple",
          "an egg"
        ],
        [
          "some",
          "some water",
          "some apples"
        ]
      ],
      "examples": [
