{"id":"u01","level":"A2","emoji":"📅","title":{"t":"Geçen hafta sonu","s":"آخر هفته‌ی گذشته","a":"audio/tr-fa/ef2ce2e5c764.mp3"},"goals":["بگویم آخر هفته‌ی گذشته چه کارهایی کردم.","با پسوند -dı فعل‌ها را در زمان گذشته صرف کنم.","با -madı و mı درباره‌ی گذشته جمله‌ی منفی و سؤالی بسازم.","از کسی بپرسم آخر هفته‌اش چطور گذشت و جواب بدهم."],"words":[{"id":"w01","t":"hafta sonu","s":"آخر هفته","pr":"هافتا سُنو","emoji":"","ex":{"t":"Hafta sonu ne yaptın?","s":"آخر هفته چه کار کردی؟","pr":"هافتا سُنو نِه یاپتِن؟","a":"audio/tr-fa/2e56b761c922.mp3"},"img":null,"a":"audio/tr-fa/8e2c51f8c412.mp3"},{"id":"w02","t":"dün","s":"دیروز","pr":"دون","emoji":"","ex":{"t":"Dün markete gittim.","s":"دیروز به سوپرمارکت رفتم.","pr":"دون مارکِتِه گیتّیم.","a":"audio/tr-fa/f1beb3771e9e.mp3"},"img":null,"a":"audio/tr-fa/77e32984affc.mp3"},{"id":"w03","t":"geçen hafta","s":"هفته‌ی گذشته","pr":"گِچِن هافتا","emoji":"","ex":{"t":"Geçen hafta çok çalıştım.","s":"هفته‌ی گذشته خیلی کار کردم.","pr":"گِچِن هافتا چُک چالِشتِم.","a":"audio/tr-fa/5dc49d63fae4.mp3"},"img":null,"a":"audio/tr-fa/1d08887ec0eb.mp3"},{"id":"w04","t":"dün akşam","s":"دیروز عصر، دیشب","pr":"دون آکشام","emoji":"","ex":{"t":"Dün akşam erken uyudum.","s":"دیشب زود خوابیدم.","pr":"دون آکشام اِرکِن اویودوم.","a":"audio/tr-fa/c0197e15ccb0.mp3"},"img":null,"a":"audio/tr-fa/d3c22fff81d1.mp3"},{"id":"w05","t":"bütün gün","s":"تمامِ روز، کلِ روز","pr":"بوتون گون","emoji":"","ex":{"t":"Bütün gün kitap okudum.","s":"تمامِ روز کتاب خواندم.","pr":"بوتون گون کیتاپ اُکودوم.","a":"audio/tr-fa/42fe8b8133a9.mp3"},"img":null,"a":"audio/tr-fa/3daeba599914.mp3"},{"id":"w06","t":"evde kalmak","s":"در خانه ماندن","pr":"اِودِه کالماک","emoji":"🏠","ex":{"t":"Hafta sonu evde kaldık.","s":"آخر هفته در خانه ماندیم.","pr":"هافتا سُنو اِودِه کالدِک.","a":"audio/tr-fa/4c949ab73e74.mp3"},"img":"img/e/1f3e0.svg","a":"audio/tr-fa/9cee89510ef0.mp3"},{"id":"w07","t":"geç kalkmak","s":"دیر بیدار شدن","pr":"گِچ کالکماک","emoji":"","ex":{"t":"Pazar günü geç kalktım.","s":"یکشنبه دیر بیدار شدم.","pr":"پازار گونو گِچ کالکتِم.","a":"audio/tr-fa/38abaf3ec16f.mp3"},"img":null,"a":"audio/tr-fa/f15230a4d27a.mp3"},{"id":"w08","t":"temizlik yapmak","s":"تمیزکاری کردن، نظافت کردن","pr":"تِمیزلیک یاپماک","emoji":"🧹","ex":{"t":"Cumartesi temizlik yaptık.","s":"شنبه تمیزکاری کردیم.","pr":"جومارتِسی تِمیزلیک یاپتِک.","a":"audio/tr-fa/d785b0b9add7.mp3"},"img":"img/e/1f9f9.svg","a":"audio/tr-fa/0e8cd9e13617.mp3"},{"id":"w09","t":"çamaşır yıkamak","s":"لباس شستن، رخت شستن","pr":"چاماشِر یِکاماک","emoji":"","ex":{"t":"Annem sabah çamaşır yıkadı.","s":"مادرم صبح لباس شست.","pr":"آنِّم ساباه چاماشِر یِکادِ.","a":"audio/tr-fa/bd418fe356d8.mp3"},"img":null,"a":"audio/tr-fa/c2ca9af3e628.mp3"},{"id":"w10","t":"piknik yapmak","s":"پیک‌نیک رفتن","pr":"پیکنیک یاپماک","emoji":"🧺","ex":{"t":"Pazar günü parkta piknik yaptık.","s":"یکشنبه در پارک پیک‌نیک کردیم.","pr":"پازار گونو پارکتا پیکنیک یاپتِک.","a":"audio/tr-fa/77adb7ec1ce1.mp3"},"img":"img/e/1f9fa.svg","a":"audio/tr-fa/b6a65aa74bd8.mp3"},{"id":"w11","t":"ziyaret etmek","s":"به دیدنِ کسی رفتن، دیدار کردن","pr":"زیارِت اِتمِک","emoji":"","ex":{"t":"Geçen hafta sonu dedemi ziyaret ettik.","s":"آخر هفته‌ی گذشته به دیدنِ پدربزرگم رفتیم.","pr":"گِچِن هافتا سُنو دِدِمیْ زیارِت اِتّیک.","a":"audio/tr-fa/ab0257b5aa37.mp3"},"img":null,"a":"audio/tr-fa/f32a6bd0f858.mp3"},{"id":"w12","t":"buluşmak","s":"(با قرارِ قبلی) همدیگر را دیدن","pr":"بولوشماک","emoji":"","ex":{"t":"Neda ve ben kafede buluştuk.","s":"من و ندا در کافه همدیگر را دیدیم.","pr":"ندا وِه بِن کافِدِه بولوشتوک.","a":"audio/tr-fa/682b532616d2.mp3"},"img":null,"a":"audio/tr-fa/e72daecfedc8.mp3"},{"id":"w13","t":"eğlenmek","s":"خوش گذراندن، تفریح کردن","pr":"اِیلِنمِک","emoji":"🎉","ex":{"t":"Partide çok eğlendik.","s":"در مهمانی خیلی به ما خوش گذشت.","pr":"پارتیدِه چُک اِیلِندیک.","a":"audio/tr-fa/0d926628b1fa.mp3"},"img":"img/e/1f389.svg","a":"audio/tr-fa/0bcd1217dac3.mp3"},{"id":"w14","t":"yorulmak","s":"خسته شدن","pr":"یُرولماک","emoji":"😫","ex":{"t":"Çok yürüdük ve yorulduk.","s":"خیلی راه رفتیم و خسته شدیم.","pr":"چُک یورودوک وِه یُرولدوک.","a":"audio/tr-fa/1fda51930494.mp3"},"img":"img/e/1f62b.svg","a":"audio/tr-fa/f38b47bbe5c1.mp3"},{"id":"w15","t":"hiç","s":"اصلاً، هیچ (در جمله‌ی منفی)","pr":"هیچ","emoji":"","ex":{"t":"Hafta sonu hiç dinlenmedim.","s":"آخر هفته اصلاً استراحت نکردم.","pr":"هافتا سُنو هیچ دینلِنمِدیم.","a":"audio/tr-fa/d23eaf58f98a.mp3"},"img":null,"a":"audio/tr-fa/7454d6df5260.mp3"}],"phrases":[{"id":"p01","t":"Hafta sonun nasıl geçti?","s":"آخر هفته‌ات چطور گذشت؟","pr":"هافتا سُنون ناسِل گِچتی؟","a":"audio/tr-fa/0ef84728015c.mp3"},{"id":"p02","t":"Çok güzel geçti.","s":"خیلی خوب گذشت.","pr":"چُک گوزِل گِچتی.","a":"audio/tr-fa/a16afb2ab64c.mp3"},{"id":"p03","t":"Eh, işte.","s":"ای، بد نبود. (معمولی بود)","pr":"اِه، ایشتِه.","a":"audio/tr-fa/27edc6ee5955.mp3"},{"id":"p04","t":"Ne yaptın?","s":"چه کار کردی؟","pr":"نِه یاپتِن؟","a":"audio/tr-fa/b15278a2e4ed.mp3"},{"id":"p05","t":"Hiçbir şey yapmadım.","s":"هیچ کاری نکردم.","pr":"هیچبیر شِی یاپمادِم.","a":"audio/tr-fa/34e24785299c.mp3"},{"id":"p06","t":"Ya sen?","s":"تو چطور؟ (و تو؟)","pr":"یا سِن؟","a":"audio/tr-fa/96d37b375944.mp3"},{"id":"p07","t":"Çok eğlendik!","s":"خیلی به ما خوش گذشت!","pr":"چُک اِیلِندیک!","a":"audio/tr-fa/eb9043d4e2c2.mp3"},{"id":"p08","t":"Ne güzel!","s":"چه خوب!","pr":"نِه گوزِل!","a":"audio/tr-fa/1a2889b59a48.mp3"}],"dialogue":{"title":{"t":"Pazartesi sabahı","s":"دوشنبه صبح","a":"audio/tr-fa/41ce15ca4a6c.mp3"},"speakers":{"A":{"name":"Elif","voice":"f"},"B":{"name":"Amir","voice":"m"}},"lines":[{"sp":"A","t":"Günaydın Amir! Hafta sonun nasıl geçti?","s":"صبح بخیر امیر! آخر هفته‌ات چطور گذشت؟","pr":"گونایدِن امیر! هافتا سُنون ناسِل گِچتی؟","a":"audio/tr-fa/017d8016883a.mp3"},{"sp":"B","t":"Çok güzel geçti, teşekkürler. Cumartesi ailemle Belgrad Ormanı'na gittik.","s":"خیلی خوب گذشت، ممنون. شنبه با خانواده‌ام به جنگلِ بلگراد رفتیم.","pr":"چُک گوزِل گِچتی، تِشِکّورلِر. جومارتِسی آئیلِملِه بِلگراد اُرمانِنا گیتّیک.","a":"audio/tr-fa/034101960ee0.mp3"},{"sp":"A","t":"Ne güzel! Ne yaptınız?","s":"چه خوب! چه کار کردید؟","pr":"نِه گوزِل! نِه یاپتِنِز؟","a":"audio/tr-fa/9fbf41310bc7.mp3"},{"sp":"B","t":"Piknik yaptık ve çok yürüdük. Akşam çok yorulduk ama çok eğlendik.","s":"پیک‌نیک کردیم و خیلی پیاده‌روی کردیم. عصر خیلی خسته شدیم، ولی خیلی خوش گذشت.","pr":"پیکنیک یاپتِک وِه چُک یورودوک. آکشام چُک یُرولدوک آما چُک اِیلِندیک.","a":"audio/tr-fa/16eae30b1dfa.mp3"},{"sp":"A","t":"Çocuklar da geldi mi?","s":"بچه‌ها هم آمدند؟","pr":"چُجوکلار دا گِلدی می؟","a":"audio/tr-fa/4fc728b549f0.mp3"},{"sp":"B","t":"Evet, onlar da geldi. Peki sen ne yaptın?","s":"بله، آن‌ها هم آمدند. خب، تو چه کار کردی؟","pr":"اِوِت، اُنلار دا گِلدی. پِکی سِن نِه یاپتِن؟","a":"audio/tr-fa/6d3857adad6a.mp3"},{"sp":"A","t":"Ben hiçbir yere gitmedim. Cumartesi temizlik yaptım ve çamaşır yıkadım.","s":"من هیچ جا نرفتم. شنبه تمیزکاری کردم و لباس شستم.","pr":"بِن هیچبیر یِرِه گیتمِدیم. جومارتِسی تِمیزلیک یاپتِم وِه چاماشِر یِکادِم.","a":"audio/tr-fa/279be648d2e9.mp3"},{"sp":"B","t":"Pazar günü de evde mi kaldın?","s":"یکشنبه هم در خانه ماندی؟","pr":"پازار گونو دِه اِودِه میْ کالدِن؟","a":"audio/tr-fa/65eb1d49082b.mp3"},{"sp":"A","t":"Hayır, pazar günü annemi ziyaret ettim. Birlikte yemek yaptık.","s":"نه، یکشنبه به دیدنِ مادرم رفتم. با هم غذا درست کردیم.","pr":"هایِر، پازار گونو آنِّمیْ زیارِت اِتّیم. بیرلیکتِه یِمِک یاپتِک.","a":"audio/tr-fa/b859cc948ff5.mp3"},{"sp":"B","t":"Annen nasıl?","s":"مادرت چطور است؟","pr":"آنِّن ناسِل؟","a":"audio/tr-fa/ac4a97634b81.mp3"},{"sp":"A","t":"İyi, sağ ol. Ama çok konuştuk ve geç yattım. Şimdi çok yorgunum!","s":"خوب است، ممنون. ولی خیلی حرف زدیم و دیر خوابیدم. الان خیلی خسته‌ام!","pr":"ای‌یی، ساا اُل. آما چُک کُنوشتوک وِه گِچ یاتِّم. شیمدی چُک یُرگونوم!","a":"audio/tr-fa/e594003f42fe.mp3"},{"sp":"B","t":"Ben de! Bir kahve ister misin?","s":"من هم! یک قهوه می‌خواهی؟","pr":"بِن دِه! بیر کاهوِه ایستِر میسین؟","a":"audio/tr-fa/6499050edf26.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Geçmiş zaman: geldim, yaptım","s":"گذشته‌ی ساده با پسوندِ -dı"},"explain":"برای کاری که در گذشته انجام شده و تمام شده است (مثلِ «رفتم، دیدم») به ریشه‌ی فعل پسوندِ **-dı** و بعد شناسه اضافه می‌کنیم: gel**dim** = آمدم، yap**tım** = انجام دادم، درست کردم.\nهماهنگیِ چهارتایی: بعد از a و ı ← **-dı**؛ بعد از e و i ← **-di**؛ بعد از o و u ← **-du**؛ بعد از ö و ü ← **-dü**: al**dı**، gel**di**، oku**du**، gör**dü**.\nبعد از حروفِ **ç f h k p s ş t** (همان «Fıstıkçı Şahap») حرفِ d به **t** تبدیل می‌شود: yap**tı**، iç**ti**، koş**tu**، git**ti**. (در gitmek حرفِ t این‌جا عوض نمی‌شود: **gittim**؛ ولی در زمانِ حال: gidiyorum.)\nشناسه‌ها کوتاه‌اند و شبیهِ پسوندهای مالکیت: **-m، -n، (هیچ)، -k، -nız، -lar**. دقت کنید: برای «ما» **-k** می‌آید: gittik = رفتیم.\nمثلِ فارسی، سوم‌شخصِ مفرد شناسه ندارد: **gitti** = رفت، **geldi** = آمد.","table":[["ben","geldim","yaptım"],["sen","geldin","yaptın"],["o","geldi","yaptı"],["biz","geldik","yaptık"],["siz","geldiniz","yaptınız"],["onlar","geldiler","yaptılar"]],"examples":[{"t":"Dün sinemaya gittim.","s":"دیروز به سینما رفتم.","pr":"دون سینِمایا گیتّیم.","a":"audio/tr-fa/3fa188c40e41.mp3"},{"t":"Hafta sonu kitap okuduk.","s":"آخر هفته کتاب خواندیم.","pr":"هافتا سُنو کیتاپ اُکودوک.","a":"audio/tr-fa/9e0194497604.mp3"},{"t":"Ayşe pazar günü kek yaptı.","s":"آیشه یکشنبه کیک درست کرد.","pr":"آیشِه پازار گونو کِک یاپتِ.","a":"audio/tr-fa/fafacb87b0d3.mp3"},{"t":"Çocuklar parkta oynadılar.","s":"بچه‌ها در پارک بازی کردند.","pr":"چُجوکلار پارکتا اُینادِلار.","a":"audio/tr-fa/8078931c6aa8.mp3"},{"t":"Sen dün çok çalıştın.","s":"تو دیروز خیلی کار کردی.","pr":"سِن دون چُک چالِشتِن.","a":"audio/tr-fa/0b1f35d32654.mp3"}],"exercises":[{"type":"choice","t":"Geçen hafta İzmir'e ___.","options":["gittik","gitdik","gidtik"],"answer":0,"s":"هفته‌ی گذشته به ازمیر رفتیم.","full":"Geçen hafta İzmir'e gittik.","a":"audio/tr-fa/ef0137fb5842.mp3"},{"type":"choice","t":"Akşam bir film ___.","options":["izledik","izledık","izlemdik"],"answer":0,"s":"عصر یک فیلم تماشا کردیم.","full":"Akşam bir film izledik.","a":"audio/tr-fa/c024072dc7fd.mp3"},{"type":"choice","t":"Annem güzel bir yemek ___.","options":["yaptı","yapdı","yaptim"],"answer":0,"s":"مادرم یک غذای خوب درست کرد.","full":"Annem güzel bir yemek yaptı.","a":"audio/tr-fa/40c9a74384b8.mp3"},{"type":"type","t":"Ben dün çok ___.","answer":["yoruldum"],"s":"من دیروز خیلی خسته شدم.","full":"Ben dün çok yoruldum.","a":"audio/tr-fa/148d519118a6.mp3"},{"type":"type","t":"Siz cumartesi ne ___?","answer":["yaptınız"],"s":"شما شنبه چه کار کردید؟","full":"Siz cumartesi ne yaptınız?","a":"audio/tr-fa/c74dc690a779.mp3"},{"type":"type","t":"Dün akşam saat on birde ___.","answer":["yattım","uyudum"],"s":"دیشب ساعت یازده خوابیدم.","full":"Dün akşam saat on birde yattım.","a":"audio/tr-fa/9653f3e4cc1e.mp3"},{"type":"order","t":"Geçen hafta dedemi ziyaret ettik.","s":"هفته‌ی گذشته به دیدنِ پدربزرگم رفتیم.","alts":["Dedemi geçen hafta ziyaret ettik."],"full":"Geçen hafta dedemi ziyaret ettik.","a":"audio/tr-fa/f9d68006119c.mp3"},{"type":"order","t":"Kız kardeşim dün bize geldi.","s":"خواهرم دیروز پیش ما آمد.","alts":["Dün kız kardeşim bize geldi.","Kız kardeşim bize dün geldi."],"full":"Kız kardeşim dün bize geldi.","a":"audio/tr-fa/20b259cfda1a.mp3"}]},{"id":"g02","title":{"t":"Gitmedim. Gittin mi?","s":"گذشته‌ی منفی و سؤالی"},"explain":"**منفی:** مثلِ زمانِ حال، **-ma / -me** بعد از ریشه می‌آید و بعد **-dı**. چون بعد از -ma / -me همیشه واکه است، پسوند فقط **-dı / -di** می‌شود (هیچ‌وقت -tı): gel**medim** = نیامدم، yap**madım** = انجام ندادم، git**medin** = نرفتی، oku**madı** = نخواند.\n**سؤالی:** کلمه‌ی جدای **mı / mi / mu / mü** را بعد از فعل می‌آوریم. در گذشته‌ی -dı **شناسه روی خودِ فعل می‌ماند**: Gel**din mi**? = آمدی؟ Gör**dün mü**? = دیدی؟ Yap**tınız mı**? = انجام دادید؟\nاین با زمانِ حال فرق دارد؛ آن‌جا شناسه به mi می‌چسبید: Geliyor **musun**? ولی در گذشته: Gel**din mi**?\nسؤالِ منفی: Gel**medin mi**? = نیامدی؟\nبا کلمه‌ی پرسشی، mi لازم نیست: **Ne yaptın?** **Nereye gittiniz?** جوابِ کوتاه: **Evet, gittim.** / **Hayır, gitmedim.**\nمثلِ فارسی، **hiç** و **hiçbir** با فعلِ منفی می‌آیند: **Hiçbir yere gitmedim.** = هیچ جا نرفتم.","table":[["ben","gitmedim","gittim mi?"],["sen","gitmedin","gittin mi?"],["o","gitmedi","gitti mi?"],["biz","gitmedik","gittik mi?"],["siz","gitmediniz","gittiniz mi?"],["onlar","gitmediler","gittiler mi?"]],"examples":[{"t":"Hafta sonu hiçbir yere gitmedim.","s":"آخر هفته هیچ جا نرفتم.","pr":"هافتا سُنو هیچبیر یِرِه گیتمِدیم.","a":"audio/tr-fa/dff15f3efa0c.mp3"},{"t":"Dün akşam televizyon izlemedik.","s":"دیشب تلویزیون تماشا نکردیم.","pr":"دون آکشام تِلِویزیُن ایزلِمِدیک.","a":"audio/tr-fa/9629a47b32a2.mp3"},{"t":"Kahvaltı yaptın mı?","s":"صبحانه خوردی؟","pr":"کاهوالتِ یاپتِن مِ؟","a":"audio/tr-fa/d78c54bf165b.mp3"},{"t":"Siz de pikniğe geldiniz mi?","s":"شما هم به پیک‌نیک آمدید؟","pr":"سیز دِه پیکنیِه گِلدینیز می؟","a":"audio/tr-fa/a766a30562ec.mp3"},{"t":"Neda dün okula gelmedi mi?","s":"ندا دیروز به مدرسه نیامد؟","pr":"ندا دون اُکولا گِلمِدی می؟","a":"audio/tr-fa/083a826f9d3c.mp3"}],"exercises":[{"type":"choice","t":"Dün akşam hiçbir şey ___.","options":["yemedim","yemadım","yemedım"],"answer":0,"s":"دیشب هیچ چیز نخوردم.","full":"Dün akşam hiçbir şey yemedim.","a":"audio/tr-fa/f638ec3809bf.mp3"},{"type":"choice","t":"Hafta sonu sinemaya gittin ___?","options":["mi","mı","mu"],"answer":0,"s":"آخر هفته به سینما رفتی؟","full":"Hafta sonu sinemaya gittin mi?","a":"audio/tr-fa/725a5bf5299e.mp3"},{"type":"choice","t":"Dün bize ___?","options":["geldin mi","geldi misin","gel misin"],"answer":0,"s":"دیروز پیش ما آمدی؟","full":"Dün bize geldin mi?","a":"audio/tr-fa/361e54d37a9f.mp3"},{"type":"type","t":"Ben bugün kahve ___.","answer":["içmedim"],"s":"من امروز قهوه نخوردم.","full":"Ben bugün kahve içmedim.","a":"audio/tr-fa/a3b7e73106b4.mp3"},{"type":"type","t":"Ali dün işe ___.","answer":["gitmedi"],"s":"علی دیروز سرِ کار نرفت.","full":"Ali dün işe gitmedi.","a":"audio/tr-fa/be233b1aef24.mp3"},{"type":"type","t":"Dün akşam maç ___ mi?","answer":["izlediniz","seyrettiniz"],"s":"دیشب مسابقه را تماشا کردید؟","full":"Dün akşam maç izlediniz mi?","a":"audio/tr-fa/56af49081e91.mp3"},{"type":"order","t":"Hafta sonu hiçbir yere gitmedik.","s":"آخر هفته هیچ جا نرفتیم.","alts":["Hiçbir yere hafta sonu gitmedik."],"full":"Hafta sonu hiçbir yere gitmedik.","a":"audio/tr-fa/f7a476c7042e.mp3"},{"type":"order","t":"Bu filmi hiç izlemedin mi?","s":"تا حالا این فیلم را ندیدی؟","alts":["Hiç bu filmi izlemedin mi?"],"full":"Bu filmi hiç izlemedin mi?","a":"audio/tr-fa/5b8aacdf6be5.mp3"}]}],"reading":{"title":{"t":"Benim hafta sonum","s":"آخر هفته‌ی من","a":"audio/tr-fa/a231b981669e.mp3"},"text":[{"t":"Merhaba, ben Maryam. Geçen hafta sonu çok güzel geçti.","s":"سلام، من مریم هستم. آخر هفته‌ی گذشته خیلی خوب گذشت.","pr":"مِرحابا، بِن مریم. گِچِن هافتا سُنو چُک گوزِل گِچتی.","a":"audio/tr-fa/17aef8821267.mp3"},{"t":"Cumartesi sabahı geç kalktım ve uzun bir kahvaltı yaptım.","s":"شنبه صبح دیر بیدار شدم و یک صبحانه‌ی مفصل خوردم.","pr":"جومارتِسی ساباهِ گِچ کالکتِم وِه اوزون بیر کاهوالتِ یاپتِم.","a":"audio/tr-fa/cb85b36147af.mp3"},{"t":"Sonra temizlik yaptım ve çamaşır yıkadım.","s":"بعد تمیزکاری کردم و لباس شستم.","pr":"سُنرا تِمیزلیک یاپتِم وِه چاماشِر یِکادِم.","a":"audio/tr-fa/a0657c708ea3.mp3"},{"t":"Akşam kız kardeşim Neda bize geldi.","s":"عصر خواهرم ندا پیش ما آمد.","pr":"آکشام کِز کاردِشیم ندا بیزِه گِلدی.","a":"audio/tr-fa/95f28993bdb2.mp3"},{"t":"Birlikte yemek yaptık ve bir film izledik.","s":"با هم غذا درست کردیم و یک فیلم تماشا کردیم.","pr":"بیرلیکتِه یِمِک یاپتِک وِه بیر فیلم ایزلِدیک.","a":"audio/tr-fa/f436fe7bc084.mp3"},{"t":"Pazar günü ailemle parkta piknik yaptık.","s":"یکشنبه با خانواده‌ام در پارک پیک‌نیک کردیم.","pr":"پازار گونو آئیلِملِه پارکتا پیکنیک یاپتِک.","a":"audio/tr-fa/1cba9ad8a1a8.mp3"},{"t":"Çocuklar top oynadılar, biz çay içtik.","s":"بچه‌ها توپ‌بازی کردند و ما چای خوردیم.","pr":"چُجوکلار تُپ اُینادِلار، بیز چای ایچتیک.","a":"audio/tr-fa/393b810fce10.mp3"},{"t":"Ama ben kitabımı oku