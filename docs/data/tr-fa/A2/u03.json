{"id":"u03","level":"A2","emoji":"🥘","title":{"t":"Mutfakta","s":"در آشپزخانه","a":"audio/tr-fa/78b4c55bf886.mp3"},"goals":["وسایلِ آشپزخانه و فعل‌های آشپزی را نام ببرم.","با پسوندِ -(y)ı مفعولِ معین را نشان بدهم (مثلِ «را» در فارسی).","با فعلِ امر و نهی (sen / siz) دستورِ پخت بدهم یا کمک بخواهم.","یک دستورِ پختِ ساده را بخوانم و بفهمم."],"words":[{"id":"w01","t":"tencere","pl":"tencereler","s":"قابلمه","pr":"تِنجِرِه","emoji":"","ex":{"t":"Tencereyi ocağa koy.","s":"قابلمه را روی اجاق بگذار.","pr":"تِنجِرِیی اُجاآ کُی.","a":"audio/tr-fa/bfc525cda556.mp3"},"img":null,"a":"audio/tr-fa/e41c22601923.mp3","pla":"audio/tr-fa/278ecefba86a.mp3"},{"id":"w02","t":"tava","pl":"tavalar","s":"ماهیتابه","pr":"تاوا","emoji":"🍳","ex":{"t":"Tavada yumurta pişirdim.","s":"در ماهیتابه تخم‌مرغ پختم.","pr":"تاوادا یومورتا پیشیردیم.","a":"audio/tr-fa/1237e9604c6c.mp3"},"img":"img/e/1f373.svg","a":"audio/tr-fa/9d817e0ab0e5.mp3","pla":"audio/tr-fa/5e36c88b9704.mp3"},{"id":"w03","t":"ocak","s":"اجاقِ گاز","pr":"اُجاک","emoji":"","ex":{"t":"Ocağı kapat, lütfen.","s":"لطفاً اجاق را خاموش کن.","pr":"اُجائِ کاپات، لوتفِن.","a":"audio/tr-fa/9cf11e05ee68.mp3"},"img":null,"a":"audio/tr-fa/c6c32cb7fcc3.mp3"},{"id":"w04","t":"fırın","s":"فِر؛ نانوایی","pr":"فِرِن","emoji":"","ex":{"t":"Keki fırına koydum.","s":"کیک را توی فر گذاشتم.","pr":"کِکی فِرِنا کُیدوم.","a":"audio/tr-fa/e3869ca960a3.mp3"},"img":null,"a":"audio/tr-fa/d408a2284416.mp3"},{"id":"w05","t":"bıçak","pl":"bıçaklar","s":"چاقو","pr":"بِچاک","emoji":"🔪","ex":{"t":"Ekmeği bu bıçakla kes.","s":"نان را با این چاقو ببُر.","pr":"اِکمِیی بو بِچاکلا کِس.","a":"audio/tr-fa/4945fb0e25b8.mp3"},"img":"img/e/1f52a.svg","a":"audio/tr-fa/3303ffa94092.mp3","pla":"audio/tr-fa/baa95baad8d4.mp3"},{"id":"w06","t":"kaşık","pl":"kaşıklar","s":"قاشق","pr":"کاشِک","emoji":"🥄","ex":{"t":"Çaya bir kaşık şeker koy.","s":"یک قاشق شکر در چای بریز.","pr":"چایا بیر کاشِک شِکِر کُی.","a":"audio/tr-fa/c7421cc00f48.mp3"},"img":"img/e/1f944.svg","a":"audio/tr-fa/8c8be48b6494.mp3","pla":"audio/tr-fa/3cd4b9f744a2.mp3"},{"id":"w07","t":"tabak","pl":"tabaklar","s":"بشقاب","pr":"تاباک","emoji":"🍽️","ex":{"t":"Tabaklar dolapta.","s":"بشقاب‌ها توی کابینت‌اند.","pr":"تاباکلار دُلاپتا.","a":"audio/tr-fa/f2aed88d2c5a.mp3"},"img":"img/e/1f37d.svg","a":"audio/tr-fa/78dc3d6a769c.mp3","pla":"audio/tr-fa/3126549b0f8b.mp3"},{"id":"w08","t":"bardak","pl":"bardaklar","s":"لیوان","pr":"بارداک","emoji":"","ex":{"t":"Bardakları yıka, lütfen.","s":"لطفاً لیوان‌ها را بشوی.","pr":"بارداکلارِ یِکا، لوتفِن.","a":"audio/tr-fa/51f4f618736d.mp3"},"img":null,"a":"audio/tr-fa/ba836df51ced.mp3","pla":"audio/tr-fa/96c405291526.mp3"},{"id":"w09","t":"pişirmek","s":"پختن","pr":"پیشیرمِک","emoji":"","ex":{"t":"Annem pilavı çok güzel pişiriyor.","s":"مادرم پلو را خیلی خوب می‌پزد.","pr":"آنِّم پیلاوِ چُک گوزِل پیشیریُر.","a":"audio/tr-fa/fafdf1d1c66b.mp3"},"img":null,"a":"audio/tr-fa/c0d8d41c5c42.mp3"},{"id":"w10","t":"doğramak","s":"خرد کردن (با چاقو)","pr":"دُراماک","emoji":"","ex":{"t":"Havucu doğradın mı?","s":"هویج را خرد کردی؟","pr":"هاووجو دُرادِن مِ؟","a":"audio/tr-fa/b9feeaf6aceb.mp3"},"img":null,"a":"audio/tr-fa/00592087bee2.mp3"},{"id":"w11","t":"karıştırmak","s":"هم زدن، مخلوط کردن","pr":"کارِشتِرماک","emoji":"","ex":{"t":"Yumurtaları bir kaşıkla karıştır.","s":"تخم‌مرغ‌ها را با یک قاشق هم بزن.","pr":"یومورتالارِ بیر کاشِکلا کارِشتِر.","a":"audio/tr-fa/d70232311518.mp3"},"img":null,"a":"audio/tr-fa/605c3888b9cd.mp3"},{"id":"w12","t":"soğan","pl":"soğanlar","s":"پیاز","pr":"سُئان","emoji":"🧅","ex":{"t":"Bir soğan ve iki domates al.","s":"یک پیاز و دو گوجه بخر.","pr":"بیر سُئان وِه ایکی دُماتِس آل.","a":"audio/tr-fa/de063c7da9e7.mp3"},"img":"img/e/1f9c5.svg","a":"audio/tr-fa/5483ac5fe9fa.mp3","pla":"audio/tr-fa/48409c76b0df.mp3"},{"id":"w13","t":"domates","pl":"domatesler","s":"گوجه‌فرنگی","pr":"دُماتِس","emoji":"🍅","ex":{"t":"Domatesleri yıkadın mı?","s":"گوجه‌ها را شستی؟","pr":"دُماتِسلِری یِکادِن مِ؟","a":"audio/tr-fa/497c2dce840e.mp3"},"img":"img/e/1f345.svg","a":"audio/tr-fa/c212529a3db1.mp3","pla":"audio/tr-fa/22f123caf6d6.mp3"},{"id":"w14","t":"tuz","s":"نمک","pr":"توز","emoji":"🧂","ex":{"t":"Çorbaya biraz tuz koy.","s":"کمی نمک در سوپ بریز.","pr":"چُربایا بیراز توز کُی.","a":"audio/tr-fa/37651a2d7873.mp3"},"img":"img/e/1f9c2.svg","a":"audio/tr-fa/2c99c50543aa.mp3"},{"id":"w15","t":"yağ","s":"روغن","pr":"یاا","emoji":"","ex":{"t":"Bu yemekte çok yağ var.","s":"این غذا روغنِ زیادی دارد.","pr":"بو یِمِکتِه چُک یاا وار.","a":"audio/tr-fa/008eaf92ef05.mp3"},"img":null,"a":"audio/tr-fa/ce83628eaf1b.mp3"},{"id":"w16","t":"tarif","pl":"tarifler","s":"دستورِ پخت","pr":"تاریف","emoji":"","ex":{"t":"Bu tarif çok kolay.","s":"این دستورِ پخت خیلی آسان است.","pr":"بو تاریف چُک کُلای.","a":"audio/tr-fa/20eb65321c84.mp3"},"img":null,"a":"audio/tr-fa/7132a3bd9720.mp3","pla":"audio/tr-fa/c404b34b6f20.mp3"}],"phrases":[{"id":"p01","t":"Yardım edebilir miyim?","s":"می‌توانم کمک کنم؟","pr":"یاردِم اِدِبیلیر مییم؟","a":"audio/tr-fa/a4c6d424d716.mp3"},{"id":"p02","t":"Ne pişiriyorsun?","s":"چه می‌پزی؟","pr":"نِه پیشیریُرسون؟","a":"audio/tr-fa/8f9023ebe319.mp3"},{"id":"p03","t":"Mis gibi kokuyor!","s":"چه بوی خوبی می‌دهد!","pr":"میس گیبی کُکویُر!","a":"audio/tr-fa/52db65a4933c.mp3"},{"id":"p04","t":"Tuzu bana verir misin?","s":"نمک را به من می‌دهی؟","pr":"توزو بانا وِریر میسین؟","a":"audio/tr-fa/5cddeb0d1ad5.mp3"},{"id":"p05","t":"Dikkat et, sıcak!","s":"مواظب باش، داغ است!","pr":"دیکّات اِت، سِجاک!","a":"audio/tr-fa/fc6921890acf.mp3"},{"id":"p06","t":"Biraz daha ister misin?","s":"کمی دیگر می‌خواهی؟","pr":"بیراز داها ایستِر میسین؟","a":"audio/tr-fa/91cbf01356fc.mp3"},{"id":"p07","t":"Tadına bak!","s":"مزه‌اش را بچش!","pr":"تادِنا باک!","a":"audio/tr-fa/8eb65b46c67d.mp3"},{"id":"p08","t":"Kolay gelsin!","s":"خسته نباشی! (به کسی که مشغولِ کار است)","pr":"کُلای گِلسین!","a":"audio/tr-fa/b40aea7b6e2d.mp3"}],"dialogue":{"title":{"t":"Menemen yapıyoruz","s":"منمن درست می‌کنیم","a":"audio/tr-fa/57ce22225749.mp3"},"speakers":{"A":{"name":"Reza","voice":"m"},"B":{"name":"Ayşe","voice":"f"}},"lines":[{"sp":"A","t":"Kolay gelsin, Ayşe! Ne pişiriyorsun?","s":"خسته نباشی، آیشه! چه می‌پزی؟","pr":"کُلای گِلسین، آیشِه! نِه پیشیریُرسون؟","a":"audio/tr-fa/815284892bf9.mp3"},{"sp":"B","t":"Menemen yapıyorum. Menemeni biliyor musun?","s":"منمن درست می‌کنم. منمن را می‌شناسی؟","pr":"مِنِمِن یاپِیُروم. مِنِمِنی بیلیُر موسون؟","a":"audio/tr-fa/98df4ca93e0d.mp3"},{"sp":"A","t":"Hayır, bilmiyorum. Yardım edebilir miyim?","s":"نه، نمی‌شناسم. می‌توانم کمک کنم؟","pr":"هایِر، بیلمیُروم. یاردِم اِدِبیلیر مییم؟","a":"audio/tr-fa/e25f1805366d.mp3"},{"sp":"B","t":"Tabii. Önce biberleri ve domatesleri yıka, sonra doğra.","s":"حتماً. اول فلفل‌ها و گوجه‌ها را بشوی، بعد خرد کن.","pr":"تابیی. اُنجِه بیبِرلِری وِه دُماتِسلِری یِکا، سُنرا دُرا.","a":"audio/tr-fa/688d63ea6632.mp3"},{"sp":"A","t":"Bıçak nerede?","s":"چاقو کجاست؟","pr":"بِچاک نِرِدِه؟","a":"audio/tr-fa/465178e98299.mp3"},{"sp":"B","t":"Dolapta. Dikkat et, çok keskin!","s":"توی کابینت. مواظب باش، خیلی تیز است!","pr":"دُلاپتا. دیکّات اِت، چُک کِسکین!","a":"audio/tr-fa/706c4ec94480.mp3"},{"sp":"A","t":"Tamam, doğradım. Sonra?","s":"باشه، خرد کردم. بعد؟","pr":"تامام، دُرادِم. سُنرا؟","a":"audio/tr-fa/5471ce203198.mp3"},{"sp":"B","t":"Tavaya biraz yağ koy ve ocağı aç. Önce biberleri biraz kavur.","s":"کمی روغن در ماهیتابه بریز و اجاق را روشن کن. اول فلفل‌ها را کمی تفت بده.","pr":"تاوایا بیراز یاا کُی وِه اُجائِ آچ. اُنجِه بیبِرلِری بیراز کاوور.","a":"audio/tr-fa/3621d93248e0.mp3"},{"sp":"A","t":"Ya domatesler?","s":"پس گوجه‌ها چه؟","pr":"یا دُماتِسلِر؟","a":"audio/tr-fa/6c6cdac9466f.mp3"},{"sp":"B","t":"Beş dakika sonra domatesleri ekle. Sonra yumurtaları kır ve karıştır.","s":"پنج دقیقه بعد گوجه‌ها را اضافه کن. بعد تخم‌مرغ‌ها را بشکن و هم بزن.","pr":"بِش داکیکا سُنرا دُماتِسلِری اِکلِه. سُنرا یومورتالارِ کِر وِه کارِشتِر.","a":"audio/tr-fa/fd16695a9854.mp3"},{"sp":"A","t":"Mis gibi kokuyor! Tuz nerede?","s":"چه بوی خوبی می‌دهد! نمک کجاست؟","pr":"میس گیبی کُکویُر! توز نِرِدِه؟","a":"audio/tr-fa/978567c21957.mp3"},{"sp":"B","t":"Burada. Ama çok koyma! Tabakları da masaya götür, ekmeği unutma.","s":"این‌جاست. ولی زیاد نریز! بشقاب‌ها را هم سرِ میز ببر، نان را فراموش نکن.","pr":"بورادا. آما چُک کُیما! تاباکلارِ دا ماسایا گُتور، اِکمِیی اونوتما.","a":"audio/tr-fa/90ad933a289a.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Domatesi doğra: -(y)ı / -(y)i / -(y)u / -(y)ü","s":"حالتِ مفعولی: نشانه‌ی «را»"},"explain":"در A1 دیدید: **Çayı seviyorum** = چای را دوست دارم. این پسوند، یعنی **-ı / -i / -u / -ü** (هماهنگیِ چهارتایی)، درست مثلِ «را» در فارسی است و مفعولِ **معین** (مشخص) را نشان می‌دهد.\n**Domatesi doğra.** = گوجه را خرد کن (همان گوجه‌ای که می‌دانیم کدام است). اما **Domates aldım.** = گوجه خریدم (مفعولِ نامعین، بدونِ پسوند؛ مثلِ فارسی که «را» نمی‌آید).\nبعد از واکه یک **y** می‌آید: kahve ← kahve**yi**، tava ← tava**yı**، su ← su**yu**.\nدر بیشترِ کلمه‌های چندهجایی، حرفِ آخر قبل از واکه نرم می‌شود: k ← **ğ** (bıçak ← bıça**ğı**)، p ← **b** (kitap ← kita**bı**)، ç ← **c** (havuç ← havu**cu**). در کلمه‌های تک‌هجایی معمولاً نه: süt ← süt**ü**، top ← top**u**.\nاسم‌های خاص و ضمیرها همیشه معین‌اند: **Ali'yi**، **bunu** (این را)، **onu** (او را، آن را)، **beni، seni، bizi، sizi، onları**. بعد از پسوندِ مالکیتِ سوم‌شخص یک **n** می‌آید: annesi ← annesi**ni**.","table":[["çay","çayı"],["peynir","peyniri"],["soğan","soğanı"],["süt","sütü"],["tava","tavayı"],["kahve","kahveyi"],["bıçak","bıçağı"]],"examples":[{"t":"Soğanı doğradın mı?","s":"پیاز را خرد کردی؟","pr":"سُئانِ دُرادِن مِ؟","a":"audio/tr-fa/7bfd285c2afe.mp3"},{"t":"Bugün marketten domates aldım.","s":"امروز از سوپرمارکت گوجه خریدم.","pr":"بوگون مارکِتِّن دُماتِس آلدِم.","a":"audio/tr-fa/b834b86d76c9.mp3"},{"t":"Domatesleri buzdolabına koydum.","s":"گوجه‌ها را توی یخچال گذاشتم.","pr":"دُماتِسلِری بوزدُلابِنا کُیدوم.","a":"audio/tr-fa/7ec5c73cff2f.mp3"},{"t":"Bu tarifi çok seviyorum.","s":"این دستورِ پخت را خیلی دوست دارم.","pr":"بو تاریفی چُک سِویُروم.","a":"audio/tr-fa/b1bd9e787f58.mp3"},{"t":"Ali'yi gördün mü?","s":"علی را دیدی؟","pr":"علی‌یی گُردون مو؟","a":"audio/tr-fa/b7614a1a904f.mp3"}],"exercises":[{"type":"choice","t":"___ bana ver, lütfen.","options":["Bıçağı","Bıçakı","Bıçağa"],"answer":0,"s":"لطفاً چاقو را به من بده.","full":"Bıçağı bana ver, lütfen.","a":"audio/tr-fa/bf5db37e0146.mp3"},{"type":"choice","t":"Çorba___ karıştır.","options":["yı","yi","ı"],"answer":0,"s":"سوپ را هم بزن.","full":"Çorbayı karıştır.","a":"audio/tr-fa/4ae77f85d734.mp3"},{"type":"choice","t":"Marketten iki kilo ___ aldım.","options":["domates","domatesi","domatesleri"],"answer":0,"s":"از سوپرمارکت دو کیلو گوجه خریدم.","full":"Marketten iki kilo domates aldım.","a":"audio/tr-fa/234814f9aea9.mp3"},{"type":"type","t":"Kahve___ çok seviyorum.","answer":["yi"],"s":"قهوه را خیلی دوست دارم.","full":"Kahveyi çok seviyorum.","a":"audio/tr-fa/541ade35566b.mp3"},{"type":"type","t":"Süt___ buzdolabına koy.","answer":["ü"],"s":"شیر را توی یخچال بگذار.","full":"Sütü buzdolabına koy.","a":"audio/tr-fa/78ef1f59bdf0.mp3"},{"type":"type","t":"Dün Mehmet'___ gördüm.","answer":["i"],"s":"دیروز مهمت را دیدم.","full":"Dün Mehmet'i gördüm.","a":"audio/tr-fa/b8a803b00f1d.mp3"},{"type":"choice","t":"Annem ___ çok seviyor.","options":["beni","ben","bana"],"answer":0,"s":"مادرم من را خیلی دوست دارد.","full":"Annem beni çok seviyor.","a":"audio/tr-fa/d627dba611e0.mp3"},{"type":"order","t":"Domatesleri ve soğanları doğradım.","s":"گوجه‌ها و پیازها را خرد کردم.","alts":["Soğanları ve domatesleri doğradım."],"full":"Domatesleri ve soğanları doğradım.","a":"audio/tr-fa/4fbbf22d7a44.mp3"}]},{"id":"g02","title":{"t":"Al, alın, alma, almayın","s":"فعلِ امر و نهی: sen و siz"},"explain":"**امر با sen (تو):** فقط **ریشه‌ی فعل**، بدونِ هیچ پسوندی: al = بگیر، بخر؛ doğra = خرد کن؛ gel = بیا. (مثلِ فارسیِ «بیا»، «برو».)\n**امر با siz (شما؛ مؤدبانه یا جمع):** ریشه + **-ın / -in / -un / -ün**؛ بعد از واکه **-yın / -yin / -yun / -yün**: al**ın**، gel**in**، karıştır**ın**، doğra**yın**، bekle**yin**. (در A1 دیدید: dön**ün**، gid**in**.)\n**نهی (منفی):** ریشه + **-ma / -me**: al**ma** = نگیر، koy**ma** = نگذار، نریز. با siz: **-mayın / -meyin**: al**mayın**، gel**meyin**.\nدر دستورِ پخت‌ها و تابلوها شکلِ رسمی‌ترِ **-ınız** را هم می‌بینید: **karıştırınız**، **girmeyiniz** (وارد نشوید).\nبرای مؤدب‌تر کردن، **lütfen** را اول یا آخرِ جمله بگذارید: **Lütfen kapıyı kapatın.**\nدقت کنید: gitmek ← **git** (تو)، **gidin** (شما)؛ etmek ← **et**، **edin**: **Dikkat edin!** = مواظب باشید!","table":[["almak","al, alın","alma, almayın"],["gelmek","gel, gelin","gelme, gelmeyin"],["doğramak","doğra, doğrayın","doğrama, doğramayın"],["koymak","koy, koyun","koyma, koymayın"],["gitmek","git, gidin","gitme, gitmeyin"],["etmek","et, edin","etme, etmeyin"]],"examples":[{"t":"Soğanı doğra, sonra tavaya koy.","s":"پیاز را خرد کن، بعد در ماهیتابه بریز.","pr":"سُئانِ دُرا، سُنرا تاوایا کُی.","a":"audio/tr-fa/3ee52a879124.mp3"},{"t":"Lütfen ellerinizi yıkayın.","s":"لطفاً دست‌هایتان را بشویید.","pr":"لوتفِن اِلِّرینیزی یِکایِن.","a":"audio/tr-fa/9996c7b80f74.mp3"},{"t":"Fırını açma, kek daha pişmedi.","s":"فر را باز نکن، کیک هنوز نپخته.","pr":"فِرِنِ آچما، کِک داها پیشمِدی.","a":"audio/tr-fa/10d0759072b2.mp3"},{"t":"Çok tuz koymayın!","s":"زیاد نمک نریزید!","pr":"چُک توز کُیمایِن!","a":"audio/tr-fa/502799f87bb6.mp3"},{"t":"Dikkat edin, tava çok sıcak!","s":"مواظب باشید، ماهیتابه خیلی داغ است!","pr":"دیکّات اِدین، تاوا چُک سِجاک!","a":"audio/tr-fa/9945d913270b.mp3"}],"exercises":[{"type":"choice","t":"Çocuklar, mutfakta ___!","options":["oynamayın","oynamadın","oynamıyorsun"],"answer":0,"s":"بچه‌ها، در آشپزخانه بازی نکنید!","full":"Çocuklar, mutfakta oynamayın!","a":"audio/tr-fa/b3800f7b3c9a.mp3"},{"type":"choice","t":"Lütfen biraz ___, yemek hazır değil.","options":["bekleyin","bekleyın","beklein"],"answer":0,"s":"لطفاً کمی صبر کنید، غذا آماده نیست.","full":"Lütfen biraz bekleyin, yemek hazır değil.","a":"audio/tr-fa/71a474cad046.mp3"},{"type":"choice","t":"Bıçağa ___, çok keskin!","options":["dokunma","dokunmadı","dokunmuyor"],"answer":0,"s":"به چاقو دست نزن، خیلی تیز است!","full":"Bıçağa dokunma, çok keskin!","a":"audio/tr-fa/09a3e1f431c7.mp3"},{"type":"type","t":"Ellerini ___, sonra yemek ye!","answer":["yıka"],"s":"دست‌هایت را بشوی، بعد غذا بخور!","full":"Ellerini yıka, sonra yemek ye!","a":"audio/tr-fa/10d3ec8cffb7.mp3"},{"type":"type","t":"Hanımefendi, lütfen buraya ___.","answer":["oturun","oturunuz"],"s":"خانم، لطفاً این‌جا بنشینید.","full":"Hanımefendi, lütfen buraya oturun.","a":"audio/tr-fa/963fa787d4ee.mp3"},{"type":"type","t":"Çorbaya çok tuz ___!","answer":["koyma","atma"],"s":"زیاد نمک در سوپ نریز!","full":"Çorbaya çok tuz koyma!","a":"audio/tr-fa/cea7ed2a9bae.mp3"},{"type":"type","t":"Lütfen kapıyı ___.","answer":["açın","açınız"],"s":"لطفاً در را باز کنید.","full":"Lütfen kapıyı açın.","a":"audio/tr-fa/89bd48d92733.mp3"},{"type":"order","t":"Soğanı doğra ve tavaya koy.","s":"پیاز را خرد کن و در ماهیتابه بریز.","full":"Soğanı doğra ve tavaya koy.","a":"audio/tr-fa/6ea1b9377c85.mp3"}]}],"reading":{"title":{"t":"Kolay mercimek çorbası","s":"سوپِ عدسِ آسان","a":"audio/tr-fa/27858bb78ffd.mp3"},"text":[{"t":"Merhaba, ben Neda! Bu tarifi annemden öğrendim; çok kolay ve lezzetli.","s":"سلام، من ندا هستم! این دستورِ پخت را از مادرم یاد گرفتم؛ خیلی آسان و خوشمزه است.","pr":"مِرحابا، بِن ندا! بو تاریفی آنِّمدِن اُرِندیم؛ چُک کُلای وِه لِزِّتلی.","a":"audio/tr-fa/6c6580b298c3.mp3"},{"t":"Bir su bardağı kırmızı mercimek, bir soğan, bir havuç, biraz yağ ve tuz alın.","s":"یک لیوان عدسِ قرمز، یک پیاز، یک هویج، کمی روغن و نمک بردارید.","pr":"بیر سو باردائِ کِرمِزِ مِرجیمِک، بیر سُئان، بیر هاووچ، بیراز یاا وِه توز آلِن.","a":"audio/tr-fa/85ff4917ce18.mp3"},{"t":"Önce mercimeği yıkayın.","s":"اول عدس را بشویید.","pr":"اُنجِه مِرجیمِیی یِکایِن.","a":"audio/tr-fa/2dd9a8cc591e.mp3"},{"t":"Sonra soğanı ve havucu doğrayın.","s":"بعد پیاز و هویج را خرد کنید.","pr":"سُنرا سُئانِ وِه هاووجو دُرایِن.","a":"audio/tr-fa/7125b9d275b4.mp3"},{"t":"Tencereye biraz yağ koyun ve soğanı iki üç dakika kavurun.","s":"کمی روغن در قابلمه بریزید و پیاز را دو سه دقیقه تفت بدهید.","pr":"تِنجِرِیِه بیراز یاا کُیون وِه سُئانِ ایکی اوچ داکیکا کاوورون.","a":"audio/tr-fa/ae458fd8198b.mp3"},{"t":"Mercimeği, havucu ve beş bardak suyu tencereye ekleyin.","s":"عدس، هویج و پنج لیوان آب را به قابلمه اضافه کنید.","pr":"مِرجیمِیی، هاووجو وِه بِش بارداک سویو تِنجِرِیِه اِکلِیین.","a":"audio/tr-fa/7a5511e39bfe.mp3"},{"t":"Çorbayı yarım saat pişirin ve arada bir karıştırın.","s":"سوپ را نیم ساعت بپزید و گاه‌گاهی هم بزنید.","pr":"چُربایِ یارِم ساآت پیشیرین وِه آرادا بیر کارِشتِرِن.","a":"audio/tr-fa/bd83724c27f0.mp3"},{"t":"Sonra ocağı kapatın ve biraz tuz ekleyin.","s":"بعد اجاق را خاموش کنید و کمی نمک اضافه کنید.","pr":"سُنرا اُجائِ کاپاتِن وِه بیراز توز اِکلِیین.","a":"audio/tr-fa/094b9787bedc.mp3"},{"t":"Çorbayı çok sıcak içmeyin, biraz bekleyin!","s":"سوپ را خیلی داغ نخورید، کمی صبر کنید!","pr":"چُربایِ چُک سِجاک ایچمِیین، بیراز بِکلِیین!","a":"audio/tr-fa/f441b41af430.mp3"},{"t":"Limon ve ekmekle servis yapın. Afiyet olsun!","s":"با لیمو و نان سرو کنید. نوشِ جان!","pr":"لیمُن وِه اِکمِکلِه سِرویس یاپِن. آفیِت اُلسون!","a":"audio/tr-fa/87941a27a722.mp3"}],"questions":[{"q":{"t":"Neda bu tarifi kimden öğrendi?","s":"ندا این دستورِ پخت را از چه کسی یاد گرفت؟","a":"audio/tr-fa/d2d15b27e694.mp3"},"options":["Annesinden","Arkadaşından","Bir kitaptan"],"answer":0},{"q":{"t":"Önce ne yapıyoruz?","s":"اول چه کار می‌کنیم؟","a":"audio/tr-fa/8acb77deafbe.mp3"},"options":["Mercimeği yıkıyoruz.","Soğanı kavuruyoruz.","Tuz ekliyoruz."],"answer":0},{"q":{"t":"Çorbaya kaç bardak su ekliyoruz?","s":"چند لیوان آب به سوپ اضافه می‌کنیم؟","a":"audio/tr-fa/051e1004eb2b.mp3"},"options":["Bir","Üç","Beş"],"answer":2},{"q":{"t":"Çorba ne kadar pişiyor?","s":"سوپ چقدر می‌پزد؟","a":"audio/tr-fa/0e6e7bd0e220.mp3"},"options":["On dakika","Yarım saat","Bir saat"],"answer":1},{"q":{"t":"Çorbayı neyle servis yapıyoruz?","s":"سوپ را با چه سرو می‌کنیم؟","a":"audio/tr-fa/59bd45f931bf.mp3"},"options":["Limon ve ekmekle","Peynirle","Pilavla"],"answer":0}]},"sentences":[{"t":"Bıçağı nereye koydun?","s":"چاقو را کجا گذاشتی؟","pr":"بِچائِ نِرِیِه کُیدون؟","a":"audio/tr-fa/a7c15215153c.mp3"},{"t":"Tabakları masaya koy, lütfen.","s":"لطفاً بشقاب‌ها را روی میز بگذار.","pr":"تاباکلارِ ماسایا کُی، لوتفِن.","alts":["Lütfen tabakları masaya koy."],"a":"audio/tr-fa/c13495b6abd0.mp3"},{"t":"Çorbayı karıştırmayı unutma!","s":"یادت نرود سوپ را هم بزنی!","pr":"چُربایِ کارِشتِرمایِ اونوتما!","a":"audio/tr-fa/41aed599497c.mp3"},{"t":"Fırını açmayın!","s":"فر را باز نکنید!","pr":"فِرِنِ آچمایِن!","a":"audio/tr-fa/1475725d291f.mp3"},{"t":"Bu bıçak çok keskin, dikkat et!","s":"این چاقو خیلی تیز است، مواظب باش!","pr":"بو بِچاک چُک کِسکین، دیکّات اِت!","a":"audio/tr-fa/35ca1022cb42.mp3"},{"t":"Ali'yi ve Ayşe'yi yemeğe çağırdım.","s":"علی و آیشه را به غذا دعوت کردم.","pr":"علی‌یی وِه آیشِیی یِمِیِه چائِردِم.","alts":["Ayşe'yi ve Ali'yi yemeğe çağırdım."],"a":"audio/tr-fa/de14b1c5ace3.mp3"},{"t":"Babam bu akşam yemek pişiriyor.","s":"پدرم امشب غذا می‌پزد.","pr":"بابام بو آکشام یِمِک پیشیریُر.","alts":["Bu akşam babam yemek pişiriyor."],"a":"audio/tr-fa/7d6f9af8f25c.mp3"},{"t":"Bize biraz yardım edin, lütfen.","s":"لطفاً کمی به ما کمک کنید.","pr":"بیزِه بیراز یاردِم اِدین، لوتفِن.","alts":["Lütfen bize biraz yardım edin."],"a":"audio/tr-fa/e01973416322.mp3"}],"img":"img/e/1f958.svg"}