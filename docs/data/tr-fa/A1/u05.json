,"pr":"هُش بولدوک!","a":"audio/tr-fa/d3b6af77f02f.mp3"},{"id":"p06","t":"Evin çok güzel!","s":"خانه‌ات خیلی قشنگ است!","pr":"اِوین چُک گوزِل!","a":"audio/tr-fa/1661966db87e.mp3"},{"id":"p07","t":"Buyurun, oturun.","s":"بفرمایید، بنشینید.","pr":"بویورون، اُتورون","a":"audio/tr-fa/f43db57410db.mp3"},{"id":"p08","t":"Evde kimse yok.","s":"کسی در خانه نیست.","pr":"اِودِه کیمسِه یُک","a":"audio/tr-fa/ede36a5f3345.mp3"}],"dialogue":{"title":{"t":"Mina'nın evi","s":"خانه‌ی مینا","a":"audio/tr-fa/27d34ff143ed.mp3"},"speakers":{"A":{"name":"Mina","voice":"f"},"B":{"name":"Can","voice":"m"}},"lines":[{"sp":"A","t":"Hoş geldin, Can!","s":"خوش آمدی، جان!","a":"audio/tr-fa/725f2725a787.mp3"},{"sp":"B","t":"Hoş bulduk, Mina! Evin çok güzel.","s":"ممنون، مینا! خانه‌ات خیلی قشنگ است.","a":"audio/tr-fa/d3112ac9d435.mp3"},{"sp":"A","t":"Teşekkürler! Bu salon.","s":"ممنون! این پذیرایی است.","a":"audio/tr-fa/fe20a7646f3d.mp3"},{"sp":"B","t":"Bu halı çok güzel!","s":"این فرش خیلی قشنگ است!","a":"audio/tr-fa/bd850cb06e09.mp3"},{"sp":"A","t":"Evet, bu bir İran halısı.","s":"بله، این یک فرش ایرانی است.","a":"audio/tr-fa/4f0c884ae543.mp3"},{"sp":"B","t":"Annen ve baban nerede?","s":"مادر و پدرت کجا هستند؟","a":"audio/tr-fa/33edb8af98d4.mp3"},{"sp":"A","t":"Annem mutfakta, babam bahçede.","s":"مادرم در آشپزخانه است، پدرم در حیاط.","a":"audio/tr-fa/add80ce8e9e0.mp3"},{"sp":"B","t":"Evde kaç oda var?","s":"خانه چند اتاق دارد؟","a":"audio/tr-fa/1299458879d1.mp3"},{"sp":"A","t":"Üç oda var. Gel, mutfakta çay var!","s":"سه اتاق دارد. بیا، در آشپزخانه چای هست!","a":"audio/tr-fa/742c52c68630.mp3"},{"sp":"B","t":"Çok güzel! Çayı çok seviyorum.","s":"چه خوب! چای را خیلی دوست دارم.","a":"audio/tr-fa/8b382e2b7a0f.mp3"}]},"grammar":[{"id":"g01","title":{"t":"var / yok","s":"هست / نیست"},"explain":"**var** یعنی «هست، وجود دارد» و **yok** یعنی «نیست، وجود ندارد». این دو کلمه معمولاً **آخرِ جمله** می‌آیند.\n**Salonda televizyon var.** = در پذیرایی تلویزیون هست.\n**Mutfakta ekmek yok.** = در آشپزخانه نان نیست.\nبا پسوندهای مالکیتِ درس ۳، **var** معنی «داشتن» هم می‌دهد: **Bir kız kardeşim var.** = یک خواهر دارم. **Arabam yok.** = ماشین ندارم.\nبرای سؤال، **mı** را اضافه کنید: **Evde süt var mı?** = در خانه شیر هست؟","table":[["Evde süt var.","Evde süt yok.","Evde süt var mı?"],["Bir kardeşim var.","Kardeşim yok.","Kardeşin var mı?"],["Salonda televizyon var.","Salonda televizyon yok.","Salonda televizyon var mı?"]],"examples":[{"t":"Evimizde üç oda var.","s":"خانه‌ی ما سه اتاق دارد.","a":"audio/tr-fa/7d8b98d51d77.mp3"},{"t":"Mutfakta ekmek yok.","s":"در آشپزخانه نان نیست.","a":"audio/tr-fa/48cdd748e5b4.mp3"},{"t":"İki çocuğum var.","s":"دو بچه دارم.","a":"audio/tr-fa/d8fcd1d3b514.mp3"},{"t":"Bahçede bir kedi var.","s":"در حیاط یک گربه هست.","a":"audio/tr-fa/97479b73936d.mp3"},{"t":"Evde süt var mı? — Hayır, yok.","s":"در خانه شیر هست؟ — نه، نیست.","a":"audio/tr-fa/795afbfa66e9.mp3"}],"exercises":[{"type":"choice","t":"Salonda bir kanepe ___.","options":["var","yok"],"answer":0,"s":"در پذیرایی یک مبل هست.","full":"Salonda bir kanepe var.","a":"audio/tr-fa/ecd36d1bdd9e.mp3"},{"type":"choice","t":"Mutfakta su ___.","options":["var","yok"],"answer":1,"s":"در آشپزخانه آب نیست.","full":"Mutfakta su yok.","a":"audio/tr-fa/6531bc1be530.mp3"},{"type":"type","t":"İki kardeşim ___.","answer":["var"],"s":"دو خواهر یا برادر دارم.","full":"İki kardeşim var.","a":"audio/tr-fa/faebb8f83200.mp3"},{"type":"type","t":"Evde televizyon ___.","answer":["yok"],"s":"در خانه تلویزیون نیست.","full":"Evde televizyon yok.","a":"audio/tr-fa/4ae3e950e056.mp3"},{"type":"choice","t":"Evde ekmek var ___?","options":["mı","mi","mu"],"answer":0,"s":"در خانه نان هست؟","full":"Evde ekmek var mı?","a":"audio/tr-fa/e46be2f210dc.mp3"},{"type":"order","t":"Bahçede bir kedi var.","s":"در حیاط یک گربه هست.","full":"Bahçede bir kedi var.","a":"audio/tr-fa/97479b73936d.mp3"},{"type":"order","t":"Evimizde üç oda var.","s":"خانه‌ی ما سه اتاق دارد.","full":"Evimizde üç oda var.","a":"audio/tr-fa/7d8b98d51d77.mp3"}]},{"id":"g02","title":{"t":"-de / -da / -te / -ta — Nerede?","s":"پسوندِ «در»: کجا؟"},"explain":"برای گفتنِ «در، توی، روی» در ترکی یک پسوند به **آخرِ** کلمه اضافه می‌کنیم: **-de** یا **-da**. (در فارسی «در» قبل از کلمه می‌آید، در ترکی بعد از آن!)\n**e، i، ö، ü ← -de**: ev ← **evde**، bahçe ← **bahçede**\n**a، ı، o، u ← -da**: oda ← **odada**، salon ← **salonda**\nاگر کلمه با یکی از حروفِ **ç f h k p s ş t** تمام شود، d به **t** تبدیل می‌شود: **mutfak ← mutfakta**. (برای حفظ کردن، ترک‌ها می‌گویند: **Fıstıkçı Şahap**)\nمی‌توانیم پسوندِ «بودن» را هم اضافه کنیم: **evdeyim** = خانه هستم.\nسؤال: **nerede?** = کجا؟ — **Annem nerede? — Mutfakta.** برای اسمِ شهرها آپاستروف می‌گذاریم: **Tahran'da**، **İstanbul'da**.","table":[["ev","evde"],["bahçe","bahçede"],["oda","odada"],["salon","salonda"],["mutfak","mutfakta"],["Tahran","Tahran'da"]],"examples":[{"t":"Annem mutfakta.","s":"مادرم در آشپزخانه است.","a":"audio/tr-fa/05bd62f907c7.mp3"},{"t":"Kitap masada.","s":"کتاب روی میز است.","a":"audio/tr-fa/f977608f3467.mp3"},{"t":"Babam nerede? — Bahçede.","s":"پدرم کجاست؟ — در حیاط.","a":"audio/tr-fa/3e6cc6eb9d85.mp3"},{"t":"Dayım İstanbul'da.","s":"دایی‌ام در استانبول است.","a":"audio/tr-fa/fd3be4b195c8.mp3"},{"t":"Ben evdeyim.","s":"من خانه هستم.","a":"audio/tr-fa/d71be0afdc26.mp3"}],"exercises":[{"type":"choice","t":"Kedi bahçe___.","options":["de","da","te"],"answer":0,"s":"گربه در حیاط است.","full":"Kedi bahçede.","a":"audio/tr-fa/ed9bc59c368a.mp3"},{"type":"choice","t":"Annem mutfak___.","options":["da","ta","de"],"answer":1,"s":"مادرم در آشپزخانه است.","full":"Annem mutfakta.","a":"audio/tr-fa/05bd62f907c7.mp3"},{"type":"type","t":"Çocuklar oda___.","answer":["da"],"s":"بچه‌ها در اتاق هستند.","full":"Çocuklar odada.","a":"audio/tr-fa/9fedf9d4d7de.mp3"},{"type":"type","t":"Kitap masa___.","answer":["da"],"s":"کتاب روی میز است.","full":"Kitap masada.","a":"audio/tr-fa/f977608f3467.mp3"},{"type":"choice","t":"Babam ___? — Salonda.","options":["nerede","nereli","kaç"],"answer":0,"s":"پدرم کجاست؟ — در پذیرایی.","full":"Babam nerede? — Salonda.","a":"audio/tr-fa/29bec101077c.mp3"},{"type":"choice","t":"Ben ev___.","options":["deyim","dayım","desin"],"answer":0,"s":"من خانه هستم.","full":"Ben evdeyim.","a":"audio/tr-fa/d71be0afdc26.mp3"},{"type":"order","t":"Dedem ve büyükannem bahçede.","s":"پدربزرگ و مادربزرگم در حیاط هستند.","full":"Dedem ve büyükannem bahçede.","a":"audio/tr-fa/bc8d3f130233.mp3"}]}],"reading":{"title":{"t":"Bizim evimiz","s":"خانه‌ی ما","a":"audio/tr-fa/a659b0be1a60.mp3"},"text":[{"t":"Merhaba! Ben Sara.","s":"سلام! من سارا هستم.","a":"audio/tr-fa/a755a1efccbf.mp3"},{"t":"Evimiz İstanbul'da.","s":"خانه‌ی ما در استانبول است.","a":"audio/tr-fa/79784e454b85.mp3"},{"t":"Evimizde üç oda, bir mutfak ve bir banyo var.","s":"خانه‌ی ما سه اتاق، یک آشپزخانه و یک حمام دارد.","a":"audio/tr-fa/360c3259d530.mp3"},{"t":"Salonda büyük bir kanepe ve bir İran halısı var.","s":"در پذیرایی یک مبلِ بزرگ و یک فرشِ ایرانی هست.","a":"audio/tr-fa/347d82fc236f.mp3"},{"t":"Televizyon yok.","s":"تلویزیون نداریم.","a":"audio/tr-fa/511f5c35e2a9.mp3"},{"t":"Mutfakta bir masa ve dört sandalye var.","s":"در آشپزخانه یک میز و چهار صندلی هست.","a":"audio/tr-fa/d4d6d7d40445.mp3"},{"t":"Bahçede bir kedi var.","s":"در حیاط یک گربه هست.","a":"audio/tr-fa/97479b73936d.mp3"},{"t":"Şimdi annem mutfakta, babam bahçede.","s":"الان مادرم در آشپزخانه است و پدرم در حیاط.","a":"audio/tr-fa/f71f189fb355.mp3"},{"t":"Ben odamdayım.","s":"من در اتاقم هستم.","a":"audio/tr-fa/5ddae452e9a2.mp3"}],"questions":[{"q":{"t":"Sara'nın evi nerede?","s":"خانه‌ی سارا کجاست؟","a":"audio/tr-fa/54fc195af734.mp3"},"options":["Tahran'da","İstanbul'da","İzmir'de"],"answer":1},{"q":{"t":"Evde kaç oda var?","s":"خانه چند اتاق دارد؟","a":"audio/tr-fa/d7138effd0c4.mp3"},"options":["iki","üç","dört"],"answer":1},{"q":{"t":"Evde televizyon var mı?","s":"در خانه تلویزیون هست؟","a":"audio/tr-fa/b100a061e5d3.mp3"},"options":["Evet, var.","Hayır, yok."],"answer":1},{"q":{"t":"Sara'nın babası nerede?","