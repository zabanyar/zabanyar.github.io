c2a4ea.mp3"},{"id":"p03","t":"Düz gidin.","s":"مستقیم بروید.","pr":"دوز گیدین.","a":"audio/tr-fa/952ee8058f08.mp3"},{"id":"p04","t":"Sağa dönün.","s":"به راست بپیچید.","pr":"ساآ دُنون.","a":"audio/tr-fa/e8375a45bf51.mp3"},{"id":"p05","t":"Sola dönün.","s":"به چپ بپیچید.","pr":"سُلا دُنون.","a":"audio/tr-fa/758b5c3a4624.mp3"},{"id":"p06","t":"Çok yakın.","s":"خیلی نزدیک است.","pr":"چُک یاکِن.","a":"audio/tr-fa/70c99419b4c6.mp3"},{"id":"p07","t":"Biraz uzak.","s":"کمی دور است.","pr":"بیراز اوزاک.","a":"audio/tr-fa/2cf636249637.mp3"},{"id":"p08","t":"Nereye gidiyorsun?","s":"کجا می‌روی؟","pr":"نِرِیِه گیدیُرسون؟","a":"audio/tr-fa/066eb33cdfe7.mp3"}],"dialogue":{"title":{"t":"Eczane nerede?","s":"داروخانه کجاست؟","a":"audio/tr-fa/66df61c2a4ea.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"Affedersiniz, eczane nerede?","s":"ببخشید، داروخانه کجاست؟","a":"audio/tr-fa/dc7579cbb2ac.mp3"},{"sp":"B","t":"Eczane çok yakın. Düz gidin, sonra sağa dönün.","s":"داروخانه خیلی نزدیک است. مستقیم بروید، بعد به راست بپیچید.","a":"audio/tr-fa/6e76bd862c70.mp3"},{"sp":"A","t":"Düz gidiyorum, sonra sağa dönüyorum. Tamam.","s":"مستقیم می‌روم، بعد به راست می‌پیچم. باشه.","a":"audio/tr-fa/c818b8246ea5.mp3"},{"sp":"B","t":"Evet. Eczane solda.","s":"بله. داروخانه سمت چپ است.","a":"audio/tr-fa/4c6171bf9366.mp3"},{"sp":"A","t":"Teşekkür ederim. Hastane nerede?","s":"ممنونم. بیمارستان کجاست؟","a":"audio/tr-fa/4408ea850eaa.mp3"},{"sp":"B","t":"Hastane biraz uzak. Otobüse binin.","s":"بیمارستان کمی دور است. سوار اتوبوس شوید.","a":"audio/tr-fa/ebc394fe6d3c.mp3"},{"sp":"A","t":"Otobüs durağı nerede?","s":"ایستگاه اتوبوس کجاست؟","a":"audio/tr-fa/e6e4c4df1377.mp3"},{"sp":"B","t":"Durak orada, solda.","s":"ایستگاه آن‌جاست، سمت چپ.","a":"audio/tr-fa/e2b8128a5092.mp3"},{"sp":"A","t":"Çok teşekkürler! İyi günler!","s":"خیلی ممنون! روز خوبی داشته باشید!","a":"audio/tr-fa/817b9f6c09a1.mp3"},{"sp":"B","t":"Rica ederim. İyi günler!","s":"خواهش می‌کنم. روز خوش!","a":"audio/tr-fa/845e7c67f568.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Okula gidiyorum: -(y)e / -(y)a","s":"پسوند «به»: e / a"},"explain":"پسوند **e / a** در ترکی یعنی «به» یا «به سمتِ». مثلاً okul**a** gidiyorum = به مدرسه می‌روم.\nکدام یکی؟ مثل پسوند جمع (هماهنگی دوتایی): اگر آخرین واکه‌ی کلمه **a، ı، o، u** باشد → **a**؛ اگر **e، i، ö، ü** باشد → **e**. مثال: ev → **eve**، park → **parka**.\nاگر کلمه به واکه ختم شود، یک **y** وسط می‌آید: banka → banka**ya**، hastane → hastane**ye**، cami → cami**ye**.\nحواستان باشد: در بعضی کلمه‌ها k آخر قبل از واکه به **ğ** تبدیل می‌شود: durak → **durağa**.\nبرای «به کجا؟» می‌پرسیم **Nereye?** ولی برای «کجاست؟» همان **Nerede?** را می‌گوییم.","table":[["ev","eve"],["okul","okula"],["park","parka"],["market","markete"],["banka","bankaya"],["hastane","hastaneye"],["durak","durağa"]],"examples":[{"t":"Ben okula gidiyorum.","s":"من به مدرسه می‌روم.","a":"audio/tr-fa/86a74efb2f6c.mp3"},{"t":"Annem markete gidiyor.","s":"مادرم به سوپرمارکت می‌رود.","a":"audio/tr-fa/4bf1a8e0c5e0.mp3"},{"t":"Akşam eve gidiyoruz.","s":"عصر به خانه می‌رویم.","a":"audio/tr-fa/92c8c201ee34.mp3"},{"t":"Otobüs hastaneye gidiyor.","s":"اتوبوس به بیمارستان می‌رود.","a":"audio/tr-fa/2a48170b0b2f.mp3"},{"t":"Nereye gidiyorsun? Parka.","s":"کجا می‌روی؟ به پارک.","a":"audio/tr-fa/21dcce8ce9d0.mp3"}],"exercises":[{"type":"choice","t":"Ben her sabah ___ gidiyorum.","options":["okule","okula","okulda"],"answer":1,"s":"من هر صبح به مدرسه می‌روم.","full":"Ben her sabah okula gidiyorum.","a":"audio/tr-fa/08ccdc4ce270.mp3"},{"type":"choice","t":"Annem ___ gidiyor.","options":["markete","markata","markette"],"answer":0,"s":"مادرم به سوپرمارکت می‌رود.","full":"Annem markete gidiyor.","a":"audio/tr-fa/4bf1a8e0c5e0.mp3"},{"type":"choice","t":"Biz ___ gidiyoruz.","options":["camie","camiya","camiye"],"answer":2,"s":"ما به مسجد می‌رویم.","full":"Biz camiye gidiyoruz.","a":"audio/tr-fa/81eba5a299d4.mp3"},{"type":"type","t":"Ali ___ gidiyor.","answer":["bankaya"],"s":"علی به بانک می‌رود.","full":"Ali bankaya gidiyor.","a":"audio/tr-fa/58d57cfea634.mp3"},{"type":"type","t":"Sen ___ gidiyorsun? Parka gidiyorum.","answer":["nereye"],"s":"تو کجا می‌روی؟ به پارک می‌روم.","full":"Sen nereye gidiyorsun? Parka gidiyorum.","a":"audio/tr-fa/e702828631b2.mp3"},{"type":"type","t":"Çocuklar ___ gidiyor.","answer":["parka"],"s":"بچه‌ها به پارک می‌روند.","full":"Çocuklar parka gidiyor.","a":"audio/tr-fa/aa32f209359f.mp3"},{"type":"order","t":"Ben eve gidiyorum.","s":"من به خانه می‌روم.","full":"Ben eve gidiyorum.","a":"audio/tr-fa/66b0e712b2c4.mp3"},{"type":"order","t":"Reza hastaneye gidiyor.","s":"رضا به بیمارستان می‌رود.","full":"Reza hastaneye gidiyor.","a":"audio/tr-fa/6e9cb53e3eaa.mp3"}]},{"id":"g02","title":{"t":"Düz gidin, sağa dönün","s":"آدرس دادن: فعل امر مؤدبانه"},"explain":"برای آدرس دادن به شکل مؤدبانه از فعل امر با **siz** (شما) استفاده می‌کنیم. ساختنش آسان است: ریشه‌ی فعل + **in / ın / un / ün** (هماهنگی چهارتایی).\nمثال: gel → **gelin** (بیایید)، bak → **bakın** (نگاه کنید)، otur → **oturun** (بنشینید)، dön → **dönün** (بپیچید). در gitmek حرف t به d تبدیل می‌شود: **gidin** (بروید).\nبه «به راست / به چپ» دقت کنید: **sağa / sola** همان پسوند «به» است. اما «سمت راست است» با پسوند مکان گفته می‌شود: **sağda / solda**.\n**Düz gidin** یعنی مستقیم بروید.","table":[["gitmek","gidin"],["dönmek","dönün"],["gelmek","gelin"],["bakmak","bakın"],["oturmak","oturun"]],"examples":[{"t":"Düz gidin.","s":"مستقیم بروید.","a":"audio/tr-fa/952ee8058f08.mp3"},{"t":"Sonra sağa dönün.","s":"بعد به راست بپیچید.","a":"audio/tr-fa/c745e6920ba9.mp3"},{"t":"Banka solda.","s":"بانک سمت چپ است.","a":"audio/tr-fa/b3e703fdc68f.mp3"},{"t":"Lütfen oturun.","s":"لطفاً بنشینید.","a":"audio/tr-fa/578bafbcc0d8.mp3"},{"t":"Eczane nerede? Düz gidin, sonra sola dönün.","s":"داروخانه کجاست؟ مستقیم بروید، بعد به چپ بپیچید.","a":"audio/tr-fa/fb444932f4db.mp3"}],"exercises":[{"type":"choice","t":"Eczane nerede? Düz ___, sonra sola dönün.","options":["gitin","gidin","gidün"],"answer":1,"s":"داروخانه کجاست؟ مستقیم بروید، بعد به چپ بپیچید.","full":"Eczane nerede? Düz gidin, sonra sola dönün.","a":"audio/tr-fa/fb444932f4db.mp3"},{"type":"choice","t":"Banka ___.","options":["sağda","sağa","sağ"],"answer":0,"s":"بانک سمت راست است.","full":"Banka sağda.","a":"audio/tr-fa/66aa68eb4468.mp3"},{"type":"choice","t":"Sonra ___ dönün.","options":["solda","sol","sola"],"answer":2,"s":"بعد به چپ بپیچید.","full":"Sonra sola dönün.","a":"audio/tr-fa/801ae2afe7ba.mp3"},{"type":"type","t":"Sağa ___.","answer":["dönün"],"s":"به راست بپیچید.","full":"Sağa dönün.","a":"audio/tr-fa/e8375a45bf51.mp3"},{"type":"type","t":"Lütfen ___.","answer":["gelin"],"s":"لطفاً بیایید.","full":"Lütfen gelin.","a":"audio/tr-fa/62b664ff3774.mp3"},{"type":"order","t":"Sonra sola dönün.","s":"بعد به چپ بپیچید.","full":"Sonra sola dönün.","a":"audio/tr-fa/801ae2afe7ba.mp3"},{"type":"order","t":"Otobüs durağı solda.","s":"ایستگاه اتوبوس سمت چپ است.","full":"Otobüs durağı solda.","a":"audio/tr-fa/af71ac2ab2ed.mp3"}]}],"reading":{"title":{"t":"Şehirde bir gün","s":"یک روز در شهر","a":"audio/tr-fa/10a792c35732.mp3"},"text":[{"t":"Saat dokuz. Maryam ve Ali durakta.","s":"ساعت نه است. مریم و علی در ایستگاه هستند.","a":"audio/tr-fa/028b314160a0.mp3"},{"t":"Otobüs geliyor.","s":"اتوبوس می‌آید.","a":"audio/tr-fa/01f1e59f675a.mp3"},{"t":"Önce bankaya gidiyorlar.","s":"اول به بانک می‌روند.","a":"audio/tr-fa/9b72232aaf94.mp3"},{"t":"Sonra Maryam eczaneye gidiyor.","s":"بعد مریم به داروخانه می‌رود.","a":"audio/tr-fa/0d2c09d2c1ed.mp3"},{"t":"Ali markete gidiyor.","s":"علی به سوپرمارکت می‌رود.","a":"audio/tr-fa/9be86cebeae4.mp3"},{"t":"Saat on ikide parka gidiyorlar.","s":"ساعت دوازده به پارک می‌روند.","a":"audio/tr-fa/c459083ba6d5.mp3"},{"t":"Park çok güzel ve camiye çok yakın.","s":"پارک خیلی قشنگ است و به مسجد خیلی نزدیک است.","a":"audio/tr-fa/3e5210ddfb85.mp3"},{"t":"Akşam saat altıda eve gidiyorlar.","s":"عصر ساعت شش به خانه می‌روند.","a":"audio/tr-fa/de9e814341c5.mp3"}],"questions":[{"q":{"t":"Maryam ve Ali saat dokuzda nerede?","s":"مریم و علی ساعت نه کجا هستند؟","a":"audio/tr-fa/6d097e89ec5e.mp3"},"options":["Parkta","Durakta","Bankada"],"answer":1},{"q":{"t":"Önce nereye gidiyorlar?","s":"اول به کجا می‌روند؟","a":"audio/tr-fa/399ee29c81b7.mp3"},"options":["Bankaya","Eczaneye","Eve"],"answer":0},{"q":{"t":"Kim eczaneye gidiyor?","s":"چه کسی به داروخانه می‌رود؟","a":"audio/tr-fa/204e7c5a800c.mp3"},"options":["Ali","Mehmet","Maryam"],"answer":2},{"q":{"t":"Park nereye yakın?","s":"پارک به کجا نزدیک است؟","a":"audio/tr-fa/b411d62b84af.mp3"},"options":["Camiye","Bankaya","Hastaneye"],"answer":0}]},"sentences":[{"t":"Ben her gün okula gidiyorum.","s":"من هر روز به مدرسه می‌روم.","a":"audio/tr-fa/8720a801254e.mp3"},{"t":"Babam bankaya gidiyor.","s":"پدرم به بانک می‌رود.","a":"audio/tr-fa/8333a1f1f792.mp3"},{"t":"Affedersiniz, hastane nerede?","s":"ببخشید، بیمارستان کجاست؟","a":"audio/tr-fa/942e21070054.mp3"},{"t":"Düz gidin, sonra sola dönün.","s":"مستقیم بروید، بعد به چپ بپیچید.","a":"audio/tr-fa/fa75eb95e037.mp3"},{"t":"Eczane sağda.","s":"داروخانه سمت راست است.","a":"audio/tr-fa/cf45af8817df.mp3"},{"t":"Otobüs durağı çok yakın.","s":"ایستگاه اتوبوس خیلی نزدیک است.","a":"audio/tr-fa/40a6bec3dfe4.mp3"},{"t":"Akşam eve gidiyoruz.","s":"عصر به خانه می‌رویم.","a":"audio/tr-fa/92c8c201ee34.mp3"},{"t":"Nereye gidiyorsun?","s":"کجا می‌روی؟","a":"audio/tr-fa/066eb33cdfe7.mp3"}],"img":"img/e/1f3d9.svg"}