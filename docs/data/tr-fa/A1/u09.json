{"id":"u09","level":"A1","emoji":"🌦️","title":{"t":"Hava ve mevsimler","s":"هوا و فصل‌ها","a":"audio/tr-fa/f69a1b23dd48.mp3"},"goals":["بپرسم هوا چطور است و جواب بدهم.","ماه‌ها و فصل‌ها را به ترکی بگویم.","بگویم «در ماهِ … / در فصلِ …» چه اتفاقی می‌افتد."],"words":[{"id":"w01","t":"hava","s":"هوا","pr":"هاوا","emoji":"🌤️","ex":{"t":"Bugün hava nasıl?","s":"امروز هوا چطور است؟","pr":"بوگون هاوا ناسِل؟","a":"audio/tr-fa/ea68fa2ae5fb.mp3"},"sym":true,"img":"img/e/1f324.svg","a":"audio/tr-fa/a3ac4115395a.mp3"},{"id":"w02","t":"güneş","s":"خورشید، آفتاب","pr":"گونِش","emoji":"☀️","ex":{"t":"Bugün güneş var.","s":"امروز آفتاب هست.","pr":"بوگون گونِش وار.","a":"audio/tr-fa/08fe7a428400.mp3"},"img":"img/e/2600.svg","a":"audio/tr-fa/f9a05924f67b.mp3"},{"id":"w03","t":"yağmur","s":"باران","pr":"یاامور","emoji":"🌧️","ex":{"t":"Yağmur yağıyor.","s":"باران می‌آید.","pr":"یاامور یائِیُر.","a":"audio/tr-fa/135a083b04ce.mp3"},"img":"img/e/1f327.svg","a":"audio/tr-fa/083275f19514.mp3"},{"id":"w04","t":"kar","s":"برف","pr":"کار","emoji":"❄️","ex":{"t":"Kar çok güzel!","s":"برف خیلی قشنگ است!","pr":"کار چُک گوزِل!","a":"audio/tr-fa/9229c484e7df.mp3"},"img":"img/e/2744.svg","a":"audio/tr-fa/8aa131a688e5.mp3"},{"id":"w05","t":"bulut","pl":"bulutlar","s":"ابر","pr":"بولوت","emoji":"☁️","ex":{"t":"Bugün çok bulut var.","s":"امروز ابر زیادی هست.","pr":"بوگون چُک بولوت وار.","a":"audio/tr-fa/3051618cc314.mp3"},"img":"img/e/2601.svg","a":"audio/tr-fa/46f6eef9c24b.mp3","pla":"audio/tr-fa/e16aa771467d.mp3"},{"id":"w06","t":"rüzgâr","s":"باد","pr":"روزگیار","emoji":"🌬️","ex":{"t":"Bugün çok rüzgâr var.","s":"امروز خیلی باد می‌آید.","pr":"بوگون چُک روزگیار وار.","a":"audio/tr-fa/12df1249ed79.mp3"},"img":"img/e/1f32c.svg","a":"audio/tr-fa/97440ea742e8.mp3"},{"id":"w07","t":"sıcak","s":"گرم، داغ","pr":"سِجاک","emoji":"🥵","ex":{"t":"Çay çok sıcak.","s":"چای خیلی داغ است.","pr":"چای چُک سِجاک.","a":"audio/tr-fa/3a013ad8a1ff.mp3"},"img":"img/e/1f975.svg","a":"audio/tr-fa/459b6160417d.mp3"},{"id":"w08","t":"soğuk","s":"سرد","pr":"سُئوک","emoji":"🥶","ex":{"t":"Su çok soğuk.","s":"آب خیلی سرد است.","pr":"سو چُک سُئوک.","a":"audio/tr-fa/2f076346f27e.mp3"},"img":"img/e/1f976.svg","a":"audio/tr-fa/d8e580484923.mp3"},{"id":"w09","t":"mevsim","pl":"mevsimler","s":"فصل","pr":"مِوسیم","emoji":"","ex":{"t":"Dört mevsim var: ilkbahar, yaz, sonbahar ve kış.","s":"چهار فصل داریم: بهار، تابستان، پاییز و زمستان.","pr":"دُرت مِوسیم وار: ایلکباهار، یاز، سُنباهار وِه کِش.","a":"audio/tr-fa/14daae6fd7ac.mp3"},"img":null,"a":"audio/tr-fa/70c333876870.mp3","pla":"audio/tr-fa/a6238d010840.mp3"},{"id":"w10","t":"ilkbahar","s":"بهار","pr":"ایلکباهار","emoji":"🌸","ex":{"t":"İlkbaharda hava güzel.","s":"بهار هوا خوب است.","pr":"ایلکباهاردا هاوا گوزِل.","a":"audio/tr-fa/cc20891937c7.mp3"},"sym":true,"img":"img/e/1f338.svg","a":"audio/tr-fa/e4c05c1d5f69.mp3"},{"id":"w11","t":"yaz","s":"تابستان","pr":"یاز","emoji":"🏖️","ex":{"t":"Yazın hava çok sıcak.","s":"تابستان هوا خیلی گرم است.","pr":"یازِن هاوا چُک سِجاک.","a":"audio/tr-fa/7a433b4447c2.mp3"},"sym":true,"img":"img/e/1f3d6.svg","a":"audio/tr-fa/6e79675f1525.mp3"},{"id":"w12","t":"sonbahar","s":"پاییز","pr":"سُنباهار","emoji":"🍂","ex":{"t":"Sonbaharda yağmur yağıyor.","s":"پاییز باران می‌آید.","pr":"سُنباهاردا یاامور یائِیُر.","a":"audio/tr-fa/babba3c64d43.mp3"},"sym":true,"img":"img/e/1f342.svg","a":"audio/tr-fa/2c352809b90b.mp3"},{"id":"w13","t":"kış","s":"زمستان","pr":"کِش","emoji":"⛄","ex":{"t":"Kışın hava çok soğuk.","s":"زمستان هوا خیلی سرد است.","pr":"کِشِن هاوا چُک سُئوک.","a":"audio/tr-fa/6cb17fde9240.mp3"},"sym":true,"img":"img/e/26c4.svg","a":"audio/tr-fa/955021603e08.mp3"},{"id":"w14","t":"ay","pl":"aylar","s":"ماه","pr":"آی","emoji":"🗓️","ex":{"t":"Bir yılda on iki ay var.","s":"یک سال دوازده ماه دارد.","pr":"بیر یِلدا اُن ایکی آی وار.","a":"audio/tr-fa/e53985f3b0ac.mp3"},"sym":true,"img":"img/e/1f5d3.svg","a":"audio/tr-fa/4311d38285ec.mp3","pla":"audio/tr-fa/bf2ad1c552a6.mp3"}],"phrases":[{"id":"p01","t":"Hava nasıl?","s":"هوا چطور است؟","pr":"هاوا ناسِل؟","a":"audio/tr-fa/dad87af98ae3.mp3"},{"id":"p02","t":"Hava çok güzel.","s":"هوا خیلی خوب است.","pr":"هاوا چُک گوزِل.","a":"audio/tr-fa/cd4ba5358510.mp3"},{"id":"p03","t":"Yağmur yağıyor.","s":"باران می‌آید.","pr":"یاامور یائِیُر.","a":"audio/tr-fa/135a083b04ce.mp3"},{"id":"p04","t":"Kar yağıyor.","s":"برف می‌آید.","pr":"کار یائِیُر.","a":"audio/tr-fa/0e4c7e0fc98f.mp3"},{"id":"p05","t":"Çok sıcak!","s":"خیلی گرم است!","pr":"چُک سِجاک!","a":"audio/tr-fa/ff55564f288e.mp3"},{"id":"p06","t":"Çok soğuk!","s":"خیلی سرد است!","pr":"چُک سُئوک!","a":"audio/tr-fa/298356db8706.mp3"},{"id":"p07","t":"Doğum günün ne zaman?","s":"تولدت کی است؟","pr":"دُئوم گونون نِه زامان؟","a":"audio/tr-fa/916c60ba3631.mp3"},{"id":"p08","t":"En sevdiğim mevsim yaz.","s":"فصل مورد علاقه‌ام تابستان است.","pr":"اِن سِودییم مِوسیم یاز.","a":"audio/tr-fa/15bf70814763.mp3"}],"dialogue":{"title":{"t":"Telefonda","s":"پشت تلفن","a":"audio/tr-fa/ee71d79687ca.mp3"},"speakers":{"A":{"name":"Zeynep","voice":"f"},"B":{"name":"Ali","voice":"m"}},"lines":[{"sp":"A","t":"Alo, Ali! Nasılsın?","s":"الو، علی! حالت چطور است؟","pr":"آلو، علی! ناسِلسِن؟","a":"audio/tr-fa/8a709070ff5e.mp3"},{"sp":"B","t":"İyiyim Zeynep, teşekkürler. İstanbul'da hava nasıl?","s":"خوبم زینب، ممنون. هوای استانبول چطور است؟","pr":"ای‌یی‌ییم زِینِپ، تِشِکّورلِر. ایستانبولدا هاوا ناسِل؟","a":"audio/tr-fa/23d80820e88c.mp3"},{"sp":"A","t":"Burada yağmur yağıyor. Hava biraz soğuk. Tahran'da hava nasıl?","s":"این‌جا باران می‌آید. هوا کمی سرد است. هوای تهران چطور است؟","pr":"بورادا یاامور یائِیُر. هاوا بیراز سُئوک. تاهراندا هاوا ناسِل؟","a":"audio/tr-fa/0de98f121a5a.mp3"},{"sp":"B","t":"Tahran'da hava çok güzel. Güneşli ve sıcak.","s":"در تهران هوا خیلی خوب است. آفتابی و گرم.","pr":"تاهراندا هاوا چُک گوزِل. گونِشلی وِه سِجاک.","a":"audio/tr-fa/bef87aa55f31.mp3"},{"sp":"A","t":"Ne güzel! Ben de Tahran'a gelmek istiyorum.","s":"چه خوب! من هم می‌خواهم به تهران بیایم.","pr":"نِه گوزِل! بِن دِه تاهرانا گِلمِک ایستیُروم.","a":"audio/tr-fa/6ccf89ce5a11.mp3"},{"sp":"B","t":"Gel! Ama yazın Tahran çok sıcak. İlkbaharda gel.","s":"بیا! ولی تابستان تهران خیلی گرم است. بهار بیا.","pr":"گِل! آما یازِن تاهران چُک سِجاک. ایلکباهاردا گِل.","a":"audio/tr-fa/7d6963167ff1.mp3"},{"sp":"A","t":"Tamam! Nisanda geliyorum.","s":"باشه! آوریل می‌آیم.","pr":"تامام! نیساندا گِلیُروم.","a":"audio/tr-fa/8a345e3ae197.mp3"},{"sp":"B","t":"Harika! Nisanda Tahran çok güzel.","s":"عالی! آوریل تهران خیلی قشنگ است.","pr":"هاریکا! نیساندا تاهران چُک گوزِل.","a":"audio/tr-fa/7ceca61aae6b.mp3"},{"sp":"A","t":"Görüşürüz, Ali!","s":"به امید دیدار، علی!","pr":"گُروشوروز، علی!","a":"audio/tr-fa/e302c4a4108d.mp3"},{"sp":"B","t":"Görüşürüz, Zeynep!","s":"به امید دیدار، زینب!","pr":"گُروشوروز، زِینِپ!","a":"audio/tr-fa/3d5ccc9cb139.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Hava nasıl? güneşli, bulutlu…","s":"هوا چطور است؟ پسوند li / lı / lu / lü"},"explain":"برای پرسیدن درباره‌ی هوا می‌گوییم **Hava nasıl?** (هوا چطور است؟). جواب: **Hava** + صفت: Hava **güzel**، Hava **soğuk**، Hava **sıcak**.\nپسوند **li / lı / lu / lü** از اسم، صفت می‌سازد؛ درست مثل «ی» در «آفتابی» و «ابری»: güneş → **güneşli** (آفتابی)، bulut → **bulutlu** (ابری)، rüzgâr → **rüzgârlı** (بادی)، kar → **karlı** (برفی).\nکدام یکی؟ هماهنگی چهارتایی: بعد از e و i → **li**؛ بعد از a و ı → **lı**؛ بعد از o و u → **lu**؛ بعد از ö و ü → **lü**.\nبرای «باران می‌آید / برف می‌آید» فعل **yağmak** را با iyor می‌گوییم: **Yağmur yağıyor**، **Kar yağıyor**.\nکلمه‌های آشنا: **hava** = هوا، **mevsim** = موسم (فصل). **rüzgâr** از «روزگار» فارسی آمده، ولی در ترکی یعنی «باد»!","table":[["güneş","güneşli"],["bulut","bulutlu"],["rüzgâr","rüzgârlı"],["kar","karlı"],["yağmur","yağmurlu"]],"examples":[{"t":"Hava nasıl? Hava güneşli.","s":"هوا چطور است؟ هوا آفتابی است.","pr":"هاوا ناسِل؟ هاوا گونِشلی.","a":"audio/tr-fa/608ee95eca27.mp3"},{"t":"Bugün hava çok soğuk.","s":"امروز هوا خیلی سرد است.","pr":"بوگون هاوا چُک سُئوک.","a":"audio/tr-fa/4ee097b2dcb4.mp3"},{"t":"Yağmur yağıyor.","s":"باران می‌آید.","pr":"یاامور یائِیُر.","a":"audio/tr-fa/135a083b04ce.mp3"},{"t":"Hava bulutlu ve rüzgârlı.","s":"هوا ابری و بادی است.","pr":"هاوا بولوتلو وِه روزگیارلِ.","a":"audio/tr-fa/32fe7f21e6f8.mp3"},{"t":"Bugün kar yağıyor.","s":"امروز برف می‌آید.","pr":"بوگون کار یائِیُر.","a":"audio/tr-fa/b723bf0deefc.mp3"}],"exercises":[{"type":"choice","t":"Bugün hava ___.","options":["güneşlı","güneşli","güneşlu"],"answer":1,"s":"امروز هوا آفتابی است.","why":"آخرین واکه‌ی güneş حرفِ e است، پس -li: güneşli.","full":"Bugün hava güneşli.","a":"audio/tr-fa/6c93cb999f18.mp3"},{"type":"choice","t":"Yağmur ___.","options":["yağıyorum","yağıyorsun","yağıyor"],"answer":2,"s":"باران می‌آید.","why":"فاعل yağmur (سوم‌شخص) است، پس فعل شناسه ندارد: yağıyor.","full":"Yağmur yağıyor.","a":"audio/tr-fa/135a083b04ce.mp3"},{"type":"choice","t":"Hava ___.","options":["bulutlu","bulutlı","bulutli"],"answer":0,"s":"هوا ابری است.","why":"آخرین واکه‌ی bulut حرفِ u است، پس -lu: bulutlu.","full":"Hava bulutlu.","a":"audio/tr-fa/bcdc9b18da9a.mp3"},{"type":"choice","task":"کدام جواب درست است؟","cue":"Hava nasıl?","cpr":"هاوا ناسِل؟","t":"___","options":["Hava güneşli ve sıcak.","Hava güneş ve sıcak.","Güneşli hava nasıl."],"answer":0,"why":"برای صفتِ «آفتابی» به güneş پسوندِ -li اضافه می‌کنیم: Hava güneşli.","s":"هوا آفتابی و گرم است.","full":"Hava güneşli ve sıcak.","a":"audio/tr-fa/90cd900f131a.mp3","ca":"audio/tr-fa/dad87af98ae3.mp3"},{"type":"type","task":"با -lı بگویید «هوا خیلی بادی است».","cue":"Bugün çok rüzgâr var.","cpr":"بوگون چُک روزگیار وار.","t":"Bugün hava çok ___.","answer":["rüzgârlı","rüzgarlı"],"why":"آخرین واکه‌ی rüzgâr حرفِ a است، پس -lı: rüzgârlı.","s":"امروز هوا خیلی بادی است.","full":"Bugün hava çok rüzgârlı.","a":"audio/tr-fa/456e9dc8e820.mp3","ca":"audio/tr-fa/12df1249ed79.mp3"},{"type":"type","t":"Hava ___? Hava çok güzel.","answer":["nasıl"],"s":"هوا چطور است؟ هوا خیلی خوب است.","why":"برای «چطور؟» می‌گوییم nasıl: Hava nasıl?","full":"Hava nasıl? Hava çok güzel.","a":"audio/tr-fa/0e68d300e743.mp3"},{"type":"order","t":"Bugün hava bulutlu ve çok rüzgârlı.","s":"امروز هوا ابری و خیلی بادی است.","alts":["Hava bugün bulutlu ve çok rüzgârlı.","Bugün hava çok rüzgârlı ve bulutlu.","Hava bugün çok rüzgârlı ve bulutlu."],"full":"Bugün hava bulutlu ve çok rüzgârlı.","a":"audio/tr-fa/6e09bc6cb342.mp3"}]},{"id":"g02","title":{"t":"Temmuzda, yazın","s":"ماه‌ها و فصل‌ها: «در ژوئیه»، «در تابستان»"},"explain":"ماه‌های ترکی همان ماه‌های میلادی هستند و وسطِ جمله با حرف کوچک نوشته می‌شوند (مگر در تاریخ دقیق، مثل 19 Mayıs): ocak (ژانویه)، şubat (فوریه)، mart (مارس)، nisan (آوریل)، mayıs (مه)، haziran (ژوئن)، temmuz (ژوئیه)، ağustos (اوت)، eylül (سپتامبر)، ekim (اکتبر)، kasım (نوامبر)، aralık (دسامبر).\nبرای گفتن «در ماهِ …» همان پسوند مکان **de / da** را اضافه می‌کنیم (و بعد از حروف بی‌صدای ç، ş، t، k، p، s، f، h می‌شود **te / ta**): temmuz**da** (در ژوئیه)، eylül**de** (در سپتامبر)، mart**ta** (در مارس).\nفصل‌ها: **ilkbahar** (بهار)، **yaz** (تابستان)، **sonbahar** (پاییز)، **kış** (زمستان). برای بهار و پاییز می‌گوییم **ilkbaharda** و **sonbaharda**؛ ولی برای تابستان و زمستان شکل خاصی داریم: **yazın** (در تابستان) و **kışın** (در زمستان).","table":[["ocak","ocakta"],["şubat","şubatta"],["mart","martta"],["nisan","nisanda"],["mayıs","mayısta"],["haziran","haziranda"],["temmuz","temmuzda"],["ağustos","ağustosta"],["eylül","eylülde"],["ekim","ekimde"],["kasım","kasımda"],["aralık","aralıkta"]],"examples":[{"t":"Temmuzda hava çok sıcak.","s":"در ژوئیه هوا خیلی گرم است.","pr":"تِمّوزدا هاوا چُک سِجاک.","a":"audio/tr-fa/db0804073205.mp3"},{"t":"Kışın kar yağıyor.","s":"زمستان برف می‌آید.","pr":"کِشِن کار یائِیُر.","a":"audio/tr-fa/32427b1160ce.mp3"},{"t":"İlkbaharda hava güzel.","s":"بهار هوا خوب است.","pr":"ایلکباهاردا هاوا گوزِل.","a":"audio/tr-fa/cc20891937c7.mp3"},{"t":"Benim doğum günüm eylülde.","s":"تولد من در سپتامبر است.","pr":"بِنیم دُئوم گونوم اِیلولدِه.","a":"audio/tr-fa/ff5f1582dd4f.mp3"},{"t":"Yazın denize gidiyoruz.","s":"تابستان به دریا می‌رویم.","pr":"یازِن دِنیزِه گیدیُروز.","a":"audio/tr-fa/53afc238f10a.mp3"}],"exercises":[{"type":"choice","t":"___ hava çok soğuk.","options":["Kışın","Kışa","Kış"],"answer":0,"s":"زمستان هوا خیلی سرد است.","why":"برای «در زمستان» شکلِ خاصِ kışın را می‌گوییم (و برای تابستان yazın).","full":"Kışın hava çok soğuk.","a":"audio/tr-fa/6cb17fde9240.mp3"},{"type":"choice","t":"Biz ___ İran'a gidiyoruz.","options":["temmuzde","temmuzda","temmuza"],"answer":1,"s":"ما در ژوئیه به ایران می‌رویم.","why":"آخرین واکه‌ی temmuz حرفِ u است، پس -da: temmuzda.","full":"Biz temmuzda İran'a gidiyoruz.","a":"audio/tr-fa/13c851edfef5.mp3"},{"type":"choice","t":"___ çok yağmur yağıyor.","options":["Sonbahara","Sonbaharın","Sonbaharda"],"answer":2,"s":"پاییز خیلی باران می‌آید.","why":"«در پاییز» با پسوندِ مکان گفته می‌شود: sonbaharda.","full":"Sonbaharda çok yağmur yağıyor.","a":"audio/tr-fa/0c5cce72c065.mp3"},{"type":"type","t":"___ kar yağıyor.","answer":["Aralıkta"],"s":"در دسامبر برف می‌آید.","why":"aralık با k تمام می‌شود، پس d به t تبدیل می‌شود: aralıkta.","full":"Aralıkta kar yağıyor.","a":"audio/tr-fa/89fedd33fa40.mp3"},{"type":"type","task":"با ماه بگویید: «نوروز در مارس است».","cue":"Nevruz ilkbaharda.","cpr":"نِوروز ایلکباهاردا.","t":"Nevruz ___.","answer":["martta"],"why":"mart با t تمام می‌شود، پس پسوند -ta می‌آید: martta.","s":"نوروز در ماهِ مارس است.","full":"Nevruz martta.","a":"audio/tr-fa/539560824218.mp3","ca":"audio/tr-fa/119d0f83219e.mp3"},{"type":"choice","task":"کدام جواب درست است؟","cue":"Doğum günün ne zaman?","cpr":"دُئوم گونون نِه زامان؟","t":"___","options":["Ağustosta.","Ağustosda.","Ağustosla."],"answer":0,"why":"ağustos با s تمام می‌شود، پس d به t تبدیل می‌شود: ağustosta.","s":"در ماهِ اوت.","full":"Ağustosta.","a":"audio/tr-fa/70f02db4db61.mp3","ca":"audio/tr-fa/916c60ba3631.mp3"},{"type":"order","t":"İlkbaharda hava çok güzel.","s":"بهار هوا خیلی خوب است.","alts":["Hava ilkbaharda çok güzel."],"full":"İlkbaharda hava çok güzel.","a":"audio/tr-fa/30ca95ddbe6c.mp3"}]}],"reading":{"title":{"t":"Dört mevsim","s":"چهار فصل","a":"audio/tr-fa/fb36c0c238b4.mp3"},"text":[{"t":"Türkiye'de dört mevsim var.","s":"در ترکیه چهار فصل هست.","pr":"تورکیِدِه دُرت مِوسیم وار.","a":"audio/tr-fa/305adca9f18f.mp3"},{"t":"İlkbaharda hava güzel; bazen yağmur yağıyor.","s":"بهار هوا خوب است؛ گاهی باران می‌آید.","pr":"ایلکباهاردا هاوا گوزِل؛ بازِن یاامور یائِیُر.","a":"audio/tr-fa/8d64c9c8acaa.mp3"},{"t":"Yazın hava çok sıcak ve güneşli.","s":"تابستان هوا خیلی گرم و آفتابی است.","pr":"یازِن هاوا چُک سِجاک وِه گونِشلی.","a":"audio/tr-fa/43c6e1dff7d6.mp3"},{"t":"Temmuzda ve ağustosta insanlar denize gidiyor.","s":"در ژوئیه و اوت مردم به دریا می‌روند.","pr":"تِمّوزدا وِه آئوستُستا اینسانلار دِنیزِه گیدیُر.","a":"audio/tr-fa/3c85a5d2d985.mp3"},{"t":"Sonbaharda hava bulutlu ve rüzgârlı.","s":"پاییز هوا ابری و بادی است.","pr":"سُنباهاردا هاوا بولوتلو وِه روزگیارلِ.","a":"audio/tr-fa/30f4e391129b.mp3"},{"t":"Kışın hava soğuk.","s":"زمستان هوا سرد است.","pr":"کِشِن هاوا سُئوک.","a":"audio/tr-fa/f499cdd203b0.mp3"},{"t":"Ocakta ve şubatta İstanbul'da bazen kar yağıyor.","s":"در ژانویه و فوریه در استانبول گاهی برف می‌آید.","pr":"اُجاکتا وِه شوباتّا ایستانبولدا بازِن کار یائِیُر.","a":"audio/tr-fa/2361e81775b7.mp3"},{"t":"Benim en sevdiğim mevsim ilkbahar.","s":"فصل مورد علاقه‌ی من بهار است.","pr":"بِنیم اِن سِودییم مِوسیم ایلکباهار.","a":"audio/tr-fa/18eb7b77e83b.mp3"}],"questions":[{"q":{"t":"Türkiye'de kaç mevsim var?","s":"در ترکیه چند فصل هست؟","a":"audio/tr-fa/852db87dee8b.mp3"},"options":["İki","Dört","On iki"],"answer":1},{"q":{"t":"Yazın hava nasıl?","s":"تابستان هوا چطور است؟","a":"audio/tr-fa/ada26df68a0f.mp3"},"options":["Sıcak ve güneşli","Soğuk ve karlı","Bulutlu ve rüzgârlı"],"answer":0},{"q":{"t":"İnsanlar temmuzda nereye gidiyor?","s":"مردم در ژوئیه کجا می‌روند؟","a":"audio/tr-fa/5dedcab4306b.mp3"},"options":["Okula","Hastaneye","Denize"],"answer":2},{"q":{"t":"İstanbul'da ne zaman kar yağıyor?","s":"در استانبول کی برف می‌آید؟","a":"audio/tr-fa/7ecb43d68a32.mp3"},"options":["Ocakta ve şubatta","Temmuzda","Nisanda"],"answer":0}]},"sentences":[{"t":"Bugün hava çok güzel.","s":"امروز هوا خیلی خوب است.","pr":"بوگون هاوا چُک گوزِل.","alts":["Hava bugün çok güzel."],"a":"audio/tr-fa/c033534a82d3.mp3"},{"t":"Yağmur yağıyor, hava soğuk.","s":"باران می‌آید، هوا سرد است.","pr":"یاامور یائِیُر، هاوا سُئوک.","alts":["Hava soğuk, yağmur yağıyor."],"a":"audio/tr-fa/eb0e0b4b329e.mp3"},{"t":"Kışın kar yağıyor.","s":"زمستان برف می‌آید.","pr":"کِشِن کار یائِیُر.","a":"audio/tr-fa/32427b1160ce.mp3"},{"t":"Yazın denize gidiyoruz.","s":"تابستان به دریا می‌رویم.","pr":"یازِن دِنیزِه گیدیُروز.","a":"audio/tr-fa/53afc238f10a.mp3"},{"t":"Benim doğum günüm martta.","s":"تولد من در ماه مارس است.","pr":"بِنیم دُئوم گونوم مارتّا.","a":"audio/tr-fa/87f2b70fffe8.mp3"},{"t":"Sonbaharda hava bulutlu.","s":"پاییز هوا ابری است.","pr":"سُنباهاردا هاوا بولوتلو.","alts":["Hava sonbaharda bulutlu."],"a":"audio/tr-fa/79c5e3b84479.mp3"},{"t":"Hava nasıl? Güneşli ve sıcak.","s":"هوا چطور است؟ آفتابی و گرم.","pr":"هاوا ناسِل؟ گونِشلی وِه سِجاک.","alts":["Hava nasıl? Sıcak ve güneşli."],"a":"audio/tr-fa/bff4b5fb3792.mp3"},{"t":"Tahran'da kışın kar yağıyor.","s":"در تهران زمستان برف می‌آید.","pr":"تاهراندا کِشِن کار یائِیُر.","alts":["Kışın Tahran'da kar yağıyor."],"a":"audio/tr-fa/16aba6f15d7b.mp3"}],"img":"img/e/1f326.svg"}