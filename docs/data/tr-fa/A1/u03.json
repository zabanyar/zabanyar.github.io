{"id":"u03","level":"A1","emoji":"👪","title":{"t":"Ailem","s":"خانواده‌ی من","a":"audio/tr-fa/572cc69189bd.mp3"},"goals":["اعضای خانواده را به ترکی نام ببرم.","با پسوندهای مالکیت و benim / senin / onun بگویم «مادرم، مادرت، مادرش» (annem، annen، annesi).","با mi سؤالِ بله/نه بپرسم (Annen öğretmen mi?).","خانواده‌ام را به ترکی معرفی کنم."],"words":[{"id":"w01","t":"aile","pl":"aileler","s":"خانواده","pr":"آئیلِه","emoji":"👪","ex":{"t":"Bu benim ailem.","s":"این خانواده‌ی من است.","pr":"بو بِنیم آئیلِم.","a":"audio/tr-fa/da6ef4db4bba.mp3"},"img":"img/e/1f46a.svg","a":"audio/tr-fa/4b78ebea7053.mp3","pla":"audio/tr-fa/760094011597.mp3"},{"id":"w02","t":"kardeş","pl":"kardeşler","s":"خواهر یا برادر","pr":"کاردِش","emoji":"","ex":{"t":"Amir ve Sara kardeş.","s":"امیر و سارا خواهر و برادرند.","pr":"امیر وِه سارا کاردِش.","a":"audio/tr-fa/fc9e4d127d6e.mp3"},"img":null,"a":"audio/tr-fa/a8e956b8f1a1.mp3","pla":"audio/tr-fa/d8f1af6bf8f2.mp3"},{"id":"w03","t":"bebek","pl":"bebekler","s":"نوزاد، بچه‌ی کوچک","pr":"بِبِک","emoji":"👶","ex":{"t":"Bebek bir yaşında.","s":"نوزاد یک ساله است.","pr":"بِبِک بیر یاشِندا.","a":"audio/tr-fa/253893fcd5de.mp3"},"img":"img/e/1f476.svg","a":"audio/tr-fa/1a29f14f5522.mp3","pla":"audio/tr-fa/066cf3959327.mp3"},{"id":"w04","t":"kız kardeş","s":"خواهر","pr":"کِز کاردِش","emoji":"","ex":{"t":"Kız kardeşim on yaşında.","s":"خواهرم ده ساله است.","pr":"کِز کاردِشیم اُن یاشِندا.","a":"audio/tr-fa/f8620247b2e4.mp3"},"img":null,"a":"audio/tr-fa/47bbfe7da0f9.mp3"},{"id":"w05","t":"erkek kardeş","s":"برادر","pr":"اِرکِک کاردِش","emoji":"","ex":{"t":"Erkek kardeşin kaç yaşında?","s":"برادرت چند سال دارد؟","pr":"اِرکِک کاردِشین کاچ یاشِندا؟","a":"audio/tr-fa/7639fb1d509e.mp3"},"img":null,"a":"audio/tr-fa/e99c5d0b0c5d.mp3"},{"id":"w06","t":"dede","s":"پدربزرگ","pr":"دِدِه","emoji":"👴","ex":{"t":"Dedem Tebrizli.","s":"پدربزرگم تبریزی است.","pr":"دِدِم تِبریزلی.","a":"audio/tr-fa/98df35bcda3f.mp3"},"img":"img/e/1f474.svg","a":"audio/tr-fa/e79bdf78bd1e.mp3"},{"id":"w07","t":"büyükanne","s":"مادربزرگ","pr":"بویوک‌آنِّه","emoji":"👵","ex":{"t":"Büyükannem Şirazlı.","s":"مادربزرگم شیرازی است.","pr":"بویوک‌آنِّم شیرازلِ.","a":"audio/tr-fa/26e66707401d.mp3"},"img":"img/e/1f475.svg","a":"audio/tr-fa/820a4841c866.mp3"},{"id":"w08","t":"eş","s":"همسر","pr":"اِش","emoji":"💍","ex":{"t":"Eşim Maryam.","s":"همسرم مریم است.","pr":"اِشیم مریم.","a":"audio/tr-fa/b6735207f44c.mp3"},"sym":true,"img":"img/e/1f48d.svg","a":"audio/tr-fa/89f8024f908c.mp3"},{"id":"w09","t":"kız","pl":"kızlar","s":"دختر","pr":"کِز","emoji":"👧","ex":{"t":"Kızım Sara, yirmi yaşında.","s":"دخترم سارا است، بیست ساله است.","pr":"کِزِم سارا، ییرمی یاشِندا.","a":"audio/tr-fa/ccac3388bbdb.mp3"},"img":"img/e/1f467.svg","a":"audio/tr-fa/ddeec21879a0.mp3","pla":"audio/tr-fa/2d33286411c9.mp3"},{"id":"w10","t":"oğul","s":"پسر (فرزند)","pr":"اُئول","emoji":"👦","ex":{"t":"Oğlum Amir.","s":"پسرم امیر است.","pr":"اُلوم امیر.","a":"audio/tr-fa/7266b9306001.mp3"},"img":"img/e/1f466.svg","a":"audio/tr-fa/20ac5cd31a09.mp3"},{"id":"w11","t":"amca","s":"عمو","pr":"آمجا","emoji":"","ex":{"t":"Amcam İstanbullu.","s":"عمویم استانبولی است.","pr":"آمجام ایستانبولّو.","a":"audio/tr-fa/ed82cb28bb6c.mp3"},"img":null,"a":"audio/tr-fa/bbae2a5ea68b.mp3"},{"id":"w12","t":"dayı","s":"دایی","pr":"دایِ","emoji":"","ex":{"t":"Dayın nereli?","s":"دایی‌ات اهل کجاست؟","pr":"دایِن نِرِلی؟","a":"audio/tr-fa/cc73b2c90446.mp3"},"img":null,"a":"audio/tr-fa/d9df5de106f0.mp3"},{"id":"w13","t":"arkadaş","pl":"arkadaşlar","s":"دوست","pr":"آرکاداش","emoji":"🤝","ex":{"t":"Ayşe benim arkadaşım.","s":"آیشه دوستِ من است.","pr":"آیشِه بِنیم آرکاداشِم.","a":"audio/tr-fa/35257c40b5bb.mp3"},"sym":true,"img":"img/e/1f91d.svg","a":"audio/tr-fa/2354901986fd.mp3","pla":"audio/tr-fa/6919146c7aef.mp3"},{"id":"w14","t":"bu","s":"این","pr":"بو","emoji":"👉","ex":{"t":"Bu kim? — Bu benim babam.","s":"این کیست؟ — این پدرِ من است.","pr":"بو کیم؟ — بو بِنیم بابام.","a":"audio/tr-fa/e1e7d205ec18.mp3"},"sym":true,"img":"img/e/1f449.svg","a":"audio/tr-fa/2ceb52f18bab.mp3"}],"phrases":[{"id":"p01","t":"Bu kim?","s":"این کیست؟","pr":"بو کیم؟","a":"audio/tr-fa/f9428d390079.mp3"},{"id":"p02","t":"Bu benim annem.","s":"این مادرِ من است.","pr":"بو بِنیم آنِّم","a":"audio/tr-fa/487b5a01cdb4.mp3"},{"id":"p03","t":"Senin adın ne?","s":"اسمِ تو چیست؟","pr":"سِنین آدِن نِه؟","a":"audio/tr-fa/6787312037df.mp3"},{"id":"p04","t":"Kardeşin var mı?","s":"خواهر یا برادر داری؟","pr":"کاردِشین وار مِ؟","a":"audio/tr-fa/87fc7c28ad13.mp3"},{"id":"p05","t":"Evet, bir kardeşim var.","s":"بله، یک خواهر یا برادر دارم.","pr":"اِوِت، بیر کاردِشیم وار","a":"audio/tr-fa/a275a591f7f5.mp3"},{"id":"p06","t":"Ailen nasıl?","s":"خانواده‌ات چطورند؟","pr":"آئیلِن ناسِل؟","a":"audio/tr-fa/08672f85f5c8.mp3"},{"id":"p07","t":"Ne güzel bir aile!","s":"چه خانواده‌ی خوبی!","pr":"نِه گوزِل بیر آئیلِه!","a":"audio/tr-fa/38707cebc172.mp3"}],"dialogue":{"title":{"t":"Aile fotoğrafı","s":"عکسِ خانوادگی","a":"audio/tr-fa/c87fce137e54.mp3"},"speakers":{"A":{"name":"Ayşe","voice":"f"},"B":{"name":"Amir","voice":"m"}},"lines":[{"sp":"A","t":"Bu kim, Amir?","s":"این کیست، امیر؟","pr":"بو کیم، امیر؟","a":"audio/tr-fa/355e031b6135.mp3"},{"sp":"B","t":"Bu benim annem. Adı Maryam.","s":"این مادرِ من است. اسمش مریم است.","pr":"بو بِنیم آنِّم. آدِ مریم.","a":"audio/tr-fa/1191a9e5c9d3.mp3"},{"sp":"A","t":"Annen çok güzel! Peki bu kim?","s":"مادرت خیلی زیباست! خب، این کیست؟","pr":"آنِّن چُک گوزِل! پِکی بو کیم؟","a":"audio/tr-fa/f3ae776f779a.mp3"},{"sp":"B","t":"Bu babam. O öğretmen.","s":"این پدرم است. او معلم است.","pr":"بو بابام. اُ اُرِتمِن.","a":"audio/tr-fa/789f4cc3786d.mp3"},{"sp":"A","t":"Kardeşin var mı?","s":"خواهر یا برادر داری؟","pr":"کاردِشین وار مِ؟","a":"audio/tr-fa/87fc7c28ad13.mp3"},{"sp":"B","t":"Evet, bir kız kardeşim var. Adı Sara.","s":"بله، یک خواهر دارم. اسمش ساراست.","pr":"اِوِت، بیر کِز کاردِشیم وار. آدِ سارا.","a":"audio/tr-fa/13573ce2dfef.mp3"},{"sp":"A","t":"Sara kaç yaşında?","s":"سارا چند سال دارد؟","pr":"سارا کاچ یاشِندا؟","a":"audio/tr-fa/fcdbb03eb889.mp3"},{"sp":"B","t":"Yirmi yaşında. O öğrenci.","s":"بیست سال دارد. او دانشجو است.","pr":"ییرمی یاشِندا. اُ اُرِنجی.","a":"audio/tr-fa/e68e1b86c37f.mp3"},{"sp":"A","t":"Ne güzel bir aile!","s":"چه خانواده‌ی خوبی!","pr":"نِه گوزِل بیر آئیلِه!","a":"audio/tr-fa/38707cebc172.mp3"},{"sp":"B","t":"Teşekkürler, Ayşe!","s":"ممنون، آیشه!","pr":"تِشِکّورلِر، آیشِه!","a":"audio/tr-fa/8cb7052a6ab3.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Annem, annen, annesi","s":"پسوندهای مالکیت: مادرم، مادرت، مادرش"},"explain":"خبر خوب: ترکی هم برای «ـَم، ـَت، ـَش» پسوند دارد، درست مثل فارسی!\n**annem** = مادرم، **annen** = مادرت، **annesi** = مادرش.\nاگر کلمه با **حرف صدادار** تمام شود: **-m، -n، -sı / -si / -su / -sü** (anne ← annem، annen، annesi).\nاگر با **حرف بی‌صدا** تمام شود، اول یک حرف صدادار می‌آید: **-ım / -im / -um / -üm** (kardeş ← kardeşim، kardeşin، kardeşi).\nحرف صدادار باز هم از آخرین حرف صدادارِ کلمه پیروی می‌کند: **baba ← babam**، **okul ← okulum**.\nدو نکته‌ی کوچک: **kitap ← kitabım** (p به b تبدیل می‌شود) و **oğul ← oğlum** (یک حرف صدادار می‌افتد).\nکلمه‌های آشنا: **dayı** = دایی و **aile** = عائله (خانواده)!","table":[["-(ı)m","annem","kardeşim"],["-(ı)n","annen","kardeşin"],["-(s)ı","annesi","kardeşi"],["-(ı)mız","annemiz","kardeşimiz"],["-(ı)nız","anneniz","kardeşiniz"],["-ları / -leri","anneleri","kardeşleri"]],"examples":[{"t":"Annem Tahranlı.","s":"مادرم تهرانی است.","pr":"آنِّم تاهرانلِ.","a":"audio/tr-fa/7eb4c958bb39.mp3"},{"t":"Baban kaç yaşında?","s":"پدرت چند سال دارد؟","pr":"بابان کاچ یاشِندا؟","a":"audio/tr-fa/5948d25a28a1.mp3"},{"t":"Kız kardeşi on yaşında.","s":"خواهرش ده ساله است.","pr":"کِز کاردِشی اُن یاشِندا.","a":"audio/tr-fa/14eaf2ad8a90.mp3"},{"t":"Arkadaşımız Türk.","s":"دوستمان ترک است.","pr":"آرکاداشِمِز تورک.","a":"audio/tr-fa/e0cc9c9aedd8.mp3"},{"t":"Oğlum öğrenci.","s":"پسرم دانش‌آموز است.","pr":"اُلوم اُرِنجی.","a":"audio/tr-fa/fac3ba1b71c0.mp3"}],"exercises":[{"type":"choice","t":"Anne___ öğretmen.","options":["m","n","si"],"answer":0,"s":"مادرم معلم است.","why":"«مادرم» یعنی پسوندِ «من»؛ anne با واکه تمام می‌شود، پس فقط -m: annem.","full":"Annem öğretmen.","a":"audio/tr-fa/3dad3d1bcbce.mp3"},{"type":"choice","task":"کدام جواب درست است؟","cue":"Baban nereli?","cpr":"بابان نِرِلی؟","t":"___","options":["Babam Tebrizli.","Baban Tebrizli.","Babası Tebrizliyim."],"answer":0,"why":"سؤال درباره‌ی «پدرِ تو» (baban) است؛ جواب درباره‌ی «پدرِ من»: babam.","s":"پدرم تبریزی است.","full":"Babam Tebrizli.","a":"audio/tr-fa/5f8ecffbf008.mp3","ca":"audio/tr-fa/60f740f5577a.mp3"},{"type":"type","t":"Baba___ doktor.","answer":["sı"],"s":"پدرش دکتر است.","why":"برای «ـَش» بعد از واکه -sı می‌آید و آخرین واکه a است: babası.","full":"Babası doktor.","a":"audio/tr-fa/0e6b0a088b9a.mp3"},{"type":"type","task":"جمله را برای «تو» (sen) بنویسید.","cue":"Bu benim kitabım.","cpr":"بو بِنیم کیتابِم.","t":"Bu senin ___.","answer":["kitabın"],"why":"پسوندِ «تو» بعد از حرفِ بی‌صدا -ın است و p قبل از واکه b می‌شود: kitabın.","s":"این کتابِ توست.","full":"Bu senin kitabın.","a":"audio/tr-fa/84a6ec6ce26a.mp3","ca":"audio/tr-fa/59685c551a4c.mp3"},{"type":"choice","t":"Okul___ çok güzel.","options":["umuz","ımız","imiz"],"answer":0,"s":"مدرسه‌مان خیلی قشنگ است.","why":"آخرین واکه‌ی okul حرفِ u است، پس پسوندِ «ما» -umuz می‌شود: okulumuz.","full":"Okulumuz çok güzel.","a":"audio/tr-fa/0b2e8ff722f0.mp3"},{"type":"type","t":"Bu benim kitab___.","answer":["ım"],"s":"این کتابِ من است.","why":"با benim پسوندِ «من» می‌آید؛ بعد از حرفِ بی‌صدا و واکه‌ی a: -ım (kitabım).","full":"Bu benim kitabım.","a":"audio/tr-fa/59685c551a4c.mp3"},{"type":"order","t":"Kız kardeşim yedi yaşında.","s":"خواهرم هفت ساله است.","full":"Kız kardeşim yedi yaşında.","a":"audio/tr-fa/a916ae2a660c.mp3"}]},{"id":"g02","title":{"t":"benim, senin, onun","s":"مالِ من، مالِ تو، مالِ او"},"explain":"**benim** یعنی «مالِ من» و **senin** یعنی «مالِ تو». این کلمه‌ها **قبل از** اسم می‌آیند، ولی پسوند مالکیت هم باید سرِ جایش بماند:\n**benim annem** = مادرِ من، **senin baban** = پدرِ تو، **onun kızı** = دخترِ او.\nمعمولاً می‌توانیم benim و senin را نگوییم، چون پسوند خودش همه چیز را می‌گوید: **Annem öğretmen.**\nوقتی می‌خواهیم تأکید کنیم، آن‌ها را می‌گوییم: **Bu benim kitabım.** = این کتابِ من است (نه کتابِ کسِ دیگر).","table":[["ben → benim","benim babam"],["sen → senin","senin baban"],["o → onun","onun babası"],["biz → bizim","bizim babamız"],["siz → sizin","sizin babanız"],["onlar → onların","onların babaları"]],"examples":[{"t":"Benim adım Maryam.","s":"اسمِ من مریم است.","pr":"بِنیم آدِم مریم.","a":"audio/tr-fa/5de9144b72b6.mp3"},{"t":"Senin adın ne?","s":"اسمِ تو چیست؟","pr":"سِنین آدِن نِه؟","a":"audio/tr-fa/6787312037df.mp3"},{"t":"Onun babası doktor.","s":"پدرِ او دکتر است.","pr":"اُنون باباسِ دُکتُر.","a":"audio/tr-fa/374942643e32.mp3"},{"t":"Bizim ailemiz büyük.","s":"خانواده‌ی ما بزرگ است.","pr":"بیزیم آئیلِمیز بویوک.","a":"audio/tr-fa/5cb04c9f606e.mp3"},{"t":"Sizin eviniz çok güzel.","s":"خانه‌ی شما خیلی قشنگ است.","pr":"سیزین اِوینیز چُک گوزِل.","a":"audio/tr-fa/b05ebe1056f7.mp3"}],"exercises":[{"type":"choice","t":"___ annem Şirazlı.","options":["Benim","Senin","Onun"],"answer":0,"s":"مادرِ من شیرازی است.","why":"annem پسوندِ «من» دارد، پس benim می‌آید: benim annem.","full":"Benim annem Şirazlı.","a":"audio/tr-fa/09dfa4a58a03.mp3"},{"type":"choice","task":"کدام جواب درست است؟","cue":"Senin adın ne?","cpr":"سِنین آدِن نِه؟","t":"___","options":["Benim adım Sara.","Senin adım Sara.","Benim adın Sara."],"answer":0,"why":"benim و پسوندِ -ım هر دو «من» هستند و باید با هم بیایند: benim adım.","s":"اسمِ من ساراست.","full":"Benim adım Sara.","a":"audio/tr-fa/1eea79a1176c.mp3","ca":"audio/tr-fa/6787312037df.mp3"},{"type":"choice","t":"Onun ___ on yaşında.","options":["kızı","kızım","kızın"],"answer":0,"s":"دخترِ او ده ساله است.","why":"onun (مالِ او) با پسوندِ سوم‌شخص می‌آید: onun kızı.","full":"Onun kızı on yaşında.","a":"audio/tr-fa/51fe007389af.mp3"},{"type":"type","t":"___ ailemiz büyük.","answer":["bizim"],"s":"خانواده‌ی ما بزرگ است.","why":"پسوندِ -imiz یعنی «ما»، پس bizim می‌آید: bizim ailemiz.","full":"bizim ailemiz büyük.","a":"audio/tr-fa/4a4794e7dfbd.mp3"},{"type":"type","task":"جمله را برای «من» (benim) بنویسید.","cue":"Onun babası doktor.","cpr":"اُنون باباسِ دُکتُر.","t":"Benim ___ doktor.","answer":["babam"],"why":"با benim پسوندِ «من» می‌آید: babam (نه babası).","s":"پدرِ من دکتر است.","full":"Benim babam doktor.","a":"audio/tr-fa/817a2f1f1d1f.mp3","ca":"audio/tr-fa/374942643e32.mp3"},{"type":"order","t":"Bu benim arkadaşım Ayşe.","s":"این دوستِ من آیشه است.","full":"Bu benim arkadaşım Ayşe.","a":"audio/tr-fa/92fa37498cad.mp3"}]},{"id":"g03","title":{"t":"Annen öğretmen mi? — mi / mı / mu / mü","s":"سؤالِ بله / نه با mi"},"explain":"در فارسی برای سؤالِ بله/نه یا **«آیا»** را اولِ جمله می‌گوییم، یا فقط **صدا را بالا می‌بریم**: «مادرت معلم است؟». در ترکی یک کلمه‌ی کوچک داریم: **mi**. آن را **جدا** و بعد از کلمه‌ای که درباره‌اش می‌پرسیم (معمولاً آخرِ جمله) می‌نویسیم: **Annen öğretmen mi?** = (آیا) مادرت معلم است؟\nواکه‌ی mi از آخرین واکه‌ی کلمه‌ی قبل از خودش پیروی می‌کند (هماهنگیِ چهارتایی): **e، i ← mi**؛ **a، ı ← mı**؛ **o، u ← mu**؛ **ö، ü ← mü**.\nآهنگِ جمله: صدا روی هجای **قبل از mi** بالا می‌رود و خودِ mi کوتاه و بی‌تکیه گفته می‌شود: Annen öğret**men** mi?\nجواب: **Evet** (بله) یا **Hayır** (نه). با کلمه‌های پرسشی مثلِ **ne، kim، kaç، nereli** دیگر mi نمی‌آید: **Bu kim?**\nبرای «تو» پسوندِ «بودن» به mi می‌چسبد: **İranlı mısın?** = ایرانی هستی؟ این را در درسِ ۱۰ بیشتر تمرین می‌کنیم.","table":[["e / i","mi","Annen öğretmen mi?"],["a / ı","mı","Kardeşin var mı?"],["o / u","mu","Baban doktor mu?"],["ö / ü","mü","Mehmet Türk mü?"]],"examples":[{"t":"Annen öğretmen mi? — Evet, öğretmen.","s":"مادرت معلم است؟ — بله، معلم است.","pr":"آنِّن اُرِتمِن می؟ — اِوِت، اُرِتمِن.","a":"audio/tr-fa/d38de486ece4.mp3"},{"t":"Mehmet Türk mü? — Evet, İstanbullu.","s":"مهمت ترک است؟ — بله، استانبولی است.","pr":"مِهمِت تورک مو؟ — اِوِت، ایستانبولّو.","a":"audio/tr-fa/ec4d694fe180.mp3"},{"t":"Baban doktor mu? — Hayır, öğretmen.","s":"پدرت دکتر است؟ — نه، معلم است.","pr":"بابان دُکتُر مو؟ — هایِر، اُرِتمِن.","a":"audio/tr-fa/0b26112b8204.mp3"},{"t":"Kardeşin var mı? — Evet, bir kız kardeşim var.","s":"خواهر یا برادر داری؟ — بله، یک خواهر دارم.","pr":"کاردِشین وار مِ؟ — اِوِت، بیر کِز کاردِشیم وار.","a":"audio/tr-fa/c2b6beeee959.mp3"},{"t":"İranlı mısın? — Evet, Tahranlıyım.","s":"ایرانی هستی؟ — بله، تهرانی‌ام.","pr":"ایرانلِ مِسِن؟ — اِوِت، تاهرانلِیِم.","a":"audio/tr-fa/d441e2730b64.mp3"}],"exercises":[{"type":"choice","t":"Annen öğretmen ___?","options":["mi","mı","mu"],"answer":0,"why":"آخرین واکه‌ی öğretmen حرفِ e است، پس mi.","s":"مادرت معلم است؟","full":"Annen öğretmen mi?","a":"audio/tr-fa/ffb47278318c.mp3"},{"type":"choice","t":"Bu senin kitabın ___?","options":["mı","mi","mu"],"answer":0,"why":"آخرین واکه‌ی kitabın حرفِ ı است، پس mı.","s":"این کتابِ توست؟","full":"Bu senin kitabın mı?","a":"audio/tr-fa/aeeae82013ef.mp3"},{"type":"type","t":"Ayşe Türk ___?","answer":["mü"],"why":"آخرین واکه‌ی Türk حرفِ ü است، پس mü.","s":"آیشه ترک است؟","full":"Ayşe Türk mü?","a":"audio/tr-fa/6cf3525fcdd2.mp3"},{"type":"type","task":"سؤالی کنید.","cue":"Kızın öğrenci.","cpr":"کِزِن اُرِنجی.","t":"Kızın ___?","answer":["öğrenci mi"],"why":"mi جدا و بعد از کلمه می‌آید؛ آخرین واکه‌ی öğrenci حرفِ i است: öğrenci mi.","s":"دخترت دانشجو است؟","full":"Kızın öğrenci mi?","a":"audio/tr-fa/29f2cd3fd0a6.mp3","ca":"audio/tr-fa/9462ed9a1e18.mp3"},{"type":"choice","task":"کدام جواب درست است؟","cue":"Bu senin annen mi?","cpr":"بو سِنین آنِّن می؟","t":"___","options":["Evet, bu benim annem.","Evet, bu senin annem.","Evet, annen mi."],"answer":0,"why":"در جواب درباره‌ی «مادرِ من» حرف می‌زنیم: benim annem.","s":"بله، این مادرِ من است.","full":"Evet, bu benim annem.","a":"audio/tr-fa/2d20b0d93e0e.mp3","ca":"audio/tr-fa/e08b9b5b9bb5.mp3"},{"type":"order","t":"Senin baban öğretmen mi?","s":"پدرِ تو معلم است؟","full":"Senin baban öğretmen mi?","a":"audio/tr-fa/498ae0f7c93e.mp3"}]}],"reading":{"title":{"t":"Maryam'ın ailesi","s":"خانواده‌ی مریم","a":"audio/tr-fa/5a7e74c90582.mp3"},"text":[{"t":"Merhaba! Benim adım Maryam.","s":"سلام! اسمِ من مریم است.","pr":"مِرحابا! بِنیم آدِم مریم.","a":"audio/tr-fa/778a96168f66.mp3"},{"t":"Bu benim ailem.","s":"این خانواده‌ی من است.","pr":"بو بِنیم آئیلِم.","a":"audio/tr-fa/da6ef4db4bba.mp3"},{"t":"Eşim Ali. O öğretmen.","s":"همسرم علی است. او معلم است.","pr":"اِشیم علی. اُ اُرِتمِن.","a":"audio/tr-fa/39a7ff43eb48.mp3"},{"t":"Kızımız Sara, yirmi yaşında.","s":"دخترمان سارا است، بیست ساله است.","pr":"کِزِمِز سارا، ییرمی یاشِندا.","a":"audio/tr-fa/c1f96e4f58d9.mp3"},{"t":"Oğlumuz Amir, on sekiz yaşında.","s":"پسرمان امیر است، هجده ساله است.","pr":"اُلوموز امیر، اُن سِکیز یاشِندا.","a":"audio/tr-fa/4650c2c22970.mp3"},{"t":"Annem ve babam Tebrizli.","s":"مادر و پدرم تبریزی هستند.","pr":"آنِّم وِه بابام تِبریزلی.","a":"audio/tr-fa/670a5c1168f2.mp3"},{"t":"Dayım doktor.","s":"دایی‌ام دکتر است.","pr":"دایِم دُکتُر.","a":"audio/tr-fa/7c441764d6a7.mp3"},{"t":"Ailemiz büyük.","s":"خانواده‌ی ما بزرگ است.","pr":"آئیلِمیز بویوک.","a":"audio/tr-fa/3d6bad29e4ca.mp3"}],"questions":[{"q":{"t":"Maryam'ın eşi kim?","s":"همسرِ مریم کیست؟","a":"audio/tr-fa/59b35f5a4122.mp3"},"options":["Ali","Amir","Reza"],"answer":0},{"q":{"t":"Sara kaç yaşında?","s":"سارا چند سال دارد؟","a":"audio/tr-fa/fcdbb03eb889.mp3"},"options":["on sekiz","yirmi","on beş"],"answer":1},{"q":{"t":"Kim öğretmen?","s":"چه کسی معلم است؟","a":"audio/tr-fa/02921a354f38.mp3"},"options":["Amir","Ali","Sara"],"answer":1},{"q":{"t":"Maryam'ın annesi nereli?","s":"مادرِ مریم اهل کجاست؟","a":"audio/tr-fa/e2b5d880ea21.mp3"},"options":["Tebrizli","İstanbullu","Şirazlı"],"answer":0}]},"sentences":[{"t":"Bu benim babam.","s":"این پدرِ من است.","pr":"بو بِنیم بابام.","a":"audio/tr-fa/626d3dc02b92.mp3"},{"t":"Annen nereli?","s":"مادرت اهل کجاست؟","pr":"آنِّن نِرِلی؟","a":"audio/tr-fa/520ae879bf03.mp3"},{"t":"Kız kardeşim on beş yaşında.","s":"خواهرم پانزده ساله است.","pr":"کِز کاردِشیم اُن بِش یاشِندا.","a":"audio/tr-fa/9527829af4f1.mp3"},{"t":"Dedem ve büyükannem Şirazlı.","s":"پدربزرگ و مادربزرگم شیرازی هستند.","pr":"دِدِم وِه بویوک‌آنِّم شیرازلِ.","alts":["Büyükannem ve dedem Şirazlı."],"a":"audio/tr-fa/6ec88bdac527.mp3"},{"t":"Onun oğlu öğrenci.","s":"پسرِ او دانش‌آموز است.","pr":"اُنون اُلو اُرِنجی.","a":"audio/tr-fa/50d9a13cbf56.mp3"},{"t":"Bizim ailemiz büyük.","s":"خانواده‌ی ما بزرگ است.","pr":"بیزیم آئیلِمیز بویوک.","a":"audio/tr-fa/5cb04c9f606e.mp3"},{"t":"Arkadaşım Mehmet Türk.","s":"دوستم مهمت ترک است.","pr":"آرکاداشِم مِهمِت تورک.","a":"audio/tr-fa/6e6c909cc5c1.mp3"},{"t":"Senin adın ne?","s":"اسمِ تو چیست؟","pr":"سِنین آدِن نِه؟","a":"audio/tr-fa/6787312037df.mp3"}],"img":"img/e/1f46a.svg"}