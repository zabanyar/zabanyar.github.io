 است.","a":"audio/tr-fa/b6735207f44c.mp3"},"img":"img/e/1f48d.svg","a":"audio/tr-fa/89f8024f908c.mp3"},{"id":"w09","t":"kız","pl":"kızlar","s":"دختر","pr":"کِز","emoji":"👧","ex":{"t":"Kızım Elif, sekiz yaşında.","s":"دخترم الیف است، هشت ساله است.","a":"audio/tr-fa/3b1042a2f04e.mp3"},"img":"img/e/1f467.svg","a":"audio/tr-fa/ddeec21879a0.mp3","pla":"audio/tr-fa/2d33286411c9.mp3"},{"id":"w10","t":"oğul","s":"پسر (فرزند)","pr":"اُول","emoji":"👦","ex":{"t":"Oğlum Can.","s":"پسرم جان است.","a":"audio/tr-fa/c2e37730f2a4.mp3"},"img":"img/e/1f466.svg","a":"audio/tr-fa/20ac5cd31a09.mp3"},{"id":"w11","t":"amca","s":"عمو","pr":"آمجا","emoji":"","ex":{"t":"Amcam İstanbullu.","s":"عمویم استانبولی است.","a":"audio/tr-fa/ed82cb28bb6c.mp3"},"img":null,"a":"audio/tr-fa/bbae2a5ea68b.mp3"},{"id":"w12","t":"dayı","s":"دایی","pr":"دایِ","emoji":"","ex":{"t":"Dayın nereli?","s":"دایی‌ات اهل کجاست؟","a":"audio/tr-fa/cc73b2c90446.mp3"},"img":null,"a":"audio/tr-fa/d9df5de106f0.mp3"},{"id":"w13","t":"arkadaş","pl":"arkadaşlar","s":"دوست","pr":"آرکاداش","emoji":"🤝","ex":{"t":"Ayşe benim arkadaşım.","s":"آیشه دوستِ من است.","a":"audio/tr-fa/35257c40b5bb.mp3"},"img":"img/e/1f91d.svg","a":"audio/tr-fa/2354901986fd.mp3","pla":"audio/tr-fa/6919146c7aef.mp3"},{"id":"w14","t":"bu","s":"این","pr":"بو","emoji":"👉","ex":{"t":"Bu kim? — Bu benim babam.","s":"این کیست؟ — این پدرِ من است.","a":"audio/tr-fa/e1e7d205ec18.mp3"},"img":"img/e/1f449.svg","a":"audio/tr-fa/2ceb52f18bab.mp3"}],"phrases":[{"id":"p01","t":"Bu kim?","s":"این کیست؟","pr":"بو کیم؟","a":"audio/tr-fa/f9428d390079.mp3"},{"id":"p02","t":"Bu benim annem.","s":"این مادرِ من است.","pr":"بو بِنیم آنِّم","a":"audio/tr-fa/487b5a01cdb4.mp3"},{"id":"p03","t":"Senin adın ne?","s":"اسمِ تو چیست؟","pr":"سِنین آدِن نِه؟","a":"audio/tr-fa/6787312037df.mp3"},{"id":"p04","t":"Kardeşin var mı?","s":"خواهر یا برادر داری؟","pr":"کاردِشین وار مِ؟","a":"audio/tr-fa/87fc7c28ad13.mp3"},{"id":"p05","t":"Evet, bir kardeşim var.","s":"بله، یک خواهر یا برادر دارم.","pr":"اِوِت، بیر کاردِشیم وار","a":"audio/tr-fa/a275a591f7f5.mp3"},{"id":"p06","t":"Ailen nasıl?","s":"خانواده‌ات چطورند؟","pr":"آئیلِن ناسِل؟","a":"audio/tr-fa/08672f85f5c8.mp3"},{"id":"p07","t":"Ne güzel bir aile!","s":"چه خانواده‌ی خوبی!","pr":"نِه گوزِل بیر آئیلِه!","a":"audio/tr-fa/38707cebc172.mp3"}],"dialogue":{"title":{"t":"Aile fotoğrafı","s":"عکسِ خانوادگی","a":"audio/tr-fa/c87fce137e54.mp3"},"speakers":{"A":{"name":"Ayşe","voice":"f"},"B":{"name":"Reza","voice":"m"}},"lines":[{"sp":"A","t":"Bu kim, Reza?","s":"این کیست، رضا؟","a":"audio/tr-fa/281ec0ba0407.mp3"},{"sp":"B","t":"Bu benim annem. Adı Neda.","s":"این مادرِ من است. اسمش نداست.","a":"audio/tr-fa/4c0b32bca05e.mp3"},{"sp":"A","t":"Annen çok güzel! Peki bu kim?","s":"مادرت خیلی زیباست! خب، این کیست؟","a":"audio/tr-fa/f3ae776f779a.mp3"},{"sp":"B","t":"Bu babam. O doktor.","s":"این پدرم است. او دکتر است.","a":"audio/tr-fa/fd10b51246c8.mp3"},{"sp":"A","t":"Kardeşin var mı?","s":"خواهر یا برادر داری؟","a":"audio/tr-fa/87fc7c28ad13.mp3"},{"sp":"B","t":"Evet, bir kız kardeşim var. Adı Sara.","s":"بله، یک خواهر دارم. اسمش ساراست.","a":"audio/tr-fa/13573ce2dfef.mp3"},{"sp":"A","t":"Sara kaç yaşında?","s":"سارا چند سال دارد؟","a":"audio/tr-fa/fcdbb03eb889.mp3"},{"sp":"B","t":"On iki yaşında. O öğrenci.","s":"دوازده سال دارد. او دانش‌آموز است.","a":"audio/tr-fa/ab06db517b05.mp3"},{"sp":"A","t":"Ne güzel bir aile!","s":"چه خانواده‌ی خوبی!","a":"audio/tr-fa/38707cebc172.mp3"},{"sp":"B","t":"Teşekkürler, Ayşe!","s":"ممنون، آیشه!","a":"audio/tr-fa/8cb7052a6ab3.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Annem, annen, annesi","s":"پسوندهای مالکیت: مادرم، مادرت، مادرش"},"explain":"خبر خوب: ترکی هم برای «ـَم، ـَت، ـَش» پسوند دارد، درست مثل فارسی!\n**annem** = مادرم، **annen** = مادرت، **annesi** = مادرش.\nاگر کلمه با **حرف صدادار** تمام شود: **-m، -n، -sı / -si / -su / -sü** (anne ← annem، annen، annesi).\nاگر با **حرف بی‌صدا** تمام شود، اول یک حرف صدادار می‌آید: **-ım / -im / -um / -üm** (kardeş ← kardeşim، kardeşin، kardeşi).\nحرف صدادار باز هم از آخرین حرف صدادارِ کلمه پیروی می‌کند: **baba ← babam**، **okul ← okulum**.\nدو نکته‌ی کوچک: **kitap ← kitabım** (p به b تبدیل می‌شود) و **oğul ← oğlum** (یک حرف صدادار می‌افتد).\nکلمه‌های آشنا: **dayı** = دایی و **aile** = عائله (خانواده)!","table":[["-(ı)m","annem","kardeşim"],["-(ı)n","annen","kardeşin"],["-(s)ı","annesi","kardeşi"],["-(ı)mız","annemiz","kardeşimiz"],["-(ı)nız","anneniz","kardeşiniz"],["-ları / -leri","anneleri","kardeşleri"]],"examples":[{"t":"Annem Tahranlı.","s":"مادرم تهرانی است.","a":"audio/tr-fa/7eb4c958bb39.mp3"},{"t":"Baban kaç yaşında?","s":"پدرت چند سال دارد؟","a":"audio/tr-fa/5948d25a28a1.mp3"},{"t":"Kız kardeşi on yaşında.","s":"خواهرش ده ساله است.","a":"audio/tr-fa/14eaf2ad8a90.mp3"},{"t":"Arkadaşımız Türk.","s":"دوستمان ترک است.","a":"audio/tr-fa/e0cc9c9aedd8.mp3"},{"t":"Oğlum öğrenci.","s":"پسرم دانش‌آموز است.","a":"audio/tr-fa/fac3ba1b71c0.mp3"}],"exercises":[{"type":"choice","t":"Anne___ öğretmen.","options":["m","n","si"],"answer":0,"s":"مادرم معلم است.","full":"Annem öğretmen.","a":"audio/tr-fa/3dad3d1bcbce.mp3"},{"type":"choice","t":"Kardeş___ kaç yaşında?","options":["im","in","i"],"answer":1,"s":"برادرت چند سال دارد؟","full":"Kardeşin kaç yaşında?","a":"audio/tr-fa/0b50c4b1a987.mp3"},{"type":"type","t":"Baba___ doktor.","answer":["sı"],"s":"پدرش دکتر است.","full":"Babası doktor.","a":"audio/tr-fa/0e6b0a088b9a.mp3"},{"type":"type","t":"Arkadaş___ İranlı.","answer":["ım"],"s":"دوستم ایرانی است.","full":"Arkadaşım İranlı.","a":"audio/tr-fa/77dafbc65552.mp3"},{"type":"choice","t":"Okul___ çok güzel.","options":["umuz","ımız","imiz"],"answer":0,"s":"مدرسه‌مان خیلی قشنگ است.","full":"Okulumuz çok güzel.","a":"audio/tr-fa/0b2e8ff722f0.mp3"},{"type":"type","t":"Bu benim kitab___.","answer":["ım"],"s":"این کتابِ من است.","full":"Bu benim kitabım.","a":"audio/tr-fa/59685c551a4c.mp3"},{"type":"order","t":"Kız kardeşim yedi yaşında.","s":"خواهرم هفت ساله است.","full":"Kız kardeşim yedi yaşında.","a":"audio/tr-fa/a916ae2a660c.mp3"}]},{"id":"g02","title":{"t":"benim, senin, onun","s":"مالِ من، مالِ تو، مالِ او"},"explain":"**benim** یعنی «مالِ من» و **senin** یعنی «مالِ تو». این کلمه‌ها **قبل از** اسم می‌آیند، ولی پسوند مالکیت هم باید سرِ جایش بماند:\n**benim annem** = مادرِ من، **senin baban** = پدرِ تو، **onun kızı** = دخترِ او.\nمعمولاً می‌توانیم benim و senin را نگوییم، چون پسوند خودش همه چیز را می‌گوید: **Annem öğretmen.**\nوقتی می‌خواهیم تأکید کنیم، آن‌ها را می‌گوییم: **Bu benim kitabım.** = این کتابِ من است (نه کتابِ کسِ دیگر).","table":[["ben → benim","benim babam"],["sen → senin","senin baban"],["o → onun","onun babası"],["biz → bizim","bizim babamız"],["siz → sizin","sizin babanız"],["onlar → onların","onların babaları"]],"examples":[{"t":"Benim adım Maryam.","s":"اسمِ من مریم است.","a":"audio/tr-fa/5de9144b72b6.mp3"},{"t":"Senin adın ne?","s":"اسمِ تو چیست؟","a":"audio/tr-fa/6787312037df.mp3"},{"t":"Onun babası doktor.","s":"پدرِ او دکتر است.","a":"audio/tr-fa/374942643e32.mp3"},{"t":"Bizim ailemiz büyük.","s":"خانواده‌ی ما بزرگ است.","a":"audio/tr-fa/5cb04c9f606e.mp3"},{"t":"Sizin eviniz çok güzel.","s":"خانه‌ی شما خیلی قشنگ است.","a":"audio/tr-fa/b05ebe1056f7.mp3"}],"exercises":[{"type":"choice","t":"___ annem Şirazlı.","options":["Benim","Senin","Onun"],"answer":0,"s":"مادرِ من شیرازی است.","full":"Benim annem Şirazlı.","a":"audio/tr-fa/09dfa4a58a03.mp3"},{"type":"choice","t":"Senin ___ ne?","options":["adım","adın","adı"],"answer":1,"s":"اسمِ تو چیست؟","full":"Senin adın ne?","a":"audio/tr-fa/6787312037df.mp3"},{"type":"choice","t":"Onun ___ on yaşında.","options":["kızı","kızım","kızın"],"answer":0,"s":"دخترِ او ده ساله است.","full":"Onun kızı on yaşında.","a":"audio/tr-fa/51fe007389af.mp3"},{"type":"type","t":"___ ailemiz büyük.","answer":["bizim"],"s":"خانواده‌ی ما بزرگ است.","full":"bizim ailemiz büyük.","a":"audio/tr-fa/4a4794e7dfbd.mp3"},{"type":"type","t":"___ babanız nereli?","answer":["sizin"],"s":"پدرِ شما اهل کجاست؟","full":"sizin babanız nereli?","a":"audio/tr-fa/112650a8d62f.mp3"},{"type":"order","t":"Bu benim arkadaşım Ayşe.","s":"این دوستِ من آیشه است.","full":"Bu benim arkadaşım Ayşe.","a":"audio/tr-fa/92fa37498cad.mp3"}]}],"reading":{"title":{"t":"Maryam'ın ailesi","s":"خانواده‌ی مریم","a":"audio/tr-fa/5a7e74c90582.mp3"},"text":[{"t":"Merhaba! Benim adım Maryam.","s":"سلام! اسمِ من مریم است.","a":"audio/tr-fa/778a96168f66.mp3"},{"t":"Bu benim ailem.","s":"این خانواده‌ی من است.","a":"audio/tr-fa/da6ef4db4bba.mp3"},{"t":"Eşim Ali. O öğretmen.","s":"همسرم علی است. او معلم است.","a":"audio/tr-fa/39a7ff43eb48.mp3"},{"t":"Kızımız Elif, sekiz yaşında.","s":"دخترمان الیف است، هشت ساله است.","a":"audio/tr-fa/bbd4cfb519e5.mp3"},{"t":"Oğlumuz Can, beş yaşında.","s":"پسرمان جان است، پنج ساله است.","a":"audio/tr-fa/d25a9bc89fa7.mp3"},{"t":"Annem ve babam Tebrizli.","s":"مادر و پدرم تبریزی هستند.","a":"audio/tr-fa/670a5c1168f2.mp3"},{"t":"Dayım doktor.","s":"دایی‌ام دکتر است.","a":"audio/tr-fa/7c441764d6a7.mp3"},{"t":"Ailemiz büyük.","s":"خانواده‌ی ما بزرگ است.","a":"audio/tr-fa/3d6bad29e4ca.mp3"}],"questions":[{"q":{"t":"Maryam'ın eşi kim?","s":"همسرِ مریم کیست؟","a":"audio/tr-fa/59b35f5a4122.mp3"},"options":["Ali","Can","Reza"],"answer":0},{"q":{"t":"Elif kaç yaşında?","s":"الیف چند سال دارد؟","a":"audio/tr-fa/646c47529fb0.mp3"},"options":["beş","sekiz","on"],"answer":1},{"q":{"t":"Kim öğretmen?","s":"چه کسی معلم است؟","a":"audio/tr-fa/02921a354f38.mp3"},"options":["Can","Ali","Elif"],"answer":1},{"q":{"t":"Maryam'ın annesi nereli?","s":"مادرِ مریم اهل کجاست؟","a":"audio/tr-fa/e2b5d880ea21.mp3"},"options":["Tebrizli","İstanbullu","Şirazlı"],"answer":0}]},"sentences":[{"t":"Bu benim babam.","s":"این پدرِ من است.","a":"audio/tr-fa/626d3dc02b92.mp3"},{"t":"Annen nereli?","s":"مادرت اهل کجاست؟","a":"audio/tr-fa/520ae879bf03.mp3"},{"t":"Kız kardeşim on beş yaşında.","s":"خواهرم پانزده ساله است.","a":"audio/tr-fa/9527829af4f1.mp3"},{"t":"Dedem ve büyükannem Şirazlı.","s":"پدربزرگ و مادربزرگم شیرازی هستند.","a":"a