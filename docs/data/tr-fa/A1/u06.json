":{"t":"Annem mutfakta yemek yapıyor.","s":"مادرم در آشپزخانه غذا درست می‌کند.","a":"audio/tr-fa/2e0bf0491ea9.mp3"},"img":"img/e/1f372.svg","a":"audio/tr-fa/9a3ea930c98c.mp3"},{"id":"w09","t":"okumak","s":"خواندن","pr":"اُکوماک","emoji":"📖","ex":{"t":"Sara kitap okuyor.","s":"سارا کتاب می‌خواند.","a":"audio/tr-fa/f34a5004a042.mp3"},"img":"img/e/1f4d6.svg","a":"audio/tr-fa/bd615e206c6b.mp3"},{"id":"w10","t":"izlemek","s":"تماشا کردن","pr":"ایزلِمِک","emoji":"📺","ex":{"t":"Çocuklar televizyon izliyor.","s":"بچه‌ها تلویزیون تماشا می‌کنند.","a":"audio/tr-fa/f37ca5e2256e.mp3"},"img":"img/e/1f4fa.svg","a":"audio/tr-fa/9d32c0f2ce56.mp3"},{"id":"w11","t":"uyumak","s":"خوابیدن","pr":"اویوماک","emoji":"😴","ex":{"t":"Bebek uyuyor.","s":"نوزاد خوابیده است.","a":"audio/tr-fa/58de194d6de7.mp3"},"img":"img/e/1f634.svg","a":"audio/tr-fa/90b248304760.mp3"},{"id":"w12","t":"şimdi","s":"الان، حالا","pr":"شیمدی","emoji":"","ex":{"t":"Şimdi saat sekiz.","s":"الان ساعت هشت است.","a":"audio/tr-fa/bcd98c56fcaf.mp3"},"img":null,"a":"audio/tr-fa/12ab5fafa1b6.mp3"},{"id":"w13","t":"sonra","s":"بعد","pr":"سُنرا","emoji":"","ex":{"t":"Kahvaltı yapıyorum, sonra çalışıyorum.","s":"صبحانه می‌خورم، بعد کار می‌کنم.","a":"audio/tr-fa/689d216b5b3a.mp3"},"img":null,"a":"audio/tr-fa/f64d5c3a93e8.mp3"},{"id":"w14","t":"her gün","s":"هر روز","pr":"هِر گون","emoji":"📅","ex":{"t":"Her gün çay içiyorum.","s":"هر روز چای می‌نوشم.","a":"audio/tr-fa/1d1d1a440342.mp3"},"img":"img/e/1f4c5.svg","a":"audio/tr-fa/70261e42371e.mp3"}],"phrases":[{"id":"p01","t":"Saat kaç?","s":"ساعت چند است؟","pr":"ساآت کاچ؟","a":"audio/tr-fa/a97694abb14d.mp3"},{"id":"p02","t":"Saat yedi.","s":"ساعت هفت است.","pr":"ساآت یِدی.","a":"audio/tr-fa/dcdec6ec4b91.mp3"},{"id":"p03","t":"Saat yedi buçuk.","s":"ساعت هفت و نیم است.","pr":"ساآت یِدی بوچوک.","a":"audio/tr-fa/1c6bcc51acf1.mp3"},{"id":"p04","t":"Saat kaçta?","s":"ساعت چند؟ (در چه ساعتی؟)","pr":"ساآت کاچتا؟","a":"audio/tr-fa/8fd92ad37669.mp3"},{"id":"p05","t":"Günaydın!","s":"صبح بخیر!","pr":"گونایدِن!","a":"audio/tr-fa/e537b1bea582.mp3"},{"id":"p06","t":"İyi geceler!","s":"شب بخیر!","pr":"ای‌یی گِجِلِر!","a":"audio/tr-fa/b0e56ae10811.mp3"},{"id":"p07","t":"Geç kalıyorum!","s":"دارم دیر می‌کنم!","pr":"گِچ کالِیُروم!","a":"audio/tr-fa/af531ee8286a.mp3"},{"id":"p08","t":"Çok erken!","s":"خیلی زود است!","pr":"چُک اِرکِن!","a":"audio/tr-fa/f49e0ea3ee9a.mp3"}],"dialogue":{"title":{"t":"Saat kaçta kalkıyorsun?","s":"ساعت چند بیدار می‌شوی؟","a":"audio/tr-fa/c227da0a3440.mp3"},"speakers":{"A":{"name":"Maryam","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"Günaydın Mehmet!","s":"صبح بخیر مهمت!","a":"audio/tr-fa/1c24d09c9b89.mp3"},{"sp":"B","t":"Günaydın Maryam! Nasılsın?","s":"صبح بخیر مریم! حالت چطور است؟","a":"audio/tr-fa/bb492b053f59.mp3"},{"sp":"A","t":"İyiyim, teşekkürler. Sen her sabah saat kaçta kalkıyorsun?","s":"خوبم، ممنون. تو هر روز صبح ساعت چند بیدار می‌شوی؟","a":"audio/tr-fa/6eee196179ca.mp3"},{"sp":"B","t":"Yedide kalkıyorum. Ya sen?","s":"ساعت هفت بیدار می‌شوم. تو چطور؟","a":"audio/tr-fa/b32ca4fdc95e.mp3"},{"sp":"A","t":"Ben altıda kalkıyorum ve kahvaltı yapıyorum.","s":"من ساعت شش بیدار می‌شوم و صبحانه می‌خورم.","a":"audio/tr-fa/10aeae867dfd.mp3"},{"sp":"B","t":"Altıda! Çok erken!","s":"ساعت شش! خیلی زود است!","a":"audio/tr-fa/28864d08170f.mp3"},{"sp":"A","t":"Evet, ama gece saat onda uyuyorum.","s":"بله، ولی شب ساعت ده می‌خوابم.","a":"audio/tr-fa/b3a9b46512e2.mp3"},{"sp":"B","t":"Şimdi saat kaç?","s":"الان ساعت چند است؟","a":"audio/tr-fa/7044843d9596.mp3"},{"sp":"A","t":"Saat sekiz buçuk.","s":"ساعت هشت و نیم است.","a":"audio/tr-fa/436d6eee6c0a.mp3"},{"sp":"B","t":"Eyvah, geç kalıyorum! İyi günler, Maryam!","s":"وای، دارم دیر می‌کنم! روز خوبی داشته باشی، مریم!","a":"audio/tr-fa/cf8707fe75f6.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Şimdiki zaman: -iyor","s":"زمان حال با پسوند iyor"},"explain":"برای کارهایی که **الان** یا **هر روز** انجام می‌دهیم، در ترکی از پسوند **iyor** استفاده می‌کنیم؛ درست مثل «می‌…» در فارسی.\nروش ساخت: اول **mek / mak** را از آخر مصدر برمی‌داریم: kalkmak → **kalk**. بعد **ıyor / iyor / uyor / üyor** و در آخر شناسه را اضافه می‌کنیم: kalk**ıyor**um = بیدار می‌شوم.\nهماهنگی واکه‌ها (چهارتایی): بعد از a و ı → **ıyor**؛ بعد از e و i → **iyor**؛ بعد از o و u → **uyor**؛ بعد از ö و ü → **üyor**. مثال: kalkıyor، geliyor، oturuyor، görüyor.\nاگر ریشه به واکه ختم شود فقط **yor** می‌آید: oku → **okuyor**، uyu → **uyuyor**. ولی e یا a آخر عوض می‌شود: izle → **izliyor**، anla → **anlıyor**.\nخبر خوب: خود **yor** هیچ‌وقت تغییر نمی‌کند، پس شناسه‌ها همیشه همین‌اند: **um، sun، (هیچ)، uz، sunuz، lar**.\nچند فعل خاص: gitmek → **gidiyor** (t به d تبدیل می‌شود) و yemek → **yiyor**.","table":[["ben","kalkıyorum","izliyorum"],["sen","kalkıyorsun","izliyorsun"],["o","kalkıyor","izliyor"],["biz","kalkıyoruz","izliyoruz"],["siz","kalkıyorsunuz","izliyorsunuz"],["onlar","kalkıyorlar","izliyorlar"]],"examples":[{"t":"Ben her gün çalışıyorum.","s":"من هر روز کار می‌کنم.","a":"audio/tr-fa/7dce14e21e18.mp3"},{"t":"Sen şimdi ne yapıyorsun?","s":"تو الان چه کار می‌کنی؟","a":"audio/tr-fa/64ced13dd02b.mp3"},{"t":"Ayşe kitap okuyor.","s":"آیشه کتاب می‌خواند.","a":"audio/tr-fa/0969b4ac386b.mp3"},{"t":"Biz akşam televizyon izliyoruz.","s":"ما عصر تلویزیون تماشا می‌کنیم.","a":"audio/tr-fa/c4060816a5e1.mp3"},{"t":"Çocuklar saat dokuzda uyuyor.","s":"بچه‌ها ساعت نه می‌خوابند.","a":"audio/tr-fa/1bff40e69fe3.mp3"}],"exercises":[{"type":"choice","t":"Ben her gün saat yedide ___.","options":["kalkıyorum","kalkıyorsun","kalkıyor"],"answer":0,"s":"من هر روز ساعت هفت بیدار می‌شوم.","full":"Ben her gün saat yedide kalkıyorum.","a":"audio/tr-fa/f55fd53ad9d8.mp3"},{"type":"choice","t":"Ali bir okulda ___.","options":["çalışıyorum","çalışıyor","çalışıyoruz"],"answer":1,"s":"علی در یک مدرسه کار می‌کند.","full":"Ali bir okulda çalışıyor.","a":"audio/tr-fa/90f796756a21.mp3"},{"type":"choice","t":"Biz akşam televizyon ___.","options":["izleyoruz","izliyorlar","izliyoruz"],"answer":2,"s":"ما عصر تلویزیون تماشا می‌کنیم.","full":"Biz akşam televizyon izliyoruz.","a":"audio/tr-fa/c4060816a5e1.mp3"},{"type":"choice","t":"Sen kahvaltıda ne ___?","options":["yiyorsun","yiyorum","yiyor"],"answer":0,"s":"تو صبحانه چه می‌خوری؟","full":"Sen kahvaltıda ne yiyorsun?","a":"audio/tr-fa/79d495a5280e.mp3"},{"type":"type","t":"Sen şimdi ne ___?","answer":["yapıyorsun"],"s":"تو الان چه کار می‌کنی؟","full":"Sen şimdi ne yapıyorsun?","a":"audio/tr-fa/64ced13dd02b.mp3"},{"type":"type","t":"Biz akşam yemek ___.","answer":["yapıyoruz"],"s":"ما عصر غذا درست می‌کنیم.","full":"Biz akşam yemek yapıyoruz.","a":"audio/tr-fa/65c2c26508e8.mp3"},{"type":"order","t":"Ben gece on birde uyuyorum.","s":"من شب ساعت یازده می‌خوابم.","full":"Ben gece on birde uyuyorum.","a":"audio/tr-fa/d8a1b7a9877d.mp3"},{"type":"order","t":"Babam her gün çalışıyor.","s":"پدرم هر روز کار می‌کند.","full":"Babam her gün çalışıyor.","a":"audio/tr-fa/f968004b06f9.mp3"}]},{"id":"g02","title":{"t":"Saat kaç? Saat kaçta?","s":"ساعت چند است؟ ساعت چند؟"},"explain":"برای پرسیدن ساعت می‌گوییم **Saat kaç?** (ساعت چند است؟). جواب: **Saat** + عدد: Saat yedi = ساعت هفت است. برای «و نیم» کلمه‌ی **buçuk** را بعد از عدد می‌آوریم: Saat yedi buçuk = ساعت هفت و نیم.\nبرای «در چه ساعتی؟» می‌پرسیم **Saat kaçta?** و در جواب به عدد همان پسوند مکان **de / da** را اضافه می‌کنیم که در درس خانه یاد گرفتیم: yedi**de** = ساعت هفت، dokuz**da** = ساعت نه.\nیادتان باشد: بعد از حروف بی‌صدای ç، ş، t، k، p، s، f، h پسوند به **te / ta** تبدیل می‌شود: üç**te**، dört**te**، beş**te**، buçuk**ta**.","table":[["1","saat bir","birde"],["2","saat iki","ikide"],["3","saat üç","üçte"],["4","saat dört","dörtte"],["5","saat beş","beşte"],["6","saat altı","altıda"],["7","saat yedi","yedide"],["8","saat sekiz","sekizde"],["9","saat dokuz","dokuzda"],["10","saat on","onda"],["7:30","saat yedi buçuk","yedi buçukta"]],"examples":[{"t":"Saat kaç? Saat sekiz.","s":"ساعت چند است؟ ساعت هشت است.","a":"audio/tr-fa/efdd026b5a29.mp3"},{"t":"Saat on bir buçuk.","s":"ساعت یازده و نیم است.","a":"audio/tr-fa/9f47d5a83409.mp3"},{"t":"Saat kaçta kalkıyorsun? Altıda.","s":"ساعت چند بیدار می‌شوی؟ ساعت شش.","a":"audio/tr-fa/70ab04a14492.mp3"},{"t":"Saat üçte çay içiyoruz.","s":"ساعت سه چای می‌نوشیم.","a":"audio/tr-fa/659d711c6be2.mp3"},{"t":"Babam saat beşte kalkıyor.","s":"پدرم ساعت پنج بیدار می‌شود.","a":"audio/tr-fa/601c23ac3991.mp3"}],"exercises":[{"type":"choice","t":"Saat ___? Saat dokuz.","options":["nerede","kaç","ne"],"answer":1,"s":"ساعت چند است؟ ساعت نه است.","full":"Saat kaç? Saat dokuz.","a":"audio/tr-fa/9ec0dfb87f73.mp3"},{"type":"choice","t":"Saat ___ çay içiyoruz.","options":["üçte","üçde","üçta"],"answer":0,"s":"ساعت سه چای می‌نوشیم.","full":"Saat üçte çay içiyoruz.","a":"audio/tr-fa/659d711c6be2.mp3"},{"type":"choice","t":"Ben saat ___ kalkıyorum.","options":["altıde","altıta","altıda"],"answer":2,"s":"من ساعت شش بیدار می‌شوم.","full":"Ben saat altıda kalkıyorum.","a":"audio/tr-fa/69042c27c645.mp3"},{"type":"type","t":"Saat yedi ___.","answer":["buçuk"],"s":"ساعت هفت و نیم است.","full":"Saat yedi buçuk.","a":"audio/tr-fa/1c6bcc51acf1.mp3"},{"type":"type","t":"Ben saat ___ uyuyorum.","answer":["onda","10'da"],"s":"من ساعت ده می‌خوابم.","full":"Ben saat onda uyuyorum.","a":"audio/tr-fa/770826ccb241.mp3"},{"type":"order","t":"Saat kaçta kalkıyorsun?","s":"ساعت چند بیدار می‌شوی؟","full":"Saat kaçta kalkıyorsun?","a":"audio/tr-fa/c227da0a3440.mp3"}]}],"reading":{"title":{"t":"Reza'nın günü","s":"یک روز رضا","a":"audio/tr-fa/b1bc513eb72d.mp3"},"text":[{"t":"Merhaba! Benim adım Reza.","s":"سلام! اسم من رضا است.","a":"audio/tr-fa/9464f7f8f664.mp3"},{"t":"Her gün saat altı buçukta kalkıyorum.","s":"هر روز ساعت شش و نیم بیدار می‌شوم.","a":"audio/tr-fa/30b5045c34f7.mp3"},{"t":"Saat yedide kahvaltı yapıyorum: ekmek ve peynir yiyorum, çay içiyorum.","s":"ساعت هفت صبحانه می‌خورم: نان و پنیر می‌خورم و چای می‌نوشم.","a":"audio/tr-fa/f752eb6e62d8.mp3"},{"t":"Ben öğretmenim. Bir okulda çalışıyorum.","s":"من معلم هستم. در یک مدرسه کار می‌کنم.","a":"audio/tr-fa/1dfd0e4bab79.mp3"},{"t":"Akşam eşim ve ben yemek yapıyoruz.","s":"عصر من و همسرم غذا درست می‌کنیم.","a":"audio/tr-fa/555f326ccc42.mp3"},{"t":"Çocuklar kitap okuyor.","s":"بچه‌ها کتاب می‌خوانند.","a":"audio/tr-fa/17907a618d4c.mp3"},{"t":"Saat dokuzda hep birlikte televizyon izliyoruz.","s":"ساعت نه همه با هم تلویزیون تماشا می‌کنیم.","a":"audio/tr-fa/3d2558e40f37.mp3"},{"t":"Gece saat on birde uyuyorum.","s":"شب ساعت یازده می‌خوابم.","a":"audio/tr-fa/e59e1366d04e.mp3"}],"questions":[{"q":{"t":"Reza saat kaçta kalkıyor?","s":"رضا ساعت چند بیدار می‌شود؟","a":"audio/tr-fa/4fbc957419f9.mp3"},"options":["Altı buçukta","Yedide","On birde"],"answer":0},{"q":{"t":"Reza nerede çalışıyor?","s":"رضا کجا کار می‌کند؟","a":"audio/tr-fa/b6afd9896d3e.mp3"},"options":["Evde","Okulda","Mutfakta"],"answer":1},{"q":{"t":"Saat dokuzda ne yapıyorlar?","s":"ساعت نه چه کار می‌کنند؟","a":"audio/tr-fa/3284c20510ab.mp3"},"options":["Uyuyorlar","Kahvaltı yapıyorlar","Televizyon izliyorlar"],"answer":2},{"q":{"t":"Reza kahvaltıda ne içiyor?","s":"رضا صبحانه چه می‌نوشد؟","a":"audio/tr-fa/463d4fd328f4.mp3"},"options":["Çay","Su","Süt"],"answer":0}]},"sentences":[{"t":"Annem sabah çay içiyor.","s":"مادرم صبح چای می‌نوشد.","a":"audio/tr-fa/9db1d44bdbf8.mp3"},{"t":"Biz akşam yemek yapıyoruz.","s":"ما عصر غذا درست می‌کنیم.","a":"audio/tr-fa/65c2c26508e8.mp3"},{"t":"Çocuklar saat dokuzda uyuyor.","s":"بچه‌ها ساعت نه می‌خوابند.","a":"audio/tr-fa/1bff40e69fe3.mp3"},{"t":"Sen şimdi ne yapıyorsun?","s":"تو الان چه کار می‌کنی؟","a":"audio/tr-fa/64ced13dd02b.mp3"},{"t":"Babam her gün çalışıyor.","s":"پدرم هر روز کار می‌کند.","a":"audio/tr-fa/f968004b06f9.mp3"},{"t":"Saat sekiz buçuk.","s":"ساعت هشت و نیم است.","a":"audio/tr-fa/436d6eee6c0a.mp3"},{"t":"Ayşe kitap okuyor.","s":"آیشه کتاب می‌خواند.","a":"audio/tr-fa/0969b4ac386b.mp3"}],"img":"img/e/23f0.svg"}