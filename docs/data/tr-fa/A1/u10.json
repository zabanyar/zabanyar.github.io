ً گوش کنید!","a":"audio/tr-fa/379691efb88a.mp3"},"img":"img/e/1f3a7.svg","a":"audio/tr-fa/6e268d949a0a.mp3"},{"id":"w09","t":"şarkı söylemek","s":"آواز خواندن","pr":"شارکِ سُیلِمِک","emoji":"🎤","ex":{"t":"Sara çok güzel şarkı söylüyor.","s":"سارا خیلی قشنگ آواز می‌خواند.","a":"audio/tr-fa/9602c65493fa.mp3"},"img":"img/e/1f3a4.svg","a":"audio/tr-fa/262abcc4dacc.mp3"},{"id":"w10","t":"bisiklet","pl":"bisikletler","s":"دوچرخه","pr":"بیسیکلِت","emoji":"🚲","ex":{"t":"Ben bisiklete binebilirim.","s":"من می‌توانم دوچرخه‌سواری کنم.","a":"audio/tr-fa/5124e9537605.mp3"},"img":"img/e/1f6b2.svg","a":"audio/tr-fa/a762ad3b21af.mp3","pla":"audio/tr-fa/06082c30e7d9.mp3"},{"id":"w11","t":"gitar","pl":"gitarlar","s":"گیتار","pr":"گیتار","emoji":"🎸","ex":{"t":"Maryam gitar çalıyor.","s":"مریم گیتار می‌زند.","a":"audio/tr-fa/709c286a48d1.mp3"},"img":"img/e/1f3b8.svg","a":"audio/tr-fa/61092aaa924b.mp3","pla":"audio/tr-fa/6ee526f896c2.mp3"},{"id":"w12","t":"yürüyüş","s":"پیاده‌روی","pr":"یورویوش","emoji":"🥾","ex":{"t":"Akşam yürüyüş yapıyoruz.","s":"عصر پیاده‌روی می‌کنیم.","a":"audio/tr-fa/6ed4ae573675.mp3"},"img":"img/e/1f97e.svg","a":"audio/tr-fa/cde14d20911e.mp3"},{"id":"w13","t":"sinema","s":"سینما","pr":"سینِما","emoji":"🎬","ex":{"t":"Sinema çok yakın.","s":"سینما خیلی نزدیک است.","a":"audio/tr-fa/f9444ad65abf.mp3"},"img":"img/e/1f3ac.svg","a":"audio/tr-fa/e7b88630e200.mp3"},{"id":"w14","t":"satranç","s":"شطرنج","pr":"ساترانچ","emoji":"♟️","ex":{"t":"Dedem ve ben satranç oynuyoruz.","s":"من و پدربزرگم شطرنج بازی می‌کنیم.","a":"audio/tr-fa/f9e28bf10564.mp3"},"img":"img/e/265f.svg","a":"audio/tr-fa/2730c7045cd5.mp3"}],"phrases":[{"id":"p01","t":"Boş zamanında ne yapıyorsun?","s":"در وقت آزادت چه کار می‌کنی؟","pr":"بُش زامانِندا نِه یاپِیُرسون؟","a":"audio/tr-fa/3b45088ace74.mp3"},{"id":"p02","t":"Ne yapmayı seversin?","s":"دوست داری چه کار کنی؟","pr":"نِه یاپمایِ سِوِرسین؟","a":"audio/tr-fa/a2fcc38ffba1.mp3"},{"id":"p03","t":"Yüzebilir misin?","s":"می‌توانی شنا کنی؟","pr":"یوزِبیلیر میسین؟","a":"audio/tr-fa/3d19d0303b85.mp3"},{"id":"p04","t":"Evet, yüzebilirim.","s":"بله، می‌توانم شنا کنم.","pr":"اِوِت، یوزِبیلیریم.","a":"audio/tr-fa/88af3e37a1b5.mp3"},{"id":"p05","t":"Hayır, yüzemem.","s":"نه، نمی‌توانم شنا کنم.","pr":"هایِر، یوزِمِم.","a":"audio/tr-fa/7491cf59811c.mp3"},{"id":"p06","t":"Hobim resim yapmak.","s":"سرگرمی من نقاشی است.","pr":"هُبیم رِسیم یاپماک.","a":"audio/tr-fa/b3733d4a71c7.mp3"},{"id":"p07","t":"Hadi, birlikte oynayalım!","s":"بیا با هم بازی کنیم!","pr":"هادی، بیرلیکتِه اُینایالِم!","a":"audio/tr-fa/44706a9796ab.mp3"},{"id":"p08","t":"Ben de!","s":"من هم!","pr":"بِن دِه!","a":"audio/tr-fa/856e086a5bf3.mp3"}],"dialogue":{"title":{"t":"Ne yapmayı seversin?","s":"دوست داری چه کار کنی؟","a":"audio/tr-fa/a2fcc38ffba1.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Ali","voice":"m"}},"lines":[{"sp":"A","t":"Ali, boş zamanında ne yapıyorsun?","s":"علی، در وقت آزادت چه کار می‌کنی؟","a":"audio/tr-fa/ab3ed7807d30.mp3"},{"sp":"B","t":"Futbol oynamayı severim. Sen futbol sever misin?","s":"فوتبال بازی کردن را دوست دارم. تو فوتبال دوست داری؟","a":"audio/tr-fa/b94e23b5215b.mp3"},{"sp":"A","t":"Hayır, sevmem. Ama yüzmeyi çok severim.","s":"نه، دوست ندارم. ولی شنا کردن را خیلی دوست دارم.","a":"audio/tr-fa/895fb0581dea.mp3"},{"sp":"B","t":"Ben yüzemem. Zor mu?","s":"من نمی‌توانم شنا کنم. سخت است؟","a":"audio/tr-fa/0a7579b2e0a6.mp3"},{"sp":"A","t":"Zor değil. Ben sana öğretebilirim!","s":"سخت نیست. من می‌توانم به تو یاد بدهم!","a":"audio/tr-fa/0b833021ba81.mp3"},{"sp":"B","t":"Harika! Sen satranç oynayabilir misin?","s":"عالی! تو می‌توانی شطرنج بازی کنی؟","a":"audio/tr-fa/4ae1c4347090.mp3"},{"sp":"A","t":"Evet, oynayabilirim. Satranç oynamayı da severim.","s":"بله، می‌توانم. شطرنج بازی کردن را هم دوست دارم.","a":"audio/tr-fa/db1995d147a1.mp3"},{"sp":"B","t":"Ben de! Akşam birlikte oynayalım mı?","s":"من هم! عصر با هم بازی کنیم؟","a":"audio/tr-fa/20afaaa15a38.mp3"},{"sp":"A","t":"Tamam! Saat yedide?","s":"باشه! ساعت هفت؟","a":"audio/tr-fa/58e88fb400cc.mp3"},{"sp":"B","t":"Evet, saat yedide!","s":"بله، ساعت هفت!","a":"audio/tr-fa/19c8b051db83.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Yüzebilirim / Yüzemem","s":"می‌توانم / نمی‌توانم: ebil / abil"},"explain":"برای گفتن «می‌توانم» در ترکی به ریشه‌ی فعل **ebil** یا **abil** و بعد شناسه اضافه می‌کنیم: yüz → **yüzebilirim** (می‌توانم شنا کنم).\nهماهنگی دوتایی: بعد از e، i، ö، ü → **ebil**؛ بعد از a، ı، o، u → **abil**. مثال: koş → **koşabilirim**، çal → **çalabilirim**.\nاگر ریشه به واکه ختم شود، یک **y** وسط می‌آید: oku → **okuyabilirim**، oyna → **oynayabilirim**، söyle → **söyleyebilirim**.\nبرای «نمی‌توانم» از **eme / ama** استفاده می‌کنیم: **yüzemem** (نمی‌توانم شنا کنم)، **koşamam**. شکل منفی برای بقیه‌ی شخص‌ها کمی فرق دارد؛ جدول را ببینید.\nحالا می‌فهمید چرا در درس خرید گفتیم **Bunu alabilir miyim?** = می‌توانم این را بخرم؟","table":[["ben","yüzebilirim","yüzemem"],["sen","yüzebilirsin","yüzemezsin"],["o","yüzebilir","yüzemez"],["biz","yüzebiliriz","yüzemeyiz"],["siz","yüzebilirsiniz","yüzemezsiniz"],["onlar","yüzebilirler","yüzemezler"]],"examples":[{"t":"Ben yüzebilirim.","s":"من می‌توانم شنا کنم.","a":"audio/tr-fa/36f7d1d170f0.mp3"},{"t":"Maryam gitar çalabilir.","s":"مریم می‌تواند گیتار بزند.","a":"audio/tr-fa/ac56978656a9.mp3"},{"t":"Biz bisiklete binebiliriz.","s":"ما می‌توانیم دوچرخه‌سواری کنیم.","a":"audio/tr-fa/0c7011c136c5.mp3"},{"t":"Babam şarkı söyleyemez.","s":"پدرم نمی‌تواند آواز بخواند.","a":"audio/tr-fa/24c6299b33bf.mp3"},{"t":"Ben satranç oynayamam.","s":"من نمی‌توانم شطرنج بازی کنم.","a":"audio/tr-fa/fd1688738352.mp3"}],"exercises":[{"type":"choice","t":"Ben çok iyi ___.","options":["yüzabilirim","yüzebilirim","yüzebilir"],"answer":1,"s":"من می‌توانم خیلی خوب شنا کنم.","full":"Ben çok iyi yüzebilirim.","a":"audio/tr-fa/860bf80a1756.mp3"},{"type":"choice","t":"Ali satranç ___.","options":["oynayabilir","oynabilir","oynayebilir"],"answer":0,"s":"علی می‌تواند شطرنج بازی کند.","full":"Ali satranç oynayabilir.","a":"audio/tr-fa/09fc948e815e.mp3"},{"type":"choice","t":"Ben gitar ___.","options":["çalamaz","çalemem","çalamam"],"answer":2,"s":"من نمی‌توانم گیتار بزنم.","full":"Ben gitar çalamam.","a":"audio/tr-fa/4eae5a79b9ba.mp3"},{"type":"type","t":"Sen de ___.","answer":["koşabilirsin"],"s":"تو هم می‌توانی بدوی.","full":"Sen de koşabilirsin.","a":"audio/tr-fa/875b9f9d7a47.mp3"},{"type":"type","t":"Annem çok güzel resim ___.","answer":["yapabilir"],"s":"مادرم می‌تواند خیلی قشنگ نقاشی بکشد.","full":"Annem çok güzel resim yapabilir.","a":"audio/tr-fa/ebf28cb2fd48.mp3"},{"type":"type","t":"Ben şarkı ___.","answer":["söyleyemem"],"s":"من نمی‌توانم آواز بخوانم.","full":"Ben şarkı söyleyemem.","a":"audio/tr-fa/8ab7c25f86cc.mp3"},{"type":"order","t":"Biz bisiklete binebiliriz.","s":"ما می‌توانیم دوچرخه‌سواری کنیم.","full":"Biz bisiklete binebiliriz.","a":"audio/tr-fa/0c7011c136c5.mp3"},{"type":"order","t":"Ali yüzemez ama koşabilir.","s":"علی نمی‌تواند شنا کند ولی می‌تواند بدود.","full":"Ali yüzemez ama koşabilir.","a":"audio/tr-fa/fe8b07772568.mp3"}]},{"id":"g02","title":{"t":"Okumayı severim + mi?","s":"«… را دوست دارم» و سؤال با mi"},"explain":"برای گفتن «… کردن را دوست دارم» (به طور کلی) مصدر فعل را با **yi / yı** می‌آوریم و بعد **severim**: okumak → **okumayı severim** (خواندن را دوست دارم)، yüzmek → **yüzmeyi severim**.\nفقط دو شکل داریم: mek → **meyi** و mak → **mayı**.\nصرف sevmek در این حالت: **severim، seversin، sever، severiz، seversiniz، severler**. منفی: **sevmem** (دوست ندارم).\nسؤال بله/نه: کلمه‌ی کوچک **mi** را **جدا** می‌نویسیم و آخر جمله می‌آوریم. با هماهنگی چهارتایی: **mi / mı / mu / mü**. شناسه به mi می‌چسبد: Sever **misin**? (دوست داری؟)، Yüzebilir **misin**? (می‌توانی شنا کنی؟)، Çay istiyor **musun**? (چای می‌خواهی؟)","table":[["e / i","mi","Güzel mi?"],["a / ı","mı","Var mı?"],["o / u","mu","Soğuk mu?"],["ö / ü","mü","Büyük mü?"]],"examples":[{"t":"Kitap okumayı severim.","s":"کتاب خواندن را دوست دارم.","a":"audio/tr-fa/9f3aaa38325f.mp3"},{"t":"Yüzmeyi sever misin? Evet, çok severim.","s":"شنا کردن را دوست داری؟ بله، خیلی دوست دارم.","a":"audio/tr-fa/661f0e1f680b.mp3"},{"t":"Babam futbol oynamayı sever.","s":"پدرم فوتبال بازی کردن را دوست دارد.","a":"audio/tr-fa/c004b116f61c.mp3"},{"t":"Gitar çalabilir misin? Hayır, çalamam.","s":"می‌توانی گیتار بزنی؟ نه، نمی‌توانم.","a":"audio/tr-fa/28ea814aeb0e.mp3"},{"t":"Hava soğuk mu?","s":"هوا سرد است؟","a":"audio/tr-fa/e1ab853b6984.mp3"}],"exercises":[{"type":"choice","t":"Ben müzik ___ severim.","options":["dinlemek","dinlemeyi","dinlemayı"],"answer":1,"s":"من موسیقی گوش دادن را دوست دارم.","full":"Ben müzik dinlemeyi severim.","a":"audio/tr-fa/5a043f298cb1.mp3"},{"type":"choice","t":"Yüzmeyi sever ___?","options":["misin","mısın","musun"],"answer":0,"s":"شنا کردن را دوست داری؟","full":"Yüzmeyi sever misin?","a":"audio/tr-fa/f1785df90a1f.mp3"},{"type":"choice","t":"Çay istiyor ___?","options":["misin","müsün","musun"],"answer":2,"s":"چای می‌خواهی؟","full":"Çay istiyor musun?","a":"audio/tr-fa/b6b679fed668.mp3"},{"type":"choice","t":"Hava soğuk ___?","options":["mu","mı","mi"],"answer":0,"s":"هوا سرد است؟","full":"Hava soğuk mu?","a":"audio/tr-fa/e1ab853b6984.mp3"},{"type":"type","t":"Satranç oynayabilir ___?","answer":["misin"],"s":"می‌توانی شطرنج بازی کنی؟","full":"Satranç oynayabilir misin?","a":"audio/tr-fa/760a3a279347.mp3"},{"type":"type","t":"Annem yemek ___ sever.","answer":["yapmayı"],"s":"مادرم آشپزی کردن را دوست دارد.","full":"Annem yemek yapmayı sever.","a":"audio/tr-fa/05294d819375.mp3"},{"type":"order","t":"Kitap okumayı çok severim.","s":"کتاب خواندن را خیلی دوست دارم.","full":"Kitap okumayı çok severim.","a":"audio/tr-fa/7105b157101e.mp3"}]}],"reading":{"title":{"t":"Bizim ailede boş zaman","s":"وقت آزاد در خانواده‌ی ما","a":"audio/tr-fa/a8ecd0b8953b.mp3"},"text":[{"t":"Benim adım Maryam. Ailemde dört kişi var.","s":"اسم من مریم است. خانواده‌ی ما چهار نفر است.","a":"audio/tr-fa/09a46bf60320.mp3"},{"t":"Babam Reza satranç oynamayı çok sever.","s":"پدرم، رضا، شطرنج بازی کردن را خیلی دوست دارد.","a":"audio/tr-fa/ed99eb936d1d.mp3"},{"t":"Annem resim yapabilir; resimleri çok güzel.","s":"مادرم می‌تواند نقاشی بکشد؛ نقاشی‌هایش خیلی قشنگ است.","a":"audio/tr-fa/75b70d0ae24e.mp3"},{"t":"Kardeşim Ali futbol oynamayı sever ama yüzemez.","s":"برادرم علی فوتبال بازی کردن را دوست دارد، ولی نمی‌تواند شنا کند.","a":"audio/tr-fa/f8e66ae0da76.mp3"},{"t":"Ben kitap okumayı ve müzik dinlemeyi severim.","s":"من کتاب خواندن و موسیقی گوش دادن را دوست دارم.","a":"audio/tr-fa/7290b2e8beb7.mp3"},{"t":"Gitar da çalabilirim.","s":"گیتار هم می‌توانم بزنم.","a":"audio/tr-fa/d8c1ead729b7.mp3"},{"t":"Hafta sonu hep birlikte parka gidiyoruz ve bisiklete biniyoruz.","s":"آخر هفته همه با هم به پارک می‌رویم و دوچرخه‌سواری می‌کنیم.","a":"audio/tr-fa/05a7e88ab365.mp3"},{"t":"Sen boş zamanında ne yapmayı seversin?","s":"تو در وقت آزادت دوست داری چه کار کنی؟","a":"audio/tr-fa/590084136018.mp3"}],"questions":[{"q":{"t":"Reza ne yapmayı sever?","s":"رضا دوست دارد چه کار کند؟","a":"audio/tr-fa/fbc9a93e6183.mp3"},"options":["Yüzmeyi","Satranç oynamayı","Gitar çalmayı"],"answer":1},{"q":{"t":"Ali yüzebilir mi?","s":"علی می‌تواند شنا کند؟","a":"audio/tr-fa/9fbd443a155f.mp3"},"options":["Evet, yüzebilir.","Evet, çok sever.","Hayır, yüzemez."],"answer":2},{"q":{"t":"Kim gitar çalabilir?","s":"چه کسی می‌تواند گیتار بزند؟","a":"audio/tr-fa/88e6e1647f0a.mp3"},"options":["Maryam","Ali","Reza"],"answer":0},{"q":{"t":"Hafta sonu nereye gidiyorlar?","s":"آخر هفته کجا می‌روند؟","a":"audio/tr-fa/5aaf937a8ecb.mp3"},"options":["Denize","Parka","Sinemaya"],"answer":1}]},"sentences":[{"t":"Ben yüzebilirim ama gitar çalamam.","s":"من می‌توانم شنا کنم، ولی نمی‌توانم گیتار بزنم.","a":"audio/tr-fa/7c927739eb7a.mp3"},{"t":"Kitap okumayı severim.","s":"کتاب خواندن را دوست دارم.","a":"audio/tr-fa/9f3aaa38325f.mp3"},{"t":"Futbol oynamayı sever misin?","s":"فوتبال بازی کردن را دوست داری؟","a":"audio/tr-fa/cd21b3156b97.mp3"},{"t":"Babam her sabah koşuyor.","s":"پدرم هر صبح می‌دود.","a":"audio/tr-fa/1c6b1f2c8f15.mp3"},{"t":"Akşam sinemaya gidiyoruz.","s":"عصر به سینما می‌رویم.","a":"audio/tr-fa/a4d55f30c473.mp3"},{"t":"Satranç oynayabilir misin?","s":"می‌توانی شطرنج بازی کنی؟","a":"audio/tr-fa/760a3a279347.mp3"},{"t":"Çocuklar parkta bisiklete biniyor.","s":"بچه‌ها در پارک دوچرخه‌سواری می‌کنند.","a":"audio/tr-fa/23bd516831f7.mp3"},{"t":"Annem şarkı söylemeyi çok sever.","s":"مادرم آواز خواندن را خیلی دوست دارد.","a":"audio/tr-fa/6a7f2168d950.mp3"}],"img":"img/e/1f3a8.svg"}