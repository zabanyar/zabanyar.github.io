1ab4b641.mp3"},{"id":"w10","t":"Türk","s":"ترک، اهل ترکیه","pr":"تورک","emoji":"","ex":{"t":"Mehmet Türk.","s":"مهمت ترک است.","a":"audio/tr-fa/fed29abad6b1.mp3"},"img":null,"a":"audio/tr-fa/3f03bdde66e7.mp3"},{"id":"w11","t":"öğrenci","pl":"öğrenciler","s":"دانش‌آموز، دانشجو","pr":"اُرِنجی","emoji":"🎒","ex":{"t":"Ben öğrenciyim.","s":"من دانش‌آموز هستم.","a":"audio/tr-fa/479a2c90ba2a.mp3"},"img":"img/e/1f392.svg","a":"audio/tr-fa/477b824c9b19.mp3","pla":"audio/tr-fa/279292aebdb0.mp3"},{"id":"w12","t":"öğretmen","pl":"öğretmenler","s":"معلم","pr":"اُرِتمِن","emoji":"","ex":{"t":"Ayşe öğretmen.","s":"آیشه معلم است.","a":"audio/tr-fa/e5796e01012a.mp3"},"img":null,"a":"audio/tr-fa/48d03c8221d8.mp3","pla":"audio/tr-fa/7b7b41bed0ee.mp3"},{"id":"w13","t":"doktor","pl":"doktorlar","s":"دکتر، پزشک","pr":"دُکتُر","emoji":"🩺","ex":{"t":"Reza doktor.","s":"رضا دکتر است.","a":"audio/tr-fa/4d807900fab3.mp3"},"img":"img/e/1fa7a.svg","a":"audio/tr-fa/6e70c5a2e07a.mp3","pla":"audio/tr-fa/3518fde4eb32.mp3"},{"id":"w14","t":"de / da","s":"هم (جدا نوشته می‌شود)","pr":"دِه / دا","emoji":"","ex":{"t":"Ben de öğrenciyim.","s":"من هم دانش‌آموز هستم.","a":"audio/tr-fa/b86cd3250e30.mp3"},"img":null,"a":"audio/tr-fa/4323a7af497f.mp3"}],"phrases":[{"id":"p01","t":"Günaydın!","s":"صبح بخیر!","pr":"گونایدِن!","a":"audio/tr-fa/e537b1bea582.mp3"},{"id":"p02","t":"Nasılsın?","s":"حالت چطور است؟","pr":"ناسِلسِن؟","a":"audio/tr-fa/2b13646a8ef5.mp3"},{"id":"p03","t":"İyiyim, teşekkürler.","s":"خوبم، ممنون.","pr":"ای‌یی‌ییم، تِشِکّورلِر","a":"audio/tr-fa/7a5fef8222a1.mp3"},{"id":"p04","t":"Adın ne?","s":"اسمت چیست؟","pr":"آدِن نِه؟","a":"audio/tr-fa/88f8f5f035b4.mp3"},{"id":"p05","t":"Nerelisin?","s":"اهل کجایی؟","pr":"نِرِلیسین؟","a":"audio/tr-fa/0d2af2d3faff.mp3"},{"id":"p06","t":"Memnun oldum.","s":"از آشنایی‌ات خوشحال شدم.","pr":"مِمنون اُلدوم","a":"audio/tr-fa/3ab24e45c4ad.mp3"},{"id":"p07","t":"Görüşürüz!","s":"به امید دیدار!","pr":"گُروشوروز!","a":"audio/tr-fa/1a96fa7c4b94.mp3"},{"id":"p08","t":"Hoşça kal!","s":"خداحافظ! (کسی که می‌رود می‌گوید)","pr":"هُشچا کال!","a":"audio/tr-fa/445aa6add24c.mp3"}],"dialogue":{"title":{"t":"Tanışma","s":"آشنایی","a":"audio/tr-fa/a3ad93364c68.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"Merhaba!","s":"سلام!","a":"audio/tr-fa/0b64969b8f71.mp3"},{"sp":"B","t":"Merhaba! Nasılsın?","s":"سلام! حالت چطور است؟","a":"audio/tr-fa/186d489efe4c.mp3"},{"sp":"A","t":"İyiyim, teşekkürler. Sen nasılsın?","s":"خوبم، ممنون. تو چطوری؟","a":"audio/tr-fa/acced086dd4f.mp3"},{"sp":"B","t":"Ben de iyiyim. Adın ne?","s":"من هم خوبم. اسمت چیست؟","a":"audio/tr-fa/c271dd1354d2.mp3"},{"sp":"A","t":"Adım Sara. Ya sen?","s":"اسمم ساراست. تو چطور؟","a":"audio/tr-fa/4c865472dc7d.mp3"},{"sp":"B","t":"Ben Mehmet. Nerelisin, Sara?","s":"من مهمت هستم. اهل کجایی، سارا؟","a":"audio/tr-fa/1db0140aac05.mp3"},{"sp":"A","t":"İranlıyım. Tahranlıyım. Sen nerelisin?","s":"ایرانی هستم. تهرانی‌ام. تو اهل کجایی؟","a":"audio/tr-fa/f654937af7cd.mp3"},{"sp":"B","t":"Ben İstanbulluyum. Memnun oldum!","s":"من استانبولی هستم. از آشنایی‌ات خوشحال شدم!","a":"audio/tr-fa/097d07ff4d52.mp3"},{"sp":"A","t":"Ben de memnun oldum. Görüşürüz!","s":"من هم خوشحال شدم. به امید دیدار!","a":"audio/tr-fa/94225fd42653.mp3"},{"sp":"B","t":"Görüşürüz, Sara!","s":"به امید دیدار، سارا!","a":"audio/tr-fa/16240adc0bbb.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Öğretmenim, öğretmensin","s":"پسوندهای «بودن»: هستم، هستی، هستیم..."},"explain":"در ترکی «بودن» یک کلمه‌ی جدا نیست؛ یک **پسوند** کوچک است که به آخر کلمه می‌چسبد. درست مثل فارسی که می‌گوییم «معلم‌ام» یا «معلمی»!\n**öğretmen** (معلم) ← **öğretmenim** (معلمم)، **öğretmensin** (معلمی).\nحرف صدادارِ پسوند از **آخرین حرف صدادارِ کلمه** پیروی می‌کند:\n**a، ı ← ı** | **e، i ← i** | **o، u ← u** | **ö، ü ← ü**\nاگر کلمه با حرف صدادار تمام شود، برای «من» و «ما» یک **y** اضافه می‌شود: **İranlıyım**، **öğrenciyiz**.\nبرای «او» و «آن‌ها» معمولاً پسوندی نمی‌گوییم: **O doktor.** (او دکتر است.) کلمه‌ی **o** هم برای مرد است و هم برای زن، درست مثل «او» در فارسی.","table":[["ben","İranlıyım","Türküm"],["sen","İranlısın","Türksün"],["o","İranlı","Türk"],["biz","İranlıyız","Türküz"],["siz","İranlısınız","Türksünüz"],["onlar","İranlı","Türk"]],"examples":[{"t":"Ben öğretmenim.","s":"من معلم هستم.","a":"audio/tr-fa/3e4e56849394.mp3"},{"t":"Sen öğrencisin.","s":"تو دانش‌آموز هستی.","a":"audio/tr-fa/723cf357b15c.mp3"},{"t":"Biz İranlıyız.","s":"ما ایرانی هستیم.","a":"audio/tr-fa/e3cff57f24be.mp3"},{"t":"Ali doktor.","s":"علی دکتر است.","a":"audio/tr-fa/60887a05172e.mp3"},{"t":"Siz Türksünüz.","s":"شما ترک هستید.","a":"audio/tr-fa/0a6f42967b1b.mp3"}],"exercises":[{"type":"choice","t":"Ben öğretmen___.","options":["im","ım","um"],"answer":0,"s":"من معلم هستم.","full":"Ben öğretmenim.","a":"audio/tr-fa/3e4e56849394.mp3"},{"type":"choice","t":"Sen Türk___.","options":["sın","sün","sin"],"answer":1,"s":"تو ترک هستی.","full":"Sen Türksün.","a":"audio/tr-fa/b213a5310133.mp3"},{"type":"choice","t":"Biz İranlı___.","options":["yız","ız","yiz"],"answer":0,"s":"ما ایرانی هستیم.","full":"Biz İranlıyız.","a":"audio/tr-fa/e3cff57f24be.mp3"},{"type":"type","t":"Ben doktor___.","answer":["um"],"s":"من دکتر هستم.","full":"Ben doktorum.","a":"audio/tr-fa/5b5d36ad2751.mp3"},{"type":"type","t":"Siz öğrenci___.","answer":["siniz"],"s":"شما دانش‌آموز هستید.","full":"Siz öğrencisiniz.","a":"audio/tr-fa/69ed7fe2a32b.mp3"},{"type":"choice","t":"___ öğretmeniz.","options":["Ben","Biz","Siz"],"answer":1,"s":"ما معلم هستیم.","full":"Biz öğretmeniz.","a":"audio/tr-fa/070abe256481.mp3"},{"type":"order","t":"Merhaba, ben Ali'yim.","s":"سلام، من علی هستم.","full":"Merhaba, ben Ali'yim.","a":"audio/tr-fa/b3eb40e4db88.mp3"},{"type":"order","t":"O iyi bir doktor.","s":"او یک دکتر خوب است.","full":"O iyi bir doktor.","a":"audio/tr-fa/e2efe3f6052d.mp3"}]},{"id":"g02","title":{"t":"Nerelisin? -lı / -li / -lu / -lü","s":"اهل کجایی؟ پسوند -lı"},"explain":"برای گفتنِ اینکه اهل کجا هستیم، به اسم شهر یا کشور پسوند **-lı / -li / -lu / -lü** اضافه می‌کنیم. این خیلی شبیه «ـی» در فارسی است: تهران ← تهرانی.\n**Tahran ← Tahranlı** (تهرانی)، **İzmir ← İzmirli** (ازمیری)، **İstanbul ← İstanbullu** (استانبولی).\nحرف صدادارِ پسوند باز هم از آخرین حرف صدادارِ کلمه پیروی می‌کند. بعد پسوند «بودن» را اضافه می‌کنیم: **Tahranlıyım** = تهرانی هستم.\nسؤال: **Nerelisin?** = اهل کجایی؟ و مؤدبانه: **Nerelisiniz?** = اهل کجا هستید؟","table":[["Tahran","Tahranlı","Tahranlıyım"],["İzmir","İzmirli","İzmirliyim"],["İstanbul","İstanbullu","İstanbulluyum"],["Şiraz","Şirazlı","Şirazlıyım"]],"examples":[{"t":"Nerelisin? — Tahranlıyım.","s":"اهل کجایی؟ — تهرانی هستم.","a":"audio/tr-fa/b287ff5dda1c.mp3"},{"t":"Ayşe İstanbullu.","s":"آیشه استانبولی است.","a":"audio/tr-fa/e04cab11945d.mp3"},{"t":"Biz Tebrizliyiz.","s":"ما تبریزی هستیم.","a":"audio/tr-fa/b6cc8e686374.mp3"},{"t":"Mehmet İzmirli.","s":"مهمت ازمیری است.","a":"audio/tr-fa/e348c459986a.mp3"}],"exercises":[{"type":"choice","t":"Ben Tahran___.","options":["lıyım","liyim","luyum"],"answer":0,"s":"من تهرانی هستم.","full":"Ben Tahranlıyım.","a":"audio/tr-fa/b2df1576efec.mp3"},{"type":"choice","t":"Ayşe İstanbul___.","options":["lı","lu","lü"],"answer":1,"s":"آیشه استانبولی است.","full":"Ayşe İstanbullu.","a":"audio/tr-fa/e04cab11945d.mp3"},{"type":"type","t":"Biz İzmir___.","answer":["liyiz"],"s":"ما ازمیری هستیم.","full":"Biz İzmirliyiz.","a":"audio/tr-fa/df06163598f6.mp3"},{"type":"type","t":"Mehmet Ankara___.","answer":["lı"],"s":"مهمت اهل آنکارا است.","full":"Mehmet Ankaralı.","a":"audio/tr-fa/72b7727a0292.mp3"},{"type":"choice","t":"Nereli___?","options":["sin","sın","sun"],"answer":0,"s":"اهل کجایی؟","full":"Nerelisin?","a":"audio/tr-fa/0d2af2d3faff.mp3"},{"type":"order","t":"Maryam İsfahanlı bir öğretmen.","s":"مریم یک معلم اصفهانی است.","full":"Maryam İsfahanlı bir öğretmen.","a":"audio/tr-fa/569aa2f4a9d8.mp3"}]}],"reading":{"title":{"t":"Merhaba! Ben Reza.","s":"سلام! من رضا هستم.","a":"audio/tr-fa/54505448d22c.mp3"},"text":[{"t":"Merhaba! Adım Reza.","s":"سلام! اسم من رضا است.","a":"audio/tr-fa/c5aec5ee4394.mp3"},{"t":"Ben İranlıyım, Tebrizliyim.","s":"من ایرانی هستم، تبریزی هستم.","a":"audio/tr-fa/c849465bf242.mp3"},{"t":"Ben doktorum.","s":"من دکتر هستم.","a":"audio/tr-fa/5b5d36ad2751.mp3"},{"t":"Maryam da İranlı.","s":"مریم هم ایرانی است.","a":"audio/tr-fa/a44dc4d6c85c.mp3"},{"t":"O Şirazlı. O öğretmen.","s":"او شیرازی است. او معلم است.","a":"audio/tr-fa/5278b6790ad8.mp3"},{"t":"Ayşe Türk, İstanbullu.","s":"آیشه ترک است، استانبولی است.","a":"audio/tr-fa/5c412f6a5031.mp3"},{"t":"Ayşe öğrenci.","s":"آیشه دانشجو است.","a":"audio/tr-fa/9fe39731a752.mp3"}],"questions":[{"q":{"t":"Reza nereli?","s":"رضا اهل کجاست؟","a":"audio/tr-fa/daef56a2e998.mp3"},"options":["Tebrizli","Şirazlı","İstanbullu"],"answer":0},{"q":{"t":"Kim öğretmen?","s":"چه کسی معلم است؟","a":"audio/tr-fa/02921a354f38.mp3"},"options":["Reza","Maryam","Ayşe"],"answer":1},{"q":{"t":"Ayşe nereli?","s":"آیشه اهل کجاست؟","a":"audio/tr-fa/d4a9953a09eb.mp3"},"options":["Tahranlı","İstanbullu","Tebrizli"],"answer":1},{"q":{"t":"Kim doktor?","s":"چه کسی دکتر است؟","a":"audio/tr-fa/b1da213916a8.mp3"},"options":["Ayşe","Maryam","Reza"],"answer":2}]},"sentences":[{"t":"Merhaba, adım Ali.","s":"سلام، اسم من علی است.","a":"audio/tr-fa/c8aa2e76e6a2.mp3"},{"t":"Ben İranlıyım.","s":"من ایرانی هستم.","a":"audio/tr-fa/e3e397867b99.mp3"},{"t":"İyiyim, teşekkürler.","s":"خوبم، ممنون.","a":"audio/tr-fa/7a5fef8222a1.mp3"},{"t":"Ayşe Türk, Mehmet de Türk.","s":"آیشه ترک است، مهمت هم ترک است.","a":"audio/tr-fa/bf76bde77fe7.mp3"},{"t":"Biz öğrenciyiz.","s":"ما دانش‌آموز هستیم.","a":"audio/tr-fa/b177f3439539.mp3"},{"t":"Siz nerelisiniz?","s":"شما اهل کجا هستید؟","a":"audio/tr-fa/d406ecc294b0.mp3"},{"t":"Memnun oldum, Elif!","s":"از آشنایی‌ات خوشحال شدم، الیف!","a":"audio/tr-fa/abc44578bffa.mp3"},{"t":"O bir öğretmen.","s":"او یک معلم است.","a":"audio/tr-fa/5aad816b002a.mp3"}],"img":"img/e/1f44b.svg"}