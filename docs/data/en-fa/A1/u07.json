{"id":"u07","level":"A1","emoji":"🏙️","title":{"t":"In the city","s":"در شهر","a":"audio/en-fa/8bb3ab5c7d06.mp3"},"goals":["می‌توانم مکان‌های شهر را نام ببرم.","می‌توانم بپرسم یک جا کجاست.","می‌توانم آدرس ساده بدهم: مستقیم بروید، به چپ بپیچید."],"words":[{"id":"w01","t":"city","pl":"cities","s":"شهر","pr":"سیتی","emoji":"🏙️","ex":{"t":"Tehran is a big city.","s":"تهران شهر بزرگی است.","a":"audio/en-fa/2bba1b7d6229.mp3"},"img":"img/e/1f3d9.svg","a":"audio/en-fa/d47c047a5558.mp3","pla":"audio/en-fa/1209a2e82431.mp3"},{"id":"w02","t":"street","pl":"streets","s":"خیابان","pr":"سْتْریت","emoji":"🛣️","ex":{"t":"My house is on Hafez Street.","s":"خانهٔ من در خیابان حافظ است.","a":"audio/en-fa/64881114354b.mp3"},"img":"img/e/1f6e3.svg","a":"audio/en-fa/26f0f9162f98.mp3","pla":"audio/en-fa/db00d67018c7.mp3"},{"id":"w03","t":"bank","pl":"banks","s":"بانک","pr":"بَنک","emoji":"🏦","ex":{"t":"The bank is next to the park.","s":"بانک کنار پارک است.","a":"audio/en-fa/804874176d47.mp3"},"img":"img/e/1f3e6.svg","a":"audio/en-fa/1f8505001dc9.mp3","pla":"audio/en-fa/434c80089f3d.mp3"},{"id":"w04","t":"hospital","pl":"hospitals","s":"بیمارستان","pr":"هاسپیتال","emoji":"🏥","ex":{"t":"Maryam works at a hospital.","s":"مریم در یک بیمارستان کار می‌کند.","a":"audio/en-fa/297906506202.mp3"},"img":"img/e/1f3e5.svg","a":"audio/en-fa/a9984448bcaa.mp3","pla":"audio/en-fa/634355d14fef.mp3"},{"id":"w05","t":"park","pl":"parks","s":"پارک","pr":"پارک","emoji":"🌳","ex":{"t":"There is a big park in our city.","s":"در شهر ما یک پارک بزرگ هست.","a":"audio/en-fa/b0d4afd1c2ba.mp3"},"img":"img/e/1f333.svg","a":"audio/en-fa/c8abcdc935eb.mp3","pla":"audio/en-fa/d65d9abccc7b.mp3"},{"id":"w06","t":"supermarket","pl":"supermarkets","s":"سوپرمارکت","pr":"سوپِرمارکِت","emoji":"🛒","ex":{"t":"Is there a supermarket near here?","s":"این نزدیکی سوپرمارکت هست؟","a":"audio/en-fa/c119c624ffb5.mp3"},"img":"img/e/1f6d2.svg","a":"audio/en-fa/e100baa3b8f9.mp3","pla":"audio/en-fa/88b1dee6f46d.mp3"},{"id":"w07","t":"restaurant","pl":"restaurants","s":"رستوران","pr":"رِسْتِرانت","emoji":"🍴","ex":{"t":"We have dinner at a restaurant.","s":"ما در یک رستوران شام می‌خوریم.","a":"audio/en-fa/dfa1d4af36b6.mp3"},"img":"img/e/1f374.svg","a":"audio/en-fa/4975ff16e1ea.mp3","pla":"audio/en-fa/a9dada60f8a6.mp3"},{"id":"w08","t":"pharmacy","pl":"pharmacies","s":"داروخانه","pr":"فارمِسی","emoji":"💊","ex":{"t":"The pharmacy is opposite the hospital.","s":"داروخانه روبه‌روی بیمارستان است.","a":"audio/en-fa/46ac228f7ceb.mp3"},"img":"img/e/1f48a.svg","a":"audio/en-fa/77b32bfaa4b1.mp3","pla":"audio/en-fa/9ffd534c0a7f.mp3"},{"id":"w09","t":"post office","pl":"post offices","s":"ادارهٔ پست","pr":"پوست آفیس","emoji":"🏤","ex":{"t":"Where is the post office?","s":"ادارهٔ پست کجاست؟","a":"audio/en-fa/2fb25ede6f8d.mp3"},"img":"img/e/1f3e4.svg","a":"audio/en-fa/f985b036cdc8.mp3","pla":"audio/en-fa/fd8ac8dfd8f9.mp3"},{"id":"w10","t":"mosque","pl":"mosques","s":"مسجد","pr":"ماسک","emoji":"🕌","ex":{"t":"There is a mosque near my house.","s":"نزدیک خانه‌ام یک مسجد هست.","a":"audio/en-fa/79e40ac9504c.mp3"},"img":"img/e/1f54c.svg","a":"audio/en-fa/ff63118362ef.mp3","pla":"audio/en-fa/a28d06bad3d8.mp3"},{"id":"w11","t":"bus stop","pl":"bus stops","s":"ایستگاه اتوبوس","pr":"باس سْتاپ","emoji":"🚏","ex":{"t":"The bus stop is next to the bank.","s":"ایستگاه اتوبوس کنار بانک است.","a":"audio/en-fa/9449d97643b9.mp3"},"img":"img/e/1f68f.svg","a":"audio/en-fa/8e07d69eb44b.mp3","pla":"audio/en-fa/54001537b0da.mp3"},{"id":"w12","t":"train station","pl":"train stations","s":"ایستگاه قطار","pr":"تْرِین سْتِیشِن","emoji":"🚉","ex":{"t":"The train station is near the park.","s":"ایستگاه قطار نزدیک پارک است.","a":"audio/en-fa/3cb0e8c3692f.mp3"},"img":"img/e/1f689.svg","a":"audio/en-fa/8b5ddc3720a3.mp3","pla":"audio/en-fa/26a846ff5cd5.mp3"},{"id":"w13","t":"left","s":"چپ","pr":"لِفت","emoji":"⬅️","ex":{"t":"Turn left at the bank.","s":"سرِ بانک به چپ بپیچید.","a":"audio/en-fa/09ab16f9da08.mp3"},"img":"img/e/2b05.svg","a":"audio/en-fa/ec14101fd56c.mp3"},{"id":"w14","t":"right","s":"راست","pr":"رایت","emoji":"➡️","ex":{"t":"Turn right at the park.","s":"سرِ پارک به راست بپیچید.","a":"audio/en-fa/1597ce3ba803.mp3"},"img":"img/e/27a1.svg","a":"audio/en-fa/e10f9e032723.mp3"}],"phrases":[{"id":"p01","t":"Excuse me.","s":"ببخشید.","pr":"اِکسکیوز می","a":"audio/en-fa/926e657455d2.mp3"},{"id":"p02","t":"Where is the bank?","s":"بانک کجاست؟","pr":"وِر ایز ذِ بَنک؟","a":"audio/en-fa/55d8d3ed1a24.mp3"},{"id":"p03","t":"Is it far?","s":"دور است؟","pr":"ایز ایت فار؟","a":"audio/en-fa/278b7f6af7ef.mp3"},{"id":"p04","t":"Go straight.","s":"مستقیم بروید.","pr":"گو سْتْرِیت","a":"audio/en-fa/9c1f78a33a4b.mp3"},{"id":"p05","t":"Turn left.","s":"به چپ بپیچید.","pr":"تِرن لِفت","a":"audio/en-fa/240af4fa6496.mp3"},{"id":"p06","t":"Take the first street on the right.","s":"از اولین خیابانِ سمت راست بروید.","pr":"تِیک ذِ فِرست سْتْریت آن ذِ رایت","a":"audio/en-fa/4e85380e3cf3.mp3"},{"id":"p07","t":"Thank you very much!","s":"خیلی ممنون!","pr":"ثَنک یو وِری ماچ!","a":"audio/en-fa/74f70b4ec2a6.mp3"},{"id":"p08","t":"You're welcome.","s":"خواهش می‌کنم.","pr":"یور وِلکام","a":"audio/en-fa/eb8e8444be81.mp3"}],"dialogue":{"title":{"t":"Where is the post office?","s":"ادارهٔ پست کجاست؟","a":"audio/en-fa/2fb25ede6f8d.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Tom","voice":"m"}},"lines":[{"sp":"A","t":"Excuse me. Where is the post office?","s":"ببخشید. ادارهٔ پست کجاست؟","a":"audio/en-fa/513d7d19fee1.mp3"},{"sp":"B","t":"The post office? It's near the park.","s":"ادارهٔ پست؟ نزدیک پارک است.","a":"audio/en-fa/ba46fd816b2a.mp3"},{"sp":"A","t":"Is it far?","s":"دور است؟","a":"audio/en-fa/278b7f6af7ef.mp3"},{"sp":"B","t":"No, it isn't. Go straight and turn left at the bank.","s":"نه، دور نیست. مستقیم بروید و سرِ بانک به چپ بپیچید.","a":"audio/en-fa/8bd687ae7bb4.mp3"},{"sp":"A","t":"Turn left at the bank. OK.","s":"سرِ بانک به چپ. باشه.","a":"audio/en-fa/8bd5d993fff0.mp3"},{"sp":"B","t":"The post office is opposite the supermarket.","s":"ادارهٔ پست روبه‌روی سوپرمارکت است.","a":"audio/en-fa/0b07f1aa251f.mp3"},{"sp":"A","t":"And is there a pharmacy near here?","s":"این نزدیکی داروخانه هم هست؟","a":"audio/en-fa/9b2402025de0.mp3"},{"sp":"B","t":"Yes, there is. It's next to the post office.","s":"بله، هست. کنار ادارهٔ پست است.","a":"audio/en-fa/2c1f2dae77db.mp3"},{"sp":"A","t":"Thank you very much!","s":"خیلی ممنون!","a":"audio/en-fa/74f70b4ec2a6.mp3"},{"sp":"B","t":"You're welcome.","s":"خواهش می‌کنم.","a":"audio/en-fa/71f6b91f9cbe.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Go straight. Turn left.","s":"فعل امری (راهنمایی کردن)"},"explain":"برای آدرس دادن یا خواهش کردن، فعل را **بدون فاعل** و در اول جمله می‌گوییم: **Go straight.** (مستقیم بروید.) **Turn left.** (به چپ بپیچید.)\nدر انگلیسی فعل امری برای «تو» و «شما» یکی است.\nبرای منفی، **Don't** را اول جمله می‌گذاریم: **Don't turn right.** (به راست نپیچید.)\nبا **please** جمله مؤدبانه‌تر می‌شود: **Turn left, please.**","table":[["go","Go straight."],["turn","Turn left. / Turn right."],["don't + verb","Don't turn right."]],"examples":[{"t":"Go straight.","s":"مستقیم بروید.","a":"audio/en-fa/9c1f78a33a4b.mp3"},{"t":"Turn left at the bank.","s":"سرِ بانک به چپ بپیچید.","a":"audio/en-fa/09ab16f9da08.mp3"},{"t":"Turn right, please.","s":"لطفاً به راست بپیچید.","a":"audio/en-fa/b13bad0bb349.mp3"},{"t":"Don't turn left. Go straight.","s":"به چپ نپیچید. مستقیم بروید.","a":"audio/en-fa/1f61dc1146c8.mp3"}],"exercises":[{"type":"choice","t":"___ straight.","options":["Goes","Go","Going"],"answer":1,"s":"مستقیم بروید.","full":"Go straight.","a":"audio/en-fa/9c1f78a33a4b.mp3"},{"type":"choice","t":"Turn ___ at the park.","options":["right","straight","opposite"],"answer":0,"s":"سرِ پارک به راست بپیچید.","full":"Turn right at the park.","a":"audio/en-fa/1597ce3ba803.mp3"},{"type":"type","t":"___ left at the hospital.","answer":["Turn"],"s":"سرِ بیمارستان به چپ بپیچید.","full":"Turn left at the hospital.","a":"audio/en-fa/66b158f57c77.mp3"},{"type":"choice","t":"___ turn right. Go straight.","options":["Not","No","Don't"],"answer":2,"s":"به راست نپیچید. مستقیم بروید.","full":"Don't turn right. Go straight.","a":"audio/en-fa/4b249f7804cf.mp3"},{"type":"order","t":"Go straight and turn left.","s":"مستقیم بروید و به چپ بپیچید.","full":"Go straight and turn left.","a":"audio/en-fa/f0ab3c061c0c.mp3"},{"type":"order","t":"Turn right at the bank.","s":"سرِ بانک به راست بپیچید.","full":"Turn right at the bank.","a":"audio/en-fa/dc67d8339400.mp3"},{"type":"type","t":"Go ___ and turn right.","answer":["straight"],"s":"مستقیم بروید و به راست بپیچید.","full":"Go straight and turn right.","a":"audio/en-fa/ece188f72419.mp3"}]},{"id":"g02","title":{"t":"Where is …? near / opposite","s":"… کجاست؟ نزدیکِ / روبه‌رویِ"},"explain":"برای پرسیدن جای یک مکان می‌گوییم: **Where is the bank?** (بانک کجاست؟) مؤدبانه‌تر: **Excuse me, where is …?**\nدر جواب می‌توانیم بگوییم: **It's near the park.** (نزدیک پارک است.) **It's opposite the hospital.** (روبه‌روی بیمارستان است.) **It's next to the bank.** (کنار بانک است.)\n**near** یعنی «نزدیکِ» و **opposite** یعنی «روبه‌رویِ».","table":[["near","It's near the park."],["opposite","It's opposite the bank."],["next to","It's next to the school."]],"examples":[{"t":"Where is the post office? It's near the bank.","s":"ادارهٔ پست کجاست؟ نزدیک بانک است.","a":"audio/en-fa/1faa5735df38.mp3"},{"t":"The pharmacy is opposite the hospital.","s":"داروخانه روبه‌روی بیمارستان است.","a":"audio/en-fa/46ac228f7ceb.mp3"},{"t":"The bus stop is next to the park.","s":"ایستگاه اتوبوس کنار پارک است.","a":"audio/en-fa/c97e8ed1b3d7.mp3"},{"t":"Is there a restaurant near here?","s":"این نزدیکی رستوران هست؟","a":"audio/en-fa/9605466511c2.mp3"}],"exercises":[{"type":"choice","t":"___ is the bank?","options":["Where","What","How"],"answer":0,"s":"بانک کجاست؟","full":"Where is the bank?","a":"audio/en-fa/55d8d3ed1a24.mp3"},{"type":"choice","t":"The park is ___ the school.","options":["near","opposite","under"],"answer":1,"s":"پارک روبه‌روی مدرسه است.","full":"The park is opposite the school.","a":"audio/en-fa/76b5f7bdb037.mp3"},{"type":"type","t":"The pharmacy is ___ the bank.","answer":["near"],"s":"داروخانه نزدیک بانک است.","full":"The pharmacy is near the bank.","a":"audio/en-fa/2a3e08fdca50.mp3"},{"type":"choice","t":"The mosque is next ___ the park.","options":["at","of","to"],"answer":2,"s":"مسجد کنار پارک است.","full":"The mosque is next to the park.","a":"audio/en-fa/f9ac0a38f4b9.mp3"},{"type":"order","t":"Where is the train station?","s":"ایستگاه قطار کجاست؟","full":"Where is the train station?","a":"audio/en-fa/a9426236d0a8.mp3"},{"type":"type","t":"___ is the post office?","answer":["Where"],"s":"ادارهٔ پست کجاست؟","full":"Where is the post office?","a":"audio/en-fa/2fb25ede6f8d.mp3"},{"type":"order","t":"The bank is opposite the hospital.","s":"بانک روبه‌روی بیمارستان است.","full":"The bank is opposite the hospital.","a":"audio/en-fa/55f4e759a337.mp3"}]}],"reading":{"title":{"t":"My street","s":"خیابان من","a":"audio/en-fa/e388a5c3e37d.mp3"},"text":[{"t":"Hello! I am Neda. I am from Shiraz.","s":"سلام! من ندا هستم. من اهل شیراز هستم.","a":"audio/en-fa/c7faf754df20.mp3"},{"t":"Shiraz is a big city.","s":"شیراز شهر بزرگی است.","a":"audio/en-fa/7e174cf656df.mp3"},{"t":"My house is on Hafez Street.","s":"خانهٔ من در خیابان حافظ است.","a":"audio/en-fa/64881114354b.mp3"},{"t":"There is a park opposite my house.","s":"روبه‌روی خانهٔ من یک پارک هست.","a":"audio/en-fa/3541abd79e19.mp3"},{"t":"The supermarket is next to the park.","s":"سوپرمارکت کنار پارک است.","a":"audio/en-fa/d40a3ebb771b.mp3"},{"t":"There is a mosque near the supermarket.","s":"نزدیک سوپرمارکت یک مسجد هست.","a":"audio/en-fa/d5809f99803d.mp3"},{"t":"The bus stop is next to the mosque.","s":"ایستگاه اتوبوس کنار مسجد است.","a":"audio/en-fa/3f29d543cae2.mp3"},{"t":"My school is not near my house.","s":"مدرسهٔ من نزدیک خانه‌ام نیست.","a":"audio/en-fa/ea987c45d271.mp3"}],"questions":[{"q":{"t":"Where is Neda from?","s":"ندا اهل کجاست؟","a":"audio/en-fa/8cd4ee0723d5.mp3"},"options":["Shiraz","Tehran","Isfahan"],"answer":0},{"q":{"t":"What is opposite Neda's house?","s":"روبه‌روی خانهٔ ندا چه چیزی هست؟","a":"audio/en-fa/42ff0437b266.mp3"},"options":["a bank","a park","a mosque"],"answer":1},{"q":{"t":"Where is the supermarket?","s":"سوپرمارکت کجاست؟","a":"audio/en-fa/2fd020e68561.mp3"},"options":["opposite the school","near the bank","next to the park"],"answer":2},{"q":{"t":"Is Neda's school near her house?","s":"آیا مدرسهٔ ندا نزدیک خانه‌اش است؟","a":"audio/en-fa/58eba98b7c0e.mp3"},"options":["Yes, it is.","No, it isn't."],"answer":1}]},"sentences":[{"t":"Excuse me, where is the hospital?","s":"ببخشید، بیمارستان کجاست؟","a":"audio/en-fa/49c5484cc5da.mp3"},{"t":"The bank is opposite the park.","s":"بانک روبه‌روی پارک است.","a":"audio/en-fa/cdd49e2656ee.mp3"},{"t":"Go straight and turn right.","s":"مستقیم بروید و به راست بپیچید.","a":"audio/en-fa/ece188f72419.mp3"},{"t":"The pharmacy is near the train station.","s":"داروخانه نزدیک ایستگاه قطار است.","a":"audio/en-fa/ac70287b248c.mp3"},{"t":"Don't turn left.","s":"به چپ نپیچید.","a":"audio/en-fa/32f6d60487a3.mp3"},{"t":"Is there a restaurant near here?","s":"این نزدیکی رستوران هست؟","a":"audio/en-fa/9605466511c2.mp3"},{"t":"The bus stop is next to the mosque.","s":"ایستگاه اتوبوس کنار مسجد است.","a":"audio/en-fa/3f29d543cae2.mp3"}],"img":"img/e/1f3d9.svg"}