{"id":"u03","level":"A1","emoji":"👪","title":{"t":"My family","s":"خانوادهٔ من","a":"audio/en-fa/c4b6338268a9.mp3"},"goals":["اعضای خانواده را نام ببرم.","با my، your، his، her، our و their بگویم چیزی مال کیست.","با 's مالکیت را نشان بدهم، مثل Sara's brother.","با have و has بگویم چه کسانی را دارم."],"words":[{"id":"w01","t":"family","pl":"families","s":"خانواده","pr":"فَمیلی","emoji":"👪","ex":{"t":"This is my family.","s":"این خانوادهٔ من است.","a":"audio/en-fa/ad0fa57c0e8b.mp3"},"img":"img/e/1f46a.svg","a":"audio/en-fa/111f080b890e.mp3","pla":"audio/en-fa/6ae92e3f9d02.mp3"},{"id":"w02","t":"mother","pl":"mothers","s":"مادر","pr":"ماذِر","emoji":"👩","ex":{"t":"My mother is a teacher.","s":"مادرم معلم است.","a":"audio/en-fa/671bd14ca86e.mp3"},"img":"img/e/1f469.svg","a":"audio/en-fa/e4d7b0e0e37d.mp3","pla":"audio/en-fa/202b07218ceb.mp3"},{"id":"w03","t":"father","pl":"fathers","s":"پدر","pr":"فاذِر","emoji":"👨","ex":{"t":"His father is from Iran.","s":"پدرش اهل ایران است.","a":"audio/en-fa/48625016d099.mp3"},"img":"img/e/1f468.svg","a":"audio/en-fa/f541fa0da78b.mp3","pla":"audio/en-fa/c8ffc7a20fd2.mp3"},{"id":"w04","t":"parents","s":"پدر و مادر، والدین","pr":"پِرِنتس","emoji":"","ex":{"t":"Our parents are from Shiraz.","s":"پدر و مادر ما اهل شیراز هستند.","a":"audio/en-fa/2624176d883d.mp3"},"img":null,"a":"audio/en-fa/c5000ad222bd.mp3"},{"id":"w05","t":"brother","pl":"brothers","s":"برادر","pr":"براذِر","emoji":"👦","ex":{"t":"I have two brothers.","s":"من دو برادر دارم.","a":"audio/en-fa/e8c8fa787563.mp3"},"img":"img/e/1f466.svg","a":"audio/en-fa/14d011b7b9d7.mp3","pla":"audio/en-fa/23753a4fc3f4.mp3"},{"id":"w06","t":"sister","pl":"sisters","s":"خواهر","pr":"سیستِر","emoji":"👧","ex":{"t":"Sara is my sister.","s":"سارا خواهر من است.","a":"audio/en-fa/b73a6b3ad2d4.mp3"},"img":"img/e/1f467.svg","a":"audio/en-fa/e3b5476518c2.mp3","pla":"audio/en-fa/44ed1187e358.mp3"},{"id":"w07","t":"son","pl":"sons","s":"پسر (فرزند)","pr":"سان","emoji":"","ex":{"t":"They have a son.","s":"آن‌ها یک پسر دارند.","a":"audio/en-fa/49770dee1bcb.mp3"},"img":null,"a":"audio/en-fa/93b7e5c6d042.mp3","pla":"audio/en-fa/8aa004176da8.mp3"},{"id":"w08","t":"daughter","pl":"daughters","s":"دختر (فرزند)","pr":"داتِر","emoji":"","ex":{"t":"Our daughter is six years old.","s":"دختر ما شش‌ساله است.","a":"audio/en-fa/d266acd02b69.mp3"},"img":null,"a":"audio/en-fa/337b972930e6.mp3","pla":"audio/en-fa/50c20aa4b1d2.mp3"},{"id":"w09","t":"husband","pl":"husbands","s":"شوهر، همسر","pr":"هازبِند","emoji":"🤵","ex":{"t":"Her husband is Reza.","s":"شوهرِ او رضا است.","a":"audio/en-fa/e15833479b73.mp3"},"img":"img/e/1f935.svg","a":"audio/en-fa/6cac4509d0ff.mp3","pla":"audio/en-fa/209152b5a279.mp3"},{"id":"w10","t":"wife","pl":"wives","s":"زن، همسر","pr":"وایف","emoji":"👰","ex":{"t":"Ali's wife is a teacher.","s":"همسرِ علی معلم است.","a":"audio/en-fa/0b2655d4fddb.mp3"},"img":"img/e/1f470.svg","a":"audio/en-fa/1070946548cf.mp3","pla":"audio/en-fa/052761c56bca.mp3"},{"id":"w11","t":"grandmother","pl":"grandmothers","s":"مادربزرگ","pr":"گرَندماذِر","emoji":"👵","ex":{"t":"My grandmother is from Tabriz.","s":"مادربزرگم اهل تبریز است.","a":"audio/en-fa/e6079a5319af.mp3"},"img":"img/e/1f475.svg","a":"audio/en-fa/9c917d2f25ec.mp3","pla":"audio/en-fa/36ffdef65d38.mp3"},{"id":"w12","t":"grandfather","pl":"grandfathers","s":"پدربزرگ","pr":"گرَندفاذِر","emoji":"👴","ex":{"t":"His grandfather is a teacher.","s":"پدربزرگِ او معلم است.","a":"audio/en-fa/518d290c43f6.mp3"},"img":"img/e/1f474.svg","a":"audio/en-fa/5909b177705b.mp3","pla":"audio/en-fa/efd727f5f9a5.mp3"},{"id":"w13","t":"baby","pl":"babies","s":"نوزاد، بچهٔ کوچک","pr":"بِیبی","emoji":"👶","ex":{"t":"Our baby is one year old.","s":"بچهٔ ما یک‌ساله است.","a":"audio/en-fa/464466eddbcc.mp3"},"img":"img/e/1f476.svg","a":"audio/en-fa/1bcbb38ec2c4.mp3","pla":"audio/en-fa/bbf524f775ce.mp3"},{"id":"w14","t":"child","pl":"children","s":"بچه، فرزند","pr":"چایلد","emoji":"🧒","ex":{"t":"They have two children.","s":"آن‌ها دو فرزند دارند.","a":"audio/en-fa/e0d16a0f822f.mp3"},"img":"img/e/1f9d2.svg","a":"audio/en-fa/0b69dc8718a9.mp3","pla":"audio/en-fa/879a4b4bdf97.mp3"}],"phrases":[{"id":"p01","t":"This is my mother.","s":"این مادر من است.","pr":"ذیس ایز مای ماذِر.","a":"audio/en-fa/a387f70c0fe3.mp3"},{"id":"p02","t":"Who is this?","s":"این کیست؟","pr":"هو ایز ذیس؟","a":"audio/en-fa/014cb06a219a.mp3"},{"id":"p03","t":"Do you have any brothers or sisters?","s":"خواهر یا برادر داری؟","pr":"دو یو هَو اِنی براذِرز اُر سیستِرز؟","a":"audio/en-fa/cbb1e3eb0b21.mp3"},{"id":"p04","t":"I have one brother and two sisters.","s":"یک برادر و دو خواهر دارم.","pr":"آی هَو وان براذِر اَند تو سیستِرز.","a":"audio/en-fa/ec7cd3f899f6.mp3"},{"id":"p05","t":"How is your family?","s":"حال خانواده‌ات چطور است؟","pr":"هاو ایز یور فَمیلی؟","a":"audio/en-fa/992553bd0adb.mp3"},{"id":"p06","t":"We are a big family.","s":"ما خانوادهٔ بزرگی هستیم.","pr":"وی آر اِ بیگ فَمیلی.","a":"audio/en-fa/baaa6669cec1.mp3"},{"id":"p07","t":"You have a nice family!","s":"خانوادهٔ خوبی داری!","pr":"یو هَو اِ نایس فَمیلی!","a":"audio/en-fa/ef8ae52202f3.mp3"}],"dialogue":{"title":{"t":"Who is this?","s":"این کیست؟","a":"audio/en-fa/014cb06a219a.mp3"},"speakers":{"A":{"name":"Emma","voice":"f"},"B":{"name":"Reza","voice":"m"}},"lines":[{"sp":"A","t":"Who is this, Reza?","s":"رضا، این کیست؟","a":"audio/en-fa/678ae3e0ee6f.mp3"},{"sp":"B","t":"This is my father. His name is Ali.","s":"این پدر من است. اسمش علی است.","a":"audio/en-fa/bd5487c40023.mp3"},{"sp":"A","t":"And who is this?","s":"این یکی کیست؟","a":"audio/en-fa/97a94b13e875.mp3"},{"sp":"B","t":"This is my mother. Her name is Maryam.","s":"این مادرم است. اسمش مریم است.","a":"audio/en-fa/ab3945e5829a.mp3"},{"sp":"A","t":"Do you have any brothers or sisters?","s":"خواهر یا برادر داری؟","a":"audio/en-fa/cbb1e3eb0b21.mp3"},{"sp":"B","t":"Yes, I have one sister. Her name is Neda. She's fifteen.","s":"بله، یک خواهر دارم. اسمش ندا است. پانزده سالش است.","a":"audio/en-fa/eaab322ae248.mp3"},{"sp":"A","t":"Is this Neda's cat?","s":"این گربهٔ ندا است؟","a":"audio/en-fa/307793f1764e.mp3"},{"sp":"B","t":"Yes! The cat's name is Max.","s":"بله! اسم گربه مَکس است.","a":"audio/en-fa/1b5419a78d61.mp3"},{"sp":"A","t":"You have a nice family!","s":"خانوادهٔ خوبی داری!","a":"audio/en-fa/ef8ae52202f3.mp3"},{"sp":"B","t":"Thank you, Emma!","s":"ممنون، اِما!","a":"audio/en-fa/906456158080.mp3"}]},"grammar":[{"id":"g01","title":{"t":"my / your / his / her / our / their","s":"صفت‌های ملکی: مالِ کیست؟"},"explain":"این کلمه‌ها نشان می‌دهند چیزی **مالِ کیست**. همیشه **قبل از اسم** می‌آیند: **my** mother یعنی «مادرِ من».\n**his** برای مرد است و **her** برای زن. در فارسی برای هر دو می‌گوییم «او»، اما در انگلیسی باید درست انتخاب کنیم: Ali and **his** sister، Sara and **her** sister.\nاین کلمه‌ها برای مفرد و جمع عوض نمی‌شوند: my brother، my brothers.","table":[["I","my"],["you","your"],["he","his"],["she","her"],["we","our"],["they","their"]],"examples":[{"t":"My name is Amir.","s":"اسم من امیر است.","a":"audio/en-fa/4d6700953621.mp3"},{"t":"What's your name?","s":"اسمت چیست؟","a":"audio/en-fa/17e028377c6c.mp3"},{"t":"Reza is from Iran. His wife is from Tabriz.","s":"رضا اهل ایران است. همسرش اهل تبریز است.","a":"audio/en-fa/7bb386501c9e.mp3"},{"t":"Maryam is a teacher. Her son is ten.","s":"مریم معلم است. پسرش ده سالش است.","a":"audio/en-fa/35ed8617ec28.mp3"},{"t":"Our parents are from Shiraz.","s":"پدر و مادر ما اهل شیراز هستند.","a":"audio/en-fa/2624176d883d.mp3"}],"exercises":[{"type":"choice","t":"Ali is my brother. ___ wife is Maryam.","options":["His","Her","He"],"answer":0,"s":"علی برادر من است. همسرِ او مریم است.","full":"Ali is my brother. His wife is Maryam.","a":"audio/en-fa/0d78f54472e5.mp3"},{"type":"choice","t":"Maryam is a teacher. ___ son is a student.","options":["His","Her","She"],"answer":1,"s":"مریم معلم است. پسرِ او دانشجو است.","full":"Maryam is a teacher. Her son is a student.","a":"audio/en-fa/80f55d53958b.mp3"},{"type":"choice","t":"We are from Iran. ___ family is big.","options":["Our","We","They"],"answer":0,"s":"ما اهل ایران هستیم. خانوادهٔ ما بزرگ است.","full":"We are from Iran. Our family is big.","a":"audio/en-fa/6cec89881adf.mp3"},{"type":"choice","t":"What's ___ name?","options":["you","your","he"],"answer":1,"s":"اسمت چیست؟","full":"What's your name?","a":"audio/en-fa/17e028377c6c.mp3"},{"type":"type","t":"I am Tom. ___ name is Tom.","answer":["My"],"s":"من تام هستم. اسم من تام است.","full":"I am Tom. My name is Tom.","a":"audio/en-fa/e0f0c4b9f2b3.mp3"},{"type":"type","t":"They are my parents. ___ names are Ali and Maryam.","answer":["Their"],"s":"آن‌ها پدر و مادر من هستند. اسمشان علی و مریم است.","full":"They are my parents. Their names are Ali and Maryam.","a":"audio/en-fa/360d2ecfe99d.mp3"},{"type":"order","t":"Her brother is a teacher.","s":"برادرِ او معلم است.","full":"Her brother is a teacher.","a":"audio/en-fa/cae9c4ee4abe.mp3"},{"type":"order","t":"This is our family.","s":"این خانوادهٔ ما است.","full":"This is our family.","a":"audio/en-fa/3e20837ed588.mp3"}]},{"id":"g02","title":{"t":"'s and have / has","s":"مالکیت با 's و فعل «داشتن»"},"explain":"برای گفتن «مالِ کسی» به آخر اسم آن شخص **'s** اضافه می‌کنیم: **Sara's** brother یعنی «برادرِ سارا». ترتیب برعکسِ فارسی است: اول صاحب، بعد چیز.\nدقت کنید: **'s** گاهی شکل کوتاه **is** است: She's = She is.\nفعل «داشتن» در انگلیسی **have** است: I **have** a sister. با **he**، **she** و **it** شکلش **has** می‌شود: She **has** two sons.\nدر انگلیسی بریتانیایی **have got** هم زیاد می‌شنوید (I've got a brother) که همان معنی را دارد.","table":[["I","have"],["you","have"],["he / she / it","has"],["we","have"],["they","have"]],"examples":[{"t":"Sara's brother is twenty.","s":"برادرِ سارا بیست سالش است.","a":"audio/en-fa/252351372145.mp3"},{"t":"Reza's mother is a teacher.","s":"مادرِ رضا معلم است.","a":"audio/en-fa/b7f788b9cd7e.mp3"},{"t":"I have two sisters.","s":"من دو خواهر دارم.","a":"audio/en-fa/b54337a4cd92.mp3"},{"t":"Ali has a son and a daughter.","s":"علی یک پسر و یک دختر دارد.","a":"audio/en-fa/c64265c9b683.mp3"},{"t":"We have a big family.","s":"ما خانوادهٔ بزرگی داریم.","a":"audio/en-fa/acce83c4e915.mp3"}],"exercises":[{"type":"choice","t":"She ___ two brothers.","options":["have","has"],"answer":1,"s":"او دو برادر دارد.","full":"She has two brothers.","a":"audio/en-fa/a28239feb7cb.mp3"},{"type":"choice","t":"I ___ a sister.","options":["have","has"],"answer":0,"s":"من یک خواهر دارم.","full":"I have a sister.","a":"audio/en-fa/1b9ccfe6a81f.mp3"},{"type":"choice","t":"They ___ three children.","options":["has","have"],"answer":1,"s":"آن‌ها سه فرزند دارند.","full":"They have three children.","a":"audio/en-fa/303b5315121a.mp3"},{"type":"type","t":"Ali ___ a baby.","answer":["has"],"s":"علی یک بچهٔ کوچک دارد.","full":"Ali has a baby.","a":"audio/en-fa/e711162d250e.mp3"},{"type":"choice","t":"This is ___ cat.","options":["Neda","Neda's","Nedas"],"answer":1,"s":"این گربهٔ ندا است.","full":"This is Neda's cat.","a":"audio/en-fa/f40f326f90f1.mp3"},{"type":"type","t":"___ father is from Tabriz.","answer":["Ali's","Ali’s"],"s":"پدرِ علی اهل تبریز است.","full":"Ali's father is from Tabriz.","a":"audio/en-fa/53fd4694ad78.mp3"},{"type":"order","t":"Sara's mother is a teacher.","s":"مادرِ سارا معلم است.","full":"Sara's mother is a teacher.","a":"audio/en-fa/a3c072790b64.mp3"},{"type":"order","t":"We have two daughters.","s":"ما دو دختر داریم.","full":"We have two daughters.","a":"audio/en-fa/8999d7edecde.mp3"}]}],"reading":{"title":{"t":"Amir's family","s":"خانوادهٔ امیر","a":"audio/en-fa/6674ccfb1a34.mp3"},"text":[{"t":"Hi! I'm Amir, and this is my family.","s":"سلام! من امیر هستم و این خانوادهٔ من است.","a":"audio/en-fa/65bcdaff2cde.mp3"},{"t":"My father's name is Ali.","s":"اسم پدرم علی است.","a":"audio/en-fa/72ecb91afbb4.mp3"},{"t":"He is a teacher.","s":"او معلم است.","a":"audio/en-fa/985f677c6322.mp3"},{"t":"My mother's name is Maryam.","s":"اسم مادرم مریم است.","a":"audio/en-fa/4e299e4aeeff.mp3"},{"t":"She is from Shiraz.","s":"او اهل شیراز است.","a":"audio/en-fa/eb23df58bae6.mp3"},{"t":"I have one sister and one brother.","s":"من یک خواهر و یک برادر دارم.","a":"audio/en-fa/3a4ed0b0fdd3.mp3"},{"t":"My sister, Neda, is fifteen.","s":"خواهرم، ندا، پانزده سالش است.","a":"audio/en-fa/3203036b202d.mp3"},{"t":"My brother is a baby. He is one year old.","s":"برادرم نوزاد است. او یک‌ساله است.","a":"audio/en-fa/f5538a227e74.mp3"},{"t":"We are a happy family!","s":"ما خانوادهٔ شادی هستیم!","a":"audio/en-fa/2cbbb488d57b.mp3"}],"questions":[{"q":{"t":"Who is Ali?","s":"علی کیست؟","a":"audio/en-fa/89d022679248.mp3"},"options":["Amir's father","Amir's brother","Amir's son"],"answer":0},{"q":{"t":"Where is Amir's mother from?","s":"مادرِ امیر اهل کجاست؟","a":"audio/en-fa/3fe47502cbe8.mp3"},"options":["Tabriz","Shiraz","America"],"answer":1},{"q":{"t":"How old is Neda?","s":"ندا چند سالش است؟","a":"audio/en-fa/e3af6cc7923b.mp3"},"options":["five","fifteen","one"],"answer":1},{"q":{"t":"Is Amir's brother a student?","s":"آیا برادرِ امیر دانش‌آموز است؟","a":"audio/en-fa/d88232bbac07.mp3"},"options":["Yes, he is.","No, he isn't."],"answer":1}]},"sentences":[{"t":"This is my grandmother.","s":"این مادربزرگ من است.","a":"audio/en-fa/4346744b2cf6.mp3"},{"t":"My father has two brothers.","s":"پدرم دو برادر دارد.","a":"audio/en-fa/0fcc1159acfb.mp3"},{"t":"Reza's wife is from Tabriz.","s":"همسرِ رضا اهل تبریز است.","a":"audio/en-fa/ce65e310dee7.mp3"},{"t":"Do you have any sisters?","s":"خواهر داری؟","a":"audio/en-fa/7e6f68464cc7.mp3"},{"t":"Our son is seven years old.","s":"پسرمان هفت‌ساله است.","a":"audio/en-fa/ddb960f914c5.mp3"},{"t":"His parents are teachers.","s":"پدر و مادرش معلم هستند.","a":"audio/en-fa/7704903afc24.mp3"},{"t":"Who is this?","s":"این کیست؟","a":"audio/en-fa/014cb06a219a.mp3"}],"img":"img/e/1f46a.svg"}