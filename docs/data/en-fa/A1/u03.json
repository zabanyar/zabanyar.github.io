{"id":"u03","level":"A1","emoji":"👪","title":{"t":"My family","s":"خانوادهٔ من","a":"audio/en-fa/6ee0d3bedc3a.mp3"},"goals":["اعضای خانواده را نام ببرم.","با my، your، his، her، our و their بگویم چیزی مال کیست.","با 's مالکیت را نشان بدهم، مثل Sara's brother.","با have و has بگویم چه کسانی را دارم."],"words":[{"id":"w01","t":"family","pl":"families","s":"خانواده","pr":"فَمیلی","emoji":"👪","ex":{"t":"This is my family.","s":"این خانوادهٔ من است.","a":"audio/en-fa/d92741ac927f.mp3"},"img":"img/e/1f46a.svg","a":"audio/en-fa/83c8fb174d69.mp3","pla":"audio/en-fa/31db8fe63713.mp3"},{"id":"w02","t":"mother","pl":"mothers","s":"مادر","pr":"ماذِر","emoji":"👩","ex":{"t":"My mother is a teacher.","s":"مادرم معلم است.","a":"audio/en-fa/95d9e881a4ae.mp3"},"img":"img/e/1f469.svg","a":"audio/en-fa/40298ce5ea63.mp3","pla":"audio/en-fa/f2cdb0ecddab.mp3"},{"id":"w03","t":"father","pl":"fathers","s":"پدر","pr":"فاذِر","emoji":"👨","ex":{"t":"His father is from Iran.","s":"پدرش اهل ایران است.","a":"audio/en-fa/12f5789d1a57.mp3"},"img":"img/e/1f468.svg","a":"audio/en-fa/036f629a900c.mp3","pla":"audio/en-fa/8806a6f5e03b.mp3"},{"id":"w04","t":"parents","s":"پدر و مادر، والدین","pr":"پِرِنتس","emoji":"","ex":{"t":"Our parents are from Shiraz.","s":"پدر و مادر ما اهل شیراز هستند.","a":"audio/en-fa/678606f1b927.mp3"},"img":null,"a":"audio/en-fa/4f093e652fa1.mp3"},{"id":"w05","t":"brother","pl":"brothers","s":"برادر","pr":"براذِر","emoji":"👦","ex":{"t":"I have two brothers.","s":"من دو برادر دارم.","a":"audio/en-fa/64bb69a0d7f0.mp3"},"img":"img/e/1f466.svg","a":"audio/en-fa/8f955ac2585c.mp3","pla":"audio/en-fa/6bb55a5d9324.mp3"},{"id":"w06","t":"sister","pl":"sisters","s":"خواهر","pr":"سیستِر","emoji":"👧","ex":{"t":"Sara is my sister.","s":"سارا خواهر من است.","a":"audio/en-fa/19bd98bc65e2.mp3"},"img":"img/e/1f467.svg","a":"audio/en-fa/f4687e3a2bde.mp3","pla":"audio/en-fa/6cea2d12d8b3.mp3"},{"id":"w07","t":"son","pl":"sons","s":"پسر (فرزند)","pr":"سان","emoji":"","ex":{"t":"They have a son.","s":"آن‌ها یک پسر دارند.","a":"audio/en-fa/6ab1a26f3c69.mp3"},"img":null,"a":"audio/en-fa/4227f2568af3.mp3","pla":"audio/en-fa/e4f5ecf54dbe.mp3"},{"id":"w08","t":"daughter","pl":"daughters","s":"دختر (فرزند)","pr":"داتِر","emoji":"","ex":{"t":"Our daughter is six years old.","s":"دختر ما شش‌ساله است.","a":"audio/en-fa/991aaeaffd11.mp3"},"img":null,"a":"audio/en-fa/cdf6f001b1e4.mp3","pla":"audio/en-fa/ae8b0f575b4d.mp3"},{"id":"w09","t":"husband","pl":"husbands","s":"شوهر، همسر","pr":"هازبَند","emoji":"🤵","ex":{"t":"Her husband is Reza.","s":"شوهرِ او رضا است.","a":"audio/en-fa/8d0507d1cd7d.mp3"},"img":"img/e/1f935.svg","a":"audio/en-fa/fa25dc1fffe1.mp3","pla":"audio/en-fa/3af8dec01435.mp3"},{"id":"w10","t":"wife","pl":"wives","s":"زن، همسر","pr":"وایف","emoji":"👰","ex":{"t":"Ali's wife is a teacher.","s":"همسرِ علی معلم است.","a":"audio/en-fa/f63322f1d0c6.mp3"},"img":"img/e/1f470.svg","a":"audio/en-fa/76a06f5705ad.mp3","pla":"audio/en-fa/6ff58c01cc5c.mp3"},{"id":"w11","t":"grandmother","pl":"grandmothers","s":"مادربزرگ","pr":"گرَندماذِر","emoji":"👵","ex":{"t":"My grandmother is from Tabriz.","s":"مادربزرگم اهل تبریز است.","a":"audio/en-fa/bacdb48ae3d4.mp3"},"img":"img/e/1f475.svg","a":"audio/en-fa/6288e4bb7d4a.mp3","pla":"audio/en-fa/477797f9c2dd.mp3"},{"id":"w12","t":"grandfather","pl":"grandfathers","s":"پدربزرگ","pr":"گرَندفاذِر","emoji":"👴","ex":{"t":"His grandfather is a teacher.","s":"پدربزرگِ او معلم است.","a":"audio/en-fa/0285c9a61dc9.mp3"},"img":"img/e/1f474.svg","a":"audio/en-fa/baf9b0c2427d.mp3","pla":"audio/en-fa/4da21d16c66e.mp3"},{"id":"w13","t":"baby","pl":"babies","s":"نوزاد، بچهٔ کوچک","pr":"بِیبی","emoji":"👶","ex":{"t":"Our baby is one year old.","s":"بچهٔ ما یک‌ساله است.","a":"audio/en-fa/0956b196a99d.mp3"},"img":"img/e/1f476.svg","a":"audio/en-fa/3f66b9ee1957.mp3","pla":"audio/en-fa/0ebec66d408e.mp3"},{"id":"w14","t":"child","pl":"children","s":"بچه، فرزند","pr":"چایلد","emoji":"🧒","ex":{"t":"They have two children.","s":"آن‌ها دو فرزند دارند.","a":"audio/en-fa/8d31ff8c1ead.mp3"},"img":"img/e/1f9d2.svg","a":"audio/en-fa/38a2f83c3697.mp3","pla":"audio/en-fa/b8292458131e.mp3"}],"phrases":[{"id":"p01","t":"This is my mother.","s":"این مادر من است.","pr":"ذیس ایز مای ماذِر.","a":"audio/en-fa/479aafa39a1c.mp3"},{"id":"p02","t":"Who is this?","s":"این کیست؟","pr":"هو ایز ذیس؟","a":"audio/en-fa/5bfb62cf62df.mp3"},{"id":"p03","t":"Do you have any brothers or sisters?","s":"خواهر یا برادر داری؟","pr":"دو یو هَو اِنی براذِرز اُر سیستِرز؟","a":"audio/en-fa/78625618dd69.mp3"},{"id":"p04","t":"I have one brother and two sisters.","s":"یک برادر و دو خواهر دارم.","pr":"آی هَو وان براذِر اَند تو سیستِرز.","a":"audio/en-fa/16c4e9d56af4.mp3"},{"id":"p05","t":"How is your family?","s":"حال خانواده‌ات چطور است؟","pr":"هاو ایز یور فَمیلی؟","a":"audio/en-fa/dd505f8b5f7d.mp3"},{"id":"p06","t":"We are a big family.","s":"ما خانوادهٔ بزرگی هستیم.","pr":"وی آر اِ بیگ فَمیلی.","a":"audio/en-fa/bc3cf8fbb203.mp3"},{"id":"p07","t":"You have a nice family!","s":"خانوادهٔ خوبی داری!","pr":"یو هَو اِ نایس فَمیلی!","a":"audio/en-fa/ab0475684a5e.mp3"}],"dialogue":{"title":{"t":"Who is this?","s":"این کیست؟","a":"audio/en-fa/5bfb62cf62df.mp3"},"speakers":{"A":{"name":"Emma","voice":"f"},"B":{"name":"Reza","voice":"m"}},"lines":[{"sp":"A","t":"Who is this, Reza?","s":"رضا، این کیست؟","a":"audio/en-fa/b3ecad92bd6d.mp3"},{"sp":"B","t":"This is my father. His name is Ali.","s":"این پدر من است. اسمش علی است.","a":"audio/en-fa/d85d02e47391.mp3"},{"sp":"A","t":"And who is this?","s":"این یکی کیست؟","a":"audio/en-fa/a1a0761714ff.mp3"},{"sp":"B","t":"This is my mother. Her name is Maryam.","s":"این مادرم است. اسمش مریم است.","a":"audio/en-fa/611bcd138783.mp3"},{"sp":"A","t":"Do you have any brothers or sisters?","s":"خواهر یا برادر داری؟","a":"audio/en-fa/78625618dd69.mp3"},{"sp":"B","t":"Yes, I have one sister. Her name is Neda. She's fifteen.","s":"بله، یک خواهر دارم. اسمش ندا است. پانزده سالش است.","a":"audio/en-fa/ca1c1226de2d.mp3"},{"sp":"A","t":"Is this Neda's cat?","s":"این گربهٔ ندا است؟","a":"audio/en-fa/52bbf29faa62.mp3"},{"sp":"B","t":"Yes! The cat's name is Max.","s":"بله! اسم گربه مَکس است.","a":"audio/en-fa/03f7b6e2263b.mp3"},{"sp":"A","t":"You have a nice family!","s":"خانوادهٔ خوبی داری!","a":"audio/en-fa/ab0475684a5e.mp3"},{"sp":"B","t":"Thank you, Emma!","s":"ممنون، اِما!","a":"audio/en-fa/e6b9e0f8f364.mp3"}]},"grammar":[{"id":"g01","title":{"t":"my / your / his / her / our / their","s":"صفت‌های ملکی: مالِ کیست؟"},"explain":"این کلمه‌ها نشان می‌دهند چیزی **مالِ کیست**. همیشه **قبل از اسم** می‌آیند: **my** mother یعنی «مادرِ من».\n**his** برای مرد است و **her** برای زن. در فارسی برای هر دو می‌گوییم «او»، اما در انگلیسی باید درست انتخاب کنیم: Ali and **his** sister، Sara and **her** sister.\nاین کلمه‌ها برای مفرد و جمع عوض نمی‌شوند: my brother، my brothers.","table":[["I","my"],["you","your"],["he","his"],["she","her"],["we","our"],["they","their"]],"examples":[{"t":"My name is Amir.","s":"اسم من امیر است.","a":"audio/en-fa/d5f9e423f4ca.mp3"},{"t":"What's your name?","s":"اسمت چیست؟","a":"audio/en-fa/7f6e5a5f6488.mp3"},{"t":"Reza is from Iran. His wife is from Tabriz.","s":"رضا اهل ایران است. همسرش اهل تبریز است.","a":"audio/en-fa/9af8a9ecf0b7.mp3"},{"t":"Maryam is a teacher. Her son is ten.","s":"مریم معلم است. پسرش ده سالش است.","a":"audio/en-fa/743f69ada0cd.mp3"},{"t":"Our parents are from Shiraz.","s":"پدر و مادر ما اهل شیراز هستند.","a":"audio/en-fa/678606f1b927.mp3"}],"exercises":[{"type":"choice","t":"Ali is my brother. ___ wife is Maryam.","options":["His","Her","He"],"answer":0,"s":"علی برادر من است. همسرِ او مریم است.","full":"Ali is my brother. His wife is Maryam.","a":"audio/en-fa/9fcac0c3c49a.mp3"},{"type":"choice","t":"Maryam is a teacher. ___ son is a student.","options":["His","Her","She"],"answer":1,"s":"مریم معلم است. پسرِ او دانشجو است.","full":"Maryam is a teacher. Her son is a student.","a":"audio/en-fa/f2f9d6626a6d.mp3"},{"type":"choice","t":"We are from Iran. ___ family is big.","options":["Our","We","They"],"answer":0,"s":"ما اهل ایران هستیم. خانوادهٔ ما بزرگ است.","full":"We are from Iran. Our family is big.","a":"audio/en-fa/0a1cc5bef440.mp3"},{"type":"choice","t":"What's ___ name?","options":["you","your","he"],"answer":1,"s":"اسمت چیست؟","full":"What's your name?","a":"audio/en-fa/7f6e5a5f6488.mp3"},{"type":"type","t":"I am Tom. ___ name is Tom.","answer":["My"],"s":"من تام هستم. اسم من تام است.","full":"I am Tom. My name is Tom.","a":"audio/en-fa/6cb088bc7456.mp3"},{"type":"type","t":"They are my parents. ___ names are Ali and Maryam.","answer":["Their"],"s":"آن‌ها پدر و مادر من هستند. اسمشان علی و مریم است.","full":"They are my parents. Their names are Ali and Maryam.","a":"audio/en-fa/48740283e606.mp3"},{"type":"order","t":"Her brother is a teacher.","s":"برادرِ او معلم است.","full":"Her brother is a teacher.","a":"audio/en-fa/2d1e2d6eeb13.mp3"},{"type":"order","t":"This is our family.","s":"این خانوادهٔ ما است.","full":"This is our family.","a":"audio/en-fa/6d3892a1ffb4.mp3"}]},{"id":"g02","title":{"t":"'s and have / has","s":"مالکیت با 's و فعل «داشتن»"},"explain":"برای گفتن «مالِ کسی» به آخر اسم آن شخص **'s** اضافه می‌کنیم: **Sara's** brother یعنی «برادرِ سارا». ترتیب برعکسِ فارسی است: اول صاحب، بعد چیز.\nدقت کنید: **'s** گاهی شکل کوتاه **is** است: She's = She is.\nفعل «داشتن» در انگلیسی **have** است: I **have** a sister. با **he**، **she** و **it** شکلش **has** می‌شود: She **has** two sons.\nدر انگلیسی بریتانیایی **have got** هم زیاد می‌شنوید (I've got a brother) که همان معنی را دارد.","table":[["I","have"],["you","have"],["he / she / it","has"],["we","have"],["they","have"]],"examples":[{"t":"Sara's brother is twenty.","s":"برادرِ سارا بیست سالش است.","a":"audio/en-fa/425748162405.mp3"},{"t":"Reza's mother is a teacher.","s":"مادرِ رضا معلم است.","a":"audio/en-fa/203c518d4b42.mp3"},{"t":"I have two sisters.","s":"من دو خواهر دارم.","a":"audio/en-fa/35be07592eed.mp3"},{"t":"Ali has a son and a daughter.","s":"علی یک پسر و یک دختر دارد.","a":"audio/en-fa/976ca6d009e6.mp3"},{"t":"We have a big family.","s":"ما خانوادهٔ بزرگی داریم.","a":"audio/en-fa/6b3ca3810b9a.mp3"}],"exercises":[{"type":"choice","t":"She ___ two brothers.","options":["have","has"],"answer":1,"s":"او دو برادر دارد.","full":"She has two brothers.","a":"audio/en-fa/f0db172f2e2a.mp3"},{"type":"choice","t":"I ___ a sister.","options":["have","has"],"answer":0,"s":"من یک خواهر دارم.","full":"I have a sister.","a":"audio/en-fa/4d584276a4da.mp3"},{"type":"choice","t":"They ___ three children.","options":["has","have"],"answer":1,"s":"آن‌ها سه فرزند دارند.","full":"They have three children.","a":"audio/en-fa/92f78c793a8d.mp3"},{"type":"type","t":"Ali ___ a baby.","answer":["has"],"s":"علی یک بچهٔ کوچک دارد.","full":"Ali has a baby.","a":"audio/en-fa/826b0bca502b.mp3"},{"type":"choice","t":"This is ___ cat.","options":["Neda","Neda's","Nedas"],"answer":1,"s":"این گربهٔ ندا است.","full":"This is Neda's cat.","a":"audio/en-fa/33deb14474e9.mp3"},{"type":"type","t":"___ father is from Tabriz.","answer":["Ali's","Ali’s"],"s":"پدرِ علی اهل تبریز است.","full":"Ali's father is from Tabriz.","a":"audio/en-fa/1a01cbb55988.mp3"},{"type":"order","t":"Sara's mother is a teacher.","s":"مادرِ سارا معلم است.","full":"Sara's mother is a teacher.","a":"audio/en-fa/7fbaf81def25.mp3"},{"type":"order","t":"We have two daughters.","s":"ما دو دختر داریم.","full":"We have two daughters.","a":"audio/en-fa/8b01d486310c.mp3"}]}],"reading":{"title":{"t":"Amir's family","s":"خانوادهٔ امیر","a":"audio/en-fa/027a8a6e211d.mp3"},"text":[{"t":"Hi! I'm Amir, and this is my family.","s":"سلام! من امیر هستم و این خانوادهٔ من است.","a":"audio/en-fa/50c4557c61bd.mp3"},{"t":"My father's name is Ali.","s":"اسم پدرم علی است.","a":"audio/en-fa/21ff8a2a2e21.mp3"},{"t":"He is a teacher.","s":"او معلم است.","a":"audio/en-fa/4ce6b58507cb.mp3"},{"t":"My mother's name is Maryam.","s":"اسم مادرم مریم است.","a":"audio/en-fa/d67a3c48c40c.mp3"},{"t":"She is from Shiraz.","s":"او اهل شیراز است.","a":"audio/en-fa/ec8c0f2878d9.mp3"},{"t":"I have one sister and one brother.","s":"من یک خواهر و یک برادر دارم.","a":"audio/en-fa/f25ff2448521.mp3"},{"t":"My sister, Neda, is fifteen.","s":"خواهرم، ندا، پانزده سالش است.","a":"audio/en-fa/5e5e416f1ddb.mp3"},{"t":"My brother is a baby. He is one year old.","s":"برادرم نوزاد است. او یک‌ساله است.","a":"audio/en-fa/e6e8eed73a02.mp3"},{"t":"We are a happy family!","s":"ما خانوادهٔ شادی هستیم!","a":"audio/en-fa/9e3a109fca3b.mp3"}],"questions":[{"q":{"t":"Who is Ali?","s":"علی کیست؟","a":"audio/en-fa/e832137c741c.mp3"},"options":["Amir's father","Amir's brother","Amir's son"],"answer":0},{"q":{"t":"Where is Amir's mother from?","s":"مادرِ امیر اهل کجاست؟","a":"audio/en-fa/f50439e7fee4.mp3"},"options":["Tabriz","Shiraz","America"],"answer":1},{"q":{"t":"How old is Neda?","s":"ندا چند سالش است؟","a":"audio/en-fa/664e87939e9a.mp3"},"options":["five","fifteen","one"],"answer":1},{"q":{"t":"Is Amir's brother a student?","s":"آیا برادرِ امیر دانش‌آموز است؟","a":"audio/en-fa/38803711cd82.mp3"},"options":["Yes, he is.","No, he isn't."],"answer":1}]},"sentences":[{"t":"This is my grandmother.","s":"این مادربزرگ من است.","a":"audio/en-fa/e08a1d9abec2.mp3"},{"t":"My father has two brothers.","s":"پدرم دو برادر دارد.","a":"audio/en-fa/e7965a8caaec.mp3"},{"t":"Reza's wife is from Tabriz.","s":"همسرِ رضا اهل تبریز است.","a":"audio/en-fa/032235385861.mp3"},{"t":"Do you have any sisters?","s":"خواهر داری؟","a":"audio/en-fa/6ac17f822ce5.mp3"},{"t":"Our son is seven years old.","s":"پسرمان هفت‌ساله است.","a":"audio/en-fa/90247a6815bb.mp3"},{"t":"His parents are teachers.","s":"پدر و مادرش معلم هستند.","a":"audio/en-fa/ed08c344e796.mp3"},{"t":"Who is this?","s":"این کیست؟","a":"audio/en-fa/5bfb62cf62df.mp3"}],"img":"img/e/1f46a.svg"}