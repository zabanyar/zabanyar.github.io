/en-fa/e9dd245d9bfe.mp3"},"img":null,"a":"audio/en-fa/88310b25c4b7.mp3"},{"id":"w10","t":"nine","s":"نه","pr":"ناین","emoji":"","ex":{"t":"Five and four is nine.","s":"پنج به‌اضافهٔ چهار می‌شود نه.","a":"audio/en-fa/d3fb5683ada5.mp3"},"img":null,"a":"audio/en-fa/9d49c069ec74.mp3"},{"id":"w11","t":"ten","s":"ده","pr":"تِن","emoji":"🔟","ex":{"t":"Five and five is ten.","s":"پنج به‌اضافهٔ پنج می‌شود ده.","a":"audio/en-fa/831f8330f951.mp3"},"img":"img/e/1f51f.svg","a":"audio/en-fa/4e340bd515f0.mp3"},{"id":"w12","t":"year","pl":"years","s":"سال","pr":"ییر","emoji":"📅","ex":{"t":"I am twenty years old.","s":"من بیست سالم است.","a":"audio/en-fa/2647c14bff4b.mp3"},"img":"img/e/1f4c5.svg","a":"audio/en-fa/3bcde759ca87.mp3","pla":"audio/en-fa/f6a8cdcf6fa2.mp3"},{"id":"w13","t":"boy","pl":"boys","s":"پسر","pr":"بوی","emoji":"👦","ex":{"t":"Tom is a boy. He is seven.","s":"تام پسر است. او هفت‌ساله است.","a":"audio/en-fa/89992083655e.mp3"},"img":"img/e/1f466.svg","a":"audio/en-fa/6da26514ca9a.mp3","pla":"audio/en-fa/0f7906d0c8ad.mp3"},{"id":"w14","t":"girl","pl":"girls","s":"دختر","pr":"گِرل","emoji":"👧","ex":{"t":"Sara is a girl. She is six.","s":"سارا دختر است. او شش‌ساله است.","a":"audio/en-fa/d98382c68c94.mp3"},"img":"img/e/1f467.svg","a":"audio/en-fa/c7d173ad8c0f.mp3","pla":"audio/en-fa/43ccde0676ac.mp3"}],"phrases":[{"id":"p01","t":"How old are you?","s":"چند سالت است؟","pr":"هاو اُولد آر یو؟","a":"audio/en-fa/987b915582ae.mp3"},{"id":"p02","t":"I'm … years old.","s":"… سالم است.","pr":"آیم … ییرز اُولد.","a":"audio/en-fa/1f9e344b42c1.mp3"},{"id":"p03","t":"How many?","s":"چند تا؟","pr":"هاو مِنی؟","a":"audio/en-fa/f6e63e9b4d6b.mp3"},{"id":"p04","t":"What's your phone number?","s":"شمارهٔ تلفنت چیست؟","pr":"واتس یور فُون نامبِر؟","a":"audio/en-fa/f18db50aeffe.mp3"},{"id":"p05","t":"Happy birthday!","s":"تولدت مبارک!","pr":"هَپی بِرثدِی!","a":"audio/en-fa/205014aa021a.mp3"},{"id":"p06","t":"It's my birthday!","s":"امروز تولد من است!","pr":"ایتس مای بِرثدِی!","a":"audio/en-fa/7ad6e4b3e26b.mp3"},{"id":"p07","t":"Let's count!","s":"بیایید بشماریم!","pr":"لِتس کاونت!","a":"audio/en-fa/5298db058270.mp3"}],"dialogue":{"title":{"t":"Happy birthday!","s":"تولدت مبارک!","a":"audio/en-fa/205014aa021a.mp3"},"speakers":{"A":{"name":"Emma","voice":"f"},"B":{"name":"Ali","voice":"m"}},"lines":[{"sp":"A","t":"Hi, Ali!","s":"سلام علی!","a":"audio/en-fa/80d0cdb36dae.mp3"},{"sp":"B","t":"Hi, Emma! How are you?","s":"سلام اِما! حالت چطور است؟","a":"audio/en-fa/c8bbad0bb95d.mp3"},{"sp":"A","t":"I'm fine, thank you. It's my birthday!","s":"خوبم، ممنون. امروز تولد من است!","a":"audio/en-fa/dd09bfb74ec4.mp3"},{"sp":"B","t":"Happy birthday! How old are you?","s":"تولدت مبارک! چند سالت است؟","a":"audio/en-fa/c090d0b7ca2e.mp3"},{"sp":"A","t":"I'm thirteen. And you?","s":"سیزده سالم است. تو چطور؟","a":"audio/en-fa/1863e86d76eb.mp3"},{"sp":"B","t":"I'm eleven years old.","s":"من یازده سالم است.","a":"audio/en-fa/961cbef20942.mp3"},{"sp":"A","t":"What's your phone number, Ali?","s":"علی، شمارهٔ تلفنت چیست؟","a":"audio/en-fa/d01cd8fc0c11.mp3"},{"sp":"B","t":"It's five-five-five, one-two-three-four.","s":"شماره‌ام ۵۵۵۱۲۳۴ است.","a":"audio/en-fa/3f663c11be2e.mp3"},{"sp":"A","t":"Thank you! Goodbye!","s":"ممنون! خداحافظ!","a":"audio/en-fa/330efff17eef.mp3"},{"sp":"B","t":"Goodbye, Emma!","s":"خداحافظ، اِما!","a":"audio/en-fa/e976aeaa4746.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Numbers 11–20 and age","s":"عددهای ۱۱ تا ۲۰ و گفتن سن"},"explain":"عددهای ۱۳ تا ۱۹ با **teen** تمام می‌شوند: thir**teen** (۱۳)، four**teen** (۱۴)، six**teen** (۱۶). بخش آخر را کشیده و محکم بگویید: «تین».\nعددهای ۱۱ و ۱۲ شکل خاص دارند: **eleven** و **twelve**. عدد ۲۰ هم **twenty** است.\nبرای پرسیدن سن می‌گوییم: **How old are you?** و جواب می‌دهیم: **I'm** + عدد + **years old**. مثلاً: I'm fifteen years old. کوتاه‌تر هم می‌شود گفت: I'm fifteen.\nدقت کنید: برای یک سال می‌گوییم **one year old**، بدون s.","table":[["11","eleven"],["12","twelve"],["13","thirteen"],["14","fourteen"],["15","fifteen"],["16","sixteen"],["17","seventeen"],["18","eighteen"],["19","nineteen"],["20","twenty"]],"examples":[{"t":"How old are you?","s":"چند سالت است؟","a":"audio/en-fa/987b915582ae.mp3"},{"t":"I'm twelve years old.","s":"دوازده سالم است.","a":"audio/en-fa/af099d0d9501.mp3"},{"t":"Emma is thirteen.","s":"اِما سیزده‌ساله است.","a":"audio/en-fa/895b8b6d38cd.mp3"},{"t":"How old is Reza? — He's fourteen.","s":"رضا چند سالش است؟ — چهارده سالش است.","a":"audio/en-fa/8e7dd4e82944.mp3"}],"exercises":[{"type":"choice","t":"How ___ are you?","options":["old","year","name"],"answer":0,"s":"چند سالت است؟","full":"How old are you?","a":"audio/en-fa/987b915582ae.mp3"},{"type":"choice","t":"I'm sixteen ___ old.","options":["year","years","yes"],"answer":1,"s":"شانزده سالم است.","full":"I'm sixteen years old.","a":"audio/en-fa/ac49449d02c8.mp3"},{"type":"choice","t":"Amir is one ___ old.","options":["year","years"],"answer":0,"s":"امیر یک‌ساله است.","full":"Amir is one year old.","a":"audio/en-fa/c2415fa12839.mp3"},{"type":"type","t":"ten, eleven, ___, thirteen","answer":["twelve"],"s":"ده، یازده، دوازده، سیزده","full":"ten, eleven, twelve, thirteen","a":"audio/en-fa/8b71a5234d80.mp3"},{"type":"choice","t":"18 = ___","options":["eight","eighteen","eleven"],"answer":1,"s":"۱۸ = هجده","full":"18 = eighteen","a":"audio/en-fa/dbdbb805c40a.mp3"},{"type":"type","t":"Ten and ten is ___.","answer":["twenty"],"s":"ده به‌اضافهٔ ده می‌شود بیست.","full":"Ten and ten is twenty.","a":"audio/en-fa/cecc448a509a.mp3"},{"type":"order","t":"How old are you?","s":"چند سالت است؟","full":"How old are you?","a":"audio/en-fa/987b915582ae.mp3"},{"type":"order","t":"I am twenty years old.","s":"من بیست سالم است.","full":"I am twenty years old.","a":"audio/en-fa/2647c14bff4b.mp3"}]},{"id":"g02","title":{"t":"Plural -s","s":"جمع بستن اسم با -s"},"explain":"وقتی بیشتر از یک چیز داریم، معمولاً به آخر اسم **s** اضافه می‌کنیم: one cat (یک گربه)، two cat**s** (دو گربه).\nدقت کنید: در فارسی بعد از عدد، اسم مفرد می‌ماند (سه کتاب)، اما در انگلیسی **s** لازم است: three book**s**.\nبعد از s، sh، ch و x معمولاً **es** اضافه می‌شود: bus**es**، box**es**.\nچند کلمه جمعِ خاص دارند و باید حفظشان کنیم: child و **children** (بچه‌ها)؛ fish و **fish** (بدون تغییر).","table":[["one cat","two cats"],["one book","three books"],["one bus","two buses"],["one box","four boxes"],["one child","five children"]],"examples":[{"t":"One boy and two girls.","s":"یک پسر و دو دختر.","a":"audio/en-fa/7118c2577493.mp3"},{"t":"Sara and Neda are students.","s":"سارا و ندا دانش‌آموز هستند.","a":"audio/en-fa/f6bf6db75f9b.mp3"},{"t":"Ali and Reza are friends.","s":"علی و رضا با هم دوست هستند.","a":"audio/en-fa/739650788128.mp3"},{"t":"Three cats and four dogs.","s":"سه گربه و چهار سگ.","a":"audio/en-fa/eeebac89e3ce.mp3"}],"exercises":[{"type":"choice","t":"two ___","options":["cat","cats"],"answer":1,"s":"دو گربه","full":"two cats","a":"audio/en-fa/2fd4c2394277.mp3"},{"type":"choice","t":"one ___","options":["book","books"],"answer":0,"s":"یک کتاب","full":"one book","a":"audio/en-fa/234038f53c92.mp3"},{"type":"choice","t":"three ___","options":["bus","buses"],"answer":1,"s":"سه اتوبوس","full":"three buses","a":"audio/en-fa/6e8d82371084.mp3"},{"type":"choice","t":"five ___","options":["child","children"],"answer":1,"s":"پنج بچه","full":"five children","a":"audio/en-fa/55c8e150b2cf.mp3"},{"type":"type","t":"They are ___.","answer":["students"],"s":"آن‌ها دانشجو هستند.","full":"They are students.","a":"audio/en-fa/ce5d497cbde7.mp3"},{"type":"type","t":"two ___ and one dog","answer":["cats"],"s":"دو گربه و یک سگ","full":"two cats and one dog","a":"audio/en-fa/19bee5390342.mp3"},{"type":"order","t":"We are students.","s":"ما دانشجو هستیم.","full":"We are students.","a":"audio/en-fa/9d4ebb9c9e73.mp3"},{"type":"order","t":"Sara and Neda are girls.","s":"سارا و ندا دختر هستند.","full":"Sara and Neda are girls.","a":"audio/en-fa/fd08c0f80d1f.mp3"}]}],"reading":{"title":{"t":"Hello, I'm Neda!","s":"سلام، من ندا هستم!","a":"audio/en-fa/f9ea83c8ea37.mp3"},"text":[{"t":"Hello! My name is Neda.","s":"سلام! اسم من ندا است.","a":"audio/en-fa/2a3c96d70fff.mp3"},{"t":"I'm from Iran, and I'm twelve years old.","s":"من اهل ایران هستم و دوازده سالم است.","a":"audio/en-fa/f240249d0072.mp3"},{"t":"Emma is my friend.","s":"اِما دوست من است.","a":"audio/en-fa/b980291818c8.mp3"},{"t":"She is from America. She is thirteen.","s":"او اهل آمریکاست. او سیزده سالش است.","a":"audio/en-fa/198177414189.mp3"},{"t":"Ali and Reza are my friends, too.","s":"علی و رضا هم دوستان من هستند.","a":"audio/en-fa/6a78fe422e0a.mp3"},{"t":"They are boys.","s":"آن‌ها پسر هستند.","a":"audio/en-fa/90aee3aaa0f9.mp3"},{"t":"Ali is eleven, and Reza is fourteen.","s":"علی یازده سالش است و رضا چهارده سالش است.","a":"audio/en-fa/e6cf17b45c6a.mp3"},{"t":"We are students.","s":"ما دانش‌آموز هستیم.","a":"audio/en-fa/9d4ebb9c9e73.mp3"}],"questions":[{"q":{"t":"How old is Neda?","s":"ندا چند سالش است؟","a":"audio/en-fa/664e87939e9a.mp3"},"options":["twelve","thirteen","twenty"],"answer":0},{"q":{"t":"Where is Emma from?","s":"اِما اهل کجاست؟","a":"audio/en-fa/2df72289c31a.mp3"},"options":["Iran","America","England"],"answer":1},{"q":{"t":"How old is Reza?","s":"رضا چند سالش است؟","a":"audio/en-fa/5ea621058d2c.mp3"},"options":["eleven","fourteen","four"],"answer":1},{"q":{"t":"Are Ali and Reza girls?","s":"آیا علی و رضا دختر هستند؟","a":"audio/en-fa/5eb546e7b66b.mp3"},"options":["Yes, they are.","No, they aren't."],"answer":1}]},"sentences":[{"t":"I am eighteen years old.","s":"من هجده سالم است.","a":"audio/en-fa/e7e972b8bac2.mp3"},{"t":"How old is your friend?","s":"دوستت چند سالش است؟","a":"audio/en-fa/ee2df62f04fa.mp3"},{"t":"She is twenty.","s":"او بیست سالش است.","a":"audio/en-fa/ecba45bf307c.mp3"},{"t":"Ten, eleven, twelve!","s":"ده، یازده، دوازده!","a":"audio/en-fa/33ae4787cfc0.mp3"},{"t":"Two boys and three girls.","s":"دو پسر و سه دختر.","a":"audio/en-fa/02b36e66ed21.mp3"},{"t":"They are students.","s":"آن‌ها دانشجو هستند.","a":"audio/en-fa/ce5d497cbde7.mp3"},{"t":"Happy birthday, Amir!","s":"تولدت مبارک، امیر!","a":"audio/en-fa/22468aeaaf97.mp3"}],"img":"img/e/1f522.svg"}