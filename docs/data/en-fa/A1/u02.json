/c29bf7b81522.mp3"},{"id":"p07","t":"Let's count!","s":"بیایید بشماریم!","pr":"لِتس کاونت!","a":"audio/en-fa/545f3bc63dcd.mp3"}],"dialogue":{"title":{"t":"Happy birthday!","s":"تولدت مبارک!","a":"audio/en-fa/1e55188525d0.mp3"},"speakers":{"A":{"name":"Emma","voice":"f"},"B":{"name":"Ali","voice":"m"}},"lines":[{"sp":"A","t":"Hi, Ali!","s":"سلام علی!","a":"audio/en-fa/e714f515daf1.mp3"},{"sp":"B","t":"Hi, Emma! How are you?","s":"سلام اِما! حالت چطور است؟","a":"audio/en-fa/15b5e2d054f8.mp3"},{"sp":"A","t":"I'm fine, thank you. It's my birthday!","s":"خوبم، ممنون. امروز تولد من است!","a":"audio/en-fa/7c6c16549c5a.mp3"},{"sp":"B","t":"Happy birthday! How old are you?","s":"تولدت مبارک! چند سالت است؟","a":"audio/en-fa/f19ff21efbab.mp3"},{"sp":"A","t":"I'm thirteen. And you?","s":"سیزده سالم است. تو چطور؟","a":"audio/en-fa/87ff6fb66245.mp3"},{"sp":"B","t":"I'm eleven years old.","s":"من یازده سالم است.","a":"audio/en-fa/1fdaf94b4343.mp3"},{"sp":"A","t":"What's your phone number, Ali?","s":"علی، شمارهٔ تلفنت چیست؟","a":"audio/en-fa/231032eac13f.mp3"},{"sp":"B","t":"It's five-five-five, one-two-three-four.","s":"شماره‌ام ۵۵۵۱۲۳۴ است.","a":"audio/en-fa/8bd5d6422680.mp3"},{"sp":"A","t":"Thank you! Goodbye!","s":"ممنون! خداحافظ!","a":"audio/en-fa/bc29609d5892.mp3"},{"sp":"B","t":"Goodbye, Emma!","s":"خداحافظ، اِما!","a":"audio/en-fa/0a3be4a61e93.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Numbers 11–20 and age","s":"عددهای ۱۱ تا ۲۰ و گفتن سن"},"explain":"عددهای ۱۳ تا ۱۹ با **teen** تمام می‌شوند: thir**teen** (۱۳)، four**teen** (۱۴)، six**teen** (۱۶). بخش آخر را کشیده و محکم بگویید: «تین».\nعددهای ۱۱ و ۱۲ شکل خاص دارند: **eleven** و **twelve**. عدد ۲۰ هم **twenty** است.\nبرای پرسیدن سن می‌گوییم: **How old are you?** و جواب می‌دهیم: **I'm** + عدد + **years old**. مثلاً: I'm fifteen years old. کوتاه‌تر هم می‌شود گفت: I'm fifteen.\nدقت کنید: برای یک سال می‌گوییم **one year old**، بدون s.","table":[["11","eleven"],["12","twelve"],["13","thirteen"],["14","fourteen"],["15","fifteen"],["16","sixteen"],["17","seventeen"],["18","eighteen"],["19","nineteen"],["20","twenty"]],"examples":[{"t":"How old are you?","s":"چند سالت است؟","a":"audio/en-fa/f5152493b19c.mp3"},{"t":"I'm twelve years old.","s":"دوازده سالم است.","a":"audio/en-fa/69f02a516a30.mp3"},{"t":"Emma is thirteen.","s":"اِما سیزده‌ساله است.","a":"audio/en-fa/dd961b29d508.mp3"},{"t":"How old is Reza? — He's fourteen.","s":"رضا چند سالش است؟ — چهارده سالش است.","a":"audio/en-fa/a02425841279.mp3"}],"exercises":[{"type":"choice","t":"How ___ are you?","options":["old","year","name"],"answer":0,"s":"چند سالت است؟","full":"How old are you?","a":"audio/en-fa/f5152493b19c.mp3"},{"type":"choice","t":"I'm sixteen ___ old.","options":["year","years","yes"],"answer":1,"s":"شانزده سالم است.","full":"I'm sixteen years old.","a":"audio/en-fa/1319db4430aa.mp3"},{"type":"choice","t":"Amir is one ___ old.","options":["year","years"],"answer":0,"s":"امیر یک‌ساله است.","full":"Amir is one year old.","a":"audio/en-fa/054c8306cf9b.mp3"},{"type":"type","t":"ten, eleven, ___, thirteen","answer":["twelve"],"s":"ده، یازده، دوازده، سیزده","full":"ten, eleven, twelve, thirteen","a":"audio/en-fa/35b3995adafc.mp3"},{"type":"choice","t":"18 = ___","options":["eight","eighteen","eleven"],"answer":1,"s":"۱۸ = هجده","full":"18 = eighteen","a":"audio/en-fa/3f565750ccc0.mp3"},{"type":"type","t":"Ten and ten is ___.","answer":["twenty"],"s":"ده به‌اضافهٔ ده می‌شود بیست.","full":"Ten and ten is twenty.","a":"audio/en-fa/eed9acd60f73.mp3"},{"type":"order","t":"How old are you?","s":"چند سالت است؟","full":"How old are you?","a":"audio/en-fa/f5152493b19c.mp3"},{"type":"order","t":"I am twenty years old.","s":"من بیست سالم است.","full":"I am twenty years old.","a":"audio/en-fa/04f679c9fcaa.mp3"}]},{"id":"g02","title":{"t":"Plural -s","s":"جمع بستن اسم با -s"},"explain":"وقتی بیشتر از یک چیز داریم، معمولاً به آخر اسم **s** اضافه می‌کنیم: one cat (یک گربه)، two cat**s** (دو گربه).\nدقت کنید: در فارسی بعد از عدد، اسم مفرد می‌ماند (سه کتاب)، اما در انگلیسی **s** لازم است: three book**s**.\nبعد از s، sh، ch و x معمولاً **es** اضافه می‌شود: bus**es**، box**es**.\nچند کلمه جمعِ خاص دارند و باید حفظشان کنیم: child و **children** (بچه‌ها)؛ fish و **fish** (بدون تغییر).","table":[["one cat","two cats"],["one book","three books"],["one bus","two buses"],["one box","four boxes"],["one child","five children"]],"examples":[{"t":"One boy and two girls.","s":"یک پسر و دو دختر.","a":"audio/en-fa/7167476109b9.mp3"},{"t":"Sara and Neda are students.","s":"سارا و ندا دانش‌آموز هستند.","a":"audio/en-fa/cea639fb82a7.mp3"},{"t":"Ali and Reza are friends.","s":"علی و رضا با هم دوست هستند.","a":"audio/en-fa/48a483c36268.mp3"},{"t":"Three cats and four dogs.","s":"سه گربه و چهار سگ.","a":"audio/en-fa/27bbb8d884a4.mp3"}],"exercises":[{"type":"choice","t":"two ___","options":["cat","cats"],"answer":1,"s":"دو گربه","full":"two cats","a":"audio/en-fa/f703c7a6b9d6.mp3"},{"type":"choice","t":"one ___","options":["book","books"],"answer":0,"s":"یک کتاب","full":"one book","a":"audio/en-fa/fc4a1a48091a.mp3"},{"type":"choice","t":"three ___","options":["bus","buses"],"answer":1,"s":"سه اتوبوس","full":"three buses","a":"audio/en-fa/825f313a0822.mp3"},{"type":"choice","t":"five ___","options":["child","children"],"answer":1,"s":"پنج بچه","full":"five children","a":"audio/en-fa/ad9473175acb.mp3"},{"type":"type","t":"They are ___.","answer":["students"],"s":"آن‌ها دانشجو هستند.","full":"They are students.","a":"audio/en-fa/4785cdfe1583.mp3"},{"type":"type","t":"two ___ and one dog","answer":["cats"],"s":"دو گربه و یک سگ","full":"two cats and one dog","a":"audio/en-fa/0283f638b379.mp3"},{"type":"order","t":"We are students.","s":"ما دانشجو هستیم.","full":"We are students.","a":"audio/en-fa/dc01c7c62cce.mp3"},{"type":"order","t":"Sara and Neda are girls.","s":"سارا و ندا دختر هستند.","full":"Sara and Neda are girls.","a":"audio/en-fa/41da622ac1b1.mp3"}]}],"reading":{"title":{"t":"Hello, I'm Neda!","s":"سلام، من ندا هستم!","a":"audio/en-fa/36b36d94f94e.mp3"},"text":[{"t":"Hello! My name is Neda.","s":"سلام! اسم من ندا است.","a":"audio/en-fa/ab4e2b835da9.mp3"},{"t":"I'm from Iran, and I'm twelve years old.","s":"من اهل ایران هستم و دوازده سالم است.","a":"audio/en-fa/74983e27917f.mp3"},{"t":"Emma is my friend.","s":"اِما دوست من است.","a":"audio/en-fa/29bfa27926a2.mp3"},{"t":"She is from America. She is thirteen.","s":"او اهل آمریکاست. او سیزده سالش است.","a":"audio/en-fa/f1669a3a713d.mp3"},{"t":"Ali and Reza are my friends, too.","s":"علی و رضا هم دوستان من هستند.","a":"audio/en-fa/8007bd6742e3.mp3"},{"t":"They are boys.","s":"آن‌ها پسر هستند.","a":"audio/en-fa/1135cd31182d.mp3"},{"t":"Ali is eleven, and Reza is fourteen.","s":"علی یازده سالش است و رضا چهارده سالش است.","a":"audio/en-fa/c9f760e13bb4.mp3"},{"t":"We are students.","s":"ما دانش‌آموز هستیم.","a":"audio/en-fa/dc01c7c62cce.mp3"}],"questions":[{"q":{"t":"How old is Neda?","s":"ندا چند سالش است؟","a":"audio/en-fa/e3af6cc7923b.mp3"},"options":["twelve","thirteen","twenty"],"answer":0},{"q":{"t":"Where is Emma from?","s":"اِما اهل کجاست؟","a":"audio/en-fa/f014863a5242.mp3"},"options":["Iran","America","England"],"answer":1},{"q":{"t":"How old is Reza?","s":"رضا چند سالش است؟","a":"audio/en-fa/977a614717db.mp3"},"options":["eleven","fourteen","four"],"answer":1},{"q":{"t":"Are Ali and Reza girls?","s":"آیا علی و رضا دختر هستند؟","a":"audio/en-fa/44cbea4191ab.mp3"},"options":["Yes, they are.","No, they aren't."],"answer":1}]},"sentences":[{"t":"I am eighteen years old.","s":"من هجده سالم است.","a":"audio/en-fa/17537243a25d.mp3"},{"t":"How old is your friend?","s":"دوستت چند سالش است؟","a":"audio/en-fa/6cf212d3200f.mp3"},{"t":"She is twenty.","s":"او بیست سالش است.","a":"audio/en-fa/fe3e7f04ff56.mp3"},{"t":"Ten, eleven, twelve!","s":"ده، یازده، دوازده!","a":"audio/en-fa/c524199cac2a.mp3"},{"t":"Two boys and three girls.","s":"دو پسر و سه دختر.","a":"audio/en-fa/904362cdef53.mp3"},{"t":"They are students.","s":"آن‌ها دانشجو هستند.","a":"audio/en-fa/4785cdfe1583.mp3"},{"t":"Happy birthday, Amir!","s":"تولدت مبارک، امیر!","a":"audio/en-fa/b7dd2ecd5577.mp3"}],"img":"img/e/1f522.svg"}