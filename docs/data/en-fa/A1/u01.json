5c61e1be.mp3"},"img":"img/e/1f91d.svg","a":"audio/en-fa/fa9bf1a3fe24.mp3","pla":"audio/en-fa/1b54ec8cfba7.mp3"},{"id":"w10","t":"student","pl":"students","s":"دانشجو، دانش‌آموز","pr":"ستودِنت","emoji":"🎓","ex":{"t":"I am a student.","s":"من دانشجو هستم.","a":"audio/en-fa/eb7f97ebfbf7.mp3"},"img":"img/e/1f393.svg","a":"audio/en-fa/5645e370a5a7.mp3","pla":"audio/en-fa/248fe38e3b44.mp3"},{"id":"w11","t":"teacher","pl":"teachers","s":"معلم","pr":"تیچِر","emoji":"","ex":{"t":"She is a teacher.","s":"او معلم است.","a":"audio/en-fa/950e11050cf5.mp3"},"img":null,"a":"audio/en-fa/03fa6a45b499.mp3","pla":"audio/en-fa/f6b61cc29d48.mp3"},{"id":"w12","t":"from","s":"از، اهلِ","pr":"فرام","emoji":"","ex":{"t":"I am from Iran.","s":"من اهل ایران هستم.","a":"audio/en-fa/3dcb0908e8dc.mp3"},"img":null,"a":"audio/en-fa/f35720f0f6b2.mp3"},{"id":"w13","t":"yes","s":"بله","pr":"یِس","emoji":"✅","ex":{"t":"Yes, I am a student.","s":"بله، من دانشجو هستم.","a":"audio/en-fa/7cb315cd4d69.mp3"},"img":"img/e/2705.svg","a":"audio/en-fa/c03f406e9952.mp3"},{"id":"w14","t":"no","s":"نه","pr":"نُو","emoji":"❌","ex":{"t":"No, I am not a teacher.","s":"نه، من معلم نیستم.","a":"audio/en-fa/39239b0c5509.mp3"},"img":"img/e/274c.svg","a":"audio/en-fa/6c93127dd145.mp3"}],"phrases":[{"id":"p01","t":"Good morning!","s":"صبح بخیر!","pr":"گود مُرنینگ!","a":"audio/en-fa/acb12743ba45.mp3"},{"id":"p02","t":"Goodbye!","s":"خداحافظ!","pr":"گودبای!","a":"audio/en-fa/b241f6a6cb39.mp3"},{"id":"p03","t":"How are you?","s":"حالت چطور است؟","pr":"هاو آر یو؟","a":"audio/en-fa/7ed0308fcc13.mp3"},{"id":"p04","t":"I'm fine, thank you.","s":"خوبم، ممنون.","pr":"آیم فاین، ثَنک یو.","a":"audio/en-fa/0da6d7876f76.mp3"},{"id":"p05","t":"What's your name?","s":"اسمت چیست؟","pr":"واتس یور نِیم؟","a":"audio/en-fa/17e028377c6c.mp3"},{"id":"p06","t":"My name is …","s":"اسم من … است.","pr":"مای نِیم ایز …","a":"audio/en-fa/13724916db8a.mp3"},{"id":"p07","t":"Where are you from?","s":"اهل کجا هستی؟","pr":"وِر آر یو فرام؟","a":"audio/en-fa/2023d0f6818f.mp3"},{"id":"p08","t":"Nice to meet you.","s":"از آشنایی با شما خوشحالم.","pr":"نایس تو میت یو.","a":"audio/en-fa/f84ce831405d.mp3"}],"dialogue":{"title":{"t":"In English class","s":"در کلاس زبان انگلیسی","a":"audio/en-fa/56844e08513b.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Tom","voice":"m"}},"lines":[{"sp":"A","t":"Hello! I'm Sara.","s":"سلام! من سارا هستم.","a":"audio/en-fa/8852d8d820f2.mp3"},{"sp":"B","t":"Hi, Sara! My name is Tom.","s":"سلام سارا! اسم من تام است.","a":"audio/en-fa/253f14f2271f.mp3"},{"sp":"A","t":"Nice to meet you, Tom.","s":"خوشبختم، تام.","a":"audio/en-fa/90255e3f8a12.mp3"},{"sp":"B","t":"Nice to meet you, too. Where are you from?","s":"من هم خوشبختم. اهل کجا هستی؟","a":"audio/en-fa/b16b0769d634.mp3"},{"sp":"A","t":"I'm from Iran. And you?","s":"من اهل ایران هستم. تو چطور؟","a":"audio/en-fa/0ad05b7fa9a8.mp3"},{"sp":"B","t":"I'm from America.","s":"من اهل آمریکا هستم.","a":"audio/en-fa/730dc5f7cd6a.mp3"},{"sp":"A","t":"Are you a student?","s":"تو دانشجو هستی؟","a":"audio/en-fa/8f6ff32b1fb9.mp3"},{"sp":"B","t":"No, I'm not. I'm a teacher.","s":"نه، نیستم. من معلم هستم.","a":"audio/en-fa/601427287bf6.mp3"},{"sp":"A","t":"Goodbye, Tom!","s":"خداحافظ، تام!","a":"audio/en-fa/49dffccf9e15.mp3"},{"sp":"B","t":"Goodbye, Sara!","s":"خداحافظ، سارا!","a":"audio/en-fa/523cbae1bc10.mp3"}]},"grammar":[{"id":"g01","title":{"t":"to be: am / is / are","s":"فعل «بودن»"},"explain":"فعل «بودن» در انگلیسی سه شکل دارد: **am**، **is** و **are**.\nبا **I** (من) همیشه **am** می‌آید: I am Sara.\nبا **he** (او – مرد)، **she** (او – زن) و **it** (آن – برای چیزها و حیوان‌ها) از **is** استفاده می‌کنیم. با **you** (تو / شما)، **we** (ما) و **they** (آن‌ها) از **are** استفاده می‌کنیم.\nدر صحبت روزمره معمولاً شکل کوتاه را می‌گوییم: **I'm**، **you're**، **he's**، **she's**، **we're**، **they're**.\nنکته: قبل از شغل یک **a** می‌آید: She is **a** teacher.","table":[["I","am","I'm"],["you","are","you're"],["he / she / it","is","he's / she's / it's"],["we","are","we're"],["they","are","they're"]],"examples":[{"t":"I am Ali.","s":"من علی هستم.","a":"audio/en-fa/d23ff1a8f449.mp3"},{"t":"She is from Iran.","s":"او اهل ایران است.","a":"audio/en-fa/70f29939cbe0.mp3"},{"t":"We are students.","s":"ما دانشجو هستیم.","a":"audio/en-fa/dc01c7c62cce.mp3"},{"t":"They're teachers.","s":"آن‌ها معلم هستند.","a":"audio/en-fa/23a4cccbad34.mp3"},{"t":"You're my friend.","s":"تو دوست من هستی.","a":"audio/en-fa/37c865184a09.mp3"}],"exercises":[{"type":"choice","t":"I ___ Maryam.","options":["am","is","are"],"answer":0,"s":"من مریم هستم.","full":"I am Maryam.","a":"audio/en-fa/958d896388fc.mp3"},{"type":"choice","t":"He ___ a teacher.","options":["are","am","is"],"answer":2,"s":"او معلم است.","full":"He is a teacher.","a":"audio/en-fa/985f677c6322.mp3"},{"type":"choice","t":"We ___ from Iran.","options":["is","are","am"],"answer":1,"s":"ما اهل ایران هستیم.","full":"We are from Iran.","a":"audio/en-fa/bf2e0cde7d83.mp3"},{"type":"type","t":"She ___ a student.","answer":["is"],"s":"او دانشجو است.","full":"She is a student.","a":"audio/en-fa/9ba9e930ba46.mp3"},{"type":"type","t":"They ___ friends.","answer":["are"],"s":"آن‌ها با هم دوست هستند.","full":"They are friends.","a":"audio/en-fa/4be27bfaa8fe.mp3"},{"type":"choice","t":"You ___ my friend.","options":["am","are","is"],"answer":1,"s":"تو دوست من هستی.","full":"You are my friend.","a":"audio/en-fa/72fe9227ac5b.mp3"},{"type":"order","t":"I am from Iran.","s":"من اهل ایران هستم.","full":"I am from Iran.","a":"audio/en-fa/3dcb0908e8dc.mp3"},{"type":"order","t":"She is a teacher.","s":"او معلم است.","full":"She is a teacher.","a":"audio/en-fa/950e11050cf5.mp3"}]},{"id":"g02","title":{"t":"Questions and short answers","s":"سؤال و جواب کوتاه"},"explain":"برای ساختن سؤال، فعل را **اول جمله** می‌آوریم: جملهٔ You are a student. می‌شود **Are you** a student?\nجواب کوتاه: **Yes, I am.** یا **No, I'm not.**\nکلمهٔ **not** جمله را منفی می‌کند و بعد از فعل می‌آید: I'm **not** a teacher. شکل کوتاه: is not = **isn't** و are not = **aren't**.\nکلمه‌های پرسشی **What** (چه، چی) و **Where** (کجا) اول جمله می‌آیند: **What's** your name? **Where** are you from?","table":[["Are you a student?","Yes, I am.","No, I'm not."],["Is he from Iran?","Yes, he is.","No, he isn't."],["Are they friends?","Yes, they are.","No, they aren't."]],"examples":[{"t":"Are you from Iran?","s":"تو اهل ایران هستی؟","a":"audio/en-fa/8d66125ba92e.mp3"},{"t":"Is she a teacher? — Yes, she is.","s":"او معلم است؟ — بله، هست.","a":"audio/en-fa/8e3ec3bd27bd.mp3"},{"t":"I'm not a student.","s":"من دانشجو نیستم.","a":"audio/en-fa/2e7ef4aff0f8.mp3"},{"t":"Where is Tom from? — He's from America.","s":"تام اهل کجاست؟ — او اهل آمریکاست.","a":"audio/en-fa/e00524bf4d41.mp3"}],"exercises":[{"type":"choice","t":"___ you a student?","options":["Is","Are","Am"],"answer":1,"s":"تو دانشجو هستی؟","full":"Are you a student?","a":"audio/en-fa/8f6ff32b1fb9.mp3"},{"type":"choice","t":"___ he from Iran?","options":["Is","Are","Am"],"answer":0,"s":"او اهل ایران است؟","full":"Is he from Iran?","a":"audio/en-fa/a9643e5ec81e.mp3"},{"type":"choice","t":"Where ___ you from?","options":["is","are","am"],"answer":1,"s":"اهل کجا هستی؟","full":"Where are you from?","a":"audio/en-fa/2023d0f6818f.mp3"},{"type":"choice","t":"Are you Sara? — Yes, I ___.","options":["am","is","are"],"answer":0,"s":"تو سارا هستی؟ — بله، هستم.","full":"Are you Sara? — Yes, I am.","a":"audio/en-fa/17b3424d3c40.mp3"},{"type":"type","t":"___ is your name?","answer":["What"],"s":"اسمت چیست؟","full":"What is your name?","a":"audio/en-fa/dc12ecdc3d69.mp3"},{"type":"type","t":"I am ___ a teacher.","answer":["not"],"s":"من معلم نیستم.","full":"I am not a teacher.","a":"audio/en-fa/15760ec91416.mp3"},{"type":"order","t":"Where are you from?","s":"اهل کجا هستی؟","full":"Where are you from?","a":"audio/en-fa/2023d0f6818f.mp3"},{"type":"order","t":"What is your name?","s":"اسمت چیست؟","full":"What is your name?","a":"audio/en-fa/dc12ecdc3d69.mp3"}]}],"reading":{"title":{"t":"My name is Reza","s":"اسم من رضا است","a":"audio/en-fa/138df159b3d3.mp3"},"text":[{"t":"Hello! My name is Reza.","s":"سلام! اسم من رضا است.","a":"audio/en-fa/9deee83f1ab4.mp3"},{"t":"I am from Iran.","s":"من اهل ایران هستم.","a":"audio/en-fa/3dcb0908e8dc.mp3"},{"t":"I am a student.","s":"من دانشجو هستم.","a":"audio/en-fa/eb7f97ebfbf7.mp3"},{"t":"This is Emma.","s":"این اِما است.","a":"audio/en-fa/919c8899b608.mp3"},{"t":"She is my friend.","s":"او دوست من است.","a":"audio/en-fa/590e7ba94093.mp3"},{"t":"Emma is from America.","s":"اِما اهل آمریکاست.","a":"audio/en-fa/19f1c8da4779.mp3"},{"t":"She is not a student. She is a teacher.","s":"او دانشجو نیست. او معلم است.","a":"audio/en-fa/77ea848c05b0.mp3"}],"questions":[{"q":{"t":"Where is Reza from?","s":"رضا اهل کجاست؟","a":"audio/en-fa/e70c1163f8c3.mp3"},"options":["Iran","America","England"],"answer":0},{"q":{"t":"Is Reza a student?","s":"آیا رضا دانشجو است؟","a":"audio/en-fa/49bbe7e70a82.mp3"},"options":["Yes, he is.","No, he isn't."],"answer":0},{"q":{"t":"Where is Emma from?","s":"اِما اهل کجاست؟","a":"audio/en-fa/f014863a5242.mp3"},"options":["Iran","America","England"],"answer":1},{"q":{"t":"Is Emma a student?","s":"آیا اِما دانشجو است؟","a":"audio/en-fa/bfea4a4c4ddb.mp3"},"options":["Yes, she is.","No, she isn't."],"answer":1}]},"sentences":[{"t":"Hello, my name is Neda.","s":"سلام، اسم من ندا است.","a":"audio/en-fa/a7a7721beaf7.mp3"},{"t":"I'm from Iran.","s":"من اهل ایران هستم.","a":"audio/en-fa/cdcd1ffb3e4e.mp3"},{"t":"He is a teacher.","s":"او معلم است.","a":"audio/en-fa/985f677c6322.mp3"},{"t":"Are you a student?","s":"تو دانشجو هستی؟","a":"audio/en-fa/8f6ff32b1fb9.mp3"},{"t":"Where is Ali from?","s":"علی اهل کجاست؟","a":"audio/en-fa/974d30f09bf4.mp3"},{"t":"Nice to meet you.","s":"از آشنایی با شما خوشحالم.","a":"audio/en-fa/f84ce831405d.mp3"},{"t":"They are my friends.","s":"آن‌ها دوستان من هستند.","a":"audio/en-fa/bcd2fe15c56e.mp3"},{"t":"Good morning, Maryam!","s":"صبح بخیر، مریم!","a":"audio/en-fa/c17f87552a5b.mp3"}],"img":"img/e/1f44b.svg"}