a/9ab60aa9e28e.mp3"},{"id":"p08","t":"Nice to meet you.","s":"از آشنایی با شما خوشحالم.","pr":"نایس تو میت یو.","a":"audio/en-fa/1f9042de78bb.mp3"}],"dialogue":{"title":{"t":"In English class","s":"در کلاس زبان انگلیسی","a":"audio/en-fa/b333b08aae60.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Tom","voice":"m"}},"lines":[{"sp":"A","t":"Hello! I'm Sara.","s":"سلام! من سارا هستم.","a":"audio/en-fa/858a7a8280a1.mp3"},{"sp":"B","t":"Hi, Sara! My name is Tom.","s":"سلام سارا! اسم من تام است.","a":"audio/en-fa/7473d91bd583.mp3"},{"sp":"A","t":"Nice to meet you, Tom.","s":"خوشبختم، تام.","a":"audio/en-fa/5eeb83dc3923.mp3"},{"sp":"B","t":"Nice to meet you, too. Where are you from?","s":"من هم خوشبختم. اهل کجا هستی؟","a":"audio/en-fa/7b500e3576a8.mp3"},{"sp":"A","t":"I'm from Iran. And you?","s":"من اهل ایران هستم. تو چطور؟","a":"audio/en-fa/6f3adbfbc0fc.mp3"},{"sp":"B","t":"I'm from America.","s":"من اهل آمریکا هستم.","a":"audio/en-fa/0ba31ba3960c.mp3"},{"sp":"A","t":"Are you a student?","s":"تو دانشجو هستی؟","a":"audio/en-fa/053486b60e8a.mp3"},{"sp":"B","t":"No, I'm not. I'm a teacher.","s":"نه، نیستم. من معلم هستم.","a":"audio/en-fa/9384f76ee5d4.mp3"},{"sp":"A","t":"Goodbye, Tom!","s":"خداحافظ، تام!","a":"audio/en-fa/63acdc1149f0.mp3"},{"sp":"B","t":"Goodbye, Sara!","s":"خداحافظ، سارا!","a":"audio/en-fa/ed1d41dcebbc.mp3"}]},"grammar":[{"id":"g01","title":{"t":"to be: am / is / are","s":"فعل «بودن»"},"explain":"فعل «بودن» در انگلیسی سه شکل دارد: **am**، **is** و **are**.\nبا **I** (من) همیشه **am** می‌آید: I am Sara.\nبا **he** (او – مرد)، **she** (او – زن) و **it** (آن – برای چیزها و حیوان‌ها) از **is** استفاده می‌کنیم. با **you** (تو / شما)، **we** (ما) و **they** (آن‌ها) از **are** استفاده می‌کنیم.\nدر صحبت روزمره معمولاً شکل کوتاه را می‌گوییم: **I'm**، **you're**، **he's**، **she's**، **we're**، **they're**.\nنکته: قبل از شغل یک **a** می‌آید: She is **a** teacher.","table":[["I","am","I'm"],["you","are","you're"],["he / she / it","is","he's / she's / it's"],["we","are","we're"],["they","are","they're"]],"examples":[{"t":"I am Ali.","s":"من علی هستم.","a":"audio/en-fa/322668452ad7.mp3"},{"t":"She is from Iran.","s":"او اهل ایران است.","a":"audio/en-fa/bbac0a053ceb.mp3"},{"t":"We are students.","s":"ما دانشجو هستیم.","a":"audio/en-fa/9d4ebb9c9e73.mp3"},{"t":"They're teachers.","s":"آن‌ها معلم هستند.","a":"audio/en-fa/8c69abdd4171.mp3"},{"t":"You're my friend.","s":"تو دوست من هستی.","a":"audio/en-fa/d9752666473b.mp3"}],"exercises":[{"type":"choice","t":"I ___ Maryam.","options":["am","is","are"],"answer":0,"s":"من مریم هستم.","full":"I am Maryam.","a":"audio/en-fa/1e56d8fb4b54.mp3"},{"type":"choice","t":"He ___ a teacher.","options":["are","am","is"],"answer":2,"s":"او معلم است.","full":"He is a teacher.","a":"audio/en-fa/4ce6b58507cb.mp3"},{"type":"choice","t":"We ___ from Iran.","options":["is","are","am"],"answer":1,"s":"ما اهل ایران هستیم.","full":"We are from Iran.","a":"audio/en-fa/27b09f0698ff.mp3"},{"type":"type","t":"She ___ a student.","answer":["is"],"s":"او دانشجو است.","full":"She is a student.","a":"audio/en-fa/f1b070048352.mp3"},{"type":"type","t":"They ___ friends.","answer":["are"],"s":"آن‌ها با هم دوست هستند.","full":"They are friends.","a":"audio/en-fa/b4197379fd11.mp3"},{"type":"choice","t":"You ___ my friend.","options":["am","are","is"],"answer":1,"s":"تو دوست من هستی.","full":"You are my friend.","a":"audio/en-fa/ae6ebf7cb0eb.mp3"},{"type":"order","t":"I am from Iran.","s":"من اهل ایران هستم.","full":"I am from Iran.","a":"audio/en-fa/da8d33af3d2b.mp3"},{"type":"order","t":"She is a teacher.","s":"او معلم است.","full":"She is a teacher.","a":"audio/en-fa/0a301e9667bd.mp3"}]},{"id":"g02","title":{"t":"Questions and short answers","s":"سؤال و جواب کوتاه"},"explain":"برای ساختن سؤال، فعل را **اول جمله** می‌آوریم: جملهٔ You are a student. می‌شود **Are you** a student?\nجواب کوتاه: **Yes, I am.** یا **No, I'm not.**\nکلمهٔ **not** جمله را منفی می‌کند و بعد از فعل می‌آید: I'm **not** a teacher. شکل کوتاه: is not = **isn't** و are not = **aren't**.\nکلمه‌های پرسشی **What** (چه، چی) و **Where** (کجا) اول جمله می‌آیند: **What's** your name? **Where** are you from?","table":[["Are you a student?","Yes, I am.","No, I'm not."],["Is he from Iran?","Yes, he is.","No, he isn't."],["Are they friends?","Yes, they are.","No, they aren't."]],"examples":[{"t":"Are you from Iran?","s":"تو اهل ایران هستی؟","a":"audio/en-fa/d628abbbf685.mp3"},{"t":"Is she a teacher? — Yes, she is.","s":"او معلم است؟ — بله، هست.","a":"audio/en-fa/f20770566b0c.mp3"},{"t":"I'm not a student.","s":"من دانشجو نیستم.","a":"audio/en-fa/d8a97e1eb6c9.mp3"},{"t":"Where is Tom from? — He's from America.","s":"تام اهل کجاست؟ — او اهل آمریکاست.","a":"audio/en-fa/5082f4558690.mp3"}],"exercises":[{"type":"choice","t":"___ you a student?","options":["Is","Are","Am"],"answer":1,"s":"تو دانشجو هستی؟","full":"Are you a student?","a":"audio/en-fa/053486b60e8a.mp3"},{"type":"choice","t":"___ he from Iran?","options":["Is","Are","Am"],"answer":0,"s":"او اهل ایران است؟","full":"Is he from Iran?","a":"audio/en-fa/c5deb501b321.mp3"},{"type":"choice","t":"Where ___ you from?","options":["is","are","am"],"answer":1,"s":"اهل کجا هستی؟","full":"Where are you from?","a":"audio/en-fa/9ab60aa9e28e.mp3"},{"type":"choice","t":"Are you Sara? — Yes, I ___.","options":["am","is","are"],"answer":0,"s":"تو سارا هستی؟ — بله، هستم.","full":"Are you Sara? — Yes, I am.","a":"audio/en-fa/c17fe88f672b.mp3"},{"type":"type","t":"___ is your name?","answer":["What"],"s":"اسمت چیست؟","full":"What is your name?","a":"audio/en-fa/3f25d9511f50.mp3"},{"type":"type","t":"I am ___ a teacher.","answer":["not"],"s":"من معلم نیستم.","full":"I am not a teacher.","a":"audio/en-fa/d4df1dd8953b.mp3"},{"type":"order","t":"Where are you from?","s":"اهل کجا هستی؟","full":"Where are you from?","a":"audio/en-fa/9ab60aa9e28e.mp3"},{"type":"order","t":"What is your name?","s":"اسمت چیست؟","full":"What is your name?","a":"audio/en-fa/3f25d9511f50.mp3"}]}],"rea