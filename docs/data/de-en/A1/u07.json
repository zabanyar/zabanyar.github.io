{"id":"u07","level":"A1","emoji":"🗺️","title":{"t":"In der Stadt","s":"In the city","a":"audio/de-en/3724e1232edf.mp3"},"goals":["Name important places in the city","Ask the way: Wo ist …?","Understand and give directions: Gehen Sie geradeaus!","Say where someone is: in der Schule, im Park"],"words":[{"id":"w01","t":"die Stadt","pl":"die Städte","s":"city; town","emoji":"🏙️","ex":{"t":"Die Stadt ist groß.","s":"The city is big.","a":"audio/de-en/94597dbb4aaf.mp3"},"img":"img/e/1f3d9.svg","a":"audio/de-en/92e9ab3211e5.mp3","pla":"audio/de-en/a70ad3621284.mp3"},{"id":"w02","t":"der Bahnhof","pl":"die Bahnhöfe","s":"train station","emoji":"🚉","ex":{"t":"Wo ist der Bahnhof?","s":"Where is the train station?","a":"audio/de-en/2dd7bb8ab2d3.mp3"},"img":"img/e/1f689.svg","a":"audio/de-en/9b2e3eeacd59.mp3","pla":"audio/de-en/e0a4f9f19c75.mp3"},{"id":"w03","t":"die Bank","pl":"die Banken","s":"bank","emoji":"🏦","ex":{"t":"Die Bank ist hier.","s":"The bank is here.","a":"audio/de-en/0a7629151099.mp3"},"img":"img/e/1f3e6.svg","a":"audio/de-en/762d6612ad1d.mp3","pla":"audio/de-en/0cc358369248.mp3"},{"id":"w04","t":"die Apotheke","pl":"die Apotheken","s":"pharmacy","emoji":"💊","ex":{"t":"Maryam ist in der Apotheke.","s":"Maryam is at the pharmacy.","a":"audio/de-en/d50a98b3694c.mp3"},"img":"img/e/1f48a.svg","a":"audio/de-en/bf6dd6bbfcae.mp3","pla":"audio/de-en/76b0ae5b48c5.mp3"},{"id":"w05","t":"der Supermarkt","pl":"die Supermärkte","s":"supermarket","emoji":"🏪","ex":{"t":"Ich kaufe im Supermarkt ein.","s":"I shop at the supermarket.","a":"audio/de-en/dba18755ede6.mp3"},"img":"img/e/1f3ea.svg","a":"audio/de-en/9784e61d72c0.mp3","pla":"audio/de-en/d0f5a8b71349.mp3"},{"id":"w06","t":"das Krankenhaus","pl":"die Krankenhäuser","s":"hospital","emoji":"🏥","ex":{"t":"Das Krankenhaus ist groß.","s":"The hospital is big.","a":"audio/de-en/4584b1bb148c.mp3"},"img":"img/e/1f3e5.svg","a":"audio/de-en/5e52d3c7e9d9.mp3","pla":"audio/de-en/cfba5e167ed5.mp3"},{"id":"w07","t":"die Schule","pl":"die Schulen","s":"school","emoji":"🏫","ex":{"t":"Die Kinder sind in der Schule.","s":"The children are at school.","a":"audio/de-en/cbf4aee9a9b2.mp3"},"img":"img/e/1f3eb.svg","a":"audio/de-en/819b8c377a58.mp3","pla":"audio/de-en/e249d8ca53fd.mp3"},{"id":"w08","t":"der Park","pl":"die Parks","s":"park","emoji":"🌳","ex":{"t":"Wir sind im Park.","s":"We are in the park.","a":"audio/de-en/830ed52a9e9a.mp3"},"img":"img/e/1f333.svg","a":"audio/de-en/ed0b19e0f8c0.mp3","pla":"audio/de-en/79d822abbc54.mp3"},{"id":"w09","t":"die Haltestelle","pl":"die Haltestellen","s":"(bus) stop","emoji":"🚏","ex":{"t":"Die Haltestelle ist links.","s":"The bus stop is on the left.","a":"audio/de-en/2bc0194f3cb2.mp3"},"img":"img/e/1f68f.svg","a":"audio/de-en/1a34a85e5fea.mp3","pla":"audio/de-en/b7aeb5b0403c.mp3"},{"id":"w10","t":"die Straße","pl":"die Straßen","s":"street","emoji":"🛣️","ex":{"t":"Das ist die Goethestraße.","s":"This is Goethe Street.","a":"audio/de-en/e146ba7230f6.mp3"},"img":"img/e/1f6e3.svg","a":"audio/de-en/f6b1b0260b50.mp3","pla":"audio/de-en/712cb62e73e4.mp3"},{"id":"w11","t":"der Bus","pl":"die Busse","s":"bus","emoji":"🚌","ex":{"t":"Der Bus kommt.","s":"The bus is coming.","a":"audio/de-en/cbbf86dd8508.mp3"},"img":"img/e/1f68c.svg","a":"audio/de-en/6bb082f269d4.mp3","pla":"audio/de-en/16f6922e446e.mp3"},{"id":"w12","t":"links","s":"left; on the left","emoji":"⬅️","ex":{"t":"Die Bank ist links.","s":"The bank is on the left.","a":"audio/de-en/157584b3c763.mp3"},"img":"img/e/2b05.svg","a":"audio/de-en/298b414a365a.mp3"},{"id":"w13","t":"rechts","s":"right; on the right","emoji":"➡️","ex":{"t":"Der Bahnhof ist rechts.","s":"The train station is on the right.","a":"audio/de-en/6c423b692ee5.mp3"},"img":"img/e/27a1.svg","a":"audio/de-en/122a0569ca4c.mp3"},{"id":"w14","t":"geradeaus","s":"straight ahead","emoji":"⬆️","ex":{"t":"Gehen Sie geradeaus!","s":"Go straight ahead!","a":"audio/de-en/4ee0d6c8fd9f.mp3"},"img":"img/e/2b06.svg","a":"audio/de-en/c7d938e7275f.mp3"}],"phrases":[{"id":"p01","t":"Entschuldigung!","s":"Excuse me!","a":"audio/de-en/db3f7d99b467.mp3"},{"id":"p02","t":"Wo ist der Bahnhof, bitte?","s":"Where is the train station, please?","a":"audio/de-en/4102b5c2e665.mp3"},{"id":"p03","t":"Gehen Sie geradeaus.","s":"Go straight ahead.","a":"audio/de-en/bf450906d2cf.mp3"},{"id":"p04","t":"Gehen Sie nach links / nach rechts.","s":"Go left / go right.","a":"audio/de-en/83886b5b7484.mp3"},{"id":"p05","t":"Das ist nicht weit.","s":"It's not far.","a":"audio/de-en/8407973c7f3c.mp3"},{"id":"p06","t":"hier / dort","s":"here / there","a":"audio/de-en/97e081e0fd1c.mp3"},{"id":"p07","t":"Tut mir leid, ich bin nicht von hier.","s":"Sorry, I'm not from here.","a":"audio/de-en/286cedb18688.mp3"},{"id":"p08","t":"Vielen Dank!","s":"Thank you very much!","a":"audio/de-en/c69b8ecebcbe.mp3"}],"dialogue":{"title":{"t":"Wo ist die Apotheke?","s":"Where is the pharmacy?","a":"audio/de-en/1296827939e5.mp3"},"speakers":{"A":{"name":"Ali","voice":"m"},"B":{"name":"Frau Müller","voice":"f"}},"lines":[{"sp":"A","t":"Entschuldigung! Wo ist die Apotheke, bitte?","s":"Excuse me! Where is the pharmacy, please?","a":"audio/de-en/3eda02ae8db3.mp3"},{"sp":"B","t":"Die Apotheke? Gehen Sie hier geradeaus.","s":"The pharmacy? Go straight ahead here.","a":"audio/de-en/d0287c22c5f2.mp3"},{"sp":"A","t":"Geradeaus. Und dann?","s":"Straight ahead. And then?","a":"audio/de-en/7eb1dd0dd1ea.mp3"},{"sp":"B","t":"Dann gehen Sie nach links. Die Apotheke ist in der Goethestraße.","s":"Then go left. The pharmacy is on Goethe Street.","a":"audio/de-en/b7a501d27be5.mp3"},{"sp":"A","t":"Ist das weit?","s":"Is it far?","a":"audio/de-en/28a4f9ff109a.mp3"},{"sp":"B","t":"Nein, das ist nicht weit.","s":"No, it's not far.","a":"audio/de-en/9f94f5262a09.mp3"},{"sp":"A","t":"Gibt es dort auch einen Supermarkt?","s":"Is there a supermarket there too?","a":"audio/de-en/64aec467e6dc.mp3"},{"sp":"B","t":"Ja, rechts ist ein Supermarkt.","s":"Yes, there's a supermarket on the right.","a":"audio/de-en/25b5bf73b107.mp3"},{"sp":"A","t":"Vielen Dank!","s":"Thank you very much!","a":"audio/de-en/c69b8ecebcbe.mp3"},{"sp":"B","t":"Bitte schön!","s":"You're welcome!","a":"audio/de-en/3704dff464ca.mp3"}]},"grammar":[{"id":"g01","title":{"t":"Gehen Sie geradeaus!","s":"Polite commands (Sie-imperative)"},"explain":"To give directions or polite instructions, use the **Sie-imperative**. It's easy: take the **Sie** form of the verb and put the verb **first**: Sie gehen → **Gehen Sie!**\nAdd **bitte** to sound friendly: **Gehen Sie bitte geradeaus.**\nSeparable verbs work the same way – the prefix goes to the end: **Rufen Sie bitte Frau Müller an!**\nUseful direction words: **geradeaus** (straight ahead), **nach links** (to the left), **nach rechts** (to the right). For *where* something is, just say **links** or **rechts**: **Die Bank ist links.**","table":[["Sie gehen …","Gehen Sie …!"],["Sie kommen …","Kommen Sie …!"],["Sie rufen … an","Rufen Sie … an!"],["Sie kaufen … ein","Kaufen Sie … ein!"]],"examples":[{"t":"Gehen Sie geradeaus!","s":"Go straight ahead!","a":"audio/de-en/4ee0d6c8fd9f.mp3"},{"t":"Gehen Sie bitte nach rechts.","s":"Please go to the right.","a":"audio/de-en/4982868f5e7c.mp3"},{"t":"Gehen Sie hier nach links, dann geradeaus.","s":"Go left here, then straight ahead.","a":"audio/de-en/684dfe522599.mp3"},{"t":"Rufen Sie bitte Frau Müller an.","s":"Please call Ms. Müller.","a":"audio/de-en/c294b9ef79e5.mp3"}],"exercises":[{"type":"choice","t":"___ Sie geradeaus!","options":["Geht","Gehen","Gehst"],"answer":1,"s":"Go straight ahead!","full":"Gehen Sie geradeaus!","a":"audio/de-en/4ee0d6c8fd9f.mp3"},{"type":"choice","t":"Gehen Sie ___ links.","options":["im","um","nach"],"answer":2,"s":"Go to the left.","full":"Gehen Sie nach links.","a":"audio/de-en/544dd3e380cf.mp3"},{"type":"type","t":"Gehen ___ geradeaus!","answer":["Sie"],"s":"Go straight ahead!","full":"Gehen Sie geradeaus!","a":"audio/de-en/4ee0d6c8fd9f.mp3"},{"type":"type","t":"Rufen Sie bitte Frau Müller ___!","answer":["an"],"s":"Please call Ms. Müller!","full":"Rufen Sie bitte Frau Müller an!","a":"audio/de-en/33d1db4a0bd2.mp3"},{"type":"choice","t":"Sie kommen. → ___ Sie bitte!","options":["Kommen","Kommt","Komme"],"answer":0,"s":"Please come!","full":"Sie kommen. → Kommen Sie bitte!","a":"audio/de-en/c767aa391d3a.mp3"},{"type":"order","t":"Gehen Sie bitte nach rechts.","s":"Please go to the right.","full":"Gehen Sie bitte nach rechts.","a":"audio/de-en/4982868f5e7c.mp3"},{"type":"order","t":"Gehen Sie hier nach links.","s":"Go left here.","full":"Gehen Sie hier nach links.","a":"audio/de-en/e798ede78a96.mp3"}]},{"id":"g02","title":{"t":"im Park, in der Stadt","s":"Where? – in der / im"},"explain":"To say **where** someone or something is, use **in**. After **in**, the article changes:\n**der → im**: der Park → **im Park**\n**das → im**: das Krankenhaus → **im Krankenhaus**\n**die → in der**: die Schule → **in der Schule**\n(**im** is short for *in dem*.) This form is called the **dative**. For now, just learn these patterns.","table":[["der Park","im Park"],["der Supermarkt","im Supermarkt"],["das Krankenhaus","im Krankenhaus"],["die Stadt","in der Stadt"],["die Apotheke","in der Apotheke"]],"examples":[{"t":"Ali ist im Park.","s":"Ali is in the park.","a":"audio/de-en/c825055400c3.mp3"},{"t":"Wir kaufen im Supermarkt ein.","s":"We shop at the supermarket.","a":"audio/de-en/e1d6cdaa0e1e.mp3"},{"t":"Reza arbeitet im Krankenhaus.","s":"Reza works at the hospital.","a":"audio/de-en/0842679dd573.mp3"},{"t":"Ich wohne in der Goethestraße.","s":"I live on Goethe Street.","a":"audio/de-en/604030572425.mp3"}],"exercises":[{"type":"choice","t":"Sara ist ___ Schule.","options":["im","in der","in die"],"answer":1,"s":"Sara is at school.","full":"Sara ist in der Schule.","a":"audio/de-en/1678b8157190.mp3"},{"type":"choice","t":"Wir sind ___ Park.","options":["im","in der","in"],"answer":0,"s":"We are in the park.","full":"Wir sind im Park.","a":"audio/de-en/830ed52a9e9a.mp3"},{"type":"type","t":"Lukas ist ___ Supermarkt.","answer":["im"],"s":"Lukas is at the supermarket.","full":"Lukas ist im Supermarkt.","a":"audio/de-en/06b3d72b85e3.mp3"},{"type":"type","t":"Reza arbeitet ___ Krankenhaus.","answer":["im"],"s":"Reza works at the hospital.","full":"Reza arbeitet im Krankenhaus.","a":"audio/de-en/0842679dd573.mp3"},{"type":"choice","t":"Frau Müller ist ___ Bank.","options":["im","in den","in der"],"answer":2,"s":"Ms. Müller is at the bank.","full":"Frau Müller ist in der Bank.","a":"audio/de-en/4e9670183d0e.mp3"},{"type":"type","t":"Maryam ist in ___ Apotheke.","answer":["der"],"s":"Maryam is at the pharmacy.","full":"Maryam ist in der Apotheke.","a":"audio/de-en/d50a98b3694c.mp3"},{"type":"order","t":"Ich wohne in der Goethestraße.","s":"I live on Goethe Street.","full":"Ich wohne in der Goethestraße.","a":"audio/de-en/604030572425.mp3"}]}],"reading":{"title":{"t":"Meine Stadt","s":"My city","a":"audio/de-en/2eedc0e4ff71.mp3"},"text":[{"t":"Ich heiße Eva Müller und ich wohne in Hamburg.","s":"My name is Eva Müller and I live in Hamburg.","a":"audio/de-en/e13a702e6af9.mp3"},{"t":"Meine Stadt ist groß und schön.","s":"My city is big and beautiful.","a":"audio/de-en/d2008f3abf8d.mp3"},{"t":"Ich wohne in der Goethestraße.","s":"I live on Goethe Street.","a":"audio/de-en/604030572425.mp3"},{"t":"Rechts ist ein Supermarkt und links ist eine Apotheke.","s":"On the right there's a supermarket and on the left there's a pharmacy.","a":"audio/de-en/16690cca900a.mp3"},{"t":"Die Haltestelle ist hier und der Bahnhof ist nicht weit.","s":"The bus stop is here and the train station isn't far.","a":"audio/de-en/e10c5d0a52e3.mp3"},{"t":"In der Goethestraße gibt es auch ein Restaurant.","s":"There's also a restaurant on Goethe Street.","a":"audio/de-en/23fca100fe18.mp3"},{"t":"Ich arbeite im Krankenhaus.","s":"I work at the hospital.","a":"audio/de-en/2d1b2362a5a8.mp3"},{"t":"Am Abend bin ich im Park.","s":"In the evening I'm in the park.","a":"audio/de-en/6150654cca7e.mp3"}],"questions":[{"q":{"t":"Wo wohnt Frau Müller?","s":"Where does Ms. Müller live?","a":"audio/de-en/8ab5a192e592.mp3"},"options":["im Park","in der Goethestraße","im Krankenhaus"],"answer":1},{"q":{"t":"Was ist links?","s":"What is on the left?","a":"audio/de-en/f9eefdf30dc9.mp3"},"options":["ein Supermarkt","ein Restaurant","eine Apotheke"],"answer":2},{"q":{"t":"Wo arbeitet Frau Müller?","s":"Where does Ms. Müller work?","a":"audio/de-en/2acde8831e41.mp3"},"options":["im Krankenhaus","in der Bank","in der Apotheke"],"answer":0},{"q":{"t":"Wo ist Frau Müller am Abend?","s":"Where is Ms. Müller in the evening?","a":"audio/de-en/9d415b234cf7.mp3"},"options":["im Supermarkt","im Park","in der Schule"],"answer":1}]},"sentences":[{"t":"Entschuldigung, wo ist der Bahnhof?","s":"Excuse me, where is the train station?","a":"audio/de-en/58530e67e927.mp3"},{"t":"Gehen Sie geradeaus und dann nach rechts.","s":"Go straight ahead and then to the right.","a":"audio/de-en/a5d495c1572f.mp3"},{"t":"Die Apotheke ist links.","s":"The pharmacy is on the left.","a":"audio/de-en/41fd197e9fb6.mp3"},{"t":"Der Bus kommt um acht Uhr.","s":"The bus comes at eight o'clock.","a":"audio/de-en/6c32bab3dc8d.mp3"},{"t":"Ali ist in der Bank.","s":"Ali is at the bank.","a":"audio/de-en/49df9f5f1aef.mp3"},{"t":"Wir essen im Restaurant.","s":"We eat at the restaurant.","a":"audio/de-en/8cf9fc788e13.mp3"},{"t":"Die Haltestelle ist nicht weit.","s":"The bus stop isn't far.","a":"audio/de-en/825a6a43b1dd.mp3"},{"t":"Tut mir leid, ich bin nicht von hier.","s":"Sorry, I'm not from here.","a":"audio/de-en/286cedb18688.mp3"}],"img":"img/e/1f5fa.svg"}