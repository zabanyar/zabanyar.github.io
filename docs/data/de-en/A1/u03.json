{"id":"u03","level":"A1","emoji":"👪","title":{"t":"Meine Familie","s":"My family","a":"audio/de-en/0c94407b1789.mp3"},"goals":["Talk about your family members","Use der, die, das and mein/meine, dein/deine","Say what you have with haben"],"words":[{"id":"w01","t":"die Familie","pl":"die Familien","s":"family","emoji":"👪","ex":{"t":"Das ist meine Familie.","s":"This is my family.","a":"audio/de-en/bbf787ad2b93.mp3"},"img":"img/e/1f46a.svg","a":"audio/de-en/bbce07d1b432.mp3","pla":"audio/de-en/5318ea22e397.mp3"},{"id":"w02","t":"die Mutter","pl":"die Mütter","s":"mother","emoji":"👩","ex":{"t":"Meine Mutter heißt Maryam.","s":"My mother's name is Maryam.","a":"audio/de-en/9d309a70ffba.mp3"},"img":"img/e/1f469.svg","a":"audio/de-en/44dd85955500.mp3","pla":"audio/de-en/6565e56d9a34.mp3"},{"id":"w03","t":"der Vater","pl":"die Väter","s":"father","emoji":"👨","ex":{"t":"Mein Vater kommt aus Schiras.","s":"My father is from Shiraz.","a":"audio/de-en/1f7116e18d80.mp3"},"img":"img/e/1f468.svg","a":"audio/de-en/b842ba484939.mp3","pla":"audio/de-en/912b62574f0f.mp3"},{"id":"w04","t":"die Eltern","s":"parents (plural only)","emoji":"","ex":{"t":"Meine Eltern wohnen in Teheran.","s":"My parents live in Tehran.","a":"audio/de-en/36678638e4f8.mp3"},"img":null,"a":"audio/de-en/39a31120e041.mp3"},{"id":"w05","t":"der Bruder","pl":"die Brüder","s":"brother","emoji":"","ex":{"t":"Mein Bruder ist zwanzig Jahre alt.","s":"My brother is twenty years old.","a":"audio/de-en/4ea0eeebcaa4.mp3"},"img":null,"a":"audio/de-en/90943a482c08.mp3","pla":"audio/de-en/d6a91414ff85.mp3"},{"id":"w06","t":"die Schwester","pl":"die Schwestern","s":"sister","emoji":"","ex":{"t":"Meine Schwester heißt Sara.","s":"My sister's name is Sara.","a":"audio/de-en/7530b260b4e1.mp3"},"img":null,"a":"audio/de-en/b88feb473bdc.mp3","pla":"audio/de-en/500474990db7.mp3"},{"id":"w07","t":"der Sohn","pl":"die Söhne","s":"son","emoji":"👦","ex":{"t":"Mein Sohn ist zehn Jahre alt.","s":"My son is ten years old.","a":"audio/de-en/4418762a87c4.mp3"},"img":"img/e/1f466.svg","a":"audio/de-en/2b212a197870.mp3","pla":"audio/de-en/89bece173164.mp3"},{"id":"w08","t":"die Tochter","pl":"die Töchter","s":"daughter","emoji":"👧","ex":{"t":"Meine Tochter lernt Deutsch.","s":"My daughter is learning German.","a":"audio/de-en/a1585e494268.mp3"},"img":"img/e/1f467.svg","a":"audio/de-en/b05ed6322b18.mp3","pla":"audio/de-en/bc875952bc7c.mp3"},{"id":"w09","t":"das Kind","pl":"die Kinder","s":"child","emoji":"🧒","ex":{"t":"Ich habe zwei Kinder.","s":"I have two children.","a":"audio/de-en/751ba7bd6bf7.mp3"},"img":"img/e/1f9d2.svg","a":"audio/de-en/2237837fcc8b.mp3","pla":"audio/de-en/395b014fb4d6.mp3"},{"id":"w10","t":"das Baby","pl":"die Babys","s":"baby","emoji":"👶","ex":{"t":"Das Baby ist ein Jahr alt.","s":"The baby is one year old.","a":"audio/de-en/96406412a143.mp3"},"img":"img/e/1f476.svg","a":"audio/de-en/be608c2fd238.mp3","pla":"audio/de-en/ff7923c4a47e.mp3"},{"id":"w11","t":"die Oma","pl":"die Omas","s":"grandma","emoji":"👵","ex":{"t":"Meine Oma wohnt in Teheran.","s":"My grandma lives in Tehran.","a":"audio/de-en/8c55442b8dda.mp3"},"img":"img/e/1f475.svg","a":"audio/de-en/e6d64e900163.mp3","pla":"audio/de-en/378bbdc887bf.mp3"},{"id":"w12","t":"der Opa","pl":"die Opas","s":"grandpa","emoji":"👴","ex":{"t":"Mein Opa wohnt auch in Teheran.","s":"My grandpa lives in Tehran, too.","a":"audio/de-en/ae4894d6384a.mp3"},"img":"img/e/1f474.svg","a":"audio/de-en/981be818b4c4.mp3","pla":"audio/de-en/74c53b5a2fee.mp3"},{"id":"w13","t":"der Mann","pl":"die Männer","s":"man; husband","emoji":"","ex":{"t":"Das ist mein Mann, Ali.","s":"This is my husband, Ali.","a":"audio/de-en/8bfb685f943a.mp3"},"img":null,"a":"audio/de-en/09d58bdb7732.mp3","pla":"audio/de-en/62875d6ec403.mp3"},{"id":"w14","t":"haben","s":"to have","emoji":"","ex":{"t":"Hast du Kinder?","s":"Do you have children?","a":"audio/de-en/d901598500b8.mp3"},"img":null,"a":"audio/de-en/b5686429903c.mp3"}],"phrases":[{"id":"p01","t":"Wer ist das?","s":"Who is that?","a":"audio/de-en/1be6deb70447.mp3"},{"id":"p02","t":"Das ist mein Bruder.","s":"This is my brother.","a":"audio/de-en/1f2723f25b4e.mp3"},{"id":"p03","t":"Hast du Geschwister?","s":"Do you have brothers or sisters?","a":"audio/de-en/321c9fab3ad1.mp3"},{"id":"p04","t":"Ja, ich habe eine Schwester.","s":"Yes, I have a sister.","a":"audio/de-en/522537bafb3d.mp3"},{"id":"p05","t":"Nein, ich bin Einzelkind.","s":"No, I'm an only child.","a":"audio/de-en/23ef7223d959.mp3"},{"id":"p06","t":"Sind Sie verheiratet?","s":"Are you married? (polite)","a":"audio/de-en/36b8cce6bb8b.mp3"},{"id":"p07","t":"Ja, ich bin verheiratet.","s":"Yes, I'm married.","a":"audio/de-en/d0b0a8e06f3f.mp3"},{"id":"p08","t":"Wie heißt deine Mutter?","s":"What's your mother's name?","a":"audio/de-en/de651e922b04.mp3"}],"dialogue":{"title":{"t":"Das ist meine Familie","s":"This is my family","a":"audio/de-en/0836cf0224e1.mp3"},"speakers":{"A":{"name":"Anna","voice":"f"},"B":{"name":"Ali","voice":"m"}},"lines":[{"sp":"A","t":"Wer ist das, Ali?","s":"Who is that, Ali?","a":"audio/de-en/7762b5b9f9f9.mp3"},{"sp":"B","t":"Das ist meine Familie. Das ist meine Frau, Maryam.","s":"This is my family. This is my wife, Maryam.","a":"audio/de-en/28e46d1c9efc.mp3"},{"sp":"A","t":"Und wer ist das?","s":"And who is that?","a":"audio/de-en/8138739eb071.mp3"},{"sp":"B","t":"Das ist mein Sohn Amir. Er ist zehn Jahre alt.","s":"This is my son Amir. He is ten years old.","a":"audio/de-en/60da701e1497.mp3"},{"sp":"A","t":"Hast du auch eine Tochter?","s":"Do you have a daughter, too?","a":"audio/de-en/9186a9913d0e.mp3"},{"sp":"B","t":"Ja, meine Tochter heißt Mina. Sie ist zwölf.","s":"Yes, my daughter's name is Mina. She is twelve.","a":"audio/de-en/970b749658cb.mp3"},{"sp":"A","t":"Und sind das deine Eltern?","s":"And are these your parents?","a":"audio/de-en/b63f5226b5fc.mp3"},{"sp":"B","t":"Ja, das sind meine Eltern. Sie wohnen in Teheran. Hast du Geschwister, Anna?","s":"Yes, these are my parents. They live in Tehran. Do you have brothers or sisters, Anna?","a":"audio/de-en/b1160bc68d1d.mp3"},{"sp":"A","t":"Ja, ich habe zwei Brüder. Du hast eine schöne Familie!","s":"Yes, I have two brothers. You have a lovely family!","a":"audio/de-en/332337c6a63c.mp3"},{"sp":"B","t":"Danke, Anna!","s":"Thank you, Anna!","a":"audio/de-en/c129e8bf11a1.mp3"}]},"grammar":[{"id":"g01","title":{"t":"der, die, das – mein, meine","s":"Articles and \"my\" / \"your\""},"explain":"Every German noun has a gender: **der** (masculine), **die** (feminine) or **das** (neuter). You often can't guess it, so always learn a noun together with its article: **der Vater**, **die Mutter**, **das Kind**.\nIn the plural, the article is always **die**: **die Kinder**, **die Brüder**.\nFor *my* and *your* (informal), use **mein** / **dein** with der- and das-nouns, and **meine** / **deine** with die-nouns and all plurals.\nThe polite *your* (for **Sie**) is **Ihr** / **Ihre**, with a capital I: **Wie heißt Ihre Tochter?**","table":[["der Vater","mein Vater","dein Vater"],["die Mutter","meine Mutter","deine Mutter"],["das Kind","mein Kind","dein Kind"],["die Kinder","meine Kinder","deine Kinder"]],"examples":[{"t":"Das ist mein Vater.","s":"This is my father.","a":"audio/de-en/3d9ca39515f5.mp3"},{"t":"Meine Schwester heißt Sara.","s":"My sister's name is Sara.","a":"audio/de-en/7530b260b4e1.mp3"},{"t":"Wie heißt dein Bruder?","s":"What's your brother's name?","a":"audio/de-en/b15604202a1a.mp3"},{"t":"Meine Eltern wohnen in Teheran.","s":"My parents live in Tehran.","a":"audio/de-en/36678638e4f8.mp3"},{"t":"Wie heißt Ihr Sohn, Frau Müller?","s":"What's your son's name, Ms. Müller?","a":"audio/de-en/e72ee1c91442.mp3"}],"exercises":[{"type":"choice","t":"___ Mutter heißt Maryam.","options":["Mein","Meine"],"answer":1,"s":"My mother's name is Maryam.","full":"Meine Mutter heißt Maryam.","a":"audio/de-en/9d309a70ffba.mp3"},{"type":"choice","t":"Das ist ___ Vater.","options":["mein","meine"],"answer":0,"s":"This is my father.","full":"Das ist mein Vater.","a":"audio/de-en/3d9ca39515f5.mp3"},{"type":"choice","t":"___ Kind ist sieben Jahre alt.","options":["Der","Die","Das"],"answer":2,"s":"The child is seven years old.","full":"Das Kind ist sieben Jahre alt.","a":"audio/de-en/0ffde6a29b8d.mp3"},{"type":"choice","t":"___ Schwester wohnt in Köln.","options":["Der","Die","Das"],"answer":1,"s":"The sister lives in Cologne.","full":"Die Schwester wohnt in Köln.","a":"audio/de-en/3adce73ecd78.mp3"},{"type":"type","t":"Wie heißt ___ Bruder, Ali?","answer":["dein"],"s":"What's your brother's name, Ali?","full":"Wie heißt dein Bruder, Ali?","a":"audio/de-en/1562befb7b16.mp3"},{"type":"type","t":"Das sind ___ Eltern.","answer":["meine"],"s":"These are my parents.","full":"Das sind meine Eltern.","a":"audio/de-en/06464ce622d2.mp3"},{"type":"order","t":"Das ist meine Tochter.","s":"This is my daughter.","full":"Das ist meine Tochter.","a":"audio/de-en/d1afdf240400.mp3"},{"type":"order","t":"Wie heißt deine Schwester?","s":"What's your sister's name?","full":"Wie heißt deine Schwester?","a":"audio/de-en/793842a4d3eb.mp3"}]},{"id":"g02","title":{"t":"haben: ich habe, du hast …","s":"The verb \"to have\""},"explain":"**haben** means *to have*. It is almost regular – only **du hast** and **er/sie/es hat** are special.\n**wir** means *we*. With **wir**, the verb looks just like the **Sie** form: **wir haben**, **wir wohnen**, **wir kommen**.\nTip: after **haben**, a der-noun takes **einen**: Ich habe **einen** Bruder. With die- and das-nouns nothing changes: Ich habe **eine** Schwester, ich habe **ein** Kind. You'll learn more about this in Unit 5.","table":[["ich","habe","Ich habe zwei Kinder."],["du","hast","Hast du Geschwister?"],["er / sie / es","hat","Anna hat zwei Brüder."],["wir","haben","Wir haben ein Baby."],["Sie","haben","Haben Sie Kinder?"]],"examples":[{"t":"Ich habe zwei Kinder.","s":"I have two children.","a":"audio/de-en/751ba7bd6bf7.mp3"},{"t":"Hast du Geschwister?","s":"Do you have brothers or sisters?","a":"audio/de-en/321c9fab3ad1.mp3"},{"t":"Lukas hat eine Schwester.","s":"Lukas has a sister.","a":"audio/de-en/1dda38c9a726.mp3"},{"t":"Wir haben ein Baby.","s":"We have a baby.","a":"audio/de-en/059553a0fd6d.mp3"},{"t":"Haben Sie Kinder, Herr Schmidt?","s":"Do you have children, Mr. Schmidt?","a":"audio/de-en/62e0502f9f14.mp3"}],"exercises":[{"type":"choice","t":"Ich ___ zwei Brüder.","options":["habe","hast","hat"],"answer":0,"s":"I have two brothers.","full":"Ich habe zwei Brüder.","a":"audio/de-en/1527f0bb2423.mp3"},{"type":"choice","t":"Lukas ___ eine Schwester.","options":["habe","hast","hat"],"answer":2,"s":"Lukas has a sister.","full":"Lukas hat eine Schwester.","a":"audio/de-en/1dda38c9a726.mp3"},{"type":"choice","t":"___ du Kinder?","options":["Hast","Hat","Haben"],"answer":0,"s":"Do you have children?","full":"Hast du Kinder?","a":"audio/de-en/d901598500b8.mp3"},{"type":"type","t":"Wir ___ drei Kinder.","answer":["haben"],"s":"We have three children.","full":"Wir haben drei Kinder.","a":"audio/de-en/b92b9925f5e8.mp3"},{"type":"type","t":"Frau Müller ___ zwei Töchter.","answer":["hat"],"s":"Ms. Müller has two daughters.","full":"Frau Müller hat zwei Töchter.","a":"audio/de-en/e32351e123d3.mp3"},{"type":"order","t":"Haben Sie Kinder?","s":"Do you have children? (polite)","full":"Haben Sie Kinder?","a":"audio/de-en/2b6386f7b33d.mp3"},{"type":"order","t":"Ich habe eine Tochter.","s":"I have a daughter.","full":"Ich habe eine Tochter.","a":"audio/de-en/49bad2ac2f0e.mp3"}]}],"reading":{"title":{"t":"Minas Familie","s":"Mina's family","a":"audio/de-en/27ba1e1b013b.mp3"},"text":[{"t":"Ich heiße Mina und ich bin zwölf Jahre alt.","s":"My name is Mina and I'm twelve years old.","a":"audio/de-en/d031d6d06c2a.mp3"},{"t":"Das ist meine Familie.","s":"This is my family.","a":"audio/de-en/bbf787ad2b93.mp3"},{"t":"Mein Vater heißt Ali und meine Mutter heißt Maryam.","s":"My father's name is Ali and my mother's name is Maryam.","a":"audio/de-en/583aeaae4bb7.mp3"},{"t":"Mein Bruder heißt Amir. Er ist zehn.","s":"My brother's name is Amir. He is ten.","a":"audio/de-en/3825de766b45.mp3"},{"t":"Wir wohnen in Köln.","s":"We live in Cologne.","a":"audio/de-en/490c29a66fe3.mp3"},{"t":"Meine Oma und mein Opa wohnen in Teheran.","s":"My grandma and my grandpa live in Tehran.","a":"audio/de-en/637fbf08c5a8.mp3"},{"t":"Wir haben auch eine Katze.","s":"We also have a cat.","a":"audio/de-en/98dcf32f25a4.mp3"},{"t":"Sie heißt Mimi.","s":"Her name is Mimi.","a":"audio/de-en/cdc961407f9a.mp3"}],"questions":[{"q":{"t":"Wie alt ist Mina?","s":"How old is Mina?","a":"audio/de-en/053f8f92f3c7.mp3"},"options":["zehn","zwölf","sieben"],"answer":1},{"q":{"t":"Wer ist Amir?","s":"Who is Amir?","a":"audio/de-en/a197b0e895f8.mp3"},"options":["Minas Bruder","Minas Vater","Minas Opa"],"answer":0},{"q":{"t":"Wo wohnen Oma und Opa?","s":"Where do Grandma and Grandpa live?","a":"audio/de-en/3e12356384cc.mp3"},"options":["in Köln","in Teheran","in Berlin"],"answer":1},{"q":{"t":"Wie heißt die Katze?","s":"What's the cat's name?","a":"audio/de-en/2b70b29077de.mp3"},"options":["Mimi","Maryam","Mina"],"answer":0}]},"sentences":[{"t":"Das ist mein Vater.","s":"This is my father.","a":"audio/de-en/3d9ca39515f5.mp3"},{"t":"Meine Mutter heißt Maryam.","s":"My mother's name is Maryam.","a":"audio/de-en/9d309a70ffba.mp3"},{"t":"Hast du Geschwister?","s":"Do you have brothers or sisters?","a":"audio/de-en/321c9fab3ad1.mp3"},{"t":"Ich habe zwei Kinder.","s":"I have two children.","a":"audio/de-en/751ba7bd6bf7.mp3"},{"t":"Wir wohnen in Köln.","s":"We live in Cologne.","alts":["In Köln wohnen wir."],"a":"audio/de-en/490c29a66fe3.mp3"},{"t":"Wie heißt deine Schwester?","s":"What's your sister's name?","a":"audio/de-en/793842a4d3eb.mp3"},{"t":"Mein Bruder ist zwanzig Jahre alt.","s":"My brother is twenty years old.","a":"audio/de-en/4ea0eeebcaa4.mp3"},{"t":"Haben Sie Kinder?","s":"Do you have children? (polite)","a":"audio/de-en/2b6386f7b33d.mp3"}],"img":"img/e/1f46a.svg"}