:"🐋","img":"img/e/1f40b.svg","a":"audio/de-en/cfef0485cd20.mp3"},"a":"audio/de-en/941eb8c4b238.mp3"},{"t":"X x","pr":"iks","ex":{"t":"das Taxi","s":"taxi","emoji":"🚕","img":"img/e/1f695.svg","a":"audio/de-en/b1d1d10ef673.mp3"},"a":"audio/de-en/97fd35d36984.mp3"},{"t":"Y y","pr":"ÜP-see-lon","ex":{"t":"das Yoga","s":"yoga","emoji":"🧘","img":"img/e/1f9d8.svg","a":"audio/de-en/4c41cdd55645.mp3"},"a":"audio/de-en/3376b1425e6b.mp3"},{"t":"Z z","pr":"tset","ex":{"t":"das Zebra","s":"zebra","emoji":"🦓","img":"img/e/1f993.svg","a":"audio/de-en/3584c87480bc.mp3"},"a":"audio/de-en/50654b77118e.mp3"},{"t":"Ä ä","pr":"eh (like 'e' in 'bed', but longer)","ex":{"t":"der Käse","s":"cheese","emoji":"🧀","img":"img/e/1f9c0.svg","a":"audio/de-en/36b14e2ad8df.mp3"},"a":"audio/de-en/d46a224045f6.mp3"},{"t":"Ö ö","pr":"say 'ay' with rounded lips","ex":{"t":"die Möhre","s":"carrot","emoji":"🥕","img":"img/e/1f955.svg","a":"audio/de-en/eb49032db4c2.mp3"},"a":"audio/de-en/dd595fe91138.mp3"},{"t":"Ü ü","pr":"say 'ee' with rounded lips","ex":{"t":"die Tür","s":"door","emoji":"🚪","img":"img/e/1f6aa.svg","a":"audio/de-en/030c27d7afbb.mp3"},"a":"audio/de-en/46091d9dc2d2.mp3"},{"t":"ß","pr":"ess-TSET (a sharp 's')","ex":{"t":"der Fuß","s":"foot","emoji":"🦶","img":"img/e/1f9b6.svg","a":"audio/de-en/7329b4c7177e.mp3"},"a":"audio/de-en/5e0d6a8e6011.mp3"}],"sounds":[{"t":"ei","s":"Sounds like English 'eye'. Tip: say the English name of the SECOND letter – ei sounds like 'i' (eye).","ex":[{"t":"das Ei","s":"egg","a":"audio/de-en/eee72716803d.mp3"},{"t":"drei","s":"three","a":"audio/de-en/d20ca50168a9.mp3"},{"t":"nein","s":"no","a":"audio/de-en/578bb3429031.mp3"}]},{"t":"ie","s":"Sounds like 'ee' in 'see'. Tip: again, say the English name of the second letter – ie sounds like 'e' (ee).","ex":[{"t":"vier","s":"four","a":"audio/de-en/4d7c2f226d37.mp3"},{"t":"die Biene","s":"bee","a":"audio/de-en/9ef2e1ffae25.mp3"},{"t":"Sie","s":"you (polite)","a":"audio/de-en/11b483b154fb.mp3"}]},{"t":"eu / äu","s":"Both sound like 'oy' in 'boy'.","ex":[{"t":"neun","s":"nine","a":"audio/de-en/a173a63ff654.mp3"},{"t":"Deutsch","s":"German","a":"audio/de-en/35dd6bbc8bf2.mp3"},{"t":"die Häuser","s":"houses","a":"audio/de-en/3ab1840418f4.mp3"}]},{"t":"ch","s":"After a, o, u and au: a rough sound in the back of the throat, like 'ch' in Scottish 'loch'. After all other letters: a soft hissing sound, like a whispered 'h' in 'huge'.","ex":[{"t":"das Buch","s":"book","a":"audio/de-en/71095d979724.mp3"},{"t":"acht","s":"eight","a":"audio/de-en/f78f80b74228.mp3"},{"t":"ich","s":"I","a":"audio/de-en/a25baba11a05.mp3"},{"t":"die Milch","s":"milk","a":"audio/de-en/3f6f62f7c9b5.mp3"}]},{"t":"sch","s":"Sounds like English 'sh' in 'ship'.","ex":[{"t":"die Schule","s":"school","a":"audio/de-en/819b8c377a58.mp3"},{"t":"der Fisch","s":"fish","a":"audio/de-en/0648d72d562b.mp3"},{"t":"schön","s":"beautiful","a":"audio/de-en/db08244fb12a.mp3"}]},{"t":"sp / st","s":"At the start of a word they sound like 'shp' and 'sht'. In the middle or at the end of a word they are pronounced as in English: ist, Fenster.","ex":[{"t":"spielen","s":"to play","a":"audio/de-en/cefd1992d991.mp3"},{"t":"die Straße","s":"street","a":"audio/de-en/f6b1b0260b50.mp3"},{"t":"der Stuhl","s":"chair","a":"audio/de-en/7b33e4ab1270.mp3"}]},{"t":"w / v / z","s":"German w sounds like English 'v'. German v usually sounds like English 'f'. German z always sounds like 'ts' in 'cats'.","ex":[{"t":"das Wasser","s":"water","a":"audio/de-en/d3136614c9bc.mp3"},{"t":"der Vogel","s":"bird","a":"audio/de-en/7bbd208777ef.mp3"},{"t":"zehn","s":"ten","a":"audio/de-en/8173c9b74afd.mp3"}]}],"words":[{"id":"w01","t":"hallo","s":"hello; hi","emoji":"👋","ex":{"t":"Hallo, Anna!","s":"Hi, Anna!","a":"audio/de-en/058377a25210.mp3"},"img":"img/e/1f44b.svg","a":"audio/de-en/bc505ba3f83b.mp3"},{"id":"w02","t":"ja","s":"yes","emoji":"✅","ex":{"t":"Ja, danke!","s":"Yes, thank you!","a":"audio/de-en/238bdc4a8987.mp3"},"img":"img/e/2705.svg","a":"audio/de-en/acbef503db56.mp3"},{"id":"w03","t":"nein","s":"no","emoji":"❌","ex":{"t":"Nein, danke.","s":"No, thank you.","a":"audio/de-en/918f1438d77d.mp3"},"img":"img/e/274c.svg","a":"audio/de-en/578bb3429031.mp3"},{"id":"w04","t":"danke","s":"thank you; thanks","emoji":"🙏","ex":{"t":"Danke, Lukas!","s":"Thanks, Lukas!","a":"audio/de-en/e280aacdada3.mp3"},"img":"img/e/1f64f.svg","a":"audio/de-en/f6f904e1202c.mp3"},{"id":"w05","t":"bitte","s":"please; you're welcome","emoji":"","ex":{"t":"Wasser, bitte.","s":"Water, please.","a":"audio/de-en/35d1f0275829.mp3"},"img":null,"a":"audio/de-en/87533d137ac2.mp3"},{"id":"w06","t":"das Haus","pl":"die Häuser","s":"house","emoji":"🏠","ex":{"t":"Das Haus ist groß.","s":"The house is big.","a":"audio/de-en/702fbf9dd287.mp3"},"img":"img/e/1f3e0.svg","a":"audio/de-en/a4f8ae7b7327.mp3","pla":"audio/de-en/3ab1840418f4.mp3"},{"id":"w07","t":"der Hund","pl":"die Hunde","s":"dog","emoji":"🐶","ex":{"t":"Der Hund ist klein.","s":"The dog is small.","a":"audio/de-en/8ee3944921ae.mp3"},"img":"img/e/1f436.svg","a":"audio/de-en/6beae20cdec8.mp3","pla":"audio/de-en/a9755eacdbbd.mp3"},{"id":"w08","t":"die Katze","pl":"die Katzen","s":"cat","emoji":"🐱","ex":{"t":"Die Katze ist süß.","s":"The cat is cute.","a":"audio/de-en/90646de8e9ca.mp3"},"img":"img/e/1f431.svg","a":"audio/de-en/dd6484de82c8.mp3","pla":"audio/de-en/f85112b7a480.mp3"},{"id":"w09","t":"das Buch","pl":"die Bücher","s":"book","emoji":"📖","ex":{"t":"Das Buch ist gut.","s":"The book is good.","a":"audio/de-en/5c5d56079133.mp3"},"img":"img/e/1f4d6.svg","a":"audio/de-en/71095d979724.mp3","pla":"audio/de-en/335335dcff9c.mp3"},{"id":"w10","t":"das Auto","pl":"die Autos","s":"car","emoji":"🚗","ex":{"t":"Das Auto ist neu.","s":"The car is new.","a":"audio/de-en/f5b45359d388.mp3"},"img":"img/e/1f697.svg","a":"audio/de-en/c9192adcb0c4.mp3","pla":"audio/de-en/2a6c988aaa1b.mp3"}],"phrases":[{"id":"p01","t":"Wie bitte?","s":"Sorry? / Pardon?","a":"audio/de-en/7e44be34f2e1.mp3"},{"id":"p02","t":"Noch einmal, bitte.","s":"Once more, please.","a":"audio/de-en/714a31038927.mp3"},{"id":"p03","t":"Langsam, bitte.","s":"Slowly, please.","a":"audio/de-en/3a033e201a25.mp3"},{"id":"p04","t":"Wie schreibt man das?","s":"How do you spell that?","a":"audio/de-en/fd187055341d.mp3"}],"img":"img/e/1f524.svg"}