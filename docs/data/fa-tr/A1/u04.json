1511.mp3"},{"id":"p02","t":"یک چای، لطفاً.","pr":"Yek çây, lotfan.","s":"Bir çay, lütfen.","a":"audio/fa-tr/2b65b202536d.mp3"},{"id":"p03","t":"نوش جان!","pr":"Nuş-e cân!","s":"Afiyet olsun!","a":"audio/fa-tr/ca55faf94db5.mp3"},{"id":"p04","t":"دستتان درد نکند!","pr":"Dastetân dard nakonad!","s":"Elinize sağlık!","a":"audio/fa-tr/44106638cf7d.mp3"},{"id":"p05","t":"خیلی خوشمزه است!","pr":"Xeyli xoşmaze ast!","s":"Çok lezzetli!","a":"audio/fa-tr/f8994ab8ef6a.mp3"},{"id":"p06","t":"گرسنه‌ام.","pr":"Gorosneam.","s":"Acıktım. / Açım.","a":"audio/fa-tr/3a4c248e28fe.mp3"},{"id":"p07","t":"تشنه‌ام.","pr":"Teşneam.","s":"Susadım.","a":"audio/fa-tr/6854d0c81d4a.mp3"},{"id":"p08","t":"صورت‌حساب، لطفاً.","pr":"Surathesâb, lotfan.","s":"Hesap, lütfen.","a":"audio/fa-tr/fa581cc0fe6a.mp3"}],"dialogue":{"title":{"t":"مهمانی","pr":"Mehmâni","s":"Misafirlik","a":"audio/fa-tr/ee6d79b00467.mp3"},"speakers":{"A":{"name":"Maryam","voice":"f"},"B":{"name":"Emre","voice":"m"}},"lines":[{"sp":"A","t":"امره، چه می‌خواهی؟ چای یا قهوه؟","pr":"Emre, çe mixâhi? Çây yâ ğahve?","s":"Emre, ne istersin? Çay mı, kahve mi?","a":"audio/fa-tr/fb710d350f11.mp3"},{"sp":"B","t":"چای، لطفاً. من خیلی چای دوست دارم.","pr":"Çây, lotfan. Man xeyli çây dust dâram.","s":"Çay, lütfen. Çayı çok severim.","a":"audio/fa-tr/eb0fbe3d3204.mp3"},{"sp":"A","t":"بفرمایید!","pr":"Befarmâyid!","s":"Buyurun!","a":"audio/fa-tr/50bd22ee7f0f.mp3"},{"sp":"B","t":"ممنون!","pr":"Mamnun!","s":"Teşekkürler!","a":"audio/fa-tr/9c204b715223.mp3"},{"sp":"A","t":"غذا هم می‌خواهی؟ کباب و برنج داریم.","pr":"Ğazâ ham mixâhi? Kabâb va berenc dârim.","s":"Yemek de ister misin? Kebap ve pilav var.","a":"audio/fa-tr/7a0b89890110.mp3"},{"sp":"B","t":"بله، لطفاً! من کباب دوست دارم.","pr":"Bale, lotfan! Man kabâb dust dâram.","s":"Evet, lütfen! Kebap severim.","a":"audio/fa-tr/cbf8b2edbcb3.mp3"},{"sp":"A","t":"نوش جان!","pr":"Nuş-e cân!","s":"Afiyet olsun!","a":"audio/fa-tr/44f7b4cbe767.mp3"},{"sp":"B","t":"خیلی خوشمزه است! دستت درد نکند!","pr":"Xeyli xoşmaze ast! Dastat dard nakonad!","s":"Çok lezzetli! Eline sağlık!","a":"audio/fa-tr/041c823a7d79.mp3"},{"sp":"A","t":"میوه هم می‌خواهی؟","pr":"Mive ham mixâhi?","s":"Meyve de ister misin?","a":"audio/fa-tr/71d97d14e1c4.mp3"},{"sp":"B","t":"نه، ممنون. سیرم!","pr":"Na, mamnun. Siram!","s":"Hayır, teşekkürler. Doydum!","a":"audio/fa-tr/095d17707e0e.mp3"}]},"grammar":[{"id":"g01","title":{"t":"می‌خواهم، دوست دارم","pr":"mixâham, dust dâram","s":"İstemek ve sevmek"},"explain":"**mixâham** = istiyorum. Olumsuzu için başa **ne-** gelir: **nemixâham** = istemiyorum. Kişi ekleri yine aynı: **-am, -i, -ad, -im, -id, -and**.\nYazıda **می** ile fiil arasında yarım boşluk vardır: **می‌خواهم**. Dikkat: **خوا** 'xâ' okunur, **و** okunmaz!\n**dust dâram** = severim, hoşlanırım. Kelimesi kelimesine 'dost tutuyorum' demek: evet, Türkçedeki **dost** kelimesi! Olumsuzda sadece **dâram** değişir: **dust nadâram** = sevmem.\nKibarca bir şey istemek için Türkçedeki gibi isim + **lotfan** yeter: **Yek çây, lotfan.**","table":[["می‌خواهم","mixâham","istiyorum"],["می‌خواهی","mixâhi","istiyorsun"],["می‌خواهد","mixâhad","istiyor"],["می‌خواهیم","mixâhim","istiyoruz"],["می‌خواهید","mixâhid","istiyorsunuz"],["می‌خواهند","mixâhand","istiyorlar"]],"examples":[{"t":"من چای می‌خواهم.","pr":"Man çây mixâham.","s":"Ben çay istiyorum.","a":"audio/fa-tr/ce3437b920d4.mp3"},{"t":"او قهوه نمی‌خواهد.","pr":"U ğahve nemixâhad.","s":"O kahve istemiyor.","a":"audio/fa-tr/3d49f85849b3.mp3"},{"t":"ما برنج دوست داریم.","pr":"Mâ berenc dust dârim.","s":"Biz pilav severiz.","a":"audio/fa-tr/ac2d2259229c.mp3"},{"t":"مریم پنیر دوست ندارد.","pr":"Maryam panir dust nadârad.","s":"Maryam peynir sevmez.","a":"audio/fa-tr/06f03b05b2cf.mp3"}],"exercises":[{"type":"choice","t":"من یک چای ___.","options":["می‌خواهد","می‌خواهم","می‌خواهند"],"answer":1,"pr":"Man yek çây mixâham.","s":"Ben bir çay istiyorum.","full":"من یک چای می‌خواهم.","a":"audio/fa-tr/35fcce6c676f.mp3"},{"type":"choice","t":"او قهوه ___.","options":["نمی‌خواهد","نمی‌خواهی","نمی‌خواهم"],"answer":0,"pr":"U ğahve nemixâhad.","s":"O kahve istemiyor.","full":"او قهوه نمی‌خواهد.","a":"audio/fa-tr/3d49f85849b3.mp3"},{"type":"choice","t":"تو میوه دوست ___؟","options":["دارم","دارند","داری"],"answer":2,"pr":"To mive dust dâri?","s":"Meyve sever misin?","full":"تو میوه دوست داری؟","a":"audio/fa-tr/a7167d0a677d.mp3"},{"type":"type","t":"من پنیر دوست ___.","answer":["ندارم"],"pr":"Man panir dust nadâram.","s":"Ben peynir sevmem.","full":"من پنیر دوست ندارم.","a":"audio/fa-tr/743f9561325b.mp3"},{"type":"type","t":"ما آب ___.","answer":["می‌خواهیم","میخواهیم"],"pr":"Mâ âb mixâhim.","s":"Biz su istiyoruz.","full":"ما آب می‌خواهیم.","a":"audio/fa-tr/f6969e2e2b97.mp3"},{"type":"order","t":"من کباب دوست دارم.","pr":"Man kabâb dust dâram.","s":"Ben kebap severim.","full":"من کباب دوست دارم.","a":"audio/fa-tr/23494ec0eb77.mp3"},{"type":"order","t":"آن‌ها چای نمی‌خواهند.","pr":"Ânhâ çây nemixâhand.","s":"Onlar çay istemiyor.","full":"آن‌ها چای نمی‌خواهند.","a":"audio/fa-tr/0538ee41f786.mp3"}]},{"id":"g02","title":{"t":"این سیب را می‌خواهم","pr":"in sib râ mixâham","s":"«râ»: belirli nesne işareti"},"explain":"Türkçede belirli nesneye **-ı / -i** eki gelir: elma**yı** istiyorum. Farsçada bunun karşılığı **râ** (را) kelimesidir. Nesneden **sonra**, ayrı yazılır: **İn sib râ mixâham.** = Bu elmayı istiyorum.\nBelirsiz nesnede **râ** yoktur, tıpkı Türkçede '-ı' olmaması gibi: **Sib mixâham.** = Elma istiyorum.\nSıra Türkçedeki gibidir: özne – nesne (+ râ) – fiil.\nKonuşmada **râ** çoğu zaman **-ro / -o** gibi söylenir, ama yazıda hep **را** yazılır.","examples":[{"t":"این سیب را می‌خواهم.","pr":"İn sib râ mixâham.","s":"Bu elmayı istiyorum.","a":"audio/fa-tr/2ac495eba0f6.mp3"},{"t":"یک لیوان آب می‌خواهم.","pr":"Yek livân âb mixâham.","s":"Bir bardak su istiyorum.","a":"audio/fa-tr/f724b5a3de15.mp3"},{"t":"غذای مادرم را دوست دارم.","pr":"Ğazâ-ye mâdaram râ dust dâram.","s":"Annemin yemeğini severim.","a":"audio/fa-tr/882bd5759b0e.mp3"},{"t":"این پنیر را نمی‌خواهم.","pr":"İn panir râ nemixâham.","s":"Bu peyniri istemiyorum.","a":"audio/fa-tr/952dc7e2fcb0.mp3"}],"exercises":[{"type":"choice","t":"این کباب ___ می‌خواهم.","options":["است","را","و"],"answer":1,"pr":"İn kabâb râ mixâham.","s":"Bu kebabı istiyorum.","full":"این کباب را می‌خواهم.","a":"audio/fa-tr/87948007e06e.mp3"},{"type":"choice","t":"یک لیوان آب ___، لطفاً.","options":["می‌خواهم","را","هستم"],"answer":0,"pr":"Yek livân âb mixâham, lotfan.","s":"Bir bardak su istiyorum, lütfen.","full":"یک لیوان آب می‌خواهم، لطفاً.","a":"audio/fa-tr/87b78cd63315.mp3"},{"type":"type","t":"این غذا ___ دوست دارم.","answer":["را"],"pr":"İn ğazâ râ dust dâram.","s":"Bu yemeği seviyorum.","full":"این غذا را دوست دارم.","a":"audio/fa-tr/7e0afb33b726.mp3"},{"type":"choice","t":"غذای مادرم ___ دوست دارم.","options":["را","است","هستم"],"answer":0,"pr":"Ğazâ-ye mâdaram râ dust dâram.","s":"Annemin yemeğini severim.","full":"غذای مادرم را دوست دارم.","a":"audio/fa-tr/882bd5759b0e.mp3"},{"type":"order","t":"این پنیر را نمی‌خواهم.","pr":"İn panir râ nemixâham.","s":"Bu peyniri istemiyorum.","full":"این پنیر را نمی‌خواهم.","a":"audio/fa-tr/952dc7e2fcb0.mp3"},{"type":"order","t":"این میوه را دوست داری؟","pr":"İn mive râ dust dâri?","s":"Bu meyveyi sever misin?","full":"این میوه را دوست داری؟","a":"audio/fa-tr/dadfcc99638f.mp3"}]}],"reading":{"title":{"t":"صبحانه‌ی ایرانی","pr":"Sobhâne-ye İrâni","s":"İran kahvaltısı","a":"audio/fa-tr/23776a962e0b.mp3"},"text":[{"t":"صبحانه‌ی ما ساده است.","pr":"Sobhâne-ye mâ sâde ast.","s":"Kahvaltımız sade.","a":"audio/fa-tr/b249f2944b66.mp3"},{"t":"ما نان، پنیر و چای داریم.","pr":"Mâ nân, panir va çây dârim.","s":"Ekmeğimiz, peynirimiz ve çayımız var.","a":"audio/fa-tr/5a0c2cbad5aa.mp3"},{"t":"پدرم چای شیرین دوست دارد.","pr":"Pedaram çây-e şirin dust dârad.","s":"Babam şekerli çay sever.","a":"audio/fa-tr/484fedca5829.mp3"},{"t":"مادرم قهوه می‌خواهد، ولی قهوه نداریم!","pr":"Mâdaram ğahve mixâhad, vali ğahve nadârim!","s":"Annem kahve istiyor ama kahvemiz yok!","a":"audio/fa-tr/8358045ddea4.mp3"},{"t":"خواهرم شیر و عسل دوست دارد.","pr":"Xâharam şir va asal dust dârad.","s":"Kız kardeşim süt ve bal sever.","a":"audio/fa-tr/55371f9947d1.mp3"},{"t":"من تخم‌مرغ دوست دارم.","pr":"Man toxm-e morğ dust dâram.","s":"Ben yumurta severim.","a":"audio/fa-tr/6ed1193a2900.mp3"},{"t":"صبحانه خیلی خوشمزه است!","pr":"Sobhâne xeyli xoşmaze ast!","s":"Kahvaltı çok lezzetli!","a":"audio/fa-tr/b4c0cb59e62b.mp3"}],"questions":[{"q":{"t":"پدر چه دوست دارد؟","pr":"Pedar çe dust dârad?","s":"Baba ne sever?","a":"audio/fa-tr/45bd472da410.mp3"},"options":["چای شیرین","قهوه","شیر"],"answer":0},{"q":{"t":"چه چیزی نداریم؟","pr":"Çe çizi nadârim?","s":"Ne yok?","a":"audio/fa-tr/bb87fc4b9dd0.mp3"},"options":["نان","قهوه","پنیر"],"answer":1},{"q":{"t":"خواهر چه دوست دارد؟","pr":"Xâhar çe dust dârad?","s":"Kız kardeş ne sever?","a":"audio/fa-tr/fb91c01f9763.mp3"},"options":["تخم‌مرغ","چای","شیر و عسل"],"answer":2},{"q":{"t":"صبحانه چطور است؟","pr":"Sobhâne çetor ast?","s":"Kahvaltı nasıl?","a":"audio/fa-tr/03437eeb168f.mp3"},"options":["بزرگ","خوشمزه","کوچک"],"answer":1}]},"sentences":[{"t":"یک چای، لطفاً.","pr":"Yek çây, lotfan.","s":"Bir çay, lütfen.","a":"audio/fa-tr/2b65b202536d.mp3"},{"t":"من قهوه نمی‌خواهم.","pr":"Man ğahve nemixâham.","s":"Ben kahve istemiyorum.","a":"audio/fa-tr/6847ab1f7af2.mp3"},{"t":"ما برنج دوست داریم.","pr":"Mâ berenc dust dârim.","s":"Biz pilav severiz.","a":"audio/fa-tr/ac2d2259229c.mp3"},{"t":"این غذا خیلی خوشمزه است!","pr":"İn ğazâ xeyli xoşmaze ast!","s":"Bu yemek çok lezzetli!","a":"audio/fa-tr/1482d3a25de0.mp3"},{"t":"نوش جان!","pr":"Nuş-e cân!","s":"Afiyet olsun!","a":"audio/fa-tr/ca55faf94db5.mp3"},{"t":"دستتان درد نکند!","pr":"Dastetân dard nakonad!","s":"Elinize sağlık!","a":"audio/fa-tr/44106638cf7d.mp3"},{"t":"این کتاب را می‌خواهم.","pr":"İn ketâb râ mixâham.","s":"Bu kitabı istiyorum.","a":"audio/fa-tr/53ad6d501b78.mp3"},{"t":"او پنیر دوست ندارد.","pr":"U panir dust nadârad.","s":"O pe