لی گران است!","s":"Çok pahalı!","pr":"Xeyli gerân ast!","a":"audio/fa-tr/3927b507041c.mp3"},{"id":"p04","t":"تخفیف می‌دهید؟","s":"İndirim yapar mısınız?","pr":"Taxfif midahid?","a":"audio/fa-tr/694314d7a5b2.mp3"},{"id":"p05","t":"این را می‌خواهم.","s":"Bunu istiyorum.","pr":"İn râ mixâham.","a":"audio/fa-tr/94c64653a876.mp3"},{"id":"p06","t":"رنگ دیگری هم دارید؟","s":"Başka renk de var mı?","pr":"Rang-e digari ham dârid?","a":"audio/fa-tr/15d0d74f6009.mp3"},{"id":"p07","t":"بفرمایید.","s":"Buyurun.","pr":"Befarmâyid.","a":"audio/fa-tr/636d94fdfa7b.mp3"},{"id":"p08","t":"چه رنگی دوست دارید؟","s":"Hangi rengi seversiniz?","pr":"Çe rangi dust dârid?","a":"audio/fa-tr/d29decd26e29.mp3"}],"dialogue":{"title":{"t":"در فروشگاه لباس","s":"Giyim mağazasında","pr":"Dar foruşgâh-e lebâs","a":"audio/fa-tr/ab86be6962e6.mp3"},"speakers":{"A":{"name":"Ayşe","voice":"f"},"B":{"name":"Amir","voice":"m"}},"lines":[{"sp":"B","t":"سلام، بفرمایید!","s":"Merhaba, buyurun!","pr":"Salâm, befarmâyid!","a":"audio/fa-tr/e2c6d113a065.mp3"},{"sp":"A","t":"سلام. این پیراهن آبی چند است؟","s":"Merhaba. Bu mavi gömlek ne kadar?","pr":"Salâm. İn pirâhan-e âbi çand ast?","a":"audio/fa-tr/e06391ce4db0.mp3"},{"sp":"B","t":"یک میلیون تومان.","s":"Bir milyon toman. (milyun = milyon)","pr":"Yek milyun tomân.","a":"audio/fa-tr/5a29674639de.mp3"},{"sp":"A","t":"وای، خیلی گران است! تخفیف می‌دهید؟","s":"Of, çok pahalı! İndirim yapar mısınız?","pr":"Vây, xeyli gerân ast! Taxfif midahid?","a":"audio/fa-tr/63ad08b4610c.mp3"},{"sp":"B","t":"نه، ببخشید. ولی آن پیراهن سبز ارزان است.","s":"Hayır, kusura bakmayın. Ama şu yeşil gömlek ucuz.","pr":"Na, bebaxşid. Vali ân pirâhan-e sabz arzân ast.","a":"audio/fa-tr/65982e8c026f.mp3"},{"sp":"A","t":"قیمتش چند است؟","s":"Fiyatı ne kadar?","pr":"Ğeymataş çand ast?","a":"audio/fa-tr/9570078f9e0a.mp3"},{"sp":"B","t":"پانصد هزار تومان.","s":"Beş yüz bin toman. (pânsad = beş yüz)","pr":"Pânsad hezâr tomân.","a":"audio/fa-tr/69e0952d5805.mp3"},{"sp":"A","t":"خوب است. رنگ دیگری هم دارید؟","s":"Güzel. Başka renk de var mı?","pr":"Xub ast. Rang-e digari ham dârid?","a":"audio/fa-tr/8ae10f4a8549.mp3"},{"sp":"B","t":"بله، سفید و سیاه هم داریم.","s":"Evet, beyaz ve siyah da var.","pr":"Bale, sefid va siyâh ham dârim.","a":"audio/fa-tr/cd29f1a097fe.mp3"},{"sp":"A","t":"پس پیراهن سفید را می‌خواهم.","s":"O zaman beyaz gömleği istiyorum.","pr":"Pas pirâhan-e sefid râ mixâham.","a":"audio/fa-tr/2bc386c8b78d.mp3"}]},"grammar":[{"id":"g01","title":{"t":"این پیراهن قرمز","s":"\"in / ân\" ve renkler (ezafe ile)","pr":"in pirâhan-e ğermez"},"explain":"**in** = bu, **ân** = şu / o. Türkçedeki gibi ismin önüne gelir ve hiç değişmez: **in ketâb** (bu kitap), **in ketâbhâ** (bu kitaplar).\nRenkler (ve bütün sıfatlar) Türkçenin tersine ismin **arkasına** gelir ve araya **ezafe** (**-e**) girer: **pirâhan-e ğermez** = kırmızı gömlek. Kelime ünlüyle bitiyorsa **-ye** olur: **xâne-ye sefid** = beyaz ev. Ezafe yazıda genellikle görünmez, ama söylenir!\nSıfat yüklem olunca ezafe yoktur: **pirâhan-e ğermez** (kırmızı gömlek) ↔ **pirâhan ğermez ast** (gömlek kırmızı).\nTanıdık kelimeler: **rang** = renk (Türkçeye Farsçadan geçmiş), **ğermez** = kırmızı (aynı kökten), **âbi** = mavi (**âb** = su).","table":[["قرمز","ğermez","🔴"],["آبی","âbi","🔵"],["سبز","sabz","🟢"],["زرد","zard","🟡"],["نارنجی","nârenci","🟠"],["قهوه‌ای","ğahve'i","🟤"],["سیاه","siyâh","⚫"],["سفید","sefid","⚪"]],"examples":[{"t":"این پیراهن قرمز است.","s":"Bu gömlek kırmızı.","pr":"İn pirâhan ğermez ast.","a":"audio/fa-tr/11737baa1588.mp3"},{"t":"آن کیف سیاه گران است.","s":"Şu siyah çanta pahalı.","pr":"Ân kif-e siyâh gerân ast.","a":"audio/fa-tr/6f8e6cdcfe36.mp3"},{"t":"من کفش سفید می‌خواهم.","s":"Beyaz ayakkabı istiyorum.","pr":"Man kafş-e sefid mixâham.","a":"audio/fa-tr/1db5ebc26d75.mp3"},{"t":"خانه‌ی سفید بزرگ است.","s":"Beyaz ev büyük.","pr":"Xâne-ye sefid bozorg ast.","a":"audio/fa-tr/bc85fccebb7f.mp3"},{"t":"علی یک ماشین قرمز دارد.","s":"Ali'nin kırmızı bir arabası var.","pr":"Ali yek mâşin-e ğermez dârad.","a":"audio/fa-tr/3ef71647ce08.mp3"}],"exercises":[{"type":"choice","t":"من یک پیراهن ___ می‌خواهم.","options":["آبی","قرمز","زرد"],"answer":0,"s":"Mavi bir gömlek istiyorum.","pr":"Man yek pirâhan-e âbi mixâham.","full":"من یک پیراهن آبی می‌خواهم.","a":"audio/fa-tr/5dfbd09fe329.mp3"},{"type":"choice","t":"___ کیف سیاه است و آن کیف سفید است.","options":["این","آن","چند"],"answer":0,"s":"Bu çanta siyah, şu çanta beyaz.","pr":"İn kif siyâh ast va ân kif sefid ast.","full":"این کیف سیاه است و آن کیف سفید است.","a":"audio/fa-tr/4a1609497806.mp3"},{"type":"choice","t":"من ___ دارم.","options":["سیاه کیف","کیف سیاه","کیف سیاه است"],"answer":1,"s":"Siyah bir çantam var.","pr":"Man kif-e siyâh dâram.","full":"من کیف سیاه دارم.","a":"audio/fa-tr/34a322efe378.mp3"},{"type":"choice","t":"برف ___ است.","options":["سیاه","سبز","سفید"],"answer":2,"s":"Kar beyaz.","pr":"Barf sefid ast.","full":"برف سفید است.","a":"audio/fa-tr/826ef1c4c235.mp3"},{"type":"type","t":"آسمان ___ است.","answer":["آبی"],"s":"Gökyüzü mavi.","pr":"Âsemân âbi ast.","full":"آسمان آبی است.","a":"audio/fa-tr/d77582249dc0.mp3"},{"type":"type","t":"___ پیراهن خیلی گران است.","answer":["این"],"s":"Bu gömlek çok pahalı.","pr":"İn pirâhan xeyli gerân ast.","full":"این پیراهن خیلی گران است.","a":"audio/fa-tr/f483a9c86f1e.mp3"},{"type":"order","t":"این پیراهن قرمز است.","s":"Bu gömlek kırmızı.","pr":"İn pirâhan ğermez ast.","full":"این پیراهن قرمز است.","a":"audio/fa-tr/11737baa1588.mp3"},{"type":"order","t":"من کفش سفید می‌خواهم.","s":"Beyaz ayakkabı istiyorum.","pr":"Man kafş-e sefid mixâham.","full":"من کفش سفید می‌خواهم.","a":"audio/fa-tr/1db5ebc26d75.mp3"}]},{"id":"g02","title":{"t":"قیمتش چند است؟","s":"Fiyat sormak ve toman","pr":"Ğeymataş çand ast?"},"explain":"Fiyat sormanın en kolay yolu: **… çand ast?** = … ne kadar? **İn çand ast?** = Bu ne kadar?\nBir başka yol: **Ğeymataş çand ast?** = Fiyatı ne kadar? Sondaki **-aş** \"onun\" anlamındaki iyelik ekidir, Türkçedeki *fiyat-ı* gibi.\nİran'da fiyatlar konuşurken genellikle **toman** ile söylenir (1 toman = 10 riyal). Etiketlerde bazen riyal yazar, dikkat!\nBüyük sayılar: **sad** = yüz, **hezâr** = bin, **milyun** = milyon. Sıralama Türkçedeki gibidir: **dah hezâr** = on bin, **sad hezâr** = yüz bin. **pânsad** (beş yüz) özel bir kelimedir.","table":[["۱۰۰","صد","sad"],["۵۰۰","پانصد","pânsad"],["۱٬۰۰۰","هزار","hezâr"],["۱۰٬۰۰۰","ده هزار","dah hezâr"],["۱۰۰٬۰۰۰","صد هزار","sad hezâr"],["۱٬۰۰۰٬۰۰۰","یک میلیون","yek milyun"]],"examples":[{"t":"این کیف چند است؟","s":"Bu çanta ne kadar?","pr":"İn kif çand ast?","a":"audio/fa-tr/d56b26b07c36.mp3"},{"t":"قیمتش صد هزار تومان است.","s":"Fiyatı yüz bin toman.","pr":"Ğeymataş sad hezâr tomân ast.","a":"audio/fa-tr/024e57ab0090.mp3"},{"t":"این کفش یک میلیون تومان است.","s":"Bu ayakkabı bir milyon toman.","pr":"İn kafş yek milyun tomân ast.","a":"audio/fa-tr/ac5c8ef11d37.mp3"},{"t":"خیلی گران است! تخفیف می‌دهید؟","s":"Çok pahalı! İndirim yapar mısınız?","pr":"Xeyli gerân ast! Taxfif midahid?","a":"audio/fa-tr/419b36a1d496.mp3"},{"t":"آن کتاب ارزان است: بیست هزار تومان.","s":"Şu kitap ucuz: yirmi bin toman.","pr":"Ân ketâb arzân ast: bist hezâr tomân.","a":"audio/fa-tr/298fb580d713.mp3"}],"exercises":[{"type":"choice","t":"این پیراهن ___ است؟","options":["چند","هستم","به"],"answer":0,"s":"Bu gömlek ne kadar?","pr":"İn pirâhan çand ast?","full":"این پیراهن چند است؟","a":"audio/fa-tr/c3b819bae72a.mp3"},{"type":"choice","t":"قیمتش صد ___ تومان است.","options":["چند","هزار","است"],"answer":1,"s":"Fiyatı yüz bin toman.","pr":"Ğeymataş sad hezâr tomân ast.","full":"قیمتش صد هزار تومان است.","a":"audio/fa-tr/024e57ab0090.mp3"},{"type":"choice","t":"این کیف خیلی ___ است!","options":["ارزان","آبی","گران"],"answer":2,"s":"Bu çanta çok pahalı!","pr":"İn kif xeyli gerân ast!","full":"این کیف خیلی گران است!","a":"audio/fa-tr/2f11c086ad10.mp3"},{"type":"choice","t":"این کتاب ارزان است: ___ هزار تومان.","options":["پنج","پانصد","صد"],"answer":0,"s":"Bu kitap ucuz: beş bin toman.","pr":"