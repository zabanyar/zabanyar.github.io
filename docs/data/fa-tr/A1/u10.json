:"w07","t":"گیتار","s":"gitar","pr":"gitâr","emoji":"🎸","ex":{"t":"سارا گیتار می‌زند.","s":"Sara gitar çalıyor.","pr":"Sârâ gitâr mizanad.","a":"audio/fa-tr/b8f8156b0e4a.mp3"},"img":"img/e/1f3b8.svg","a":"audio/fa-tr/a50f22fb8900.mp3"},{"id":"w08","t":"آشپزی","s":"yemek pişirme, aşçılık","pr":"âşpazi","emoji":"🥘","ex":{"t":"پدرم آشپزی را دوست دارد.","s":"Babam yemek yapmayı sever.","pr":"Pedaram âşpazi râ dust dârad.","a":"audio/fa-tr/b6e9e686da3f.mp3"},"img":"img/e/1f958.svg","a":"audio/fa-tr/027f616fca52.mp3"},{"id":"w09","t":"نقاشی","s":"resim (yapma)","pr":"nağğâşi","emoji":"🎨","ex":{"t":"الیف نقاشی می‌کند.","s":"Elif resim yapıyor.","pr":"Elif nağğâşi mikonad.","a":"audio/fa-tr/37d0e1d77f10.mp3"},"img":"img/e/1f3a8.svg","a":"audio/fa-tr/1adeacb7b851.mp3"},{"id":"w10","t":"پیاده‌روی","s":"yürüyüş","pr":"piyâderavi","emoji":"🥾","ex":{"t":"ما عصر پیاده‌روی می‌کنیم.","s":"Biz öğleden sonra yürüyüş yapıyoruz.","pr":"Mâ asr piyâderavi mikonim.","a":"audio/fa-tr/d58673182b3b.mp3"},"img":"img/e/1f97e.svg","a":"audio/fa-tr/5740a2905d6b.mp3"},{"id":"w11","t":"دوچرخه","s":"bisiklet","pr":"doçarxe","emoji":"🚲","ex":{"t":"رضا با دوچرخه به مدرسه می‌رود.","s":"Reza okula bisikletle gidiyor.","pr":"Rezâ bâ doçarxe be madrese miravad.","a":"audio/fa-tr/cac940366821.mp3"},"img":"img/e/1f6b2.svg","a":"audio/fa-tr/8c766f8be1db.mp3"},{"id":"w12","t":"توانستن","s":"-ebilmek, yapabilmek","pr":"tavânestan","emoji":"💪","ex":{"t":"من می‌توانم فارسی بخوانم.","s":"Farsça okuyabilirim.","pr":"Man mitavânam fârsi bexânam.","a":"audio/fa-tr/6c17cec81ec0.mp3"},"img":"img/e/1f4aa.svg","a":"audio/fa-tr/7fe484cb47bc.mp3"},{"id":"w13","t":"آخر هفته","s":"hafta sonu","pr":"âxar-e hafte","emoji":"📅","ex":{"t":"آخر هفته به پارک می‌رویم.","s":"Hafta sonu parka gidiyoruz.","pr":"Âxar-e hafte be pârk miravim.","a":"audio/fa-tr/e2de2f97a89a.mp3"},"img":"img/e/1f4c5.svg","a":"audio/fa-tr/b10a1461e214.mp3"},{"id":"w14","t":"وقت آزاد","s":"boş zaman","pr":"vağt-e âzâd","emoji":"","ex":{"t":"در وقت آزاد کتا