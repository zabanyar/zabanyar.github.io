udio/fa-tr/6a7329e73d68.mp3"},{"id":"p05","t":"اهل کجا هستید؟","pr":"Ahl-e kocâ hastid?","s":"Nerelisiniz?","a":"audio/fa-tr/a67a39d63519.mp3"},{"id":"p06","t":"خوشبختم!","pr":"Xoşbaxtam!","s":"Memnun oldum! (tanışınca)","a":"audio/fa-tr/21651cfae46f.mp3"},{"id":"p07","t":"ممنون!","pr":"Mamnun!","s":"Teşekkürler!","a":"audio/fa-tr/9c204b715223.mp3"},{"id":"p08","t":"خداحافظ!","pr":"Xodâhâfez!","s":"Hoşça kal! / Güle güle!","a":"audio/fa-tr/471e2016fec3.mp3"}],"dialogue":{"title":{"t":"آشنایی","pr":"Âşenâyi","s":"Tanışma","a":"audio/fa-tr/5482d9e58dd7.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"سلام!","pr":"Salâm!","s":"Merhaba!","a":"audio/fa-tr/4fcf7bfd714a.mp3"},{"sp":"B","t":"سلام! حال شما چطور است؟","pr":"Salâm! Hâl-e şomâ çetor ast?","s":"Merhaba! Nasılsınız?","a":"audio/fa-tr/2ceac9d90836.mp3"},{"sp":"A","t":"خوبم، ممنون. شما چطورید؟","pr":"Xubam, mamnun. Şomâ çetorid?","s":"İyiyim, teşekkürler. Siz nasılsınız?","a":"audio/fa-tr/80dfe4a15577.mp3"},{"sp":"B","t":"من هم خوبم. اسم شما چیست؟","pr":"Man ham xubam. Esm-e şomâ çist?","s":"Ben de iyiyim. Adınız ne?","a":"audio/fa-tr/3236e2ee552a.mp3"},{"sp":"A","t":"اسم من سارا است. و شما؟","pr":"Esm-e man Sârâ ast. Va şomâ?","s":"Benim adım Sara. Ya siz?","a":"audio/fa-tr/cc7b9469a2eb.mp3"},{"sp":"B","t":"من مهمت هستم. اهل کجا هستید؟","pr":"Man Mehmet hastam. Ahl-e kocâ hastid?","s":"Ben Mehmet'im. Nerelisiniz?","a":"audio/fa-tr/aa4b94562b7a.mp3"},{"sp":"A","t":"من ایرانی هستم، اهل تهران. شما اهل کجا هستید؟","pr":"Man İrâni hastam, ahl-e Tehrân. Şomâ ahl-e kocâ hastid?","s":"Ben İranlıyım, Tahranlıyım. Siz nerelisiniz?","a":"audio/fa-tr/3b1bebf009c8.mp3"},{"sp":"B","t":"من ترک هستم، اهل استانبول.","pr":"Man Tork hastam, ahl-e Estânbol.","s":"Ben Türküm, İstanbulluyum.","a":"audio/fa-tr/9e9218f1bd4b.mp3"},{"sp":"A","t":"خوشبختم!","pr":"Xoşbaxtam!","s":"Memnun oldum!","a":"audio/fa-tr/92766032801e.mp3"},{"sp":"B","t":"من هم خوشبختم. خداحافظ!","pr":"Man ham xoşbaxtam. Xodâhâfez!","s":"Ben de memnun oldum. Hoşça kalın!","a":"audio/fa-tr/b12a4042aa9b.mp3"}]},"grammar":[{"id":"g01","title":{"t":"من هستم، تو هستی","pr":"man hastam, to hasti","s":"Şahıs zamirleri ve «olmak» fiili"},"explain":"Farsça cümle yapısı Türkçeye çok benzer: **fiil sonda** gelir! **Man İrâni hastam.** = Ben İranlıyım.\n«Olmak» fiili **hastam, hasti, ast…** şeklindedir. Türkçedeki **-ım, -sın** ekleri gibi düşünün, ama ayrı bir kelime olarak yazılır.\nİyi haber: Farsçada **ünlü uyumu yoktur**, ekler hep aynıdır. **Cinsiyet de yoktur**: **u** (او) Türkçedeki 'o' gibi hem kadın hem erkek için kullanılır.\n**şomâ** (siz) Türkçedeki gibi hem çoğul hem de kibar 'siz' anlamındadır. Zamir çoğu zaman düşer: **İrâni hastam.** = İranlıyım.","table":[["من هستم","man hastam","ben …-ım"],["تو هستی","to hasti","sen …-sın"],["او است","u ast","o …(dır)"],["ما هستیم","mâ hastim","biz …-ız"],["شما هستید","şomâ hastid","siz …-sınız"],["آن‌ها هستند","ânhâ hastand","onlar …-lar"]],"examples":[{"t":"من دانشجو هستم.","pr":"Man dâneşcu hastam.","s":"Ben öğrenciyim.","a":"audio/fa-tr/5e7f39b54e7c.mp3"},{"t":"تو ایرانی هستی.","pr":"To İrâni hasti.","s":"Sen İranlısın.","a":"audio/fa-tr/7584493728f7.mp3"},{"t":"او معلم است.","pr":"U mo'allem ast.","s":"O öğretmen.","a":"audio/fa-tr/1a11995a1d85.mp3"},{"t":"ما ترک هستیم.","pr":"Mâ Tork hastim.","s":"Biz Türküz.","a":"audio/fa-tr/53d212d3dfec.mp3"},{"t":"آن‌ها اهل شیراز هستند.","pr":"Ânhâ ahl-e Şirâz hastand.","s":"Onlar Şirazlı.","a":"audio/fa-tr/33d0892660af.mp3"}],"exercises":[{"type":"choice","t":"من دانشجو ___.","options":["هستم","هستی","هستند"],"answer":0,"pr":"Man dâneşcu hastam.","s":"Ben öğrenciyim.","full":"من دانشجو هستم.","a":"audio/fa-tr/5e7f39b54e7c.mp3"},{"type":"choice","t":"تو ایرانی ___.","options":["هستیم","هستی","است"],"answer":1,"pr":"To İrâni hasti.","s":"Sen İranlısın.","full":"تو ایرانی هستی.","a":"audio/fa-tr/7584493728f7.mp3"},{"type":"choice","t":"___ معلم هستیم.","options":["ما","من","آن‌ها"],"answer":0,"pr":"Mâ mo'allem hastim.","s":"Biz öğretmeniz.","full":"ما معلم هستیم.","a":"audio/fa-tr/1edae3a5e23d.mp3"},{"type":"type","t":"او دانشجو ___.","answer":["است"],"pr":"U dâneşcu ast.","s":"O öğrenci.","full":"او دانشجو است.","a":"audio/fa-tr/1c369b29f2f6.mp3"},{"type":"type","t":"شما اهل کجا ___؟","answer":["هستید"],"pr":"Şomâ ahl-e kocâ hastid?","s":"Siz nerelisiniz?","full":"شما اهل کجا هستید؟","a":"audio/fa-tr/4a358361caaf.mp3"},{"type":"choice","t":"آن‌ها ترک ___.","options":["هستند","هستید","هستم"],"answer":0,"pr":"Ânhâ Tork hastand.","s":"Onlar Türk.","full":"آن‌ها ترک هستند.","a":"audio/fa-tr/d2dce6be3417.mp3"},{"type":"order","t":"من اهل ترکیه هستم.","pr":"Man ahl-e Torkiye hastam.","s":"Ben Türkiyeliyim.","full":"من اهل ترکیه هستم.","a":"audio/fa-tr/780f9c37264d.mp3"},{"type":"order","t":"آیشه و مریم دانشجو هستند.","pr":"Âyşe va Maryam dâneşcu hastand.","s":"Ayşe ve Maryam öğrenci.","full":"آیشه و مریم دانشجو هستند.","a":"audio/fa-tr/a88502dcfcb2.mp3"}]},{"id":"g02","title":{"t":"خوبم، خوبی، خوب است","pr":"xubam, xubi, xub ast","s":"Kısa ekler ve «اسم من… / اهل…»"},"explain":"Konuşmada **hastam, hasti…** çoğu zaman kısalır ve kelimeye **ek** olarak yapışır, tıpkı Türkçe gibi: **xub hastam → xubam** (iyiyim), **xubi** (iyisin), **xubim** (iyiyiz), **xubid** (iyisiniz), **xuband** (iyiler). 'O' için **ast** kalır: **xub ast**. Ünlüyle biten kelimeden sonra **ast** bazen **-st** olur: **kocâ + ast = kocâst** (nerede?).\nAd söylemek için: **Esm-e man Sârâ ast.** = Benim adım Sara. (Aradaki **-e** sesine 3. ünitede bakacağız.)\nNereli olduğunu söylemek için **ahl-e** (…li) kullanılır: **Man ahl-e Tehrân hastam.** = Ben Tahranlıyım.\nDikkat, sahte arkadaş: **mamnun** Farsçada çoğunlukla 'teşekkürler, minnettarım' anlamındadır; 'memnun oldum' ise **xoşbaxtam** ile söylenir!","table":[["خوبم","xubam","iyiyim"],["خوبی","xubi","iyisin"],["خوب است","xub ast","iyi"],["خوبیم","xubim","iyiyiz"],["خوبید","xubid","iyisiniz"],["خوبند","xuband","iyiler"]],"examples":[{"t":"خوبم، ممنون.","pr":"Xubam, mamnun.","s":"İyiyim, teşekkürler.","a":"audio/fa-tr/271b0f89a1c7.mp3"},{"t":"اسم من سارا است.","pr":"Esm-e man Sârâ ast.","s":"Benim adım Sara.","a":"audio/fa-tr/ee88612589f5.mp3"},{"t":"من اهل استانبول هستم.","pr":"Man ahl-e Estânbol hastam.","s":"Ben İstanbulluyum.","a":"audio/fa-tr/55bdbb543954.mp3"},{"t":"رضا اهل کجاست؟","pr":"Rezâ ahl-e kocâst?","s":"Reza nereli?","a":"audio/fa-tr/8304c03b10ce.mp3"}],"exercises":[{"type":"choice","t":"من خوب___.","options":["م","ی","ند"],"answer":0,"pr":"Man xubam.","s":"Ben iyiyim.","full":"من خوبم.","a":"audio/fa-tr/39df628b34a7.mp3"},{"type":"choice","t":"تو خوب___؟","options":["یم","ی","م"],"answer":1,"pr":"To xubi?","s":"Sen iyi misin?","full":"تو خوبی؟","a":"audio/fa-tr/387035e01964.mp3"},{"type":"type","t":"ما خوب___.","answer":["یم"],"pr":"Mâ xubim.","s":"Biz iyiyiz.","full":"ما خوبیم.","a":"audio/fa-tr/4131ab656889.mp3"},{"type":"choice","t":"اسم من رضا ___.","options":["هستم","است","هستی"],"answer":1,"pr":"Esm-e man Rezâ ast.","s":"Benim adım Reza.","full":"اسم من رضا است.","a":"audio/fa-tr/09eb2a6bdd99.mp3"},{"type":"choice","t":"شما اهل ___ هستید؟","options":["کجا","اسم","من"],"answer":0,"pr":"Şomâ ahl-e kocâ hastid?","s":"Siz nerelisiniz?","full":"شما اهل کجا هستید؟","a":"audio/fa-tr/4a358361caaf.mp3"},{"type":"type","t":"من ___ تهران هستم.","answer":["اهل"],"pr":"Man ahl-e Tehrân hastam.","s":"Ben Tahranlıyım.","full":"من اهل تهران هستم.","a":"audio/fa-tr/f8632821995b.mp3"},{"type":"order","t":"اسم من سارا است.","pr":"Esm-e man Sârâ ast.","s":"Benim adım Sara.","full":"اسم من سارا است.","a":"audio/fa-tr/ee88612589f5.mp3"},{"type":"order","t":"شما اهل کجا هستید؟","pr":"Şomâ ahl-e kocâ hastid?","s":"Siz nerelisiniz?","full":"شما اهل کجا هستید؟","a":"audio/fa-tr/4a358361caaf.mp3"}]}],"reading":{"title":{"t":"سلام! من رضا هستم.","pr":"Salâm! Man Rezâ hastam.","s":"Merhaba! Ben Reza.","a":"audio/fa-tr/6bdd8f3d3d83.mp3"},"text":[{"t":"سلام! اسم من رضا است.","pr":"Salâm! Esm-e man Rezâ ast