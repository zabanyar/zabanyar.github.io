{"id":"u02","level":"A1","emoji":"🔢","title":{"t":"عددها و سن","pr":"Adadhâ va sen","s":"Sayılar ve yaş","a":"audio/fa-tr/0346ec81737e.mp3"},"goals":["0'dan 100'e kadar sayabilirim.","Fars rakamlarını (۰–۹) okuyabilirim.","Yaş sorup söyleyebilirim.","Çoğul eklerini (-hâ / -ân) kullanabilirim."],"words":[{"id":"w01","t":"صفر","pr":"sefr","s":"sıfır","emoji":"","ex":{"t":"صفر، یک، دو، سه!","pr":"Sefr, yek, do, se!","s":"Sıfır, bir, iki, üç!","a":"audio/fa-tr/0648d313cda4.mp3"},"img":null,"a":"audio/fa-tr/1a5a6fa80e98.mp3"},{"id":"w02","t":"یک","pr":"yek","s":"bir","emoji":"☝️","ex":{"t":"یک چای، لطفاً.","pr":"Yek çây, lotfan.","s":"Bir çay, lütfen.","a":"audio/fa-tr/2b65b202536d.mp3"},"img":"img/e/261d.svg","a":"audio/fa-tr/bb5776a1f80e.mp3"},{"id":"w03","t":"دو","pr":"do","s":"iki","emoji":"✌️","ex":{"t":"دو سیب، لطفاً.","pr":"Do sib, lotfan.","s":"İki elma, lütfen.","a":"audio/fa-tr/7be4c2ca5f7d.mp3"},"img":"img/e/270c.svg","a":"audio/fa-tr/c8eca81ff3fe.mp3"},{"id":"w04","t":"سه","pr":"se","s":"üç","emoji":"","ex":{"t":"سه چای، لطفاً.","pr":"Se çây, lotfan.","s":"Üç çay, lütfen.","a":"audio/fa-tr/63fd1a7069b3.mp3"},"img":null,"a":"audio/fa-tr/f21da4860523.mp3"},{"id":"w05","t":"چهار","pr":"çahâr","s":"dört","emoji":"","ex":{"t":"او چهار سال دارد.","pr":"U çahâr sâl dârad.","s":"O dört yaşında.","a":"audio/fa-tr/2c788283c3d5.mp3"},"img":null,"a":"audio/fa-tr/d45e6bb7eecf.mp3"},{"id":"w06","t":"پنج","pr":"panc","s":"beş","emoji":"","ex":{"t":"پنج نان، لطفاً.","pr":"Panc nân, lotfan.","s":"Beş ekmek, lütfen.","a":"audio/fa-tr/6874c1fa2f93.mp3"},"img":null,"a":"audio/fa-tr/e7bfb53043ee.mp3"},{"id":"w07","t":"شش","pr":"şeş","s":"altı","emoji":"","ex":{"t":"سینا شش سال دارد.","pr":"Sinâ şeş sâl dârad.","s":"Sina altı yaşında.","a":"audio/fa-tr/b1f4865e0c08.mp3"},"img":null,"a":"audio/fa-tr/f8d259d00c61.mp3"},{"id":"w08","t":"هفت","pr":"haft","s":"yedi","emoji":"","ex":{"t":"هفته هفت روز دارد.","pr":"Hafte haft ruz dârad.","s":"Haftada yedi gün var.","a":"audio/fa-tr/20f335b6ef5a.mp3"},"img":null,"a":"audio/fa-tr/8ffdb1e46fcc.mp3"},{"id":"w09","t":"هشت","pr":"haşt","s":"sekiz","emoji":"","ex":{"t":"هشت سیب، لطفاً.","pr":"Haşt sib, lotfan.","s":"Sekiz elma, lütfen.","a":"audio/fa-tr/5b6d0e786103.mp3"},"img":null,"a":"audio/fa-tr/180f84e25ee5.mp3"},{"id":"w10","t":"نه","pr":"noh","s":"dokuz","emoji":"","ex":{"t":"او نه سال دارد.","pr":"U noh sâl dârad.","s":"O dokuz yaşında.","a":"audio/fa-tr/2966e849cbb5.mp3"},"img":null,"a":"audio/fa-tr/4eb047513630.mp3"},{"id":"w11","t":"ده","pr":"dah","s":"on","emoji":"🔟","ex":{"t":"من ده کتاب دارم.","pr":"Man dah ketâb dâram.","s":"On kitabım var.","a":"audio/fa-tr/e1fda6cd0883.mp3"},"img":"img/e/1f51f.svg","a":"audio/fa-tr/a051eb7f4e70.mp3"},{"id":"w12","t":"بیست","pr":"bist","s":"yirmi","emoji":"","ex":{"t":"من بیست سال دارم.","pr":"Man bist sâl dâram.","s":"Ben yirmi yaşındayım.","a":"audio/fa-tr/feb065a23dfc.mp3"},"img":null,"a":"audio/fa-tr/3256c3b5ac67.mp3"},{"id":"w15","t":"سی","pr":"si","s":"otuz","emoji":"","ex":{"t":"من سی سال دارم.","pr":"Man si sâl dâram.","s":"Ben otuz yaşındayım.","a":"audio/fa-tr/44c5dade1882.mp3"},"img":null,"a":"audio/fa-tr/cc9c55854052.mp3"},{"id":"w16","t":"صد","pr":"sad","s":"yüz (100)","emoji":"","ex":{"t":"کلاس ما صد کتاب دارد.","pr":"Kelâs-e mâ sad ketâb dârad.","s":"Sınıfımızda yüz kitap var.","a":"audio/fa-tr/4f0c907fa215.mp3"},"img":null,"a":"audio/fa-tr/3e1508215438.mp3"},{"id":"w13","t":"سال","pl":"سال‌ها","pr":"sâl","s":"yıl; yaş","emoji":"📅","ex":{"t":"شما چند سال دارید؟","pr":"Şomâ çand sâl dârid?","s":"Kaç yaşındasınız?","a":"audio/fa-tr/e55bae5c34b1.mp3"},"sym":true,"img":"img/e/1f4c5.svg","a":"audio/fa-tr/88b1f8fbc9a8.mp3","pla":"audio/fa-tr/edd93220fe14.mp3"},{"id":"w14","t":"چند","pr":"çand","s":"kaç","emoji":"❓","ex":{"t":"چند سیب؟","pr":"Çand sib?","s":"Kaç elma?","a":"audio/fa-tr/f8805c4c7935.mp3"},"sym":true,"img":"img/e/2753.svg","a":"audio/fa-tr/7a12cecbee17.mp3"}],"phrases":[{"id":"p01","t":"چند سال دارید؟","pr":"Çand sâl dârid?","s":"Kaç yaşındasınız?","a":"audio/fa-tr/e7c283d31c6f.mp3"},{"id":"p02","t":"چند سال داری؟","pr":"Çand sâl dâri?","s":"Kaç yaşındasın?","a":"audio/fa-tr/46003b27d90a.mp3"},{"id":"p03","t":"بیست سال دارم.","pr":"Bist sâl dâram.","s":"Yirmi yaşındayım.","a":"audio/fa-tr/7a8b7635fe6e.mp3"},{"id":"p04","t":"شماره‌ی تلفن شما چند است؟","pr":"Şomâre-ye telefon-e şomâ çand ast?","s":"Telefon numaranız kaç?","a":"audio/fa-tr/ae8ccde512cf.mp3"},{"id":"p05","t":"چند تا؟","pr":"Çand tâ?","s":"Kaç tane?","a":"audio/fa-tr/72aad589b811.mp3"},{"id":"p06","t":"یک لحظه، لطفاً.","pr":"Yek lahze, lotfan.","s":"Bir dakika, lütfen.","a":"audio/fa-tr/0554fdd506d6.mp3"},{"id":"p07","t":"دوباره، لطفاً.","pr":"Dobâre, lotfan.","s":"Tekrar, lütfen.","a":"audio/fa-tr/4020331f8f69.mp3"},{"id":"p08","t":"درست است!","pr":"Dorost ast!","s":"Doğru!","a":"audio/fa-tr/1086dc5f33d7.mp3"}],"dialogue":{"title":{"t":"شماره‌ی تلفن","pr":"Şomâre-ye telefon","s":"Telefon numarası","a":"audio/fa-tr/823777c447ce.mp3"},"speakers":{"A":{"name":"Mina","voice":"f"},"B":{"name":"Emre","voice":"m"}},"lines":[{"sp":"A","t":"سلام امره! چند سال داری؟","pr":"Salâm Emre! Çand sâl dâri?","s":"Merhaba Emre! Kaç yaşındasın?","a":"audio/fa-tr/18360b7153ed.mp3"},{"sp":"B","t":"سلام مینا! نوزده سال دارم. تو چند سال داری؟","pr":"Salâm Minâ! Nuzdah sâl dâram. To çand sâl dâri?","s":"Merhaba Mina! On dokuz yaşındayım. Sen kaç yaşındasın?","a":"audio/fa-tr/4906abc0ba68.mp3"},{"sp":"A","t":"من بیست سال دارم.","pr":"Man bist sâl dâram.","s":"Ben yirmi yaşındayım.","a":"audio/fa-tr/3394f229f9ee.mp3"},{"sp":"B","t":"شماره‌ی تلفن تو چند است؟","pr":"Şomâre-ye telefon-e to çand ast?","s":"Telefon numaran kaç?","a":"audio/fa-tr/4099c36d3355.mp3"},{"sp":"A","t":"دو، دو، سه، چهار، پنج، شش، هفت، هشت.","pr":"Do, do, se, çahâr, panc, şeş, haft, haşt.","s":"İki, iki, üç, dört, beş, altı, yedi, sekiz.","a":"audio/fa-tr/953a0f41a74b.mp3"},{"sp":"B","t":"یک لحظه… دوباره، لطفاً.","pr":"Yek lahze… Dobâre, lotfan.","s":"Bir dakika… Tekrar, lütfen.","a":"audio/fa-tr/e035a69346fc.mp3"},{"sp":"A","t":"دو، دو، سه، چهار، پنج، شش، هفت، هشت.","pr":"Do, do, se, çahâr, panc, şeş, haft, haşt.","s":"İki, iki, üç, dört, beş, altı, yedi, sekiz.","a":"audio/fa-tr/953a0f41a74b.mp3"},{"sp":"B","t":"درست است. ممنون، مینا!","pr":"Dorost ast. Mamnun, Minâ!","s":"Tamam, doğru. Teşekkürler, Mina!","a":"audio/fa-tr/d0a926c4a51e.mp3"},{"sp":"A","t":"خواهش می‌کنم!","pr":"Xâheş mikonam!","s":"Rica ederim!","a":"audio/fa-tr/d2e535b081b0.mp3"}]},"grammar":[{"id":"g01","title":{"t":"عددها از صفر تا صد","pr":"adadhâ az sefr tâ sad","s":"0–100 arası sayılar ve yaş"},"explain":"Farsçada rakamların kendi şekilleri vardır: **۰ ۱ ۲ ۳ ۴ ۵ ۶ ۷ ۸ ۹**. Dikkat: **۰** (sıfır) küçük bir nokta, **۵** (beş) ise sıfıra benzer! Sayılar, yazı sağdan sola olsa bile **soldan sağa** yazılır: **۲۰** = 20.\n11–19 arası sayılar **-dah** ile biter: **yâzdah** (11), **davâzdah** (12) … **nuzdah** (19).\nOnlar: **si** (30), **çehel** (40), **pancâh** (50), **şast** (60), **haftâd** (70), **haştâd** (80), **navad** (90), **sad** (100). Aradaki sayılar Türkçedeki gibi kurulur, sadece araya **va** (و, ve) girer; konuşurken **-o** diye söylenir: **bist-o yek** (21), **si-yo panc** (35), **çehel-o haft** (47).\nTıpkı Türkçedeki gibi sayıdan sonra isim **tekil** kalır: **do sib** = iki elma (iki elmalar değil!). Türkçedeki 'tane' gibi **tâ** da eklenebilir: **se tâ çây** = üç tane çay.\nYaş söylerken Farsçada kelimesi kelimesine '… yılım var' denir: **Bist sâl dâram.** = Yirmi yaşındayım. Soru: **Çand sâl dârid?** = Kaç yaşındasınız?\nDikkat: **نه** hem **noh** (dokuz) hem **na** (hayır) olabilir; **سن** (sen) ise Farsçada 'yaş' demektir!","table":[["۱۱ یازده","yâzdah","on bir"],["۱۲ دوازده","davâzdah","on iki"],["۱۳ سیزده","sizdah","on üç"],["۱۴ چهارده","çahârdah","on dört"],["۱۵ پانزده","pânzdah","on beş"],["۱۶ شانزده","şânzdah","on altı"],["۱۷ هفده","hefdah","on yedi"],["۱۸ هجده","hecdah","on sekiz"],["۱۹ نوزده","nuzdah","on dokuz"],["۲۰ بیست","bist","yirmi"],["۳۰ سی","si","otuz"],["۴۰ چهل","çehel","kırk"],["۵۰ پنجاه","pancâh","elli"],["۶۰ شصت","şast","altmış"],["۷۰ هفتاد","haftâd","yetmiş"],["۸۰ هشتاد","haştâd","seksen"],["۹۰ نود","navad","doksan"],["۱۰۰ صد","sad","yüz"],["۲۵ بیست و پنج","bist-o panc","yirmi beş"]],"examples":[{"t":"یازده، دوازده، سیزده.","pr":"Yâzdah, davâzdah, sizdah.","s":"On bir, on iki, on üç.","a":"audio/fa-tr/074952f0d74b.mp3"},{"t":"دو سیب، لطفاً.","pr":"Do sib, lotfan.","s":"İki elma, lütfen.","a":"audio/fa-tr/7be4c2ca5f7d.mp3"},{"t":"سه تا چای، لطفاً.","pr":"Se tâ çây, lotfan.","s":"Üç tane çay, lütfen.","a":"audio/fa-tr/fda58661104e.mp3"},{"t":"من پانزده سال دارم.","pr":"Man pânzdah sâl dâram.","s":"Ben on beş yaşındayım.","a":"audio/fa-tr/86bbb24743e8.mp3"},{"t":"هفده، هجده، نوزده، بیست!","pr":"Hefdah, hecdah, nuzdah, bist!","s":"On yedi, on sekiz, on dokuz, yirmi!","a":"audio/fa-tr/e1755e7af3ee.mp3"},{"t":"او هفتاد سال دارد.","pr":"U haftâd sâl dârad.","s":"O yetmiş yaşında.","a":"audio/fa-tr/8f9ded92670e.mp3"}],"exercises":[{"type":"type","task":"On yıl sonra kaç yaşında? Sayıyı yazın.","cue":"او بیست سال دارد.","cpr":"U bist sâl dârad.","t":"او ___ سال دارد.","answer":["سی","۳۰"],"pr":"U si sâl dârad.","s":"O otuz yaşında.","why":"Yirmi artı on otuz eder: bist → si (سی).","full":"او سی سال دارد.","a":"audio/fa-tr/e014854abb29.mp3","ca":"audio/fa-tr/475a25edd6fc.mp3"},{"type":"choice","t":"یازده، دوازده، ___","options":["سه","سیزده","شش"],"answer":1,"pr":"Yâzdah, davâzdah, sizdah","s":"On bir, on iki, on üç","why":"11–19 arası sayılar -dah ile biter: yâzdah, davâzdah, sizdah.","full":"یازده، دوازده، سیزده","a":"audio/fa-tr/413a71eabdbe.mp3"},{"type":"type","t":"هفت، هشت، ___، ده","answer":["نه"],"pr":"Haft, haşt, noh, dah","s":"Yedi, sekiz, dokuz, on","why":"Sırayla: haft (7), haşt (8), noh (9), dah (10).","full":"هفت، هشت، نه، ده","a":"audio/fa-tr/ec02aaff73b3.mp3"},{"type":"choice","task":"Hangi cevap uygun?","cue":"چند سال دارید؟","cpr":"Çand sâl dârid?","t":"___","options":["سی سال دارم.","یک چای، لطفاً.","اهل ترکیه هستم."],"answer":0,"pr":"Si sâl dâram.","s":"Otuz yaşındayım.","why":"«Çand sâl dârid?» yaşı sorar; cevap: sayı + «sâl dâram».","full":"سی سال دارم.","a":"audio/fa-tr/5b4d27975e8c.mp3","ca":"audio/fa-tr/e7c283d31c6f.mp3"},{"type":"type","t":"من ___ سال دارم.","answer":["بیست","۲۰"],"pr":"Man bist sâl dâram.","s":"Ben yirmi yaşındayım.","why":"Yirmi = bist. Yaş: sayı + sâl dâram.","full":"من بیست سال دارم.","a":"audio/fa-tr/feb065a23dfc.mp3"},{"type":"choice","t":"۱۵: ___","options":["پنج","پانزده","پنجاه"],"answer":1,"pr":"Pânzdah","s":"15 = on beş","why":"۱۵ = pânzdah (on beş). panc = 5, pancâh = 50.","full":"۱۵: پانزده","a":"audio/fa-tr/9213e2e5a13c.mp3"},{"type":"order","t":"من نوزده سال دارم.","pr":"Man nuzdah sâl dâram.","s":"Ben on dokuz yaşındayım.","full":"من نوزده سال دارم.","a":"audio/fa-tr/6c183f9b35e8.mp3"}]},{"id":"g02","title":{"t":"کتاب‌ها، دانشجویان","pr":"ketâbhâ, dâneşcuyân","s":"Çoğul: -hâ ve -ân"},"explain":"Türkçedeki **-lar / -ler** ekinin Farsça karşılığı **-hâ**'dır (ها). Ünlü uyumu olmadığı için **her zaman -hâ**: **ketâb → ketâbhâ** (kitaplar), **sib → sibhâ** (elmalar).\nYazıda **ها** genelde yarım boşlukla ayrılır: **کتاب‌ها**.\nİnsanlar ve canlılar için daha resmî bir ek de vardır: **-ân** (ان): **dâneşcuyân** (öğrenciler), **mo'allemân** (öğretmenler). Konuşmada **-hâ** her yerde kullanılabilir.\nUnutmayın: sayıdan sonra çoğul eki **gelmez**: **do ketâb** (iki kitap). Ayrıca 'onlar öğrenci' derken isim tekil kalır: **Ânhâ dâneşcu hastand.**","table":[["کتاب ← کتاب‌ها","ketâb → ketâbhâ","kitap → kitaplar"],["سیب ← سیب‌ها","sib → sibhâ","elma → elmalar"],["خانه ← خانه‌ها","xâne → xânehâ","ev → evler"],["دانشجو ← دانشجوها / دانشجویان","dâneşcu → dâneşcuhâ / dâneşcuyân","öğrenci → öğrenciler"],["معلم ← معلم‌ها / معلمان","mo'allem → mo'allemhâ / mo'allemân","öğretmen → öğretmenler"]],"examples":[{"t":"کتاب‌ها خوب هستند.","pr":"Ketâbhâ xub hastand.","s":"Kitaplar iyi.","a":"audio/fa-tr/1aff460a45dc.mp3"},{"t":"معلم‌ها ایرانی هستند.","pr":"Mo'allemhâ İrâni hastand.","s":"Öğretmenler İranlı.","a":"audio/fa-tr/6294e3d71cd2.mp3"},{"t":"دانشجویان ترک هستند.","pr":"Dâneşcuyân Tork hastand.","s":"Öğrenciler Türk.","a":"audio/fa-tr/3f06f3673fd8.mp3"},{"t":"سه سیب و دو نان.","pr":"Se sib va do nân.","s":"Üç elma ve iki ekmek.","a":"audio/fa-tr/d94268bd14c7.mp3"}],"exercises":[{"type":"choice","t":"این ___ خوب هستند.","options":["کتاب‌ها","کتاب","کتابان"],"answer":0,"pr":"İn ketâbhâ xub hastand.","s":"Bu kitaplar iyi.","why":"Birden fazla kitap: ketâb + -hâ = ketâbhâ. «-ân» cansız şeylere gelmez.","full":"این کتاب‌ها خوب هستند.","a":"audio/fa-tr/5e46faafa1ff.mp3"},{"type":"choice","t":"سه ___، لطفاً.","options":["سیب‌ها","سیب","سیبان"],"answer":1,"pr":"Se sib, lotfan.","s":"Üç elma, lütfen.","why":"Sayıdan sonra isim tekil kalır: se sib (üç elma).","full":"سه سیب، لطفاً.","a":"audio/fa-tr/0f36788ea15c.mp3"},{"type":"type","t":"این ___ ایرانی هستند.","answer":["دانشجوها","دانشجویان"],"pr":"İn dâneşcuhâ İrâni hastand.","s":"Bu öğrenciler İranlı.","why":"İnsanlar için -hâ ya da -ân: dâneşcuhâ / dâneşcuyân.","full":"این دانشجوها ایرانی هستند.","a":"audio/fa-tr/59750ccb7267.mp3"},{"type":"type","t":"___ ترک هستند.","answer":["معلم‌ها","معلمها","معلمان"],"pr":"Mo'allemhâ Tork hastand.","s":"Öğretmenler Türk.","why":"Öğretmenler: mo'allemhâ ya da mo'allemân; sayı yoksa çoğul eki gerekir.","full":"معلم‌ها ترک هستند.","a":"audio/fa-tr/7d13955a3dce.mp3"},{"type":"choice","task":"Hangi cevap doğru?","cue":"این کتاب‌ها خوب هستند؟","cpr":"İn ketâbhâ xub hastand?","t":"___","options":["بله، کتاب‌ها خوب هستند.","بله، سه کتاب‌ها دارم.","بله، من بیست سال دارم."],"answer":0,"pr":"Bale, ketâbhâ xub hastand.","s":"Evet, kitaplar iyi.","why":"Sayıdan sonra çoğul eki gelmez (se ketâb); «ketâbhâ xub hastand» doğrudur.","full":"بله، کتاب‌ها خوب هستند.","a":"audio/fa-tr/4070c3be2cec.mp3","ca":"audio/fa-tr/8446f1f75dd7.mp3"},{"type":"type","task":"Çoğul yapın.","cue":"سیب خوب است.","cpr":"Sib xub ast.","t":"___ خوب هستند.