"s":"Ben saat yedide uyanıyorum.","pr":"Man sâ'at-e haft bidâr mişavam.","a":"audio/fa-tr/9bc2f5bf2404.mp3"},"img":"img/e/23f0.svg","a":"audio/fa-tr/1f3274ef3e13.mp3"},{"id":"w08","t":"خوابیدن","s":"uyumak","pr":"xâbidan","emoji":"😴","ex":{"t":"بچه‌ها ساعت نه می‌خوابند.","s":"Çocuklar saat dokuzda uyuyor.","pr":"Baççehâ sâ'at-e noh mixâband.","a":"audio/fa-tr/c733bf302719.mp3"},"img":"img/e/1f634.svg","a":"audio/fa-tr/aba61de65165.mp3"},{"id":"w09","t":"خوردن","s":"yemek; (çay, su) içmek","pr":"xordan","emoji":"🍴","ex":{"t":"علی سیب می‌خورد.","s":"Ali elma yiyor.","pr":"Ali sib mixorad.","a":"audio/fa-tr/bd0c4b1fe83f.mp3"},"img":"img/e/1f374.svg","a":"audio/fa-tr/41265c08a2a5.mp3"},{"id":"w10","t":"رفتن","s":"gitmek","pr":"raftan","emoji":"🚶","ex":{"t":"سارا هر روز به مدرسه می‌رود.","s":"Sara her gün okula gidiyor.","pr":"Sârâ har ruz be madrese miravad.","a":"audio/fa-tr/a081712139e8.mp3"},"img":"img/e/1f6b6.svg","a":"audio/fa-tr/8ee8190af69f.mp3"},{"id":"w11","t":"کار کردن","s":"çalışmak","pr":"kâr kardan","emoji":"💼","ex":{"t":"مادرم در بیمارستان کار می‌کند.","s":"Annem hastanede çalışıyor.","pr":"Mâdaram dar bimârestân kâr mikonad.","a":"audio/fa-tr/95e039985a6a.mp3"},"img":"img/e/1f4bc.svg","a":"audio/fa-tr/4a257157a2f0.mp3"},{"id":"w12","t":"خواندن","s":"okumak","pr":"xândan","emoji":"📖","ex":{"t":"سارا کتاب می‌خواند.","s":"Sara kitap okuyor.","pr":"Sârâ ketâb mixânad.","a":"audio/fa-tr/de964577c353.mp3"},"img":"img/e/1f4d6.svg","a":"audio/fa-tr/6b7a46aeb70a.mp3"},{"id":"w13","t":"الان","s":"şimdi","pr":"alân","emoji":"","ex":{"t":"الان ساعت هشت است.","s":"Şimdi saat sekiz.","pr":"Alân sâ'at haşt ast.","a":"audio/fa-tr/1bcace717a6c.mp3"},"img":null,"a":"audio/fa-tr/2e40394152f5.mp3"},{"id":"w14","t":"هر روز","s":"her gün","pr":"har ruz","emoji":"📅","ex":{"t":"پدرم هر روز کار می‌کند.","s":"Babam her gün çalışıyor.","pr":"Pedaram har ruz kâr mikonad.","a":"audio/fa-tr/0872417b40bf.mp3"},"img":"img/e/1f4c5.svg","a":"audio/fa-tr/b1eb888ba459.mp3"}],"phrases":[{"id":"p01","t":"ساعت چند است؟","s":"Saat kaç?","pr":"Sâ'at çand ast?","a":"audio/fa-tr/833e9a3b8fcb.mp3"},{"id":"p02","t":"ساعت هفت است.","s":"Saat yedi.","pr":"Sâ'at haft ast.","a":"audio/fa-tr/80c9f1196251.mp3"},{"id":"p03","t":"ساعت هفت و نیم است.","s":"Saat yedi buçuk.","pr":"Sâ'at haft va nim ast.","a":"audio/fa-tr/db547e91a7dd.mp3"},{"id":"p04","t":"ساعت چند؟","s":"Saat kaçta?","pr":"Sâ'at-e çand?","a":"audio/fa-tr/7382241f6878.mp3"},{"id":"p05","t":"صبح بخیر!","s":"Günaydın!","pr":"Sobh bexeyr!","a":"audio/fa-tr/5626a12fd5ef.mp3"},{"id":"p06","t":"شب بخیر!","s":"İyi geceler!","pr":"Şab bexeyr!","a":"audio/fa-tr/269595100481.mp3"},{"id":"p07","t":"دیرم شد!","s":"Geç kaldım!","pr":"Diram şod!","a":"audio/fa-tr/6807263b6599.mp3"},{"id":"p08","t":"خیلی زود است!","s":"Çok erken!","pr":"Xeyli zud ast!","a":"audio/fa-tr/e29c8b874d90.mp3"}],"dialogue":{"title":{"t":"ساعت چند بیدار می‌شوی؟","s":"Saat kaçta uyanıyorsun?","pr":"Sâ'at-e çand bidâr mişavi?","a":"audio/fa-tr/8aaf66ebb06b.mp3"},"speakers":{"A":{"name":"Maryam","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"صبح بخیر، مهمت!","s":"Günaydın Mehmet!","pr":"Sobh bexeyr, Mehmet!","a":"audio/fa-tr/48d775e28713.mp3"},{"sp":"B","t":"صبح بخیر، مریم! حالت چطور است؟","s":"Günaydın Maryam! Nasılsın?","pr":"Sobh bexeyr, Maryam! Hâlat çetor ast?","a":"audio/fa-tr/802418f625cb.mp3"},{"sp":"A","t":"خوبم، ممنون. تو هر روز ساعت چند بیدار می‌شوی؟","s":"İyiyim, teşekkürler. Sen her gün saat kaçta uyanıyorsun?","pr":"Xubam, mamnun. To har ruz sâ'at-e çand bidâr mişavi?","a":"audio/fa-tr/77732653ebad.mp3"},{"sp":"B","t":"ساعت هفت. تو چطور؟","s":"Yedide. Ya sen?","pr":"Sâ'at-e haft. To çetor?","a":"audio/fa-tr/1abcd2de00f3.mp3"},{"sp":"A","t":"من ساعت شش بیدار می‌شوم و صبحانه می‌خورم.","s":"Ben altıda uyanıyorum ve kahvaltı yapıyorum.","pr":"Man sâ'at-e şeş bidâr mişavam va sobhâne mixoram.","a":"audio/fa-tr/5f05875701ee.mp3"},{"sp":"B","t":"ساعت شش؟ خیلی زود است!","s":"Altıda mı? Çok erken!","pr":"Sâ'at-e şeş? Xeyli zud ast!","a":"audio/fa-tr/5a2b9c5bee42.mp3"},{"sp":"A","t":"بله، ولی شب ساعت ده می‌خوابم.","s":"Evet, ama gece saat onda uyuyorum.","pr":"Bale, vali şab sâ'at-e dah mixâbam.","a":"audio/fa-tr/229fe36c3c3c.mp3"},{"sp":"B","t":"الان ساعت چند است؟","s":"Şimdi saat kaç?","pr":"Alân sâ'at çand ast?","a":"audio/fa-tr/7b422ca3f47f.mp3"},{"sp":"A","t":"ساعت هشت و نیم است.","s":"Saat sekiz buçuk.","pr":"Sâ'at haşt va nim ast.","a":"audio/fa-tr/1a4057937b69.mp3"},{"sp":"B","t":"وای، دیرم شد! خداحافظ، مریم!","s":"Eyvah, geç kaldım! Hoşça kal, Maryam!","pr":"Vây, diram şod! Xodâhâfez, Maryam!","a":"audio/fa-tr/75a156de36bf.mp3"}]},"grammar":[{"id":"g01","title":{"t":"می‌خورم، می‌روم، می‌خوابم","s":"Şimdiki / geniş zaman: mi- + kök + şahıs eki","pr":"mixoram, miravam, mixâbam"},"explain":"Farsçada **şimdiki zaman** ile **geniş zaman** aynı biçimdedir: **mixoram** hem \"yiyorum\" hem de \"yerim\" demektir.\nFormül: **mi-** + fiil kökü + şahıs eki. Ekler \"olmak\" fiilinden tanıdık: **-am, -i, -ad, -im, -id, -and**. Yalnızca üçüncü tekil kişi (o) farklı: **-ad** (mixorad = yiyor).\nMastarlar **-an** ile biter (-tan, -dan, -idan), Türkçedeki -mak/-mek gibi: xordan → kök **xor**, xâbidan → kök **xâb**. Bazı kökler düzensizdir, onları ezberleyin: raftan → **rav** (miravam), kardan → **kon** (mikonam), şodan → **şav** (mişavam).\n**kâr kardan, bidâr şodan** gibi birleşik fiillerde ilk kelime değişmez, sadece ikinci kısım çekilir: kâr **mikonam** = çalışıyorum. Türkçedeki \"yardım etmek\" gibi düşünün.\nOlumsuz için başa **ne-** gelir: **nemixoram** = yemiyorum / içmiyorum. Fiil, Türkçede olduğu gibi cümlenin sonundadır.\nİpucu: Farslar çay ve su için de genellikle **xordan** der: **çây mixoram** = çay içiyorum.","table":[["من","می‌خورم","man mixoram"],["تو","می‌خوری","to mixori"],["او","می‌خورد","u mixorad"],["ما","می‌خوریم","mâ mixorim"],["شما","می‌خورید","şomâ mixorid"],["آن‌ها","می‌خورند","ânhâ mixorand"]],"examples":[{"t":"من هر روز کار می‌کنم.","s":"Ben her gün çalışıyorum.","pr":"Man har ruz kâr mikonam.","a":"audio/fa-tr/e784af145e7c.mp3"},{"t":"تو الان چه کار می‌کنی؟","s":"Sen şimdi ne yapıyorsun?","pr":"To alân çe kâr mikoni?","a":"audio/fa-tr/487e75894033.mp3"},{"t":"آیشه کتاب می‌خواند.","s":"Ayşe kitap okuyor.","pr":"Âyşe ketâb mixânad.","a":"audio/fa-tr/0235e5e96453.mp3"},{"t":"ما شب تلویزیون تماشا می‌کنیم.","s":"Biz akşam televizyon izliyoruz.","pr":"Mâ şab televiziyon tamâşâ mikonim.","a":"audio/fa-tr/bb418b0fa0f1.mp3"},{"t":"من قهوه نمی‌خورم.","s":"Ben kahve içmiyorum.","pr":"Man ğahve nemixoram.","a":"audio/fa-tr/fdea77f80b3b.mp3"}],"exercises":[{"type":"choice","t":"من هر روز ساعت هفت بیدار ___.","options":["می‌شوم","می‌شوی","می‌شود"],"answer":0,"s":"Ben her gün saat yedide uyanıyorum.","pr":"Man har ruz sâ'at-e haft bidâr mişavam.","full":"من هر روز ساعت هفت بیدار می‌شوم.","a":"audio/fa-tr/c8b0e3f2d68d.mp3"},{"type":"choice","t":"علی در یک مدرسه کار ___.","options":["می‌کنم","می‌کند","می‌کنیم"],"answer":1,"s":"Ali bir okulda çalışıyor.","pr":"Ali dar yek madrese kâr mikonad.","full":"علی در یک مدرسه کار می‌کند.","a":"audio/fa-tr/40ffe0352f7f.mp3"},{"type":"choice","t":"ما شب ساعت ده ___.","options":["می‌خوابند","می‌خوابیم","می‌خوابی"],"answer":1,"s":"Biz gece saat onda uyuyoruz.","pr":"Mâ şab sâ'at-e dah mixâbim.","full":"ما شب ساعت ده می‌خوابیم.","a":"audio/fa-tr/7dd8c95eee19.mp3"},{"type":"choice","t":"بچه‌ها به مدرسه ___.","options":["می‌روند","می‌رود","می‌روم"],"answer":0,"s":"Çocuklar okula gidiyor.","pr":"Baççehâ be madrese miravand.","full":"بچه‌ها به مدرسه می‌روند.","a":"audio/fa-tr/9050f992400d.mp3"},{"type":"type","t":"تو صبحانه چه ___؟","answer":["می‌خوری","میخوری"],"s":"Sen kahvaltıda ne yiyorsun?","pr":"To sobhâne çe mixori?","full":"تو صبحانه چه می‌خوری؟","a":"audio/fa-tr/f84795ecf0bc.mp3"},{"type":"type","t":"من قهوه ___.","answer":["نمی‌خورم","نمیخورم"],"s":"Ben kahve içmiyorum.","pr":"Man ğahve nemixoram.","full":"من قهوه نمی‌خورم.","a":"audio/fa-tr/fdea77f80b3b.mp3"},{"type":"order","t":"من ساعت هفت بیدار می‌شوم.","s":"Ben saat yedide uyanıyorum.","pr":"Man sâ'at-e haft bidâr mişavam.","full":"من ساعت هفت بیدار می‌شوم.","a":"audio/fa-tr/9bc2f5bf2404.mp3"},{"type":"order","t":"پدرم هر روز کار می‌کند.","s":"Babam her gün çalışıyor.","pr":"Pedaram har ruz kâr mikonad.","full":"پدرم هر روز کار می‌کند.","a":"audio/fa-tr/0872417b40bf.mp3"}]},{"id":"g02","title":{"t":"ساعت چند است؟ ساعت چند؟","s":"Saat kaç? Saat kaçta?","pr":"Sâ'at çand ast? Sâ'at-e çand?"},"explain":"Saati sormak için: **Sâ'at çand ast?** = Saat kaç? Cevap: **sâ'at** + sayı + **ast**: Sâ'at haft ast = Saat yedi.\n\"Buçuk\" için **va nim** (ve yarım) deriz: Sâ'at haft va nim ast = Saat yedi buçuk. \"Çeyrek\" için **va rob'**: Sâ'at haft va rob' ast = Saat yediyi çeyrek geçiyor.\n\"Saat kaçta?\" demek için ezafe kullanırız: **Sâ'at-e çand?** Cevap: **sâ'at-e haft** = saat yedide. Türkçedeki **-de/-da** için ayrı bir edat gerekmez; saat ile sayının arasına sadece ezafe girer.\nKarşılaştırın: **Sâ'at haft ast.** = Saat yedi. ↔ **Sâ'at-e haft mixâbam.** = Saat yedide uyuyorum. Ezafe yazıda görünmez, ama söylenir.","table":[["ساعت هفت است.","Sâ'at haft ast.","Saat yedi."],["ساعت هفت و ربع است.","Sâ'at haft va rob' ast.","Saat yediyi çeyrek geçiyor."],["ساعت هفت و نیم است.","Sâ'at haft va nim ast.","Saat yedi buçuk."],["ساعت چند؟","Sâ'at-e çand?","Saat kaçta?"],["ساعت هفت","sâ'at-e haft","saat yedide"]],"examples":[{"t":"ساعت چند است؟ ساعت هشت است.","s":"Saat kaç? Saat sekiz.","pr":"Sâ'at çand ast? Sâ'at haşt ast.","a":"audio/fa-tr/0745dd18cc18.mp3"},{"t":"ساعت یازده و نیم است.","s":"Saat on bir buçuk.","pr":"Sâ'at yâzdah va nim ast.","a":"audio/fa-tr/aeab13e8ebc3.mp3"},{"t":"ساعت چند بیدار می‌شوی؟ ساعت شش.","s":"Saat kaçta uyanıyorsun? Altıda.","pr":"Sâ'at-e çand bidâr mişavi? Sâ'at-e şeş.","a":"audio/fa-tr/b928448bf184.mp3"},{"t":"ساعت سه چای می‌خوریم.","s":"Saat üçte çay içiyoruz.","pr":"Sâ'at-e se çây mixorim.","a":"audio/fa-tr/a16df6291db9.mp3"},{"t":"پدرم ساعت پنج بیدار می‌شود.","s":"Babam saat beşte uyanıyor.","pr":"Pedaram sâ'at-e panc bidâr mişavad.","a":"audio/fa-tr/74e0b700f34e.mp3"}],"exercises":[{"type":"choice","t":"ساعت ___ است؟ ساعت نه است.","options":["هستم","چند","نیم"],"answer":1,"s":"Saat kaç? Saat dokuz.","pr":"Sâ'at çand ast? Sâ'at noh ast.","full":"ساعت چند است؟ ساعت نه است.","a":"audio/fa-tr/af46a95d6fcc.mp3"},{"type":"choice","t":"ساعت هفت و ___ است.","options":["نیم","چند","شب"],"answer":0,"s":"Saat yedi buçuk.","pr":"Sâ'at haft va nim ast.","full":"ساعت هفت و نیم است.","a":"audio/fa-tr/db547e91a7dd.mp3"},{"type":"choice","t":"مریم ساعت ده ___.","options":["می‌خوابم","می‌خوابیم","می‌خوابد"],"answer":2,"s":"Maryam saat onda uyuyor.","pr":"Maryam sâ'at-e dah mixâbad.","full":"مریم ساعت ده می‌خوابد.","a":"audio/fa-tr/8c6aaaec0b3c.mp3"},{"type":"type","t":"ساعت چند ___؟","answer":["است"],"s":"Saat kaç?","pr":"Sâ'at çand ast?","full":"ساعت چند است؟","a":"audio/fa-tr/833e9a3b8fcb.mp3"},{"type":"type","t":"ساعت یازده و ___ است.","answer":["نیم"],"s":"Saat on bir buçuk.","pr":"Sâ'at yâzdah va nim ast.","full":"ساعت یازده و نیم است.","a":"audio/fa-tr/aeab13e8ebc3.mp3"},{"type":"order","t":"ساعت چند بیدار می‌شوی؟","s":"Saat kaçta uyanıyorsun?","pr":"Sâ'at-e çand bidâr mişavi?","full":"ساعت چند بیدار می‌شوی؟","a":"audio/fa-tr/8aaf66ebb06b.mp3"},{"type":"order","t":"الان ساعت هشت است.","s":"Şimdi saat sekiz.","pr":"Alân sâ'at haşt ast.","full":"الان ساعت هشت است.","a":"audio/fa-tr/1bcace717a6c.mp3"}]}],"reading":{"title":{"t":"یک روز رضا","s":"Reza'nın bir günü","pr":"Yek ruz-e Rezâ","a":"audio/fa-tr/6ce2f9a2b3f8.mp3"},"text":[{"t":"سلام! اسم من رضا است.","s":"Merhaba! Benim adım Reza.","pr":"Salâm! Esm-e man Rezâ ast.","a":"audio/fa-tr/43e2bfeb3aec.mp3"},{"t":"من هر روز ساعت شش و نیم بیدار می‌شوم.","s":"Her gün saat altı buçukta uyanıyorum.","pr":"Man har ruz sâ'at-e şeş va nim bidâr mişavam.","a":"audio/fa-tr/df422ee2910d.mp3"},{"t":"ساعت هفت صبحانه می‌خورم: نان و پنیر و چای.","s":"Saat yedide kahvaltı yapıyorum: ekmek, peynir ve çay.","pr":"Sâ'at-e haft sobhâne mixoram: nân va panir va çây.","a":"audio/fa-tr/0dc6299a0bcd.mp3"},{"t":"من معلم هستم و در یک مدرسه کار می‌کنم.","s":"Ben öğretmenim ve bir okulda çalışıyorum.","pr":"Man mo'allem hastam va dar yek madrese kâr mikonam.","a":"audio/fa-tr/982588c4652a.mp3"},{"t":"ساعت یک در مدرسه ناهار می‌خورم.","s":"Saat birde okulda öğle yemeği yiyorum.","pr":"Sâ'at-e yek dar madrese nâhâr mixoram.","a":"audio/fa-tr/1695649e79dd.mp3"},{"t":"شب من و همسرم شام درست می‌کنیم.","s":"Akşamları eşimle birlikte yemek hazırlıyoruz.","pr":"Şab man va hamsaram şâm dorost mikonim.","a":"audio/fa-tr/ed61aa49e9cf.mp3"},{"t":"بچه‌ها کتاب می‌خوانند.","s":"Çocuklar kitap okuyor.","pr":"Baççehâ ketâb mixânand.","a":"audio/fa-tr/ce57314b6782.mp3"},{"t":"شب ساعت یازده می‌خوابم.","s":"Gece saat on birde uyuyorum.","pr":"Şab sâ'at-e yâzdah mixâbam.","a":"audio/fa-tr/f7592b5c5acb.mp3"}],"questions":[{"q":{"t":"رضا ساعت چند بیدار می‌شود؟","s":"Reza saat kaçta uyanıyor?","pr":"Rezâ sâ'at-e çand bidâr mişavad?","a":"audio/fa-tr/0409392f2735.mp3"},"options":["شش و نیم","هفت","یازده"],"answer":0},{"q":{"t":"رضا کجا کار می‌کند؟","s":"Reza nerede çalışıyor?","pr":"Rezâ kocâ kâr mikonad?","a":"audio/fa-tr/23b62aa7e0fa.mp3"},"options":["در خانه","در مدرسه","در بیمارستان"],"answer":1},{"q":{"t":"رضا صبحانه چه می‌خورد؟","s":"Reza kahvaltıda ne yiyor?","pr":"Rezâ sobhâne çe mixorad?","a":"audio/fa-tr/64f6ab033cfb.mp3"},"options":["سیب","برنج","نان و پنیر"],"answer":2},{"q":{"t":"بچه‌ها چه کار می‌کنند؟","s":"Çocuklar ne yapıyor?","pr":"Baççehâ çe kâr mikonand?","a":"audio/fa-tr/7a0980491b60.mp3"},"options":["کتاب می‌خوانند","شام می‌خورند","کار می‌کنند"],"answer":0}]},"sentences":[{"t":"مادرم صبح چای می‌خورد.","s":"Annem sabah çay içiyor.","pr":"Mâdaram sobh çây mixorad.","a":"audio/fa-tr/d6e8867ee0f3.mp3"},{"t":"ما با هم شام می‌خوریم.","s":"Akşam yemeğini birlikte yiyoruz.","pr":"Mâ bâ ham şâm mixorim.","a":"audio/fa-tr/29f2603e794d.mp3"},{"t":"امیر ساعت هشت به مدرسه می‌رود.","s":"Amir saat sekizde okula gidiyor.","pr":"Amir sâ'at-e haşt be madrese miravad.","a":"audio/fa-tr/d9cb4d32ccc1.mp3"},{"t":"تو الان چه کار می‌کنی؟","s":"Sen şimdi ne yapıyorsun?","pr":"To alân çe kâr mikoni?","a":"audio/fa-tr/487e75894033.mp3"},{"t":"ندا در بیمارستان کار می‌کند.","s":"Neda hastanede çalışıyor.","pr":"Nedâ dar bimârestân kâr mikonad.","a":"audio/fa-tr/aecdd34b5d0d.mp3"},{"t":"ساعت هشت و نیم است.","s":"Saat sekiz buçuk.","pr":"Sâ'at haşt va nim ast.","a":"audio/fa-tr/1a4057937b69.mp3"},{"t":"من شب کتاب می‌خوانم.","s":"Ben akşam kitap okuyorum.","pr":"Man şab ketâb mixânam.","a":"audio/fa-tr/c8b17d51cafb.mp3"},{"t":"الیف ساعت ده می‌خوابد.","s":"Elif saat onda uyuyor.","pr":"Elif sâ'at-e dah mixâbad.","a":"audio/fa-tr/c77d05860515.mp3"}],"img":"img/e/23f0.svg"}