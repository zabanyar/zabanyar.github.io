":"bidâr şodan","emoji":"","ex":{"t":"من ساعت هفت بیدار می‌شوم.","s":"Ben saat yedide uyanıyorum.","pr":"Man sâ'at-e haft bidâr mişavam.","a":"audio/fa-tr/7a82ebccf7c1.mp3"},"img":null,"a":"audio/fa-tr/039932f761f8.mp3"},{"id":"w08","t":"خوابیدن","s":"uyumak","pr":"xâbidan","emoji":"😴","ex":{"t":"بچه‌ها ساعت نه می‌خوابند.","s":"Çocuklar saat dokuzda uyuyor.","pr":"Baççehâ sâ'at-e noh mixâband.","a":"audio/fa-tr/18bdea11c3cf.mp3"},"img":"img/e/1f634.svg","a":"audio/fa-tr/e333bedf187c.mp3"},{"id":"w09","t":"خوردن","s":"yemek; (çay, su) içmek","pr":"xordan","emoji":"🍴","ex":{"t":"علی سیب می‌خورد.","s":"Ali elma yiyor.","pr":"Ali sib mixorad.","a":"audio/fa-tr/e641079e3300.mp3"},"sym":true,"img":"img/e/1f374.svg","a":"audio/fa-tr/a8f833637cc8.mp3"},{"id":"w10","t":"رفتن","s":"gitmek","pr":"raftan","emoji":"🚶","ex":{"t":"علی هر روز به مدرسه می‌رود.","s":"Ali her gün okula gidiyor.","pr":"Ali har ruz be madrese miravad.","a":"audio/fa-tr/f41097bd62bf.mp3"},"img":"img/e/1f6b6.svg","a":"audio/fa-tr/6b3b6c994686.mp3"},{"id":"w11","t":"کار کردن","s":"çalışmak","pr":"kâr kardan","emoji":"💼","ex":{"t":"مادرم در بیمارستان کار می‌کند.","s":"Annem hastanede çalışıyor.","pr":"Mâdaram dar bimârestân kâr mikonad.","a":"audio/fa-tr/c1592539d263.mp3"},"sym":true,"img":"img/e/1f4bc.svg","a":"audio/fa-tr/80f97f1f642d.mp3"},{"id":"w12","t":"خواندن","s":"okumak","pr":"xândan","emoji":"📖","ex":{"t":"سارا کتاب می‌خواند.","s":"Sara kitap okuyor.","pr":"Sârâ ketâb mixânad.","a":"audio/fa-tr/cf46831335df.mp3"},"sym":true,"img":"img/e/1f4d6.svg","a":"audio/fa-tr/e0715abebe39.mp3"},{"id":"w13","t":"الان","s":"şimdi","pr":"alân","emoji":"","ex":{"t":"الان ساعت هشت است.","s":"Şimdi saat sekiz.","pr":"Alân sâ'at haşt ast.","a":"audio/fa-tr/1372330764cb.mp3"},"img":null,"a":"audio/fa-tr/3c0b50952e41.mp3"},{"id":"w14","t":"هر روز","s":"her gün","pr":"har ruz","emoji":"📅","ex":{"t":"پدرم هر روز کار می‌کند.","s":"Babam her gün çalışıyor.","pr":"Pedaram har ruz kâr mikonad.","a":"audio/fa-tr/87b7e2dce7a6.mp3"},"sym":true,"img":"img/e/1f4c5.svg","a":"audio/fa-tr/9f3fe643d774.mp3"},{"id":"w15","t":"شنبه","pr":"şanbe","s":"cumartesi (haftanın ilk günü)","emoji":"","ex":{"t":"من شنبه کار می‌کنم.","pr":"Man şanbe kâr mikonam.","s":"Cumartesi çalışıyorum.","a":"audio/fa-tr/c4552d9117a9.mp3"},"img":null,"a":"audio/fa-tr/e4cded0ed8ce.mp3"},{"id":"w16","t":"جمعه","pr":"com'e","s":"cuma (İran'da tatil günü)","emoji":"","ex":{"t":"جمعه کار نمی‌کنم.","pr":"Com'e kâr nemikonam.","s":"Cuma günü çalışmıyorum.","a":"audio/fa-tr/7f7b8e1a7f9e.mp3"},"img":null,"a":"audio/fa-tr/23e25353bbfb.mp3"}],"phrases":[{"id":"p01","t":"ساعت چند است؟","s":"Saat kaç?","pr":"Sâ'at çand ast?","a":"audio/fa-tr/4c9001ac57dd.mp3"},{"id":"p02","t":"ساعت هفت است.","s":"Saat yedi.","pr":"Sâ'at haft ast.","a":"audio/fa-tr/65e299b3ccfa.mp3"},{"id":"p03","t":"ساعت هفت و نیم است.","s":"Saat yedi buçuk.","pr":"Sâ'at haft va nim ast.","a":"audio/fa-tr/3fa39919683d.mp3"},{"id":"p04","t":"ساعت چند؟","s":"Saat kaçta?","pr":"Sâ'at-e çand?","a":"audio/fa-tr/c628077e7224.mp3"},{"id":"p05","t":"صبح بخیر!","s":"Günaydın!","pr":"Sobh bexeyr!","a":"audio/fa-tr/91401e6d5970.mp3"},{"id":"p06","t":"شب بخیر!","s":"İyi geceler!","pr":"Şab bexeyr!","a":"audio/fa-tr/baca6f57bb03.mp3"},{"id":"p07","t":"دیرم شد!","s":"Geç kaldım!","pr":"Diram şod!","a":"audio/fa-tr/4f33bb03da66.mp3"},{"id":"p08","t":"خیلی زود است!","s":"Çok erken!","pr":"Xeyli zud ast!","a":"audio/fa-tr/1f9d490e1d4a.mp3"}],"dialogue":{"title":{"t":"ساعت چند بیدار می‌شوی؟","s":"Saat kaçta uyanıyorsun?","pr":"Sâ'at-e çand bidâr mişavi?","a":"audio/fa-tr/0319092f3b0b.mp3"},"speakers":{"A":{"name":"Maryam","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"صبح بخیر، مهمت!","s":"Günaydın Mehmet!","pr":"Sobh bexeyr, Mehmet!","a":"audio/fa-tr/2f285def45fd.mp3"},{"sp":"B","t":"صبح بخیر، مریم! حالت چطور است؟","s":"Günaydın Maryam! Nasılsın?","pr":"Sobh bexeyr, Maryam! Hâlat çetor ast?","a":"audio/fa-tr/53a40d5fb897.mp3"},{"sp":"A","t":"خوبم، ممنون. تو هر روز ساعت چند بیدار می‌شوی؟","s":"İyiyim, teşekkürler. Sen her gün saat kaçta uyanıyorsun?","pr":"Xubam, mamnun. To har ruz sâ'at-e çand bidâr mişavi?","a":"audio/fa-tr/c9bd6ed2cb25.mp3"},{"sp":"B","t":"ساعت هفت. تو چطور؟","s":"Yedide. Ya sen?","pr":"Sâ'at-e haft. To çetor?","a":"audio/fa-tr/450c159832f3.mp3"},{"sp":"A","t":"من ساعت شش بیدار می‌شوم و صبحانه می‌خورم.","s":"Ben altıda uyanıyorum ve kahvaltı yapıyorum.","pr":"Man sâ'at-e şeş bidâr mişavam va sobhâne mixoram.","a":"audio/fa-tr/b41f64236b08.mp3"},{"sp":"B","t":"ساعت شش؟ خیلی زود است!","s":"Altıda mı? Çok erken!","pr":"Sâ'at-e şeş? Xeyli zud ast!","a":"audio/fa-tr/e1a698cd1f26.mp3"},{"sp":"A","t":"بله، ولی شب ساعت ده می‌خوابم.","s":"Evet, ama gece saat onda uyuyorum.","pr":"Bale, vali şab sâ'at-e dah mixâbam.","a":"audio/fa-tr/ba524355c5c4.mp3"},{"sp":"B","t":"الان ساعت چند است؟","s":"Şimdi saat kaç?","pr":"Alân sâ'at çand ast?","a":"audio/fa-tr/f4f9d0d21ad5.mp3"},{"sp":"A","t":"ساعت هشت و نیم است.","s":"Saat sekiz buçuk.","pr":"Sâ'at haşt va nim ast.","a":"audio/fa-tr/ef8aefc31d17.mp3"},{"sp":"B","t":"وای، دیرم شد! خداحافظ، مریم!","s":"Eyvah, geç kaldım! Hoşça kal, Maryam!","pr":"Vây, diram şod! Xodâhâfez, Maryam!","a":"audio/fa-tr/eba066b1106f.mp3"}]},"grammar":[{"id":"g01","title":{"t":"می‌خورم، می‌روم، می‌خوابم","s":"Şimdiki / geniş zaman: mi- + kök + şahıs eki","pr":"mixoram, miravam, mixâbam"},"explain":"Farsçada **şimdiki zaman** ile **geniş zaman** aynı biçimdedir: **mixoram** hem «yiyorum» hem de «yerim» demektir.\nFormül: **mi-** + fiil kökü + şahıs eki. Ekler «olmak» fiilinden tanıdık: **-am, -i, -ad, -im, -id, -and**. Yalnızca üçüncü tekil kişi (o) farklı: **-ad** (mixorad = yiyor).\nMastarlar **-an** ile biter (-tan, -dan, -idan), Türkçedeki -mak/-mek gibi: xordan → kök **xor**, xâbidan → kök **xâb**. Bazı kökler düzensizdir, onları ezberleyin: raftan → **rav** (miravam), kardan → **kon** (mikonam), şodan → **şav** (mişavam).\n**kâr kardan, bidâr şodan** gibi birleşik fiillerde ilk kelime değişmez, sadece ikinci kısım çekilir: kâr **mikonam** = çalışıyorum. Türkçedeki «yardım etmek» gibi düşünün.\nOlumsuz için başa **ne-** gelir: **nemixoram** = yemiyorum / içmiyorum. Fiil, Türkçede olduğu gibi cümlenin sonundadır.\nİpucu: Farslar çay ve su için de genellikle **xordan** der: **çây mixoram** = çay içiyorum.\n**Konuşmada:** Tahran'da bu fiiller kısalır: **miravam → miram**, **miravi → miri**, **miravad → mire**, **mixorad → mixore**. Ailede *Kocâ miri?* (Nereye gidiyorsun?) diye duyabilirsiniz.","table":[["من","می‌خورم","man mixoram"],["تو","می‌خوری","to mixori"],["او","می‌خورد","u mixorad"],["ما","می‌خوریم","mâ mixorim"],["شما","می‌خورید","şomâ mixorid"],["آن‌ها","می‌خورند","ânhâ mixorand"]],"examples":[{"t":"من هر روز کار می‌کنم.","s":"Ben her gün çalışıyorum.","pr":"Man har ruz kâr mikonam.","a":"audio/fa-tr/095feebf2fff.mp3"},{"t":"تو الان چه کار می‌کنی؟","s":"Sen şimdi ne yapıyorsun?","pr":"To alân çe kâr mikoni?","a":"audio/fa-tr/c5fd65c518b2.mp3"},{"t":"آیشه کتاب می‌خواند.","s":"Ayşe kitap okuyor.","pr":"Âyşe ketâb mixânad.","a":"audio/fa-tr/3ac8ec56f6d2.mp3"},{"t":"ما شب تلویزیون تماشا می‌کنیم.","s":"Biz akşam televizyon izliyoruz.","pr":"Mâ şab televiziyon tamâşâ mikonim.","a":"audio/fa-tr/4aa24b9616cf.mp3"},{"t":"من قهوه نمی‌خورم.","s":"Ben kahve içmiyorum.","pr":"Man ğahve nemixoram.","a":"audio/fa-tr/5bd3543f2807.mp3"}],"exercises":[{"type":"choice","t":"من هر روز ساعت هفت بیدار ___.","options":["می‌شوم","می‌شوی","می‌شود"],"answer":0,"s":"Ben her gün saat yedide uyanıyorum.","pr":"Man har ruz sâ'at-e haft bidâr mişavam.","why":"«man» ile şahıs eki -am: bidâr mişavam (uyanıyorum).","full":"من هر روز ساعت هفت بیدار می‌شوم.","a":"audio/fa-tr/b5ab9a19fb0f.mp3"},{"type":"choice","t":"رضا در یک مدرسه کار ___.","options":["می‌کنم","می‌کند","می‌کنیم"],"answer":1,"s":"Reza bir okulda çalışıyor.","pr":"Rezâ dar yek madrese kâr mikonad.","why":"«Reza» üçüncü tekil kişi (o): -ad → kâr mikonad.","full":"رضا در یک مدرسه کار می‌کند.","a":"audio/fa-tr/b120823c8035.mp3"},{"type":"type","task":"Cümleyi «u» (o) için yazın.","cue":"من هر روز کار می‌کنم.","cpr":"Man har ruz kâr mikonam.","t":"او هر روز کار ___.","answer":["می‌کند","میکند"],"pr":"U har ruz kâr mikonad.","s":"O her gün çalışıyor.","why":"Üçüncü tekil kişi (o) eki -ad: mikonam → mikonad.","full":"او هر روز کار می‌کند.","a":"audio/fa-tr/57a502caf1ef.mp3","ca":"audio/fa-tr/095feebf2fff.mp3"},{"type":"choice","t":"بچه‌ها به مدرسه ___.","options":["می‌روند","می‌رود","می‌روم"],"answer":0,"s":"Çocuklar okula gidiyor.","pr":"Baççehâ be madrese miravand.","why":"«baççehâ» (çocuklar) çoğul: -and → miravand.","full":"بچه‌ها به مدرسه می‌روند.","a":"audio/fa-tr/b1593970f231.mp3"},{"type":"type","t":"تو صبحانه چه ___؟","answer":["می‌خوری","میخوری"],"s":"Sen kahvaltıda ne yiyorsun?","pr":"To sobhâne çe mixori?","why":"«to» (sen) ile -i: mixori (yiyorsun).","full":"تو صبحانه چه می‌خوری؟","a":"audio/fa-tr/f8619087fd3c.mp3"},{"type":"type","t":"من قهوه ___.","answer":["نمی‌خورم","نمیخورم"],"s":"Ben kahve içmiyorum.","pr":"Man ğahve nemixoram.","why":"Olumsuz: mi- yerine nemi-: nemixoram (içmiyorum).","full":"من قهوه نمی‌خورم.","a":"audio/fa-tr/5bd3543f2807.mp3"},{"type":"choice","task":"Hangi cevap uygun?","cue":"تو الان چه کار می‌کنی؟","cpr":"To alân çe kâr mikoni?","t":"___","options":["کتاب می‌خوانم.","ساعت هشت است.","خوبم، ممنون."],"answer":0,"pr":"Ketâb mixânam.","s":"Kitap okuyorum.","why":"«Çe kâr mikoni?» = ne yapıyorsun; cevap bir fiille verilir: ketâb mixânam.","full":"کتاب می‌خوانم.","a":"audio/fa-tr/515e78b5d6ef.mp3","ca":"audio/fa-tr/c5fd65c518b2.mp3"},{"type":"order","t":"پدرم هر روز کار می‌کند.","s":"Babam her gün çalışıyor.","pr":"Pedaram har ruz kâr mikonad.","alts":["هر روز پدرم کار می‌کند."],"full":"پدرم هر روز کار می‌کند.","a":"audio/fa-tr/87b7e2dce7a6.mp3"}]},{"id":"g02","title":{"t":"ساعت چند است؟ ساعت چند؟","s":"Saat kaç? Saat kaçta?","pr":"Sâ'at çand ast? Sâ'at-e çand?"},"explain":"Saati sormak için: **Sâ'at çand ast?** = Saat kaç? Cevap: **sâ'at** + sayı + **ast**: Sâ'at haft ast = Saat yedi.\n«Buçuk» için **va nim** (ve yarım) deriz: Sâ'at haft va nim ast = Saat yedi buçuk. «Çeyrek» için **va rob'**: Sâ'at haft va rob' ast = Saat yediyi çeyrek geçiyor.\n«Saat kaçta?» demek için ezafe kullanırız: **Sâ'at-e çand?** Cevap: **sâ'at-e haft** = saat yedide. Türkçedeki **-de/-da** için ayrı bir edat gerekmez; saat ile sayının arasına sadece ezafe girer.\nKarşılaştırın: **Sâ'at haft ast.** = Saat yedi. ↔ **Sâ'at-e haft mixâbam.** = Saat yedide uyuyorum. Ezafe yazıda görünmez, ama söylenir.","table":[["ساعت هفت است.","Sâ'at haft ast.","Saat yedi."],["ساعت هفت و ربع است.","Sâ'at haft va rob' ast.","Saat yediyi çeyrek geçiyor."],["ساعت هفت و نیم است.","Sâ'at haft va nim ast.","Saat yedi buçuk."],["ساعت چند؟","Sâ'at-e çand?","Saat kaçta?"],["ساعت هفت","sâ'at-e haft","saat yedide"]],"examples":[{"t":"ساعت چند است؟ ساعت هشت است.","s":"Saat kaç? Saat sekiz.","pr":"Sâ'at çand ast? Sâ'at haşt ast.","a":"audio/fa-tr/07bd37654b5e.mp3"},{"t":"ساعت یازده و نیم است.","s":"Saat on bir buçuk.","pr":"Sâ'at yâzdah va nim ast.","a":"audio/fa-tr/29cd12aff787.mp3"},{"t":"ساعت چند بیدار می‌شوی؟ ساعت شش.","s":"Saat kaçta uyanıyorsun? Altıda.","pr":"Sâ'at-e çand bidâr mişavi? Sâ'at-e şeş.","a":"audio/fa-tr/a860d3c3664f.mp3"},{"t":"ساعت سه چای می‌خوریم.","s":"Saat üçte çay içiyoruz.","pr":"Sâ'at-e se çây mixorim.","a":"audio/fa-tr/5b47fd9b3e7f.mp3"},{"t":"پدرم ساعت پنج بیدار می‌شود.","s":"Babam saat beşte uyanıyor.","pr":"Pedaram sâ'at-e panc bidâr mişavad.","a":"audio/fa-tr/30e83a7a2fb3.mp3"}],"exercises":[{"type":"choice","t":"ساعت ___ است؟ ساعت نه است.","options":["هستم","چند","نیم"],"answer":1,"s":"Saat kaç? Saat dokuz.","pr":"Sâ'at çand ast? Sâ'at noh ast.","why":"Saat sorusu: «Sâ'at çand ast?» (çand = kaç).","full":"ساعت چند است؟ ساعت نه است.","a":"audio/fa-tr/ad2cd07bc1bb.mp3"},{"type":"choice","t":"ساعت هفت و ___ است.","options":["نیم","چند","شب"],"answer":0,"s":"Saat yedi buçuk.","pr":"Sâ'at haft va nim ast.","why":"«Buçuk» = va nim: haft va nim (yedi buçuk).","full":"ساعت هفت و نیم است.","a":"audio/fa-tr/3fa39919683d.mp3"},{"type":"choice","t":"مریم ساعت ده ___.","options":["می‌خوابم","می‌خوابیم","می‌خوابد"],"answer":2,"s":"Maryam saat onda uyuyor.","pr":"Maryam sâ'at-e dah mixâbad.","why":"«Maryam» üçüncü tekil kişi: -ad → mixâbad.","full":"مریم ساعت ده می‌خوابد.","a":"audio/fa-tr/3ea3176e28bc.mp3"},{"type":"type","t":"ساعت چند ___؟","answer":["است"],"s":"Saat kaç?","pr":"Sâ'at çand ast?","why":"Saat sorusu «ast» ile biter: Sâ'at çand ast?","full":"ساعت چند است؟","a":"audio/fa-tr/4c9001ac57dd.mp3"},{"type":"type","task":"Bir saat sonrasını yazın.","cue":"ساعت هفت است.","cpr":"Sâ'at haft ast.","t":"ساعت ___ است.","answer":["هشت"],"pr":"Sâ'at haşt ast.","s":"Saat sekiz.","why":"Yedi (haft) + bir = sekiz (haşt); kalıp: sâ'at + sayı + ast.","full":"ساعت هشت است.","a":"audio/fa-tr/ee6ec3c1e84e.mp3","ca":"audio/fa-tr/65e299b3ccfa.mp3"},{"type":"choice","task":"Hangi cevap uygun?","cue":"ساعت چند است؟","cpr":"Sâ'at çand ast?","t":"___","options":["ساعت ده است.","ساعت ده می‌خوابم.","ده سال دارم."],"answer":0,"pr":"Sâ'at dah ast.","s":"Saat on.","why":"«Sâ'at çand ast?» saati sorar: «Sâ'at dah ast.» «Sâ'at-e dah» ise «saat onda» demektir.","full":"ساعت ده است.","a":"audio/fa-tr/ca2a27c681b3.mp3","ca":"audio/fa-tr/4c9001ac57dd.mp3"},{"type":"order","t":"الان ساعت هشت است.","s":"Şimdi saat sekiz.","pr":"Alân sâ'at haşt ast.","alts":["ساعت الان هشت است."],"full":"الان ساعت هشت است.","a":"audio/fa-tr/1372330764cb.mp3"}]},{"id":"g03","title":{"t":"روزهای هفته","pr":"ruzhâ-ye hafte","s":"Haftanın günleri"},"explain":"Haftanın günleri çok kolay! Hafta **şanbe** (cumartesi) ile başlar; sonraki günler **sayı + şanbe**'dir: **yekşanbe** (pazar, 'bir-şanbe'), **doşanbe** (pazartesi), **seşanbe** (salı), **çahârşanbe** (çarşamba), **pancşanbe** (perşembe). Türkçedeki **çarşamba** ve **perşembe** de bu Farsça kelimelerden gelir!\n**com'e** (cuma) İran'da hafta sonu tatilidir; okullar ve çoğu iş yeri cuma kapalıdır.\n**hafte** = hafta, **ruz** = gün. Gün sormak için: **Emruz çe ruzi ast?** = Bugün günlerden ne? Cevap: **Emruz doşanbe ast.**\n«Pazartesi günü» demek için edat gerekmez: **Doşanbe kâr mikonam.** «Cumaları» için **-hâ** eklenir: **com'ehâ**.\nOkunuş: **şanbe** konuşmada çoğu zaman *şambe* diye söylenir. **سه‌شنبه** yazılırken **سه** ile **شنبه** arasında yarım boşluk vardır.","table":[["شنبه","şanbe","cumartesi"],["یکشنبه","yekşanbe","pazar"],["دوشنبه","doşanbe","pazartesi"],["سه‌شنبه","seşanbe","salı"],["چهارشنبه","çahârşanbe","çarşamba"],["پنجشنبه","pancşanbe","perşembe"],["جمعه","com'e","cuma"]],"examples":[{"t":"امروز چه روزی است؟ امروز دوشنبه است.","pr":"Emruz çe ruzi ast? Emruz doşanbe ast.","s":"Bugün günlerden ne? Bugün pazartesi.","a":"audio/fa-tr/da2de2713134.mp3"},{"t":"من شنبه تا چهارشنبه کار می‌کنم.","pr":"Man şanbe tâ çahârşanbe kâr mikonam.","s":"Cumartesiden çarşambaya kadar çalışıyorum.","a":"audio/fa-tr/82735aabe927.mp3"},{"t":"جمعه‌ها به خانه‌ی پدربزرگ می‌رویم.","pr":"Com'ehâ be xâne-ye pedarbozorg miravim.","s":"Cumaları büyükbabamın evine gidiyoruz.","a":"audio/fa-tr/ea656ee3c341.mp3"},{"t":"پنجشنبه شب با خانواده شام می‌خوریم.","pr":"Pancşanbe şab bâ xânevâde şâm mixorim.","s":"Perşembe akşamı ailece akşam yemeği yiyoruz.","a":"audio/fa-tr/18b7f7b55e03.mp3"}],"exercises":[{"type":"choice","t":"شنبه، یکشنبه، ___","options":["دوشنبه","جمعه","سه‌شنبه"],"answer":0,"pr":"Şanbe, yekşanbe, doşanbe","s":"Cumartesi, pazar, pazartesi","why":"Sıra: şanbe, yek-şanbe, do-şanbe… Her gün sayı bir artar.","full":"شنبه، یکشنبه، دوشنبه","a":"audio/fa-tr/fd4ff165db25.mp3"},{"type":"choice","t":"امروز ___ است؟ امروز جمعه است.","options":["چه روزی","چند سال","کجا"],"answer":0,"pr":"Emruz çe ruzi ast? Emruz com'e ast.","s":"Bugün günlerden ne? Bugün cuma.","why":"Gün sormak: «Emruz çe ruzi ast?» «Çand sâl» yaşı, «kocâ» yeri sorar.","full":"امروز چه روزی است؟ امروز جمعه است.","a":"audio/fa-tr/0b0f22548ab7.mp3"},{"type":"type","t":"یکشنبه، دوشنبه، ___","answer":["سه‌شنبه","سه شنبه","سهشنبه"],"pr":"Yekşanbe, doşanbe, seşanbe","s":"Pazar, pazartesi, salı","why":"se (3) + şanbe = seşanbe (salı). سه ile شنبه arasında yarım boşluk.","full":"یکشنبه، دوشنبه، سه‌شنبه","a":"audio/fa-tr/7a0993e353dd.mp3"},{"type":"type","t":"پنجشنبه، ___","answer":["جمعه"],"pr":"Pancşanbe, com'e","s":"Perşembe, cuma","why":"Perşembeden (pancşanbe) sonra cuma (com'e) gelir; İran'da tatil günü.","full":"پنجشنبه، جمعه","a":"audio/fa-tr/ec9a0bf54091.mp3"},{"type":"type","task":"«Cumaları» (her cuma) deyin.","cue":"جمعه کار نمی‌کنم.","cpr":"Com'e kâr nemikonam.","t":"___ کار نمی‌کنم.","answer":["جمعه‌ها","جمعهها","جمعه ها"],"pr":"Com'ehâ kâr nemikonam.","s":"Cumaları çalışmıyorum.","why":"«Her cuma» için güne çoğul eki -hâ eklenir: com'e → com'ehâ (cumaları).","full":"جمعه‌ها کار نمی‌کنم.","a":"audio/fa-tr/48f151bac1f7.mp3","ca":"audio/fa-tr/7f7b8e1a7f9e.mp3"},{"type":"choice","task":"Hangi cevap uygun?","cue":"امروز چه روزی است؟","cpr":"Emruz çe ruzi ast?","t":"___","options":["امروز سه‌شنبه است.","ساعت سه است.","سه سال دارم."],"answer":0,"pr":"Emruz seşanbe ast.","s":"Bugün salı.","why":"«Çe ruzi?» günü sorar; «sâ'at» saati, «sâl» yaşı anlatır.","full":"امروز سه‌شنبه است.","a":"audio/fa-tr/89d463da9392.mp3","ca":"audio/fa-tr/cd91e5875b57.mp3"},{"type":"order","t":"ما جمعه کار نمی‌کنیم.","alts":["جمعه ما کار نمی‌کنیم."],"pr":"Mâ com'e kâr nemikonim.","s":"Biz cuma günü çalışmıyoruz.","full":"ما جمعه کار نمی‌کنیم.","a":"audio/fa-tr/d7fe6cca0ed8.mp3"}]}],"reading":{"title":{"t":"یک روز رضا","s":"Reza'nın bir günü","pr":"Yek ruz-e Rezâ","a":"audio/fa-tr/2518de16d780.mp3"},"text":[{"t":"سلام! اسم من رضا است.","s":"Merhaba! Benim adım Reza.","pr":"Salâm! Esm-e man Rezâ ast.","a":"audio/fa-tr/51c7ce1b2ec6.mp3"},{"t":"من هر روز ساعت شش و نیم بیدار می‌شوم.","s":"Her gün saat altı buçukta uyanıyorum.","pr":"Man har ruz sâ'at-e şeş va nim bidâr mişavam.","a":"audio/fa-tr/79d330815140.mp3"},{"t":"ساعت هفت صبحانه می‌خورم: نان و پنیر و چای.","s":"Saat yedide kahvaltı yapıyorum: ekmek, peynir ve çay.","pr":"Sâ'at-e haft sobhâne mixoram: nân va panir va çây.","a":"audio/fa-tr/80e10a601cff.mp3"},{"t":"من معلم هستم و در یک مدرسه کار می‌کنم.","s":"Ben öğretmenim ve bir okulda çalışıyorum.","pr":"Man mo'allem hastam va dar yek madrese kâr mikonam.","a":"audio/fa-tr/4b8607f0cfd8.mp3"},{"t":"ساعت یک در مدرسه ناهار می‌خورم.","s":"Saat birde okulda öğle yemeği yiyorum.","pr":"Sâ'at-e yek dar madrese nâhâr mixoram.","a":"audio/fa-tr/63f31eb705b1.mp3"},{"t":"شب من و همسرم شام درست می‌کنیم.","s":"Akşamları eşimle birlikte yemek hazırlıyoruz.","pr":"Şab man va hamsaram şâm dorost mikonim.","a":"audio/fa-tr/5981574e5296.mp3"},{"t":"بچه‌ها کتاب می‌خوانند.","s":"Çocuklar kitap okuyor.","pr":"Baççehâ ketâb mixânand.","a":"audio/fa-tr/64ad604587fa.mp3"},{"t":"شب ساعت یازده می‌خوابم.","s":"Gece saat on birde uyuyorum.","pr":"Şab sâ'at-e yâzdah mixâbam.","a":"audio/fa-tr/2e3bfcfcf62f.mp3"}],"questions":[{"q":{"t":"رضا ساعت چند بیدار می‌شود؟","s":"Reza saat kaçta uyanıyor?","pr":"Rezâ sâ'at-e çand bidâr mişavad?","a":"audio/fa-tr/d052ef75d9a6.mp3"},"options":["شش و نیم","هفت","یازده"],"answer":0},{"q":{"t":"رضا کجا کار می‌کند؟","s":"Reza nerede çalışıyor?","pr":"Rezâ kocâ kâr mikonad?","a":"audio/fa-tr/eecdf1a2d730.mp3"},"options":["در خانه","در مدرسه","در بیمارستان"],"answer":1},{"q":{"t":"رضا صبحانه چه می‌خورد؟","s":"Reza kahvaltıda ne yiyor?","pr":"Rezâ sobhâne çe mixorad?","a":"audio/fa-tr/ae0723767f6f.mp3"},"options":["سیب","برنج","نان و پنیر"],"answer":2},{"q":{"t":"بچه‌ها چه کار می‌کنند؟","s":"Çocuklar ne yapıyor?","pr":"Baççehâ çe kâr mikonand?","a":"audio/fa-tr/29d4bb6b5df9.mp3"},"options":["کتاب می‌خوانند","شام می‌خورند","کار می‌کنند"],"answer":0}]},"sentences":[{"t":"مادرم صبح چای می‌خورد.","s":"Annem sabah çay içiyor.","pr":"Mâdaram sobh çây mixorad.","a":"audio/fa-tr/199513940f5c.mp3"},{"t":"ما با هم شام می‌خوریم.","s":"Akşam yemeğini birlikte yiyoruz.","pr":"Mâ bâ ham şâm mixorim.","a":"audio/fa-tr/f6d1f553883f.mp3"},{"t":"امید ساعت هشت به