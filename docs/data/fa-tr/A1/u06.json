{"id":"u06","level":"A1","emoji":"⏰","title":{"t":"زندگی روزانه و ساعت","s":"Günlük hayat ve saat","pr":"Zendegi-ye ruzâne va sâ'at","a":"audio/fa-tr/f731d28c25d3.mp3"},"goals":["Saatin kaç olduğunu sorup söyleyebilirim.","Günlük işlerimi Farsça anlatabilirim.","Fiilleri şimdiki/geniş zamanda (mi- ile) çekebilirim."],"words":[{"id":"w01","t":"ساعت","s":"saat","pr":"sâ'at","emoji":"🕐","ex":{"t":"ساعت روی میز است.","s":"Saat masanın üstünde.","pr":"Sâ'at ru-ye miz ast.","a":"audio/fa-tr/bd93c58222a5.mp3"},"img":"img/e/1f550.svg","a":"audio/fa-tr/9d79883b43fc.mp3"},{"id":"w02","t":"صبح","s":"sabah","pr":"sobh","emoji":"🌅","ex":{"t":"صبح چای می‌خورم.","s":"Sabah çay içiyorum.","pr":"Sobh çây mixoram.","a":"audio/fa-tr/faa8ae76011a.mp3"},"img":"img/e/1f305.svg","a":"audio/fa-tr/87106240ab1b.mp3"},{"id":"w03","t":"شب","s":"gece, akşam","pr":"şab","emoji":"🌙","ex":{"t":"شب ساعت ده می‌خوابم.","s":"Gece saat onda uyuyorum.","pr":"Şab sâ'at-e dah mixâbam.","a":"audio/fa-tr/82a7b7aaa558.mp3"},"img":"img/e/1f319.svg","a":"audio/fa-tr/d8afae8bd7f3.mp3"},{"id":"w04","t":"صبحانه","s":"kahvaltı","pr":"sobhâne","emoji":"🍳","ex":{"t":"صبحانه نان و پنیر می‌خورم.","s":"Kahvaltıda ekmek ve peynir yiyorum.","pr":"Sobhâne nân va panir mixoram.","a":"audio/fa-tr/6c2d98c71221.mp3"},"img":"img/e/1f373.svg","a":"audio/fa-tr/7ee1c325459d.mp3"},{"id":"w05","t":"ناهار","s":"öğle yemeği","pr":"nâhâr","emoji":"🍚","ex":{"t":"ساعت یک ناهار می‌خوریم.","s":"Saat birde öğle yemeği yiyoruz.","pr":"Sâ'at-e yek nâhâr mixorim.","a":"audio/fa-tr/fdd5df77fb0c.mp3"},"img":"img/e/1f35a.svg","a":"audio/fa-tr/fa12556a8ecc.mp3"},{"id":"w06","t":"شام","s":"akşam yemeği","pr":"şâm","emoji":"🍽️","ex":{"t":"ما ساعت هشت شام می‌خوریم.","s":"Biz saat sekizde akşam yemeği yiyoruz.","pr":"Mâ sâ'at-e haşt şâm mixorim.","a":"audio/fa-tr/019b54742f69.mp3"},"img":"img/e/1f37d.svg","a":"audio/fa-tr/71cc4691929c.mp3"},{"id":"w07","t":"بیدار شدن","s":"uyanmak","pr":"bidâr şodan","emoji":"⏰","ex":{"t":"من ساعت هفت بیدار می‌شوم.","s":"Ben saat yedide uyanıyorum.","pr":"Man sâ'at-e haft bidâr mişavam.","a":"audio/fa-tr/7a82ebccf7c1.mp3"},"img":"img/e/23f0.svg","a":"audio/fa-tr/039932f761f8.mp3"},{"id":"w08","t":"خوابیدن","s":"uyumak","pr":"xâbidan","emoji":"😴","ex":{"t":"بچه‌ها ساعت نه می‌خوابند.","s":"Çocuklar saat dokuzda uyuyor.","pr":"Baççehâ sâ'at-e noh mixâband.","a":"audio/fa-tr/18bdea11c3cf.mp3"},"img":"img/e/1f634.svg","a":"audio/fa-tr/e333bedf187c.mp3"},{"id":"w09","t":"خوردن","s":"yemek; (çay, su) içmek","pr":"xordan","emoji":"🍴","ex":{"t":"علی سیب می‌خورد.","s":"Ali elma yiyor.","pr":"Ali sib mixorad.","a":"audio/fa-tr/e641079e3300.mp3"},"img":"img/e/1f374.svg","a":"audio/fa-tr/a8f833637cc8.mp3"},{"id":"w10","t":"رفتن","s":"gitmek","pr":"raftan","emoji":"🚶","ex":{"t":"سارا هر روز به مدرسه می‌رود.","s":"Sara her gün okula gidiyor.","pr":"Sârâ har ruz be madrese miravad.","a":"audio/fa-tr/aa694b2bf0cf.mp3"},"img":"img/e/1f6b6.svg","a":"audio/fa-tr/6b3b6c994686.mp3"},{"id":"w11","t":"کار کردن","s":"çalışmak","pr":"kâr kardan","emoji":"💼","ex":{"t":"مادرم در بیمارستان کار می‌کند.","s":"Annem hastanede çalışıyor.","pr":"Mâdaram dar bimârestân kâr mikonad.","a":"audio/fa-tr/c1592539d263.mp3"},"img":"img/e/1f4bc.svg","a":"audio/fa-tr/80f97f1f642d.mp3"},{"id":"w12","t":"خواندن","s":"okumak","pr":"xândan","emoji":"📖","ex":{"t":"سارا کتاب می‌خواند.","s":"Sara kitap okuyor.","pr":"Sârâ ketâb mixânad.","a":"audio/fa-tr/cf46831335df.mp3"},"img":"img/e/1f4d6.svg","a":"audio/fa-tr/e0715abebe39.mp3"},{"id":"w13","t":"الان","s":"şimdi","pr":"alân","emoji":"","ex":{"t":"الان ساعت هشت است.","s":"Şimdi saat sekiz.","pr":"Alân sâ'at haşt ast.","a":"audio/fa-tr/1372330764cb.mp3"},"img":null,"a":"audio/fa-tr/3c0b50952e41.mp3"},{"id":"w14","t":"هر روز","s":"her gün","pr":"har ruz","emoji":"📅","ex":{"t":"پدرم هر روز کار می‌کند.","s":"Babam her gün çalışıyor.","pr":"Pedaram har ruz kâr mikonad.","a":"audio/fa-tr/87b7e2dce7a6.mp3"},"img":"img/e/1f4c5.svg","a":"audio/fa-tr/9f3fe643d774.mp3"}],"phrases":[{"id":"p01","t":"ساعت چند است؟","s":"Saat kaç?","pr":"Sâ'at çand ast?","a":"audio/fa-tr/4c9001ac57dd.mp3"},{"id":"p02","t":"ساعت هفت است.","s":"Saat yedi.","pr":"Sâ'at haft ast.","a":"audio/fa-tr/65e299b3ccfa.mp3"},{"id":"p03","t":"ساعت هفت و نیم است.","s":"Saat yedi buçuk.","pr":"Sâ'at haft va nim ast.","a":"audio/fa-tr/3fa39919683d.mp3"},{"id":"p04","t":"ساعت چند؟","s":"Saat kaçta?","pr":"Sâ'at-e çand?","a":"audio/fa-tr/c628077e7224.mp3"},{"id":"p05","t":"صبح بخیر!","s":"Günaydın!","pr":"Sobh bexeyr!","a":"audio/fa-tr/91401e6d5970.mp3"},{"id":"p06","t":"شب بخیر!","s":"İyi geceler!","pr":"Şab bexeyr!","a":"audio/fa-tr/baca6f57bb03.mp3"},{"id":"p07","t":"دیرم شد!","s":"Geç kaldım!","pr":"Diram şod!","a":"audio/fa-tr/4f33bb03da66.mp3"},{"id":"p08","t":"خیلی زود است!","s":"Çok erken!","pr":"Xeyli zud ast!","a":"audio/fa-tr/1f9d490e1d4a.mp3"}],"dialogue":{"title":{"t":"ساعت چند بیدار می‌شوی؟","s":"Saat kaçta uyanıyorsun?","pr":"Sâ'at-e çand bidâr mişavi?","a":"audio/fa-tr/0319092f3b0b.mp3"},"speakers":{"A":{"name":"Maryam","voice":"f"},"B":{"name":"Mehmet","voice":"m"}},"lines":[{"sp":"A","t":"صبح بخیر، مهمت!","s":"Günaydın Mehmet!","pr":"Sobh bexeyr, Mehmet!","a":"audio/fa-tr/2f285def45fd.mp3"},{"sp":"B","t":"صبح بخیر، مریم! حالت چطور است؟","s":"Günaydın Maryam! Nasılsın?","pr":"Sobh bexeyr, Maryam! Hâlat çetor ast?","a":"audio/fa-tr/53a40d5fb897.mp3"},{"sp":"A","t":"خوبم، ممنون. تو هر روز ساعت چند بیدار می‌شوی؟","s":"İyiyim, teşekkürler. Sen her gün saat kaçta uyanıyorsun?","pr":"Xubam, mamnun. To har ruz sâ'at-e çand bidâr mişavi?","a":"audio/fa-tr/c9bd6ed2cb25.mp3"},{"sp":"B","t":"ساعت هفت. تو چطور؟","s":"Yedide. Ya sen?","pr":"Sâ'at-e haft. To çetor?","a":"audio/fa-tr/450c159832f3.mp3"},{"sp":"A","t":"من ساعت شش بیدار می‌شوم و صبحانه می‌خورم.","s":"Ben altıda uyanıyorum ve kahvaltı yapıyorum.","pr":"Man sâ'at-e şeş bidâr mişavam va sobhâne mixoram.","a":"audio/fa-tr/b41f64236b08.mp3"},{"sp":"B","t":"ساعت شش؟ خیلی زود است!","s":"Altıda mı? Çok erken!","pr":"Sâ'at-e şeş? Xeyli zud ast!","a":"audio/fa-tr/e1a698cd1f26.mp3"},{"sp":"A","t":"بله، ولی شب ساعت ده می‌خوابم.","s":"Evet, ama gece saat onda uyuyorum.","pr":"Bale, vali şab sâ'at-e dah mixâbam.","a":"audio/fa-tr/ba524355c5c4.mp3"},{"sp":"B","t":"الان ساعت چند است؟","s":"Şimdi saat kaç?","pr":"Alân sâ'at çand ast?","a":"audio/fa-tr/f4f9d0d21ad5.mp3"},{"sp":"A","t":"ساعت هشت و نیم است.","s":"Saat sekiz buçuk.","pr":"Sâ'at haşt va nim ast.","a":"audio/fa-tr/ef8aefc31d17.mp3"},{"sp":"B","t":"وای، دیرم شد! خداحافظ، مریم!","s":"Eyvah, geç kaldım! Hoşça kal, Maryam!","pr":"Vây, diram şod! Xodâhâfez, Maryam!","a":"audio/fa-tr/eba066b1106f.mp3"}]},"grammar":[{"id":"g01","title":{"t":"می‌خورم، می‌روم، می‌خوابم","s":"Şimdiki / geniş zaman: mi- + kök + şahıs eki","pr":"mixoram, miravam, mixâbam"},"explain":"Farsçada **şimdiki zaman** ile **geniş zaman** aynı biçimdedir: **mixoram** hem \"yiyorum\" hem de \"yerim\" demektir.\nFormül: **mi-** + fiil kökü + şahıs eki. Ekler \"olmak\" fiilinden tanıdık: **-am, -i, -ad, -im, -id, -and**. Yalnızca üçüncü tekil kişi (o) farklı: **-ad** (mixorad = yiyor).\nMastarlar **-an** ile biter (-tan, -dan, -idan), Türkçedeki -mak/-mek gibi: xordan → kök **xor**, xâbidan → kök **xâb**. Bazı kökler düzensizdir, onları ezberleyin: raftan → **rav** (miravam), kardan → **kon** (mikonam), şodan → **şav** (mişavam).\n**kâr kardan, bidâr şodan** gibi birleşik fiillerde ilk kelime değişmez, sadece ikinci kısım çekilir: kâr **mikonam** = çalışıyorum. Türkçedeki \"yardım etmek\" gibi düşünün.\nOlumsuz için başa **ne-** gelir: **nemixoram** = yemiyorum / içmiyorum. Fiil, Türkçede olduğu gibi cümlenin sonundadır.\nİpucu: Farslar çay ve su için de genellikle **xordan** der: **çây mixoram** = çay içiyorum.","table":[["من","می‌خورم","man mixoram"],["تو","می‌خوری","to mixori"],["او","می‌خورد","u mixorad"],["ما","می‌خوریم","mâ mixorim"],["شما","می‌خورید","şomâ mixorid"],["آن‌ها","می‌خورند","ânhâ mixorand"]],"examples":[{"t":"من هر روز کار می‌کنم.","s":"Ben her gün çalışıyorum.","pr":"Man har ruz kâr mikonam.","a":"audio/fa-tr/095feebf2fff.mp3"},{"t":"تو الان چه کار می‌کنی؟","s":"Sen şimdi ne yapıyorsun?","pr":"To alân çe kâr mikoni?","a":"audio/fa-tr/c5fd65c518b2.mp3"},{"t":"آیشه کتاب می‌خواند.","s":"Ayşe kitap okuyor.","pr":"Âyşe ketâb mixânad.","a":"audio/fa-tr/3ac8ec56f6d2.mp3"},{"t":"ما شب تلویزیون تماشا می‌کنیم.","s":"Biz akşam televizyon izliyoruz.","pr":"Mâ şab televiziyon tamâşâ mikonim.","a":"audio/fa-tr/4aa24b9616cf.mp3"},{"t":"من قهوه نمی‌خورم.","s":"Ben kahve içmiyorum.","pr":"Man ğahve nemixoram.","a":"audio/fa-tr/5bd3543f2807.mp3"}],"exercises":[{"type":"choice","t":"من هر روز ساعت هفت بیدار ___.","options":["می‌شوم","می‌شوی","می‌شود"],"answer":0,"s":"Ben her gün saat yedide uyanıyorum.","pr":"Man har ruz sâ'at-e haft bidâr mişavam.","full":"من هر روز ساعت هفت بیدار می‌شوم.","a":"audio/fa-tr/b5ab9a19fb0f.mp3"},{"type":"choice","t":"علی در یک مدرسه کار ___.","options":["می‌کنم","می‌کند","می‌کنیم"],"answer":1,"s":"Ali bir okulda çalışıyor.","pr":"Ali dar yek madrese kâr mikonad.","full":"علی در یک مدرسه کار می‌کند.","a":"audio/fa-tr/568d20dd4bc5.mp3"},{"type":"choice","t":"ما شب ساعت ده ___.","options":["می‌خوابند","می‌خوابیم","می‌خوابی"],"answer":1,"s":"Biz gece saat onda uyuyoruz.","pr":"Mâ şab sâ'at-e dah mixâbim.","full":"ما شب ساعت ده می‌خوابیم.","a":"audio/fa-tr/15dc1b6ea88c.mp3"},{"type":"choice","t":"بچه‌ها به مدرسه ___.","options":["می‌روند","می‌رود","می‌روم"],"answer":0,"s":"Çocuklar okula gidiyor.","pr":"Baççehâ be madrese miravand.","full":"بچه‌ها به مدرسه می‌روند.","a":"audio/fa-tr/b1593970f231.mp3"},{"type":"type","t":"تو صبحانه چه ___؟","answer":["می‌خوری","میخوری"],"s":"Sen kahvaltıda ne yiyorsun?","pr":"To sobhâne çe mixori?","full":"تو صبحانه چه می‌خوری؟","a":"audio/fa-tr/f8619087fd3c.mp3"},{"type":"type","t":"من قهوه ___.","answer":["نمی‌خورم","نمیخورم"],"s":"Ben kahve içmiyorum.","pr":"Man ğahve nemixoram.","full":"من قهوه نمی‌خورم.","a":"audio/fa-tr/5bd3543f2807.mp3"},{"type":"order","t":"من ساعت هفت بیدار می‌شوم.","s":"Ben saat yedide uyanıyorum.","pr":"Man sâ'at-e haft bidâr mişavam.","full":"من ساعت هفت بیدار می‌شوم.","a":"audio/fa-tr/7a82ebccf7c1.mp3"},{"type":"order","t":"پدرم هر روز کار می‌کند.","s":"Babam her gün çalışıyor.","pr":"Pedaram har ruz kâr mikonad.","alts":["هر روز پدرم کار می‌کند."],"full":"پدرم هر روز کار می‌کند.","a":"audio/fa-tr/87b7e2dce7a6.mp3"}]},{"id":"g02","title":{"t":"ساعت چند است؟ ساعت چند؟","s":"Saat kaç? Saat kaçta?","pr":"Sâ'at çand ast? Sâ'at-e çand?"},"explain":"Saati sormak için: **Sâ'at çand ast?** = Saat kaç? Cevap: **sâ'at** + sayı + **ast**: Sâ'at haft ast = Saat yedi.\n\"Buçuk\" için **va nim** (ve yarım) deriz: Sâ'at haft va nim ast = Saat yedi buçuk. \"Çeyrek\" için **va rob'**: Sâ'at haft va rob' ast = Saat yediyi çeyrek geçiyor.\n\"Saat kaçta?\" demek için ezafe kullanırız: **Sâ'at-e çand?** Cevap: **sâ'at-e haft** = saat yedide. Türkçedeki **-de/-da** için ayrı bir edat gerekmez; saat ile sayının arasına sadece ezafe girer.\nKarşılaştırın: **Sâ'at haft ast.** = Saat yedi. ↔ **Sâ'at-e haft mixâbam.** = Saat yedide uyuyorum. Ezafe yazıda görünmez, ama söylenir.","table":[["ساعت هفت است.","Sâ'at haft ast.","Saat yedi."],["ساعت هفت و ربع است.","Sâ'at haft va rob' ast.","Saat yediyi çeyrek geçiyor."],["ساعت هفت و نیم است.","Sâ'at haft va nim ast.","Saat yedi buçuk."],["ساعت چند؟","Sâ'at-e çand?","Saat kaçta?"],["ساعت هفت","sâ'at-e haft","saat yedide"]],"examples":[{"t":"ساعت چند است؟ ساعت هشت است.","s":"Saat kaç? Saat sekiz.","pr":"Sâ'at çand ast? Sâ'at haşt ast.","a":"audio/fa-tr/07bd37654b5e.mp3"},{"t":"ساعت یازده و نیم است.","s":"Saat on bir buçuk.","pr":"Sâ'at yâzdah va nim ast.","a":"audio/fa-tr/29cd12aff787.mp3"},{"t":"ساعت چند بیدار می‌شوی؟ ساعت شش.","s":"Saat kaçta uyanıyorsun? Altıda.","pr":"Sâ'at-e çand bidâr mişavi? Sâ'at-e şeş.","a":"audio/fa-tr/a860d3c3664f.mp3"},{"t":"ساعت سه چای می‌خوریم.","s":"Saat üçte çay içiyoruz.","pr":"Sâ'at-e se çây mixorim.","a":"audio/fa-tr/5b47fd9b3e7f.mp3"},{"t":"پدرم ساعت پنج بیدار می‌شود.","s":"Babam saat beşte uyanıyor.","pr":"Pedaram sâ'at-e panc bidâr mişavad.","a":"audio/fa-tr/30e83a7a2fb3.mp3"}],"exercises":[{"type":"choice","t":"ساعت ___ است؟ ساعت نه است.","options":["هستم","چند","نیم"],"answer":1,"s":"Saat kaç? Saat dokuz.","pr":"Sâ'at çand ast? Sâ'at noh ast.","full":"ساعت چند است؟ ساعت نه است.","a":"audio/fa-tr/ad2cd07bc1bb.mp3"},{"type":"choice","t":"ساعت هفت و ___ است.","options":["نیم","چند","شب"],"answer":0,"s":"Saat yedi buçuk.","pr":"Sâ'at haft va nim ast.","full":"ساعت هفت و نیم است.","a":"audio/fa-tr/3fa39919683d.mp3"},{"type":"choice","t":"مریم ساعت ده ___.","options":["می‌خوابم","می‌خوابیم","می‌خوابد"],"answer":2,"s":"Maryam saat onda uyuyor.","pr":"Maryam sâ'at-e dah mixâbad.","full":"مریم ساعت ده می‌خوابد.","a":"audio/fa-tr/3ea3176e28bc.mp3"},{"type":"type","t":"ساعت چند ___؟","answer":["است"],"s":"Saat kaç?","pr":"Sâ'at çand ast?","full":"ساعت چند است؟","a":"audio/fa-tr/4c9001ac57dd.mp3"},{"type":"type","t":"ساعت یازده و ___ است.","answer":["نیم"],"s":"Saat on bir buçuk.","pr":"Sâ'at yâzdah va nim ast.","full":"ساعت یازده و نیم است.","a":"audio/fa-tr/29cd12aff787.mp3"},{"type":"order","t":"ساعت چند بیدار می‌شوی؟","s":"Saat kaçta uyanıyorsun?","pr":"Sâ'at-e çand bidâr mişavi?","full":"ساعت چند بیدار می‌شوی؟","a":"audio/fa-tr/0319092f3b0b.mp3"},{"type":"order","t":"الان ساعت هشت است.","s":"Şimdi saat sekiz.","pr":"Alân sâ'at haşt ast.","alts":["ساعت الان هشت است."],"full":"الان ساعت هشت است.","a":"audio/fa-tr/1372330764cb.mp3"}]}],"reading":{"title":{"t":"یک روز رضا","s":"Reza'nın bir günü","pr":"Yek ruz-e Rezâ","a":"audio/fa-tr/2518de16d780.mp3"},"text":[{"t":"سلام! اسم من رضا است.","s":"Merhaba! Benim adım Reza.","pr":"Salâm! Esm-e man Rezâ ast.","a":"audio/fa-tr/51c7ce1b2ec6.mp3"},{"t":"من هر روز ساعت شش و نیم بیدار می‌شوم.","s":"Her gün saat altı buçukta uyanıyorum.","pr":"Man har ruz sâ'at-e şeş va nim bidâr mişavam.","a":"audio/fa-tr/79d330815140.mp3"},{"t":"ساعت هفت صبحانه می‌خورم: نان و پنیر و چای.","s":"Saat ye