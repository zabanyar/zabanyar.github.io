":"Mostağim beravid.","a":"audio/fa-tr/aa91f1c3d67c.mp3"},{"id":"p03","t":"به راست بپیچید.","s":"Sağa dönün.","pr":"Be râst bepiçid.","a":"audio/fa-tr/0ede34fe9ad7.mp3"},{"id":"p04","t":"به چپ بپیچید.","s":"Sola dönün.","pr":"Be çap bepiçid.","a":"audio/fa-tr/020187456a75.mp3"},{"id":"p05","t":"سمت راست است.","s":"Sağ tarafta.","pr":"Samt-e râst ast.","a":"audio/fa-tr/8342dab3e783.mp3"},{"id":"p06","t":"دور است؟","s":"Uzak mı?","pr":"Dur ast?","a":"audio/fa-tr/84fd60ccfa4e.mp3"},{"id":"p07","t":"نه، خیلی نزدیک است.","s":"Hayır, çok yakın.","pr":"Na, xeyli nazdik ast.","a":"audio/fa-tr/3dbf3d84972d.mp3"},{"id":"p08","t":"خیلی ممنون!","s":"Çok teşekkürler!","pr":"Xeyli mamnun!","a":"audio/fa-tr/eaa8acccf2ab.mp3"}],"dialogue":{"title":{"t":"ببخشید، داروخانه کجاست؟","s":"Affedersiniz, eczane nerede?","pr":"Bebaxşid, dâruxâne kocâst?","a":"audio/fa-tr/b8a013d1fdea.mp3"},"speakers":{"A":{"name":"Emre","voice":"m"},"B":{"name":"Mina","voice":"f"}},"lines":[{"sp":"A","t":"ببخشید خانم، داروخانه کجاست؟","s":"Affedersiniz hanımefendi, eczane nerede?","pr":"Bebaxşid xânom, dâruxâne kocâst?","a":"audio/fa-tr/8e172341dc83.mp3"},{"sp":"B","t":"داروخانه؟ کنار بیمارستان است.","s":"Eczane mi? Hastanenin yanında.","pr":"Dâruxâne? Kenâr-e bimârestân ast.","a":"audio/fa-tr/5c517c7060a6.mp3"},{"sp":"A","t":"دور است؟","s":"Uzak mı?","pr":"Dur ast?","a":"audio/fa-tr/84fd60ccfa4e.mp3"},{"sp":"B","t":"نه، خیلی نزدیک است. مستقیم بروید.","s":"Hayır, çok yakın. Düz gidin.","pr":"Na, xeyli nazdik ast. Mostağim beravid.","a":"audio/fa-tr/3127fbbc3051.mp3"},{"sp":"A","t":"مستقیم، بعد؟","s":"Düz, sonra?","pr":"Mostağim, ba'd?","a":"audio/fa-tr/1192f7f77caf.mp3"},{"sp":"B","t":"سر چهارراه به راست بپیچید.","s":"Kavşakta sağa dönün.","pr":"Sar-e çahârrâh be râst bepiçid.","a":"audio/fa-tr/f78340513dd4.mp3"},{"sp":"A","t":"به راست، بله.","s":"Sağa, tamam.","pr":"Be râst, bale.","a":"audio/fa-tr/b010eaa6338e.mp3"},{"sp":"B","t":"بیمارستان سمت چپ است و داروخانه کنار آن است.","s":"Hastane sol tarafta, eczane de onun yanında.","pr":"Bimârestân samt-e çap ast va dâruxâne kenâr-e ân ast.","a":"audio/fa-tr/7aaaa67d7620.mp3"},{"sp":"A","t":"خیلی ممنون!","s":"Çok teşekkürler!","pr":"Xeyli mamnun!","a":"audio/fa-tr/eaa8acccf2ab.mp3"},{"sp":"B","t":"خواهش می‌کنم.","s":"Rica ederim.","pr":"Xâheş mikonam.","a":"audio/fa-tr/e7f7021a6ccb.mp3"}]},"grammar":[{"id":"g01","title":{"t":"بروید، بپیچید","s":"Emir kipi: be- + kök","pr":"beravid, bepiçid"},"explain":"Yol tarifi verirken emir kipini kullanırız. Formül çok basit: **be-** + fiil kökü. Geniş zamandaki **mi-** yerine **be-** gelir: miravid (gidiyorsunuz) → **beravid** (gidin).\n**Sen** için sadece **be- + kök**: **bepiç!** (dön!). **Siz** (kibar ya da çoğul) için sona **-id** eklenir: **bepiçid** (dönün). Türkçedeki *dön / dönün* farkının aynısı!\nKökte **o** sesi varsa be- genellikle **bo-** diye söylenir: **boxor** (ye!), **bokon** (yap!). Bazı fiiller düzensizdir: raftan (gitmek) → **boro / beravid** (git / gidin), âmadan (gelmek) → **biyâ / biyâyid** (gel / gelin).\n**kardan** ile kurulan fiillerde be- çoğunlukla düşer: **sabr konid** = bekleyin.\nOlumsuz emir için **be-** yerine **na-** gelir: **naravid** (gitmeyin), **napiçid** (dönmeyin). Kibar olmak için başa **lotfan** (lütfen) ekleyin; Türkçedeki *lütfen* ile aynı kelime!","table":[["رفتن","برو / بروید","boro / beravid"],["پیچیدن","بپیچ / بپیچید","bepiç / bepiçid"],["خوردن","بخور / بخورید","boxor / boxorid"],["آمدن","بیا / بیایید","biyâ / biyâyid"],["نشستن","بنشین / بنشینید","beneşin / beneşinid"],["صبر کردن","صبر کن / صبر کنید","sabr kon / sabr konid"]],"examples":[{"t":"مستقیم بروید.","s":"Düz gidin.","pr":"Mostağim beravid.","a":"audio/fa-tr/aa91f1c3d67c.mp3"},{"t":"سر چهارراه به چپ بپیچید.","s":"Kavşakta sola dönün.","pr":"Sar-e çahârrâh be çap bepiçid.","a":"audio/fa-tr/83d5e5cd7d01.mp3"},{"t":"علی، بیا!","s":"Ali, gel!","pr":"Ali, biyâ!","a":"audio/fa-tr/cfe607a0dcf0.mp3"},{"t":"لطفاً بنشینید.","s":"Lütfen oturun.","pr":"Lotfan beneşinid.","a":"audio/fa-tr/874767104edd.mp3"},{"t":"به راست نپیچید!","s":"Sağa dönmeyin!","pr":"Be râst napiçid!","a":"audio/fa-tr/c6475afe3420.mp3"}],"exercises":[{"type":"choice","t":"لطفاً مستقیم ___.","options":["بروید","می‌روید","رفتن"],"answer":0,"s":"Lütfen düz gidin.","pr":"Lotfan mostağim beravid.","full":"لطفاً مستقیم بروید.","a":"audio/fa-tr/15543324342b.mp3"},{"type":"choice","t":"سر چهارراه به راست ___.","options":["پیچیدن","بپیچید","پیچ"],"answer":1,"s":"Kavşakta sağa dönün.","pr":"Sar-e çahârrâh be râst bepiçid.","full":"سر چهارراه به راست بپیچید.","a":"audio/fa-tr/db5fce1d9452.mp3"},{"type":"choice","t":"مریم، ___!","options":["آمدن","آمد","بیا"],"answer":2,"s":"Maryam, gel!","pr":"Maryam, biyâ!","full":"مریم، بیا!","a":"audio/fa-tr/2e7f2a2e1a56.mp3"},{"type":"choice","t":"به چپ ___! بانک سمت راست است.","options":["نپیچید","بپیچید","پیچیدن"],"answer":0,"s":"Sola dönmeyin! Banka sağda.","pr":"Be çap napiçid! Bânk samt-e râst ast.","full":"به چپ نپیچید! بانک سمت راست است.","a":"audio/fa-tr/6a5dc2c52af4.mp3"},{"type":"type","t":"لطفاً ___.","answer":["بنشینید"],"s":"Lütfen oturun.","pr":"Lotfan beneşinid.","full":"لطفاً بنشینید.","a":"audio/fa-tr/874767104edd.mp3"},{"type":"type","t":"مستقیم ___!","answer":["برو"],"s":"Düz git!","pr":"Mostağim boro!","full":"مستقیم برو!","a":"audio/fa-tr/5203a755db5a.mp3"},{"type":"order","t":"سر چهارراه به چپ بپیچید.","s":"Kavşakta sola dönün.","pr":"Sar-e çahârrâh be çap bepiçid.","full":"سر چهارراه به چپ بپیچید.","a":"audio/fa-tr/83d5e5cd7d01.mp3"},{"type":"order","t":"لطفاً مستقیم بروید.","s":"Lütfen düz gidin.","pr":"Lotfan mostağim beravid.","full":"لطفاً مستقیم بروید.","a":"audio/fa-tr/15543324342b.mp3"}]},{"id":"g02","title":{"t":"به بانک می‌روم. بانک کجاست؟","s":"\"be\" (-e/-a) ve \"kocâst?\" (nerede?)","pr":"Be bânk miravam. Bânk kocâst?"},"explain":"Türkçede yön için isme **-e/-a** ekleriz: *bankaya*. Farsçada ise ismin **önüne** **be** edatı gelir: **be bânk** = bankaya. Ek yok, ünlü uyumu yok; her zaman **be**!\n**Be bânk miravam** = Bankaya gidiyorum. Fiil yine sonda.\nHatırlayın: **dar** = -de/-da. Yani **dar bânk** (bankada) ↔ **be bânk** (bankaya).\nBir yeri sormak için: isim + **kocâst?** (kocâ + ast): **Bânk kocâst?** = Banka nerede?\nCevapta yön: **samt-e râst** (sağ taraf), **samt-e çap** (sol taraf): Bânk **samt-e râst** ast = Banka sağda. Hareket için **be râst / be çap** (sağa / sola) ve **mostağim** (düz).","table":[["به بانک","be bânk","bankaya"],["در بانک","dar bânk","bankada"],["بانک کجاست؟","Bânk kocâst?","Banka nerede?"],["سمت راست / سمت چپ","samt-e râst / samt-e çap","sağda / solda"],["به راست / به چپ","be râst / be çap","sağa / sola"]],"examples":[{"t":"من به بانک می‌روم.","s":"Ben bankaya gidiyorum.","pr":"Man be bânk miravam.","a":"audio/fa-tr/423cd53a9b97.mp3"},{"t":"بچه‌ها به پارک می‌روند.","s":"Çocuklar parka gidiyor.","pr":"Baççehâ be pârk miravand.","a":"audio/fa-tr/bb239e6cd201.mp3"},{"t":"ببخشید، ایستگاه مترو کجاست؟","s":"Affedersiniz, metro istasyonu nerede?","pr":"Bebaxşid, istgâh-e metro kocâst?","a":"audio/fa-tr/49c723280549.mp3"},{"t":"بیمارستان سمت چپ است.","s":"Hastane solda.","pr":"Bimârestân samt-e çap ast.","a":"audio/fa-tr/dff829253431.mp3"},{"t":"ما با تاکسی به خانه می‌رویم.","s":"Eve taksiyle gidiyoruz.","pr":"Mâ bâ tâksi be xâne miravim.","a":"audio/fa-tr/ee5810bb040d.mp3"}],"exercises":[{"type":"choice","t":"من ___ مدرسه می‌روم.","options":["به","در","روی"],"answer":0,"s":"Ben okula gidiyorum.","pr":"Man be madrese miravam.","full":"من به مدرسه می‌روم.","a":"audio/fa-tr/084fa9f902a8.mp3"},{"type":"choice","t":"مادرم ___ بیمارستان کار می‌کند.","options":["به","در","سمت"],"answer":1,"s":"Annem hastanede çalışıyor.","pr":"Mâdaram dar bimârestân kâr mikonad.","full":"مادرم در بیمارستان کار می‌کند.","a":"audio/fa-tr/c1592539d263.mp3"},{"type":"choice","t":"ببخشید، داروخانه ___؟","options":["ساعت","هستم","کجاست"],"answer":2,"s":"Affedersiniz, eczane nerede?","pr":"Bebaxşid, dâruxâne kocâst?","full":"ببخشید، داروخانه کجاست؟","a":"audio/fa-tr/b8a013d1fdea.mp3"},