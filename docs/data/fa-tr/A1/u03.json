{"id":"u03","level":"A1","emoji":"👪","title":{"t":"خانواده‌ی من","pr":"Xânevâde-ye man","s":"Ailem","a":"audio/fa-tr/806423d56af1.mp3"},"goals":["Aile üyelerini Farsça söyleyebilmek.","Ezafe (-e) ile «Ali'nin annesi, büyük ev» diyebilmek.","İyelik eklerini (-am, -at, -aş) kullanabilmek.","«dâştan» (sahip olmak) fiiliyle «…im var / yok» diyebilmek."],"words":[{"id":"w01","t":"خانواده","pl":"خانواده‌ها","pr":"xânevâde","s":"aile","emoji":"👪","ex":{"t":"خانواده‌ی من بزرگ است.","pr":"Xânevâde-ye man bozorg ast.","s":"Ailem kalabalık.","a":"audio/fa-tr/b4faf495511b.mp3"},"img":"img/e/1f46a.svg","a":"audio/fa-tr/8606d2358ef5.mp3","pla":"audio/fa-tr/a8670117943b.mp3"},{"id":"w02","t":"مادر","pl":"مادرها","pr":"mâdar","s":"anne","emoji":"👩","ex":{"t":"مادرم معلم است.","pr":"Mâdaram mo'allem ast.","s":"Annem öğretmen.","a":"audio/fa-tr/7e7d5115d910.mp3"},"img":"img/e/1f469.svg","a":"audio/fa-tr/b143b250ff0f.mp3","pla":"audio/fa-tr/b532370b0d3f.mp3"},{"id":"w03","t":"پدر","pl":"پدرها","pr":"pedar","s":"baba","emoji":"👨","ex":{"t":"پدرم دکتر است.","pr":"Pedaram doktor ast.","s":"Babam doktor.","a":"audio/fa-tr/8dece9c66532.mp3"},"img":"img/e/1f468.svg","a":"audio/fa-tr/ecb21895307d.mp3","pla":"audio/fa-tr/4006f4e0bd1d.mp3"},{"id":"w04","t":"برادر","pl":"برادرها","pr":"barâdar","s":"erkek kardeş, ağabey","emoji":"👦","ex":{"t":"من یک برادر دارم.","pr":"Man yek barâdar dâram.","s":"Bir erkek kardeşim var.","a":"audio/fa-tr/32b555f2a441.mp3"},"img":"img/e/1f466.svg","a":"audio/fa-tr/6df2a70fca82.mp3","pla":"audio/fa-tr/126a0c607dac.mp3"},{"id":"w05","t":"خواهر","pl":"خواهرها","pr":"xâhar","s":"kız kardeş, abla","emoji":"👧","ex":{"t":"خواهرم دانشجو است.","pr":"Xâharam dâneşcu ast.","s":"Kız kardeşim öğrenci.","a":"audio/fa-tr/efb36a76a511.mp3"},"img":"img/e/1f467.svg","a":"audio/fa-tr/5c105471334f.mp3","pla":"audio/fa-tr/c56bd524c35b.mp3"},{"id":"w06","t":"پسر","pl":"پسرها","pr":"pesar","s":"oğul; erkek çocuk","emoji":"","ex":{"t":"آن‌ها یک پسر دارند.","pr":"Ânhâ yek pesar dârand.","s":"Onların bir oğlu var.","a":"audio/fa-tr/fee3273401a6.mp3"},"img":null,"a":"audio/fa-tr/4a706706becc.mp3","pla":"audio/fa-tr/db31a14e8600.mp3"},{"id":"w07","t":"دختر","pl":"دخترها","pr":"doxtar","s":"kız; kız evlat","emoji":"","ex":{"t":"دختر من هشت سال دارد.","pr":"Doxtar-e man haşt sâl dârad.","s":"Kızım sekiz yaşında.","a":"audio/fa-tr/3cbcbedaa81a.mp3"},"img":null,"a":"audio/fa-tr/7f2643bdb2e1.mp3","pla":"audio/fa-tr/512757689df1.mp3"},{"id":"w08","t":"بچه","pl":"بچه‌ها","pr":"baççe","s":"çocuk","emoji":"🧒","ex":{"t":"آن‌ها دو بچه دارند.","pr":"Ânhâ do baççe dârand.","s":"Onların iki çocuğu var.","a":"audio/fa-tr/37d91ee5ba54.mp3"},"img":"img/e/1f9d2.svg","a":"audio/fa-tr/718702acea77.mp3","pla":"audio/fa-tr/57f12bd5c520.mp3"},{"id":"w09","t":"پدربزرگ","pr":"pedarbozorg","s":"dede, büyükbaba","emoji":"👴","ex":{"t":"پدربزرگم اهل تبریز است.","pr":"Pedarbozorgam ahl-e Tabriz ast.","s":"Dedem Tebrizli.","a":"audio/fa-tr/c4d0e571e1b1.mp3"},"img":"img/e/1f474.svg","a":"audio/fa-tr/b79440084d55.mp3"},{"id":"w10","t":"مادربزرگ","pr":"mâdarbozorg","s":"nine, büyükanne","emoji":"👵","ex":{"t":"مادربزرگم خیلی مهربان است.","pr":"Mâdarbozorgam xeyli mehrabân ast.","s":"Ninem çok sevecen.","a":"audio/fa-tr/b90180937c3e.mp3"},"img":"img/e/1f475.svg","a":"audio/fa-tr/fdfdb982deea.mp3"},{"id":"w11","t":"همسر","pr":"hamsar","s":"eş","emoji":"💑","ex":{"t":"همسرم ترک است.","pr":"Hamsaram Tork ast.","s":"Eşim Türk.","a":"audio/fa-tr/1c9030d1d797.mp3"},"img":"img/e/1f491.svg","a":"audio/fa-tr/999749813049.mp3"},{"id":"w12","t":"بزرگ","pr":"bozorg","s":"büyük","emoji":"","ex":{"t":"خانه‌ی ما بزرگ است.","pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","a":"audio/fa-tr/87ba30615dc2.mp3"},"img":null,"a":"audio/fa-tr/e445a4b8ec0e.mp3"},{"id":"w13","t":"کوچک","pr":"kuçak","s":"küçük","emoji":"","ex":{"t":"برادرم کوچک است.","pr":"Barâdaram kuçak ast.","s":"Erkek kardeşim küçük.","a":"audio/fa-tr/40b544cb7f6e.mp3"},"img":null,"a":"audio/fa-tr/404973697324.mp3"},{"id":"w14","t":"مهربان","pr":"mehrabân","s":"sevecen, iyi kalpli","emoji":"","ex":{"t":"پدرم مهربان است.","pr":"Pedaram mehrabân ast.","s":"Babam sevecen biri.","a":"audio/fa-tr/1edd39402f8e.mp3"},"img":null,"a":"audio/fa-tr/a4cf61e57d54.mp3"}],"phrases":[{"id":"p01","t":"این مادر من است.","pr":"İn mâdar-e man ast.","s":"Bu benim annem.","a":"audio/fa-tr/03f82d3b7db1.mp3"},{"id":"p02","t":"خواهر یا برادر دارید؟","pr":"Xâhar yâ barâdar dârid?","s":"Kardeşiniz var mı?","a":"audio/fa-tr/36fe6c87e5bb.mp3"},{"id":"p03","t":"بله، یک خواهر دارم.","pr":"Bale, yek xâhar dâram.","s":"Evet, bir kız kardeşim var.","a":"audio/fa-tr/2d42284e7827.mp3"},{"id":"p04","t":"نه، ندارم.","pr":"Na, nadâram.","s":"Hayır, yok.","a":"audio/fa-tr/a8abdcc0e8dd.mp3"},{"id":"p05","t":"اسم پدرت چیست؟","pr":"Esm-e pedarat çist?","s":"Babanın adı ne?","a":"audio/fa-tr/d4cd05ec9edb.mp3"},{"id":"p06","t":"چه خانواده‌ی خوبی!","pr":"Çe xânevâde-ye xubi!","s":"Ne güzel bir aile!","a":"audio/fa-tr/7cf3b62da38b.mp3"}],"dialogue":{"title":{"t":"عکس خانواده","pr":"Aks-e xânevâde","s":"Aile fotoğrafı","a":"audio/fa-tr/544a8c831198.mp3"},"speakers":{"A":{"name":"Ayşe","voice":"f"},"B":{"name":"Amir","voice":"m"}},"lines":[{"sp":"A","t":"امیر، این عکس خانواده‌ی توست؟","pr":"Amir, in aks-e xânevâde-ye tost?","s":"Amir, bu senin ailenin fotoğrafı mı?","a":"audio/fa-tr/9d2510c662bf.mp3"},{"sp":"B","t":"بله. این پدرم است و این هم مادرم.","pr":"Bale. İn pedaram ast va in ham mâdaram.","s":"Evet. Bu babam, bu da annem.","a":"audio/fa-tr/41cccbdfa3b5.mp3"},{"sp":"A","t":"مادرت خیلی جوان است!","pr":"Mâdarat xeyli cavân ast!","s":"Annen çok genç!","a":"audio/fa-tr/6755f48231af.mp3"},{"sp":"B","t":"بله! این هم خواهرم، ندا. او دانشجو است.","pr":"Bale! İn ham xâharam, Nedâ. U dâneşcu ast.","s":"Evet! Bu da kız kardeşim Neda. O öğrenci.","a":"audio/fa-tr/33391e216cbb.mp3"},{"sp":"A","t":"برادر هم داری؟","pr":"Barâdar ham dâri?","s":"Erkek kardeşin de var mı?","a":"audio/fa-tr/85e629c43420.mp3"},{"sp":"B","t":"بله، یک برادر کوچک دارم. اسمش رضا است.","pr":"Bale, yek barâdar-e kuçak dâram. Esmaş Rezâ ast.","s":"Evet, küçük bir erkek kardeşim var. Adı Reza.","a":"audio/fa-tr/9b7e44cc0f14.mp3"},{"sp":"A","t":"رضا چند سال دارد؟","pr":"Rezâ çand sâl dârad?","s":"Reza kaç yaşında?","a":"audio/fa-tr/9c1a41c00b5b.mp3"},{"sp":"B","t":"ده سال دارد. تو خواهر و برادر داری؟","pr":"Dah sâl dârad. To xâhar va barâdar dâri?","s":"On yaşında. Senin kardeşlerin var mı?","a":"audio/fa-tr/16e15b649320.mp3"},{"sp":"A","t":"نه، ندارم. ولی یک خانواده‌ی بزرگ دارم!","pr":"Na, nadâram. Vali yek xânevâde-ye bozorg dâram!","s":"Hayır, yok. Ama kalabalık bir ailem var!","a":"audio/fa-tr/7443c4678264.mp3"}]},"grammar":[{"id":"g01","title":{"t":"مادر من، خانه‌ی بزرگ","pr":"mâdar-e man, xâne-ye bozorg","s":"Ezafe: -e bağı"},"explain":"Farsçada iki ismi ya da bir isimle sıfatı bağlamak için araya **-e** sesi girer. Buna **ezafe** denir. Türkçedeki **izafet** kelimesiyle aynı kökten (Arapça 'ekleme') gelir! Osmanlıcadaki **Bâb-ı Âli** gibi tamlamaları hatırlayın: bu aslında Farsça ezafedir.\nSıra Türkçenin **tersidir**: önce sahip olunan şey, sonra sahibi: **ketâb-e man** = benim kitabım, **mâdar-e Ali** = Ali'nin annesi.\nSıfat da ismin **arkasından** gelir: **xâne-ye bozorg** = büyük ev.\nEzafe genelde **yazılmaz**, sadece söylenir! Kelime **â** ya da **u** ile bitiyorsa **-ye** olur ve **ی** yazılır: **دانشجوی ایرانی** (dâneşcu-ye İrâni). Sessiz **ه** ile bitiyorsa **ـه‌ی** yazılır: **خانه‌ی من** (xâne-ye man).","table":[["کتاب من","ketâb-e man","benim kitabım"],["مادر علی","mâdar-e Ali","Ali'nin annesi"],["خانه‌ی بزرگ","xâne-ye bozorg","büyük ev"],["دانشجوی ایرانی","dâneşcu-ye İrâni","İranlı öğrenci"],["برادر کوچک من","barâdar-e kuçak-e man","benim küçük kardeşim"]],"examples":[{"t":"این کتاب من است.","pr":"İn ketâb-e man ast.","s":"Bu benim kitabım.","a":"audio/fa-tr/2b03bb3b4608.mp3"},{"t":"مادر علی معلم است.","pr":"Mâdar-e Ali mo'allem ast.","s":"Ali'nin annesi öğretmen.","a":"audio/fa-tr/1c9b9c9f9e69.mp3"},{"t":"خانه‌ی ما بزرگ است.","pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","a":"audio/fa-tr/87ba30615dc2.mp3"},{"t":"او یک دانشجوی ترک است.","pr":"U yek dâneşcu-ye Tork ast.","s":"O, Türk bir öğrenci.","a":"audio/fa-tr/5f916c137b84.mp3"}],"exercises":[{"type":"choice","t":"این ___ است.","options":["من کتاب","کتاب من","کتاب‌ها من"],"answer":1,"pr":"İn ketâb-e man ast.","s":"Bu benim kitabım.","full":"این کتاب من است.","a":"audio/fa-tr/2b03bb3b4608.mp3"},{"type":"choice","t":"او یک ___ است.","options":["دانشجوی ایرانی","ایرانی دانشجو","دانشجو ایرانی‌ها"],"answer":0,"pr":"U yek dâneşcu-ye İrâni ast.","s":"O, İranlı bir öğrenci.","full":"او یک دانشجوی ایرانی است.","a":"audio/fa-tr/472a4042e299.mp3"},{"type":"choice","t":"___ علی دکتر است.","options":["پدرها","پدر","است"],"answer":1,"pr":"Pedar-e Ali doktor ast.","s":"Ali'nin babası doktor.","full":"پدر علی دکتر است.","a":"audio/fa-tr/fb93ce04798a.mp3"},{"type":"type","t":"خانه‌ی ___ بزرگ است.","answer":["ما"],"pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","full":"خانه‌ی ما بزرگ است.","a":"audio/fa-tr/87ba30615dc2.mp3"},{"type":"type","t":"برادر ___ کوچک است.","answer":["من"],"pr":"Barâdar-e man kuçak ast.","s":"Benim kardeşim küçük.","full":"برادر من کوچک است.","a":"audio/fa-tr/390b737db07c.mp3"},{"type":"order","t":"این خانه‌ی بزرگ من است.","pr":"İn xâne-ye bozorg-e man ast.","s":"Bu benim büyük evim.","full":"این خانه‌ی بزرگ من است.","a":"audio/fa-tr/856be5a7b383.mp3"},{"type":"order","t":"مادر مریم معلم است.","pr":"Mâdar-e Maryam mo'allem ast.","s":"Maryam'ın annesi öğretmen.","full":"مادر مریم معلم است.","a":"audio/fa-tr/8d3f7cba5dee.mp3"}]},{"id":"g02","title":{"t":"مادرم، خواهر دارم","pr":"mâdaram, xâhar dâram","s":"İyelik ekleri ve «dâştan» (sahip olmak)"},"explain":"Türkçedeki gibi Farsçada da iyelik bir **ek** ile söylenebilir: **-am** (benim), **-at** (senin), **-aş** (onun), **-emân** (bizim), **-etân** (sizin), **-eşân** (onların).\n**mâdar → mâdaram** (annem), **mâdarat** (annen), **mâdaraş** (annesi). Ünlü uyumu yok, ekler hep aynı! **Mâdaram** ile **mâdar-e man** aynı anlamdadır.\nTürkçe '…im **var**' der; Farsça ise **dâştan** (sahip olmak) fiilini kullanır: **Yek xâhar dâram.** = Bir kız kardeşim var. Kişi ekleri tanıdık: **dâram, dâri, dârad, dârim, dârid, dârand**.\nOlumsuz için başa **na-** gelir: **nadâram** = (bende) yok. **Barâdar nadâram.** = Erkek kardeşim yok.","table":[["مادرم","mâdaram","annem"],["مادرت","mâdarat","annen"],["مادرش","mâdaraş","annesi"],["مادرمان","mâdaremân","annemiz"],["مادرتان","mâdaretân","anneniz"],["مادرشان","mâdareşân","anneleri"]],"examples":[{"t":"مادرم معلم است.","pr":"Mâdaram mo'allem ast.","s":"Annem öğretmen.","a":"audio/fa-tr/7e7d5115d910.mp3"},{"t":"اسمت چیست؟","pr":"Esmat çist?","s":"Adın ne?","a":"audio/fa-tr/332f05184897.mp3"},{"t":"من دو برادر دارم.","pr":"Man do barâdar dâram.","s":"İki erkek kardeşim var.","a":"audio/fa-tr/d6dd02d33063.mp3"},{"t":"او بچه ندارد.","pr":"U baççe nadârad.","s":"Onun çocuğu yok.","a":"audio/fa-tr/685ba2f1bcae.mp3"},{"t":"خواهرش دانشجو است.","pr":"Xâharaş dâneşcu ast.","s":"Onun kız kardeşi öğrenci.","a":"audio/fa-tr/8af477d7d1f2.mp3"}],"exercises":[{"type":"choice","t":"من یک خواهر ___.","options":["دارم","داری","دارد"],"answer":0,"pr":"Man yek xâhar dâram.","s":"Bir kız kardeşim var.","full":"من یک خواهر دارم.","a":"audio/fa-tr/420359f9dc63.mp3"},{"type":"choice","t":"تو برادر ___؟","options":["دارند","داری","داریم"],"answer":1,"pr":"To barâdar dâri?","s":"Erkek kardeşin var mı?","full":"تو برادر داری؟","a":"audio/fa-tr/724d60b8f05a.mp3"},{"type":"choice","t":"من سارا هستم. اسم___ سارا است.","options":["ت","ش","م"],"answer":2,"pr":"Man Sârâ hastam. Esmam Sârâ ast.","s":"Ben Sara'yım. Adım Sara.","full":"من سارا هستم. اسمم سارا است.","a":"audio/fa-tr/867a221e6849.mp3"},{"type":"type","t":"پدر___ دکتر است.","answer":["ش"],"pr":"Pedaraş doktor ast.","s":"Babası doktor.","full":"پدرش دکتر است.","a":"audio/fa-tr/8a48c7efbb4f.mp3"},{"type":"type","t":"ما دو بچه ___.","answer":["داریم"],"pr":"Mâ do baççe dârim.","s":"İki çocuğumuz var.","full":"ما دو بچه داریم.","a":"audio/fa-tr/c3eec10f1d26.mp3"},{"type":"choice","t":"نه، من برادر ___.","options":["ندارم","ندارد","نداری"],"answer":0,"pr":"Na, man barâdar nadâram.","s":"Hayır, erkek kardeşim yok.","full":"نه، من برادر ندارم.","a":"audio/fa-tr/541908e69b60.mp3"},{"type":"order","t":"آن‌ها یک دختر دارند.","pr":"Ânhâ yek doxtar dârand.","s":"Onların bir kızı var.","full":"آن‌ها یک دختر دارند.","a":"audio/fa-tr/43e0513da9bf.mp3"},{"type":"order","t":"اسم خواهرم ندا است.","pr":"Esm-e xâharam Nedâ ast.","s":"Kız kardeşimin adı Neda.","full":"اسم خواهرم ندا است.","a":"audio/fa-tr/8ef5aaf50343.mp3"}]}],"reading":{"title":{"t":"خانواده‌ی مریم","pr":"Xânevâde-ye Maryam","s":"Maryam'ın ailesi","a":"audio/fa-tr/72044ab48b7a.mp3"},"text":[{"t":"سلام! من مریم هستم.","pr":"Salâm! Man Maryam hastam.","s":"Merhaba! Ben Maryam.","a":"audio/fa-tr/c5a0c23206db.mp3"},{"t":"خانواده‌ی من بزرگ است.","pr":"Xânevâde-ye man bozorg ast.","s":"Ailem kalabalık.","a":"audio/fa-tr/b4faf495511b.mp3"},{"t":"پدرم دکتر است و مادرم معلم است.","pr":"Pedaram doktor ast va mâdaram mo'allem ast.","s":"Babam doktor, annem öğretmen.","a":"audio/fa-tr/b9f801e0e6f2.mp3"},{"t":"من دو برادر و یک خواهر دارم.","pr":"Man do barâdar va yek xâhar dâram.","s":"İki erkek kardeşim ve bir kız kardeşim var.","a":"audio/fa-tr/a9b921f02a15.mp3"},{"t":"خواهرم سارا دانشجو است.","pr":"Xâharam Sârâ dâneşcu ast.","s":"Kız kardeşim Sara öğrenci.","a":"audio/fa-tr/e822e5d20d6d.mp3"},{"t":"برادرهایم کوچک هستند.","pr":"Barâdarhâyam kuçak hastand.","s":"Erkek kardeşlerim küçük.","a":"audio/fa-tr/19f01f2c800e.mp3"},{"t":"علی هشت سال دارد و رضا شش سال دارد.","pr":"Ali haşt sâl dârad va Rezâ şeş sâl dârad.","s":"Ali sekiz yaşında, Reza altı yaşında.","a":"audio/fa-tr/89018a0a10ff.mp3"},{"t":"مادربزرگم خیلی مهربان است.","pr":"Mâdarbozorgam xeyli mehrabân ast.","s":"Ninem çok sevecen.","a":"audio/fa-tr/b90180937c3e.mp3"}],"questions":[{"q":{"t":"پدر مریم چه‌کاره است؟","pr":"Pedar-e Maryam çekâre ast?","s":"Maryam'ın babası ne iş yapıyor?","a":"audio/fa-tr/a5549014828c.mp3"},"options":["دکتر","معلم","دانشجو"],"answer":0},{"q":{"t":"مریم چند برادر دارد؟","pr":"Maryam çand barâdar dârad?","s":"Maryam'ın kaç erkek kardeşi var?","a":"audio/fa-tr/3cbf1ae7e4dd.mp3"},"options":["یک","دو","سه"],"answer":1},{"q":{"t":"اسم خواهر مریم چیست؟","pr":"Esm-e xâhar-e Maryam çist?","s":"Maryam'ın kız kardeşinin adı ne?","a":"audio/fa-tr/7cd3b222fb9c.mp3"},"options":["ندا","سارا","آیشه"],"answer":1},{"q":{"t":"رضا چند سال دارد؟","pr":"Rezâ çand sâl dârad?","s":"Reza kaç yaşında?","a":"audio/fa-tr/9c1a41c00b5b.mp3"},"options":["هشت","شش","ده"],"answer":1}]},"sentences":[{"t":"این مادر من است.","pr":"İn mâdar-e man ast.","s":"Bu benim annem.","a":"audio/fa-tr/03f82d3b7db1.mp3"},{"t":"من یک برادر دارم.","pr":"Man yek barâdar dâram.","s":"Bir erkek kardeşim var.","a":"audio/fa-tr/32b555f2a441.mp3"},{"t":"خواهرم دانشجو است.","pr":"Xâharam dâneşcu ast.","s":"Kız kardeşim öğrenci.","a":"audio/fa-tr/efb36a76a511.mp3"},{"t":"اسم پدرت چیست؟","pr":"Esm-e pedarat çist?","s":"Babanın adı ne?","a":"audio/fa-tr/d4cd05ec9edb.mp3"},{"t":"خانه‌ی ما بزرگ است.","pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","a":"audio/fa-tr/87ba30615dc2.mp3"},{"t":"آن‌ها دو بچه دارند.","pr":"Ânhâ do baççe dârand.","s":"Onların iki çocuğu var.","a":"audio/fa-tr/37d91ee5ba54.mp3"},{"t":"نه، من خواهر ندارم.","pr":"Na, man xâhar nadâram.","s":"Hayır, kız kardeşim yok.","a":"audio/fa-tr/86bae3b3c9ad.mp3"},{"t":"پدربزرگم اهل تبریز است.","pr":"Pedarbozorgam ahl-e Tabriz ast.","s":"Dedem Tebrizli.","a":"audio/fa-tr/c4d0e571e1b1.mp3"}],"img":"img/e/1f46a.svg"}