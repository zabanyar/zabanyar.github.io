{"id":"u03","level":"A1","emoji":"👪","title":{"t":"خانواده‌ی من","pr":"Xânevâde-ye man","s":"Ailem","a":"audio/fa-tr/6b91b85ddeab.mp3"},"goals":["Aile üyelerini Farsça söyleyebilmek.","Ezafe (-e) ile «Ali'nin annesi, büyük ev» diyebilmek.","İyelik eklerini (-am, -at, -aş) kullanabilmek.","«dâştan» (sahip olmak) fiiliyle «…im var / yok» diyebilmek."],"words":[{"id":"w01","t":"خانواده","pl":"خانواده‌ها","pr":"xânevâde","s":"aile","emoji":"👪","ex":{"t":"خانواده‌ی من بزرگ است.","pr":"Xânevâde-ye man bozorg ast.","s":"Ailem kalabalık.","a":"audio/fa-tr/6a24ba76f68e.mp3"},"img":"img/e/1f46a.svg","a":"audio/fa-tr/e3959e187fe4.mp3","pla":"audio/fa-tr/8f4681a37a5f.mp3"},{"id":"w02","t":"مادر","pl":"مادرها","pr":"mâdar","s":"anne","emoji":"👩","ex":{"t":"مادرم معلم است.","pr":"Mâdaram mo'allem ast.","s":"Annem öğretmen.","a":"audio/fa-tr/230e47af4132.mp3"},"img":"img/e/1f469.svg","a":"audio/fa-tr/ee10e72eeeae.mp3","pla":"audio/fa-tr/ee08012c2f7a.mp3"},{"id":"w03","t":"پدر","pl":"پدرها","pr":"pedar","s":"baba","emoji":"👨","ex":{"t":"پدرم دکتر است.","pr":"Pedaram doktor ast.","s":"Babam doktor.","a":"audio/fa-tr/5d8a74c2aded.mp3"},"img":"img/e/1f468.svg","a":"audio/fa-tr/2ac031665ac8.mp3","pla":"audio/fa-tr/c2e4b27821ee.mp3"},{"id":"w04","t":"برادر","pl":"برادرها","pr":"barâdar","s":"erkek kardeş, ağabey","emoji":"👦","ex":{"t":"من یک برادر دارم.","pr":"Man yek barâdar dâram.","s":"Bir erkek kardeşim var.","a":"audio/fa-tr/c961a4def266.mp3"},"img":"img/e/1f466.svg","a":"audio/fa-tr/4280639dcc8e.mp3","pla":"audio/fa-tr/582f12e173f9.mp3"},{"id":"w05","t":"خواهر","pl":"خواهرها","pr":"xâhar","s":"kız kardeş, abla","emoji":"👧","ex":{"t":"خواهرم دانشجو است.","pr":"Xâharam dâneşcu ast.","s":"Kız kardeşim öğrenci.","a":"audio/fa-tr/2fc78c175555.mp3"},"img":"img/e/1f467.svg","a":"audio/fa-tr/5aca133dccb1.mp3","pla":"audio/fa-tr/beb8464a82b1.mp3"},{"id":"w06","t":"پسر","pl":"پسرها","pr":"pesar","s":"oğul; erkek çocuk","emoji":"","ex":{"t":"آن‌ها یک پسر دارند.","pr":"Ânhâ yek pesar dârand.","s":"Onların bir oğlu var.","a":"audio/fa-tr/31ce0971be6c.mp3"},"img":null,"a":"audio/fa-tr/2b1bfd10b5cb.mp3","pla":"audio/fa-tr/0bb77932f557.mp3"},{"id":"w07","t":"دختر","pl":"دخترها","pr":"doxtar","s":"kız; kız evlat","emoji":"","ex":{"t":"دختر من هشت سال دارد.","pr":"Doxtar-e man haşt sâl dârad.","s":"Kızım sekiz yaşında.","a":"audio/fa-tr/03836276bf31.mp3"},"img":null,"a":"audio/fa-tr/88f330c32f50.mp3","pla":"audio/fa-tr/9d527a6e0d45.mp3"},{"id":"w08","t":"بچه","pl":"بچه‌ها","pr":"baççe","s":"çocuk","emoji":"🧒","ex":{"t":"آن‌ها دو بچه دارند.","pr":"Ânhâ do baççe dârand.","s":"Onların iki çocuğu var.","a":"audio/fa-tr/1044eb4bf350.mp3"},"img":"img/e/1f9d2.svg","a":"audio/fa-tr/b75ba8def8a5.mp3","pla":"audio/fa-tr/4f569f9c93eb.mp3"},{"id":"w09","t":"پدربزرگ","pr":"pedarbozorg","s":"dede, büyükbaba","emoji":"👴","ex":{"t":"پدربزرگم اهل تبریز است.","pr":"Pedarbozorgam ahl-e Tabriz ast.","s":"Dedem Tebrizli.","a":"audio/fa-tr/e51596398014.mp3"},"img":"img/e/1f474.svg","a":"audio/fa-tr/d92e83bbdc45.mp3"},{"id":"w10","t":"مادربزرگ","pr":"mâdarbozorg","s":"nine, büyükanne","emoji":"👵","ex":{"t":"مادربزرگم خیلی مهربان است.","pr":"Mâdarbozorgam xeyli mehrabân ast.","s":"Ninem çok sevecen.","a":"audio/fa-tr/3177e44f5b69.mp3"},"img":"img/e/1f475.svg","a":"audio/fa-tr/f4efe16ddbb7.mp3"},{"id":"w11","t":"همسر","pr":"hamsar","s":"eş","emoji":"💑","ex":{"t":"همسرم ترک است.","pr":"Hamsaram Tork ast.","s":"Eşim Türk.","a":"audio/fa-tr/8e334b54b2c2.mp3"},"img":"img/e/1f491.svg","a":"audio/fa-tr/fb3a88067754.mp3"},{"id":"w12","t":"بزرگ","pr":"bozorg","s":"büyük","emoji":"","ex":{"t":"خانه‌ی ما بزرگ است.","pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","a":"audio/fa-tr/1c014ea9822b.mp3"},"img":null,"a":"audio/fa-tr/4f9e32f608dc.mp3"},{"id":"w13","t":"کوچک","pr":"kuçak","s":"küçük","emoji":"","ex":{"t":"برادرم کوچک است.","pr":"Barâdaram kuçak ast.","s":"Erkek kardeşim küçük.","a":"audio/fa-tr/71756dc173eb.mp3"},"img":null,"a":"audio/fa-tr/6a31c51e66cc.mp3"},{"id":"w14","t":"مهربان","pr":"mehrabân","s":"sevecen, iyi kalpli","emoji":"","ex":{"t":"پدرم مهربان است.","pr":"Pedaram mehrabân ast.","s":"Babam sevecen biri.","a":"audio/fa-tr/4e426e2ce9b2.mp3"},"img":null,"a":"audio/fa-tr/2972eb434e8f.mp3"}],"phrases":[{"id":"p01","t":"این مادر من است.","pr":"İn mâdar-e man ast.","s":"Bu benim annem.","a":"audio/fa-tr/f75696e744c2.mp3"},{"id":"p02","t":"خواهر یا برادر دارید؟","pr":"Xâhar yâ barâdar dârid?","s":"Kardeşiniz var mı?","a":"audio/fa-tr/ff8ba0aed1bc.mp3"},{"id":"p03","t":"بله، یک خواهر دارم.","pr":"Bale, yek xâhar dâram.","s":"Evet, bir kız kardeşim var.","a":"audio/fa-tr/8ca833ad8f39.mp3"},{"id":"p04","t":"نه، ندارم.","pr":"Na, nadâram.","s":"Hayır, yok.","a":"audio/fa-tr/fc06994b6560.mp3"},{"id":"p05","t":"اسم پدرت چیست؟","pr":"Esm-e pedarat çist?","s":"Babanın adı ne?","a":"audio/fa-tr/28d1425c3836.mp3"},{"id":"p06","t":"چه خانواده‌ی خوبی!","pr":"Çe xânevâde-ye xubi!","s":"Ne güzel bir aile!","a":"audio/fa-tr/55d0f3de2e95.mp3"}],"dialogue":{"title":{"t":"عکس خانواده","pr":"Aks-e xânevâde","s":"Aile fotoğrafı","a":"audio/fa-tr/ab767683368d.mp3"},"speakers":{"A":{"name":"Ayşe","voice":"f"},"B":{"name":"Amir","voice":"m"}},"lines":[{"sp":"A","t":"امیر، این عکس خانواده‌ی توست؟","pr":"Amir, in aks-e xânevâde-ye tost?","s":"Amir, bu senin ailenin fotoğrafı mı?","a":"audio/fa-tr/72fbd69b6ce7.mp3"},{"sp":"B","t":"بله. این پدرم است و این هم مادرم.","pr":"Bale. İn pedaram ast va in ham mâdaram.","s":"Evet. Bu babam, bu da annem.","a":"audio/fa-tr/2ae4a674e7fd.mp3"},{"sp":"A","t":"مادرت خیلی جوان است!","pr":"Mâdarat xeyli cavân ast!","s":"Annen çok genç!","a":"audio/fa-tr/2ce81f6073c5.mp3"},{"sp":"B","t":"بله! این هم خواهرم، ندا. او دانشجو است.","pr":"Bale! İn ham xâharam, Nedâ. U dâneşcu ast.","s":"Evet! Bu da kız kardeşim Neda. O öğrenci.","a":"audio/fa-tr/0072ad105152.mp3"},{"sp":"A","t":"برادر هم داری؟","pr":"Barâdar ham dâri?","s":"Erkek kardeşin de var mı?","a":"audio/fa-tr/614de4ae1d04.mp3"},{"sp":"B","t":"بله، یک برادر کوچک دارم. اسمش رضا است.","pr":"Bale, yek barâdar-e kuçak dâram. Esmaş Rezâ ast.","s":"Evet, küçük bir erkek kardeşim var. Adı Reza.","a":"audio/fa-tr/cb4659942ee8.mp3"},{"sp":"A","t":"رضا چند سال دارد؟","pr":"Rezâ çand sâl dârad?","s":"Reza kaç yaşında?","a":"audio/fa-tr/1f362affa21a.mp3"},{"sp":"B","t":"ده سال دارد. تو خواهر و برادر داری؟","pr":"Dah sâl dârad. To xâhar va barâdar dâri?","s":"On yaşında. Senin kardeşlerin var mı?","a":"audio/fa-tr/282a0f3852bb.mp3"},{"sp":"A","t":"نه، ندارم. ولی یک خانواده‌ی بزرگ دارم!","pr":"Na, nadâram. Vali yek xânevâde-ye bozorg dâram!","s":"Hayır, yok. Ama kalabalık bir ailem var!","a":"audio/fa-tr/15ebcb3b491a.mp3"}]},"grammar":[{"id":"g01","title":{"t":"مادر من، خانه‌ی بزرگ","pr":"mâdar-e man, xâne-ye bozorg","s":"Ezafe: -e bağı"},"explain":"Farsçada iki ismi ya da bir isimle sıfatı bağlamak için araya **-e** sesi girer. Buna **ezafe** denir. Türkçedeki **izafet** kelimesiyle aynı kökten (Arapça 'ekleme') gelir! Osmanlıcadaki **Bâb-ı Âli** gibi tamlamaları hatırlayın: bu aslında Farsça ezafedir.\nSıra Türkçenin **tersidir**: önce sahip olunan şey, sonra sahibi: **ketâb-e man** = benim kitabım, **mâdar-e Ali** = Ali'nin annesi.\nSıfat da ismin **arkasından** gelir: **xâne-ye bozorg** = büyük ev.\nEzafe genelde **yazılmaz**, sadece söylenir! Kelime **â** ya da **u** ile bitiyorsa **-ye** olur ve **ی** yazılır: **دانشجوی ایرانی** (dâneşcu-ye İrâni). Sessiz **ه** ile bitiyorsa **ـه‌ی** yazılır: **خانه‌ی من** (xâne-ye man).","table":[["کتاب من","ketâb-e man","benim kitabım"],["مادر علی","mâdar-e Ali","Ali'nin annesi"],["خانه‌ی بزرگ","xâne-ye bozorg","büyük ev"],["دانشجوی ایرانی","dâneşcu-ye İrâni","İranlı öğrenci"],["برادر کوچک من","barâdar-e kuçak-e man","benim küçük kardeşim"]],"examples":[{"t":"این کتاب من است.","pr":"İn ketâb-e man ast.","s":"Bu benim kitabım.","a":"audio/fa-tr/bc634fc6bdd1.mp3"},{"t":"مادر علی معلم است.","pr":"Mâdar-e Ali mo'allem ast.","s":"Ali'nin annesi öğretmen.","a":"audio/fa-tr/b9a0a8115936.mp3"},{"t":"خانه‌ی ما بزرگ است.","pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","a":"audio/fa-tr/1c014ea9822b.mp3"},{"t":"او یک دانشجوی ترک است.","pr":"U yek dâneşcu-ye Tork ast.","s":"O, Türk bir öğrenci.","a":"audio/fa-tr/2fdde1b81b6f.mp3"}],"exercises":[{"type":"choice","t":"این ___ است.","options":["من کتاب","کتاب من","کتاب‌ها من"],"answer":1,"pr":"İn ketâb-e man ast.","s":"Bu benim kitabım.","full":"این کتاب من است.","a":"audio/fa-tr/bc634fc6bdd1.mp3"},{"type":"choice","t":"او یک ___ است.","options":["دانشجوی ایرانی","ایرانی دانشجو","دانشجو ایرانی‌ها"],"answer":0,"pr":"U yek dâneşcu-ye İrâni ast.","s":"O, İranlı bir öğrenci.","full":"او یک دانشجوی ایرانی است.","a":"audio/fa-tr/7975c3c53e85.mp3"},{"type":"choice","t":"___ علی دکتر است.","options":["پدرها","پدر","است"],"answer":1,"pr":"Pedar-e Ali doktor ast.","s":"Ali'nin babası doktor.","full":"پدر علی دکتر است.","a":"audio/fa-tr/fc5dd2d6b2a7.mp3"},{"type":"type","t":"خانه‌ی ___ بزرگ است.","answer":["ما"],"pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","full":"خانه‌ی ما بزرگ است.","a":"audio/fa-tr/1c014ea9822b.mp3"},{"type":"type","t":"برادر ___ کوچک است.","answer":["من"],"pr":"Barâdar-e man kuçak ast.","s":"Benim kardeşim küçük.","full":"برادر من کوچک است.","a":"audio/fa-tr/bd79d5dd5e72.mp3"},{"type":"order","t":"این خانه‌ی بزرگ من است.","pr":"İn xâne-ye bozorg-e man ast.","s":"Bu benim büyük evim.","alts":["این خانه‌ی من بزرگ است."],"full":"این خانه‌ی بزرگ من است.","a":"audio/fa-tr/389d80bf75f4.mp3"},{"type":"order","t":"مادر مریم معلم است.","pr":"Mâdar-e Maryam mo'allem ast.","s":"Maryam'ın annesi öğretmen.","full":"مادر مریم معلم است.","a":"audio/fa-tr/f1fa7a29f8a7.mp3"}]},{"id":"g02","title":{"t":"مادرم، خواهر دارم","pr":"mâdaram, xâhar dâram","s":"İyelik ekleri ve «dâştan» (sahip olmak)"},"explain":"Türkçedeki gibi Farsçada da iyelik bir **ek** ile söylenebilir: **-am** (benim), **-at** (senin), **-aş** (onun), **-emân** (bizim), **-etân** (sizin), **-eşân** (onların).\n**mâdar → mâdaram** (annem), **mâdarat** (annen), **mâdaraş** (annesi). Ünlü uyumu yok, ekler hep aynı! **Mâdaram** ile **mâdar-e man** aynı anlamdadır.\nTürkçe '…im **var**' der; Farsça ise **dâştan** (sahip olmak) fiilini kullanır: **Yek xâhar dâram.** = Bir kız kardeşim var. Kişi ekleri tanıdık: **dâram, dâri, dârad, dârim, dârid, dârand**.\nOlumsuz için başa **na-** gelir: **nadâram** = (bende) yok. **Barâdar nadâram.** = Erkek kardeşim yok.","table":[["مادرم","mâdaram","annem"],["مادرت","mâdarat","annen"],["مادرش","mâdaraş","annesi"],["مادرمان","mâdaremân","annemiz"],["مادرتان","mâdaretân","anneniz"],["مادرشان","mâdareşân","anneleri"]],"examples":[{"t":"مادرم معلم است.","pr":"Mâdaram mo'allem ast.","s":"Annem öğretmen.","a":"audio/fa-tr/230e47af4132.mp3"},{"t":"اسمت چیست؟","pr":"Esmat çist?","s":"Adın ne?","a":"audio/fa-tr/fffdc6160563.mp3"},{"t":"من دو برادر دارم.","pr":"Man do barâdar dâram.","s":"İki erkek kardeşim var.","a":"audio/fa-tr/b38d2fb63676.mp3"},{"t":"او بچه ندارد.","pr":"U baççe nadârad.","s":"Onun çocuğu yok.","a":"audio/fa-tr/48bd9bdbbf51.mp3"},{"t":"خواهرش دانشجو است.","pr":"Xâharaş dâneşcu ast.","s":"Onun kız kardeşi öğrenci.","a":"audio/fa-tr/6e4fb6fe31ea.mp3"}],"exercises":[{"type":"choice","t":"من یک خواهر ___.","options":["دارم","داری","دارد"],"answer":0,"pr":"Man yek xâhar dâram.","s":"Bir kız kardeşim var.","full":"من یک خواهر دارم.","a":"audio/fa-tr/a3c4f4b42039.mp3"},{"type":"choice","t":"تو برادر ___؟","options":["دارند","داری","داریم"],"answer":1,"pr":"To barâdar dâri?","s":"Erkek kardeşin var mı?","full":"تو برادر داری؟","a":"audio/fa-tr/e72c676702b1.mp3"},{"type":"choice","t":"من سارا هستم. اسم___ سارا است.","options":["ت","ش","م"],"answer":2,"pr":"Man Sârâ hastam. Esmam Sârâ ast.","s":"Ben Sara'yım. Adım Sara.","full":"من سارا هستم. اسمم سارا است.","a":"audio/fa-tr/fef26fe37171.mp3"},{"type":"type","t":"پدر___ دکتر است.","answer":["ش"],"pr":"Pedaraş doktor ast.","s":"Babası doktor.","full":"پدرش دکتر است.","a":"audio/fa-tr/e6404911519d.mp3"},{"type":"type","t":"ما دو بچه ___.","answer":["داریم"],"pr":"Mâ do baççe dârim.","s":"İki çocuğumuz var.","full":"ما دو بچه داریم.","a":"audio/fa-tr/16247a16eb27.mp3"},{"type":"choice","t":"نه، من برادر ___.","options":["ندارم","ندارد","نداری"],"answer":0,"pr":"Na, man barâdar nadâram.","s":"Hayır, erkek kardeşim yok.","full":"نه، من برادر ندارم.","a":"audio/fa-tr/24d226e5c9a9.mp3"},{"type":"order","t":"آن‌ها یک دختر دارند.","pr":"Ânhâ yek doxtar dârand.","s":"Onların bir kızı var.","full":"آن‌ها یک دختر دارند.","a":"audio/fa-tr/e2c8a5657dc0.mp3"},{"type":"order","t":"اسم خواهرم ندا است.","pr":"Esm-e xâharam Nedâ ast.","s":"Kız kardeşimin adı Neda.","full":"اسم خواهرم ندا است.","a":"audio/fa-tr/70e8f013f3b8.mp3"}]}],"reading":{"title":{"t":"خانواده‌ی مریم","pr":"Xânevâde-ye Maryam","s":"Maryam'ın ailesi","a":"audio/fa-tr/89e376b5d7a4.mp3"},"text":[{"t":"سلام! من مریم هستم.","pr":"Salâm! Man Maryam hastam.","s":"Merhaba! Ben Maryam.","a":"audio/fa-tr/0d7e807eb91c.mp3"},{"t":"خانواده‌ی من بزرگ است.","pr":"Xânevâde-ye man bozorg ast.","s":"Ailem kalabalık.","a":"audio/fa-tr/6a24ba76f68e.mp3"},{"t":"پدرم دکتر است و مادرم معلم است.","pr":"Pedaram doktor ast va mâdaram mo'allem ast.","s":"Babam doktor, annem öğretmen.","a":"audio/fa-tr/0a3e6687795b.mp3"},{"t":"من دو برادر و یک خواهر دارم.","pr":"Man do barâdar va yek xâhar dâram.","s":"İki erkek kardeşim ve bir kız kardeşim var.","a":"audio/fa-tr/be92d11e2032.mp3"},{"t":"خواهرم سارا دانشجو است.","pr":"Xâharam Sârâ dâneşcu ast.","s":"Kız kardeşim Sara öğrenci.","a":"audio/fa-tr/bd881c8cc118.mp3"},{"t":"برادرهایم کوچک هستند.","pr":"Barâdarhâyam kuçak hastand.","s":"Erkek kardeşlerim küçük.","a":"audio/fa-tr/a99d85fd3cd2.mp3"},{"t":"علی هشت سال دارد و رضا شش سال دارد.","pr":"Ali haşt sâl dârad va Rezâ şeş sâl dârad.","s":"Ali sekiz yaşında, Reza altı yaşında.","a":"audio/fa-tr/df28eb161284.mp3"},{"t":"مادربزرگم خیلی مهربان است.","pr":"Mâdarbozorgam xeyli mehrabân ast.","s":"Ninem çok sevecen.","a":"audio/fa-tr/3177e44f5b69.mp3"}],"questions":[{"q":{"t":"پدر مریم چه‌کاره است؟","pr":"Pedar-e Maryam çekâre ast?","s":"Maryam'ın babası ne iş yapıyor?","a":"audio/fa-tr/692ecc85252e.mp3"},"options":["دکتر","معلم","دانشجو"],"answer":0},{"q":{"t":"مریم چند برادر دارد؟","pr":"Maryam çand barâdar dârad?","s":"Maryam'ın kaç erkek kardeşi var?","a":"audio/fa-tr/740cd5df3f82.mp3"},"options":["یک","دو","سه"],"answer":1},{"q":{"t":"اسم خواهر مریم چیست؟","pr":"Esm-e xâhar-e Maryam çist?","s":"Maryam'ın kız kardeşinin adı ne?","a":"audio/fa-tr/9d08fd788482.mp3"},"options":["ندا","سارا","آیشه"],"answer":1},{"q":{"t":"رضا چند سال دارد؟","pr":"Rezâ çand sâl dârad?","s":"Reza kaç yaşında?","a":"audio/fa-tr/713ab7357000.mp3"},"options":["هشت","شش","ده"],"answer":1}]},"sentences":[{"t":"این مادر من است.","pr":"İn mâdar-e man ast.","s":"Bu benim annem.","a":"audio/fa-tr/f75696e744c2.mp3"},{"t":"من یک برادر دارم.","pr":"Man yek barâdar dâram.","s":"Bir erkek kardeşim var.","a":"audio/fa-tr/c961a4def266.mp3"},{"t":"خواهرم دانشجو است.","pr":"Xâharam dâneşcu ast.","s":"Kız kardeşim öğrenci.","a":"audio/fa-tr/2fc78c175555.mp3"},{"t":"اسم پدرت چیست؟","pr":"Esm-e pedarat çist?","s":"Babanın adı ne?","a":"audio/fa-tr/28d1425c3836.mp3"},{"t":"خانه‌ی ما بزرگ است.","pr":"Xâne-ye mâ bozorg ast.","s":"Bizim evimiz büyük.","a":"audio/fa-tr/1c014ea9822b.mp3"},{"t":"آن‌ها دو بچه دارند.","pr":"Ânhâ do baççe dârand.","s":"Onların iki çocuğu var.","a":"audio/fa-tr/1044eb4bf350.mp3"},{"t":"نه، من خواهر ندارم.","pr":"Na, man xâhar nadâram.","s":"Hayır, kız kardeşim yok.","a":"audio/fa-tr/797ed19d1d4c.mp3"},{"t":"پدربزرگم اهل تبریز است.","pr":"Pedarbozorgam ahl-e Tabriz ast.","s":"Dedem Tebrizli.","a":"audio/fa-tr/e51596398014.mp3"}],"img":"img/e/1f46a.svg"}