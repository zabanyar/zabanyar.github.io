","pl":"میزها","pr":"miz","s":"masa","emoji":"","ex":{"t":"میز در آشپزخانه است.","pr":"Miz dar âşpazxâne ast.","s":"Masa mutfakta.","a":"audio/fa-tr/8cffef95d53e.mp3"},"img":null,"a":"audio/fa-tr/9d6361c7ee33.mp3","pla":"audio/fa-tr/c2b1a31af615.mp3"},{"id":"w08","t":"صندلی","pl":"صندلی‌ها","pr":"sandali","s":"sandalye","emoji":"🪑","ex":{"t":"گربه زیر صندلی است.","pr":"Gorbe zir-e sandali ast.","s":"Kedi sandalyenin altında.","a":"audio/fa-tr/2011d5410dcb.mp3"},"img":"img/e/1fa91.svg","a":"audio/fa-tr/7fe836dc2a0a.mp3","pla":"audio/fa-tr/e2a9b19f16fc.mp3"},{"id":"w09","t":"تخت","pr":"taxt","s":"yatak","emoji":"🛏️","ex":{"t":"تخت در اتاق من است.","pr":"Taxt dar otâğ-e man ast.","s":"Yatak benim odamda.","a":"audio/fa-tr/aabeece6b443.mp3"},"img":"img/e/1f6cf.svg","a":"audio/fa-tr/55f99dc3597f.mp3"},{"id":"w10","t":"گربه","pl":"گربه‌ها","pr":"gorbe","s":"kedi","emoji":"🐈","ex":{"t":"گربه کجاست؟","pr":"Gorbe kocâst?","s":"Kedi nerede?","a":"audio/fa-tr/08feba477043.mp3"},"img":"img/e/1f408.svg","a":"audio/fa-tr/b97655eb0abc.mp3","pla":"audio/fa-tr/965286b37fae.mp3"},{"id":"w11","t":"یخچال","pr":"yaxçâl","s":"buzdolabı","emoji":"","ex":{"t":"شیر در یخچال است.","pr":"Şir dar yaxçâl ast.","s":"Süt buzdolabında.","a":"audio/fa-tr/e57ae610fc88.mp3"},"img":null,"a":"audio/fa-tr/1bc9f8e49ccd.mp3"},{"id":"w12","t":"کلید","pr":"kelid","s":"anahtar","emoji":"🔑","ex":{"t":"کلید روی میز است.","pr":"Kelid ru-ye miz ast.","s":"Anahtar masanın üstünde.","a":"audio/fa-tr/aa43549b343a.mp3"},"img":"img/e/1f511.svg","a":"audio/fa-tr/d706a8089747.mp3"},{"id":"w13","t":"فرش","pr":"farş","s":"halı","emoji":"","ex":{"t":"فرش ما ایرانی است.","pr":"Farş-e mâ İrâni ast.","s":"Halımız İran halısı.","a":"audio/fa-tr/1ba8bfda772c.mp3"},"img":null,"a":"audio/fa-tr/c042672ad557.mp3"},{"id":"w14","t":"کجا","pr":"kocâ","s":"nere, nerede","emoji":"","ex":{"t":"مادرت کجاست؟","pr":"Mâdarat kocâst?","s":"Annen nerede?","a":"audio/fa-tr/0b92f7e0fab7.mp3"},"img":null,"a":"audio/fa-tr/fb0db21222af.mp3"}],"phrases":[{"id":"p01","t":"خوش آمدید!","pr":"Xoş âmadid!","s":"Hoş geldiniz!","a":"audio/fa-tr/2ac08dd9fd29.mp3"},{"id":"p02","t":"بفرمایید تو!","pr":"Befarmâyid tu!","s":"Buyurun, içeri girin!","a":"audio/fa-tr/6eb1677ad403.mp3"},{"id":"p03","t":"خانه‌ی شما خیلی قشنگ است!","pr":"Xâne-ye şomâ xeyli ğaşang ast!","s":"Eviniz çok güzel!","a":"audio/fa-tr/71f6a937578e.mp3"},{"id":"p04","t":"ببخشید، دستشویی کجاست؟","pr":"Bebaxşid, dastşuyi kocâst?","s":"Affedersiniz, tuvalet nerede?","a":"audio/fa-tr/9999624a4363.mp3"},{"id":"p05","t":"اینجاست.","pr":"İncâst.","s":"Burada.","a":"audio/fa-tr/e2468016113c.mp3"},{"id":"p06","t":"آنجاست.","pr":"Âncâst.","s":"Orada.","a":"audio/fa-tr/b605fe83f310.mp3"},{"id":"p07","t":"خانه‌ی خودتان است.","pr":"Xâne-ye xodetân ast.","s":"Kendi eviniz sayılır.","a":"audio/fa-tr/a0525d1e0499.mp3"}],"dialogue":{"title":{"t":"در خانه‌ی امیر","pr":"Dar xâne-ye Amir","s":"Amir'in evinde","a":"audio/fa-tr/359546b14b4f.mp3"},"speakers":{"A":{"name":"Amir","voice":"m"},"B":{"name":"Elif","voice":"f"}},"lines":[{"sp":"A","t":"سلام الیف! خوش آمدی! بفرما تو!","pr":"Salâm Elif! Xoş âmadi! Befarmâ tu!","s":"Merhaba Elif! Hoş geldin! Buyur, gir!","a":"audio/fa-tr/47b5e8ed4295.mp3"},{"sp":"B","t":"سلام امیر! ممنون. خانه‌ی تو خیلی قشنگ است!","pr":"Salâm Amir! Mamnun. Xâne-ye to xeyli ğaşang ast!","s":"Merhaba Amir! Teşekkürler. Evin çok güzel!","a":"audio/fa-tr/1c709ace2bf0.mp3"},{"sp":"A","t":"ممنون! این آشپزخانه است و آن اتاق من است.","pr":"Mamnun! İn âşpazxâne ast va ân otâğ-e man ast.","s":"Teşekkürler! Burası mutfak, şurası da benim odam.","a":"audio/fa-tr/868c52da8a15.mp3"},{"sp":"B","t":"این فرش ایرانی است؟","pr":"İn farş İrâni ast?","s":"Bu halı İran halısı mı?","a":"audio/fa-tr/f9753f06a9d8.mp3"},{"sp":"A","t":"بله، فرش مادربزرگم است.","pr":"Bale, farş-e mâdarbozorgam ast.","s":"Evet, ninemin halısı.","a":"audio/fa-tr/efad11cd307c.mp3"},{"sp":"B","t":"گربه‌ات کجاست؟","pr":"Gorbeat kocâst?","s":"Kedin nerede?","a":"audio/fa-tr/5e267b369b8a.mp3"},{"sp":"A","t":"زیر تخت است!","pr":"Zir-e taxt ast!","s":"Yatağın altında!","a":"audio/fa-tr/abba1d9668e3.mp3"},{"sp":"B","t":"ببخشید، دستشویی کجاست؟","pr":"Bebaxşid, dastşuyi kocâst?","s":"Affedersin, tuvalet nerede?","a":"audio/fa-tr/878151a15869.mp3"},{"sp":"A","t":"آنجاست، کنار آشپزخانه.","pr":"Âncâst, kenâr-e âşpazxâne.","s":"Şurada, mutfağın yanında.","a":"audio/fa-tr/84cb3078eb4e.mp3"},{"sp":"B","t":"ممنون!","pr":"Mamnun!","s":"Teşekkürler!","a":"audio/fa-tr/ed43386dda9a.mp3"}]},"grammar":[{"id":"g01","title":{"t":"هست، نیست","pr":"hast, nist","s":"Var ve yok: «hast / nist»"},"explain":"Türkçedeki **var** ve **yok** için Farsçada **hast** (var) ve **nist** (yok) kullanılır: **Dar xâne yek gorbe hast.** = Evde bir kedi var. **Şir nist.** = Süt yok.\nSoru için sadece sesi yükseltin: **Çây hast?** = Çay var mı?\n**nist** aynı zamanda **değil** demektir. «Olmak» fiilinin olumsuzu böyle çekilir: **nistam** (değilim), **nisti**, **nist**, **nistim**, **nistid**, **nistand**.\n**Man İrâni nistam, Tork hastam.** = İranlı değilim, Türküm.","table":[["هست","hast","var"],["نیست","nist","yok / değil"],["نیستم","nistam","değilim"],["نیستی","nisti","değilsin"],["نیستیم","nistim","değiliz"],["نیستید","nistid","değilsiniz"],["نیستند","nistand","değiller"]],"examples":[{"t":"در خانه یک گربه هست.","pr":"Dar xâne yek gorbe hast.","s":"Evde bir kedi var.","a":"audio/fa-tr/cde03c3c4197.mp3"},{"t":"چای هست؟ — بله، هست.","pr":"Çây hast? — Bale, hast.","s":"Çay var mı? — Evet, var.","a":"audio/fa-tr/95b87a372a4a.mp3"},{"t":"شیر نیست.","pr":"Şir nist.","s":"Süt yok.","a":"audio/fa-tr/740b6ceb4e64.mp3"},{"t":"من ایرانی نیستم، ترک هستم.","pr":"Man İrâni nistam, Tork hastam.","s":"Ben İranlı değilim, Türküm.","a":"audio/fa-tr/16aec9ab288a.mp3"},{"t":"آشپزخانه کوچک نیست.","pr":"Âşpazxâne kuçak nist.","s":"Mutfak küçük değil.","a":"audio/fa-tr/661b183e0b1b.mp3"}],"exercises":[{"type":"choice","t":"در یخچال شیر ___.","options":["هستم","هست","هستی"],"answer":1,"pr":"Dar yaxçâl şir hast.","s":"Buzdolabında süt var.","full":"در یخچال شیر هست.","a":"audio/fa-tr/02775d5a1b6a.mp3"},{"type":"choice","t":"ببخشید، قهوه ___. چای می‌خواهید؟","options":["نیست","نیستم","نیستیم"],"answer":0,"pr":"Bebaxşid, ğahve nist. Çây mixâhid?","s":"Kusura bakmayın, kahve yok. Çay ister misiniz?","full":"ببخشید، قهوه نیست. چای می‌خواهید؟","a":"audio/fa-tr/eaa96963fb6b.mp3"},{"type":"choice","t":"من دانشجو ___، معلم هستم.","options":["نیست","نیستند","نیستم"],"answer":2,"pr":"Man dâneşcu nistam, mo'allem hastam.","s":"Ben öğrenci değilim, öğretmenim.","full":"من دانشجو نیستم، معلم هستم.","a":"audio/fa-tr/9c4b4f075e39.mp3"},{"type":"type","t":"او ایرانی ___.","answer":["نیست"],"pr":"U İrâni nist.","s":"O İranlı değil.","full":"او ایرانی نیست.","a":"audio/fa-tr/4ffba1abf166.mp3"},{"type":"type","t":"ما ترک ___.","answer":["نیستیم"],"pr":"Mâ Tork nistim.","s":"Biz Türk değiliz.","full":"ما ترک نیستیم.","a":"audio/fa-tr/5e65fce4dc79.mp3"},{"type":"order","t":"در اتاق یک تخت هست.","pr":"Dar otâğ yek taxt hast.","s":"Odada bir yatak var.","alts":["یک تخت در اتاق هست."],"full":"در اتاق یک تخت هست.","a":"audio/fa-tr/7e33b711d943.mp3"},{"type":"order","t":"حمام کوچک نیست.","pr":"Hammâm kuçak nist.","s":"Banyo küçük değil.","full":"حمام کوچک نیست.","a":"audio/fa-tr/7b386d7f9980.mp3"}]},{"id":"g02","title":{"t":"در، روی، زیر، کنار","pr":"dar, ru-ye, zir-e, kenâr-e","s":"Yer edatları: -de, üstünde, altında, yanında"},"explain":"Türkçede yer bildirmek için kelimenin **sonuna ek** getiririz: ev**de**, masanın **üstünde**. Farsçada ise küçük bir kelime ismin **önüne** gelir: **dar xâne** = evde.\n**dar** = -de / -da, içinde · **ru-ye** = üstünde · **zir-e** = altında · **kenâr-e** = yanında.\n**ru, zir, kenâr** aslında isimdir ('üst, alt, yan'), bu yüzden arkalarından **ezafe** (-e / -ye) gelir: **zir-e miz** = masanın altı(nda).\nYer sormak için: **… kocâst?** = … nerede? (kocâ + ast). Cevap: **incâst** (burada), **âncâst** (orada).\nDikkat: **در** hem 'dar' = -de, hem de 'dar' = kapı demektir!","table":[["در اتاق","dar otâğ","odada"],["روی میز","ru-ye miz","masanın üstünde"],["زیر صندلی","zir-e sandali","sandalyenin altında"],["کنار پنجره","kenâr-e pancere","pencerenin yanında"]],"examples":[{"t":"کتاب روی میز است.","pr":"Ketâb ru-ye miz ast.","s":"Kitap masanın üstünde.","a":"audio/fa-tr/a3241f477728.mp3"},{"t":"گربه زیر تخت است.","pr":"Gorbe zir-e taxt ast.","s":"Kedi yatağın altında.","a":"audio/fa-tr/e68223c1a25e.mp3"},{"t":"صندلی کنار پنجره است.","pr":"Sandali kenâr-e pancere ast.","s":"Sandalye pencerenin yanında.","a":"audio/fa-tr/148a5facd922.mp3"},{"t":"کلید کجاست؟ — در آشپزخانه است.","pr":"Kelid kocâst? — Dar âşpazxâne ast.","s":"Anahtar nerede? — Mutfakta.","a":"audio/fa-tr/149b31dacb95.mp3"}],"exercises":[{"type":"choice","t":"کتاب ___ میز است.","options":["زیر","روی","کنار"],"answer":1,"pr":"Ketâb ru-ye miz ast.","s":"Kitap masanın üstünde.","full":"کتاب روی میز است.","a":"audio/fa-tr/a3241f477728.mp3"},{"type":"choice","t":"گربه ___ صندلی است.","options":["زیر","روی","در"],"answer":0,"pr":"Gorbe zir-e sandali ast.","s":"Kedi sandalyenin altında.","full":"گربه زیر صندلی است.","a":"audio/fa-tr/2011d5410dcb.mp3"},{"type":"choice","t":"مادرم ___ آشپزخانه است.","options":["روی","زیر","در"],"answer":2,"pr":"Mâdaram dar âşpazxâne ast.","s":"Annem mutfakta.","full":"مادرم در آشپزخانه است.","a":"audio/fa-tr/90b882efa149.mp3"},{"type":"type","t":"کلید ___؟","answer":["کجاست","کجا است"],"pr":"Kelid kocâst?","s":"Anahtar nerede?","full":"کلید کجاست؟","a":"audio/fa-tr/a23488cccef1.mp3"},{"type":"type","t":"میز ___ پنجره است.","answer":["کنار"],"pr":"Miz kenâr-e pancere ast.","s":"Masa pencerenin yanında.","full":"میز کنار پنجره است.","a":"audio/fa-tr/1279adb8c30e.mp3"},{"type":"order","t":"کلید روی میز است.","pr":"Kelid ru-ye miz ast.","s":"Anahtar masanın üstünde.","full":"کلید روی میز است.","a":"audio/fa-tr/aa43549b343a.mp3"},{"type":"order","t":"یخچال در آشپزخانه است.","pr":"Yaxçâl dar âşpazxâne ast.","s":"Buzdolabı mutfakta.","full":"یخچال در آشپزخانه است.","a":"audio/fa-tr/691387da97cf.mp3"}]}],"reading":{"title":{"t":"خانه‌ی امیر","pr":"Xâne-ye Amir","s":"Amir'in evi","a":"audio/fa-tr/4f2df836d932.mp3"},"text":[{"t":"این خانه‌ی امیر است.","pr":"İn xâne-ye Amir ast.","s":"Bu, Amir'in evi.","a":"audio/fa-tr/e3c91587c242.mp3"},{"t":"خانه‌ی او کوچک است، ولی خیلی قشنگ است.","pr":"Xâne-ye u kuçak ast, vali xeyli ğaşang ast.","s":"Onun evi küçük ama çok güzel.","a":"audio/fa-tr/121dc2aa03d2.mp3"},{"t":"خانه دو اتاق، یک آشپزخانه و یک حمام دارد.","pr":"Xâne do otâğ, yek âşpazxâne va yek hammâm dârad.","s":"Evde iki oda, bir mutfak ve bir banyo var.","a":"audio/fa-tr/5185666deb03.mp3"},{"t":"در اتاق امیر یک تخت و یک میز هست.","pr":"Dar otâğ-e Amir yek taxt va yek miz hast.","s":"Amir'in odasında bir yatak ve bir masa var.","a":"audio/fa-tr/3e00ad6069f8.mp3"},{"t":"کتاب‌های او روی میز هستند.","pr":"Ketâbhâ-ye u ru-ye miz hastand.","s":"Kitapları masanın üstünde.","a":"audio/fa-tr/04d3b3364b8a.mp3"},{"t":"یک فرش ایرانی زیر میز است.","pr":"Yek farş-e İrâni zir-e miz ast.","s":"Masanın altında bir İran halısı var.","a":"audio/fa-tr/552ac88eb263.mp3"},{"t":"گربه‌ی امیر کجاست؟","pr":"Gorbe-ye Amir kocâst?","s":"Amir'in kedisi nerede?","a":"audio/fa-tr/d46de8590ef6.mp3"},{"t":"او روی تخت است!","pr":"U ru-ye taxt ast!","s":"Yatağın üstünde!","a":"audio/fa-tr/d3f17c304343.mp3"}],"questions":[{"q":{"t":"خانه‌ی امیر چند اتاق دارد؟","pr":"Xâne-ye Amir çand otâğ dârad?","s":"Amir'in evinde kaç oda var?","a":"audio/fa-tr/96078bdab78a.mp3"},"options":["دو","سه","یک"],"answer":0},{"q":{"t":"کتاب‌های امیر کجا هستند؟","pr":"Ketâbhâ-ye Amir kocâ hastand?","s":"Amir'in kitapları nerede?","a":"audio/fa-tr/307408681ec4.mp3"},"options":["زیر تخت","روی میز","در آشپزخانه"],"answer":1},{"q":{"t":"زیر میز چه هست؟","pr":"Zir-e miz çe hast?","s":"Masanın altında ne var?","a":"audio/fa-tr/d9856db9b9e1.mp3"},"options":["گربه","کتاب","فرش"],"answer":2},{"q":{"t":"گربه کجاست؟","pr":"Gorbe kocâst?","s":"Kedi nerede?","a":"audio/fa-tr/08feba477043.mp3"},"opti