","pl":"میزها","pr":"miz","s":"masa","emoji":"","ex":{"t":"میز در آشپزخانه است.","pr":"Miz dar âşpazxâne ast.","s":"Masa mutfakta.","a":"audio/fa-tr/312d6f28440f.mp3"},"img":null,"a":"audio/fa-tr/12912e018ff9.mp3","pla":"audio/fa-tr/bb63a52e2e45.mp3"},{"id":"w08","t":"صندلی","pl":"صندلی‌ها","pr":"sandali","s":"sandalye","emoji":"🪑","ex":{"t":"گربه زیر صندلی است.","pr":"Gorbe zir-e sandali ast.","s":"Kedi sandalyenin altında.","a":"audio/fa-tr/0d1a1c939fb6.mp3"},"img":"img/e/1fa91.svg","a":"audio/fa-tr/b320aafac554.mp3","pla":"audio/fa-tr/b5cbe6843484.mp3"},{"id":"w09","t":"تخت","pr":"taxt","s":"yatak","emoji":"🛏️","ex":{"t":"تخت در اتاق من است.","pr":"Taxt dar otâğ-e man ast.","s":"Yatak benim odamda.","a":"audio/fa-tr/1d3329994d11.mp3"},"img":"img/e/1f6cf.svg","a":"audio/fa-tr/c445e1fa6788.mp3"},{"id":"w10","t":"گربه","pl":"گربه‌ها","pr":"gorbe","s":"kedi","emoji":"🐈","ex":{"t":"گربه کجاست؟","pr":"Gorbe kocâst?","s":"Kedi nerede?","a":"audio/fa-tr/7adadbf727e7.mp3"},"img":"img/e/1f408.svg","a":"audio/fa-tr/77943dd3c4a2.mp3","pla":"audio/fa-tr/12d588a77d9f.mp3"},{"id":"w11","t":"یخچال","pr":"yaxçâl","s":"buzdolabı","emoji":"","ex":{"t":"شیر در یخچال است.","pr":"Şir dar yaxçâl ast.","s":"Süt buzdolabında.","a":"audio/fa-tr/15d70586e26d.mp3"},"img":null,"a":"audio/fa-tr/7a10469c2c6e.mp3"},{"id":"w12","t":"کلید","pr":"kelid","s":"anahtar","emoji":"🔑","ex":{"t":"کلید روی میز است.","pr":"Kelid ru-ye miz ast.","s":"Anahtar masanın üstünde.","a":"audio/fa-tr/e30998a7aa24.mp3"},"img":"img/e/1f511.svg","a":"audio/fa-tr/8559011f9b96.mp3"},{"id":"w13","t":"فرش","pr":"farş","s":"halı","emoji":"","ex":{"t":"فرش ما ایرانی است.","pr":"Farş-e mâ İrâni ast.","s":"Halımız İran halısı.","a":"audio/fa-tr/564d2a4d8367.mp3"},"img":null,"a":"audio/fa-tr/805ea0d37502.mp3"},{"id":"w14","t":"کجا","pr":"kocâ","s":"nere, nerede","emoji":"","ex":{"t":"مادرت کجاست؟","pr":"Mâdarat kocâst?","s":"Annen nerede?","a":"audio/fa-tr/39a5a1d8d454.mp3"},"img":null,"a":"audio/fa-tr/23f789d84740.mp3"}],"phrases":[{"id":"p01","t":"خوش آمدید!","pr":"Xoş âmadid!","s":"Hoş geldiniz!","a":"audio/fa-tr/33cbab9cadb9.mp3"},{"id":"p02","t":"بفرمایید تو!","pr":"Befarmâyid tu!","s":"Buyurun, içeri girin!","a":"audio/fa-tr/242f6d11bd5a.mp3"},{"id":"p03","t":"خانه‌ی شما خیلی قشنگ است!","pr":"Xâne-ye şomâ xeyli ğaşang ast!","s":"Eviniz çok güzel!","a":"audio/fa-tr/f4d7b90f3b1f.mp3"},{"id":"p04","t":"ببخشید، دستشویی کجاست؟","pr":"Bebaxşid, dastşuyi kocâst?","s":"Affedersiniz, tuvalet nerede?","a":"audio/fa-tr/bb95aa726ce2.mp3"},{"id":"p05","t":"اینجاست.","pr":"İncâst.","s":"Burada.","a":"audio/fa-tr/53faa7add692.mp3"},{"id":"p06","t":"آنجاست.","pr":"Âncâst.","s":"Orada.","a":"audio/fa-tr/920932756ef8.mp3"},{"id":"p07","t":"خانه‌ی خودتان است.","pr":"Xâne-ye xodetân ast.","s":"Kendi eviniz sayılır.","a":"audio/fa-tr/ce84f893449b.mp3"}],"dialogue":{"title":{"t":"در خانه‌ی امیر","pr":"Dar xâne-ye Amir","s":"Amir'in evinde","a":"audio/fa-tr/4bd83c564d0a.mp3"},"speakers":{"A":{"name":"Amir","voice":"m"},"B":{"name":"Elif","voice":"f"}},"lines":[{"sp":"A","t":"سلام الیف! خوش آمدی! بفرما تو!","pr":"Salâm Elif! Xoş âmadi! Befarmâ tu!","s":"Merhaba Elif! Hoş geldin! Buyur, gir!","a":"audio/fa-tr/ba75aec617e9.mp3"},{"sp":"B","t":"سلام امیر! ممنون. خانه‌ی تو خیلی قشنگ است!","pr":"Salâm Amir! Mamnun. Xâne-ye to xeyli ğaşang ast!","s":"Merhaba Amir! Teşekkürler. Evin çok güzel!","a":"audio/fa-tr/d2c5f5b1a428.mp3"},{"sp":"A","t":"ممنون! این آشپزخانه است و آن اتاق من است.","pr":"Mamnun! İn âşpazxâne ast va ân otâğ-e man ast.","s":"Teşekkürler! Burası mutfak, şurası da benim odam.","a":"audio/fa-tr/49e5fe830a3b.mp3"},{"sp":"B","t":"این فرش ایرانی است؟","pr":"İn farş İrâni ast?","s":"Bu halı İran halısı mı?","a":"audio/fa-tr/a8cfe26a9570.mp3"},{"sp":"A","t":"بله، فرش مادربزرگم است.","pr":"Bale, farş-e mâdarbozorgam ast.","s":"Evet, ninemin halısı.","a":"audio/fa-tr/e9e118c4b363.mp3"},{"sp":"B","t":"گربه‌ات کجاست؟","pr":"Gorbeat kocâst?","s":"Kedin nerede?","a":"audio/fa-tr/e8b25e5737d3.mp3"},{"sp":"A","t":"زیر تخت است!","pr":"Zir-e taxt ast!","s":"Yatağın altında!","a":"audio/fa-tr/ca7602a1094b.mp3"},{"sp":"B","t":"ببخشید، دستشویی کجاست؟","pr":"Bebaxşid, dastşuyi kocâst?","s":"Affedersin, tuvalet nerede?","a":"audio/fa-tr/bb95aa726ce2.mp3"},{"sp":"A","t":"آنجاست، کنار آشپزخانه.","pr":"Âncâst, kenâr-e âşpazxâne.","s":"Şurada, mutfağın yanında.","a":"audio/fa-tr/713004db3c04.mp3"},{"sp":"B","t":"ممنون!","pr":"Mamnun!","s":"Teşekkürler!","a":"audio/fa-tr/107ad1657126.mp3"}]},"grammar":[{"id":"g01","title":{"t":"هست، نیست","pr":"hast, nist","s":"Var ve yok: «hast / nist»"},"explain":"Türkçedeki **var** ve **yok** için Farsçada **hast** (var) ve **nist** (yok) kullanılır: **Dar xâne yek gorbe hast.** = Evde bir kedi var. **Şir nist.** = Süt yok.\nSoru için sadece sesi yükseltin: **Çây hast?** = Çay var mı?\n**nist** aynı zamanda **değil** demektir. «Olmak» fiilinin olumsuzu böyle çekilir: **nistam** (değilim), **nisti**, **nist**, **nistim**, **nistid**, **nistand**.\n**Man İrâni nistam, Tork hastam.** = İranlı değilim, Türküm.","table":[["هست","hast","var"],["نیست","nist","yok / değil"],["نیستم","nistam","değilim"],["نیستی","nisti","değilsin"],["نیستیم","nistim","değiliz"],["نیستید","nistid","değilsiniz"],["نیستند","nistand","değiller"]],"examples":[{"t":"در خانه یک گربه هست.","pr":"Dar xâne yek gorbe hast.","s":"Evde bir kedi var.","a":"audio/fa-tr/fdd03bcce8ee.mp3"},{"t":"چای هست؟ — بله، هست.","pr":"Çây hast? — Bale, hast.","s":"Çay var mı? — Evet, var.","a":"audio/fa-tr/85f33e276e5d.mp3"},{"t":"شیر نیست.","pr":"Şir nist.","s":"Süt yok.","a":"audio/fa-tr/9a16efeabcf5.mp3"},{"t":"من ایرانی نیستم، ترک هستم.","pr":"Man İrâni nistam, Tork hastam.","s":"Ben İranlı değilim, Türküm.","a":"audio/fa-tr/0a8de7f466a1.mp3"},{"t":"آشپزخانه کوچک نیست.","pr":"Âşpazxâne kuçak nist.","s":"Mutfak küçük değil.","a":"audio/fa-tr/04c23996ce84.mp3"}],"exercises":[{"type":"choice","t":"در یخچال شیر ___.","options":["هستم","هست","هستی"],"answer":1,"pr":"Dar yaxçâl şir hast.","s":"Buzdolabında süt var.","full":"در یخچال شیر هست.","a":"audio/fa-tr/069ab25e6628.mp3"},{"type":"choice","t":"ببخشید، قهوه ___. چای می‌خواهید؟","options":["نیست","نیستم","نیستیم"],"answer":0,"pr":"Bebaxşid, ğahve nist. Çây mixâhid?","s":"Kusura bakmayın, kahve yok. Çay ister misiniz?","full":"ببخشید، قهوه نیست. چای می‌خواهید؟","a":"audio/fa-tr/242c200c4ef1.mp3"},{"type":"choice","t":"من دانشجو ___، معلم هستم.","options":["نیست","نیستند","نیستم"],"answer":2,"pr":"Man dâneşcu nistam, mo'allem hastam.","s":"Ben öğrenci değilim, öğretmenim.","full":"من دانشجو نیستم، معلم هستم.","a":"audio/fa-tr/1ecb0af46801.mp3"},{"type":"type","t":"او ایرانی ___.","answer":["نیست"],"pr":"U İrâni nist.","s":"O İranlı değil.","full":"او ایرانی نیست.","a":"audio/fa-tr/aac082aec63b.mp3"},{"type":"type","t":"ما ترک ___.","answer":["نیستیم"],"pr":"Mâ Tork nistim.","s":"Biz Türk değiliz.","full":"ما ترک نیستیم.","a":"audio/fa-tr/2f12fcc0c2c4.mp3"},{"type":"order","t":"در اتاق یک تخت هست.","pr":"Dar otâğ yek taxt hast.","s":"Odada bir yatak var.","full":"در اتاق یک تخت هست.","a":"audio/fa-tr/74beaa500b89.mp3"},{"type":"order","t":"حمام کوچک نیست.","pr":"Hammâm kuçak nist.","s":"Banyo küçük değil.","full":"حمام کوچک نیست.","a":"audio/fa-tr/3d67aa345906.mp3"}]},{"id":"g02","title":{"t":"در، روی، زیر، کنار","pr":"dar, ru-ye, zir-e, kenâr-e","s":"Yer edatları: -de, üstünde, altında, yanında"},"explain":"Türkçede yer bildirmek için kelimenin **sonuna ek** getiririz: ev**de**, masanın **üstünde**. Farsçada ise küçük bir kelime ismin **önüne** gelir: **dar xâne** = evde.\n**dar** = -de / -da, içinde · **ru-ye** = üstünde · **zir-e** = altında · **kenâr-e** = yanında.\n**ru, zir, kenâr** aslında isimdir ('üst, alt, yan'), bu yüzden arkalarından **ezafe** (-e / -ye) gelir: **zir-e miz** = masanın altı(nda).\nYer sormak için: **… kocâst?** = … nerede? (kocâ + ast). Cevap: **incâst** (burada), **âncâst** (orada).\nDikkat: **در** hem 'dar' = -de, hem de 'dar' = kapı demektir!","table":[["در اتاق","dar otâğ","odada"],["روی میز","ru-ye miz","masanın üstünde"],["زیر صندلی","zir-e sandali","sandalyenin altında"],["کنار پنجره","kenâr-e pancere","pencerenin yanında"]],"examples":[{"t":"کتاب روی میز است.","pr":"Ketâb ru-ye miz ast.","s":"Kitap masanın üstünde.","a":"audio/fa-tr/9026e81f7621.mp3"},{"t":"گربه زیر تخت است.","pr":"Gorbe zir-e taxt ast.","s":"Kedi yatağın altında.","a":"audio/fa-tr/76a49168eb6f.mp3"},{"t":"صندلی کنار پنجره است.","pr":"Sandali kenâr-e pancere ast.","s":"Sandalye pencerenin yanında.","a":"audio/fa-tr/fafd91e3cd56.mp3"},{"t":"کلید کجاست؟ — در آشپزخانه است.","pr":"Kelid kocâst? — Dar âşpazxâne ast.","s":"Anahtar nerede? — Mutfakta.","a":"audio/fa-tr/aeba095d6057.mp3"}],"exercises":[{"type":"choice","t":"کتاب ___ میز است.","options":["زیر","روی","کنار"],"answer":1,"pr":"Ketâb ru-ye miz ast.","s":"Kitap masanın üstünde.","full":"کتاب روی میز است.","a":"audio/fa-tr/9026e81f7621.mp3"},{"type":"choice","t":"گربه ___ صندلی است.","options":["زیر","روی","در"],"answer":0,"pr":"Gorbe zir-e sandali ast.","s":"Kedi sandalyenin altında.","full":"گربه زیر صندلی است.","a":"audio/fa-tr/0d1a1c939fb6.mp3"},{"type":"choice","t":"مادرم ___ آشپزخانه است.","options":["روی","زیر","در"],"answer":2,"pr":"Mâdaram dar âşpazxâne ast.","s":"Annem mutfakta.","full":"مادرم در آشپزخانه است.","a":"audio/fa-tr/e0410c7a074a.mp3"},{"type":"type","t":"کلید ___؟","answer":["کجاست","کجا است"],"pr":"Kelid kocâst?","s":"Anahtar nerede?","full":"کلید کجاست؟","a":"audio/fa-tr/d6e9603377b9.mp3"},{"type":"type","t":"میز ___ پنجره است.","answer":["کنار"],"pr":"Miz kenâr-e pancere ast.","s":"Masa pencerenin yanında.","full":"میز کنار پنجره است.","a":"audio/fa-tr/bf37ca070dea.mp3"},{"type":"order","t":"کلید روی میز است.","pr":"Kelid ru-ye miz ast.","s":"Anahtar masanın üstünde.","full":"کلید روی میز است.","a":"audio/fa-tr/e30998a7aa24.mp3"},{"type":"order","t":"یخچال در آشپزخانه است.","pr":"Yaxçâl dar âşpazxâne ast.","s":"Buzdolabı mutfakta.","full":"یخچال در آشپزخانه است.","a":"audio/fa-tr/d396d579fc8d.mp3"}]}],"reading":{"title":{"t":"خانه‌ی امیر","pr":"Xâne-ye Amir","s":"Amir'in evi","a":"audio/fa-tr/81c22bc290f3.mp3"},"text":[{"t":"این خانه‌ی امیر است.","pr":"İn xâne-ye Amir ast.","s":"Bu, Amir'in evi.","a":"audio/fa-tr/842b1b1a7ced.mp3"},{"t":"خانه‌ی او کوچک است، ولی خیلی قشنگ است.","pr":"Xâne-ye u kuçak ast, vali xeyli ğaşang ast.","s":"Onun evi küçük ama çok güzel.","a":"audio/fa-tr/21961c86fa50.mp3"},{"t":"خانه دو اتاق، یک آشپزخانه و یک حمام دارد.","pr":"Xâne do otâğ, yek âşpazxâne va yek hammâm dârad.","s":"Evde iki oda, bir mutfak ve bir banyo var.","a":"audio/fa-tr/665d841bd319.mp3"},{"t":"در اتاق امیر یک تخت و یک میز هست.","pr":"Dar otâğ-e Amir yek taxt va yek miz hast.","s":"Amir'in odasında bir yatak ve bir masa var.","a":"audio/fa-tr/32f009cc6fde.mp3"},{"t":"کتاب‌های او روی میز هستند.","pr":"Ketâbhâ-ye u ru-ye miz hastand.","s":"Kitapları masanın üstünde.","a":"audio/fa-tr/2f5470b8672b.mp3"},{"t":"یک فرش ایرانی زیر میز است.","pr":"Yek farş-e İrâni zir-e miz ast.","s":"Masanın altında bir İran halısı var.","a":"audio/fa-tr/786fa54ee052.mp3"},{"t":"گربه‌ی امیر کجاست؟","pr":"Gorbe-ye Amir kocâst?","s":"Amir'in kedisi nerede?","a":"audio/fa-tr/5b1e104f48df.mp3"},{"t":"او روی تخت است!","pr":"U ru-ye taxt ast!","s":"Yatağın üstünde!","a":"audio/fa-tr/6a689bb87a3a.mp3"}],"questions":[{"q":{"t":"خانه‌ی امیر چند اتاق دارد؟","pr":"Xâne-ye Amir çand otâğ dârad?","s":"Amir'in evinde kaç oda var?","a":"audio/fa-tr/fec6e4dbc978.mp3"},"options":["دو","سه","یک"],"answer":0},{"q":{"t":"کتاب‌های امیر کجا هستند؟","pr":"Ketâbhâ-ye Amir kocâ hastand?","s":"Amir'in kitapları nerede?","a":"audio/fa-tr/2555ea1b4d09.mp3"},"options":["زیر تخت","روی میز","در آشپزخانه"],"answer":1},{"q":{"t":"زیر میز چه هست؟","pr":"Zir-e miz çe hast?","s":"Masanın altında ne var?","a":"audio/fa-tr/939ccf913178.mp3"},"options":["گربه","کتاب","فرش"],"answer":2},{"q":{"t":"گربه کجاست؟","pr":"Gorbe kocâst?","s":"Kedi nerede?","a":"audio/fa-tr/7adadbf727e7.mp3"},"options":["روی تخت","در حمام","زیر میز"],"answer":0}]},"sentences":[{"t":"خانه‌ی ما کوچک است.","pr":"Xâne-ye mâ kuçak ast.","s":"Bizim evimiz küçük.","a":"audio/fa-tr/c68babf27984.mp3"},{"t":"آشپزخانه کجاست؟","pr":"Âşpazxâne kocâst?","s":"Mutfak nerede?","a":"audio/fa-tr/3e339baedcff.mp3"},{"t":"کتاب روی میز است.","pr":"Ketâb ru-ye miz ast.","s":"Kitap masanın üstünde.","a":"audio/fa-tr/9026e81f7621.mp3"},{"t":"گربه زیر صندلی است.","pr":"Gorbe zir-e sandali ast.","s":"Kedi sandalyenin altında.","a":"audio/fa-tr/0d1a1c939fb6.mp3"},{"t":"در یخچال شیر نیست.","pr":"Dar yaxçâl şir nist.","s":"Buzdolabında süt yok.","a":"audio/fa-tr/e010890349e4.mp3"},{"t":"خوش آمدید! بفرمایید تو!","pr":"Xoş âmadid! Befarmâyid tu!","s":"Hoş geldiniz! Buyurun, içeri girin!","a":"audio/fa-tr/2a29e253044f.mp3"},{"t":"کلید کنار پنجره است.","pr":"Kelid kenâr-e pancere ast.","s":"Anahtar pencerenin yanında.","a":"audio/fa-tr/c58135a2fd34.mp3"},{"t":"من در اتاقم هستم.","pr":"Man dar otâğam hastam.","s":"Ben odamdayım.","a":"audio/fa-tr/f2668101ee8c.mp3"}],"img":"img/e/1f3e0.svg"}