{"id":"u09","level":"A1","emoji":"🌦️","title":{"t":"هوا، ماه‌ها و فصل‌ها","s":"Hava, aylar ve mevsimler","pr":"Havâ, mâhhâ va faslhâ","a":"audio/fa-tr/3d771576465a.mp3"},"goals":["Havanın nasıl olduğunu sorup anlatabilirim.","Dört mevsimi ve İran takvimindeki 12 ayı söyleyebilirim.","Nevruz hakkında birkaç basit cümle kurabilirim."],"words":[{"id":"w01","t":"هوا","s":"hava","pr":"havâ","emoji":"🌤️","ex":{"t":"امروز هوا خوب است.","s":"Bugün hava güzel.","pr":"Emruz havâ xub ast.","a":"audio/fa-tr/8a51fd6da3ed.mp3"},"img":"img/e/1f324.svg","a":"audio/fa-tr/f816836397dc.mp3"},{"id":"w02","t":"آفتابی","s":"güneşli","pr":"âftâbi","emoji":"☀️","ex":{"t":"امروز هوا آفتابی است.","s":"Bugün hava güneşli.","pr":"Emruz havâ âftâbi ast.","a":"audio/fa-tr/4328cbd39150.mp3"},"img":"img/e/2600.svg","a":"audio/fa-tr/71880ac38b39.mp3"},{"id":"w03","t":"باران","s":"yağmur","pr":"bârân","emoji":"🌧️","ex":{"t":"باران می‌آید.","s":"Yağmur yağıyor.","pr":"Bârân miâyad.","a":"audio/fa-tr/b3ef9a312c47.mp3"},"img":"img/e/1f327.svg","a":"audio/fa-tr/9fd02b37ac90.mp3"},{"id":"w04","t":"برف","s":"kar","pr":"barf","emoji":"❄️","ex":{"t":"در زمستان برف می‌آید.","s":"Kışın kar yağar.","pr":"Dar zemestân barf miâyad.","a":"audio/fa-tr/dc3d1fd0ad27.mp3"},"img":"img/e/2744.svg","a":"audio/fa-tr/2de1819654a7.mp3"},{"id":"w05","t":"گرم","s":"sıcak","pr":"garm","emoji":"🌡️","ex":{"t":"تابستان هوا گرم است.","s":"Yazın hava sıcak.","pr":"Tâbestân havâ garm ast.","a":"audio/fa-tr/db4dcc7f708e.mp3"},"img":"img/e/1f321.svg","a":"audio/fa-tr/7e99086e7e56.mp3"},{"id":"w06","t":"سرد","s":"soğuk","pr":"sard","emoji":"🥶","ex":{"t":"امروز هوا خیلی سرد است.","s":"Bugün hava çok soğuk.","pr":"Emruz havâ xeyli sard ast.","a":"audio/fa-tr/dc9838ef5c1a.mp3"},"img":"img/e/1f976.svg","a":"audio/fa-tr/fb759ddb4cf2.mp3"},{"id":"w07","t":"ابری","s":"bulutlu","pr":"abri","emoji":"☁️","ex":{"t":"امروز هوا ابری است.","s":"Bugün hava bulutlu.","pr":"Emruz havâ abri ast.","a":"audio/fa-tr/dfc8053e03b7.mp3"},"img":"img/e/2601.svg","a":"audio/fa-tr/2927ac018a47.mp3"},{"id":"w08","t":"بهار","s":"ilkbahar","pr":"bahâr","emoji":"🌸","ex":{"t":"بهار فصل گل است.","s":"İlkbahar çiçek mevsimidir.","pr":"Bahâr fasl-e gol ast.","a":"audio/fa-tr/f87f4d92c0f7.mp3"},"img":"img/e/1f338.svg","a":"audio/fa-tr/a33e061d22ea.mp3"},{"id":"w09","t":"تابستان","s":"yaz","pr":"tâbestân","emoji":"🏖️","ex":{"t":"تابستان به دریا می‌رویم.","s":"Yazın denize gidiyoruz.","pr":"Tâbestân be daryâ miravim.","a":"audio/fa-tr/f3929ea89ce5.mp3"},"img":"img/e/1f3d6.svg","a":"audio/fa-tr/4fec4e1fd9d3.mp3"},{"id":"w10","t":"پاییز","s":"sonbahar","pr":"pâyiz","emoji":"🍂","ex":{"t":"پاییز برگ‌ها زرد می‌شوند.","s":"Sonbaharda yapraklar sararır.","pr":"Pâyiz barghâ zard mişavand.","a":"audio/fa-tr/6a1a794034c1.mp3"},"img":"img/e/1f342.svg","a":"audio/fa-tr/95ae2296e383.mp3"},{"id":"w11","t":"زمستان","s":"kış","pr":"zemestân","emoji":"⛄","ex":{"t":"من زمستان را دوست دارم.","s":"Kışı severim.","pr":"Man zemestân râ dust dâram.","a":"audio/fa-tr/de227af39619.mp3"},"img":"img/e/26c4.svg","a":"audio/fa-tr/9d8678fbe95e.mp3"},{"id":"w12","t":"فصل","s":"mevsim","pr":"fasl","emoji":"","ex":{"t":"سال چهار فصل دارد.","s":"Yılın dört mevsimi var.","pr":"Sâl çahâr fasl dârad.","a":"audio/fa-tr/c1607783da21.mp3"},"img":null,"a":"audio/fa-tr/d2b803128751.mp3"},{"id":"w13","t":"ماه","s":"ay","pr":"mâh","emoji":"🗓️","ex":{"t":"سال دوازده ماه دارد.","s":"Yılın on iki ayı var.","pr":"Sâl davâzdah mâh dârad.","a":"audio/fa-tr/c33949289756.mp3"},"img":"img/e/1f5d3.svg","a":"audio/fa-tr/9943f382c6c2.mp3"},{"id":"w14","t":"نوروز","s":"Nevruz (İran'da yılbaşı)","pr":"nowruz","emoji":"🌱","ex":{"t":"نوروز جشن سال نو است.","s":"Nevruz yeni yıl bayramıdır.","pr":"Nowruz caşn-e sâl-e now ast.","a":"audio/fa-tr/2275d8f94f19.mp3"},"img":"img/e/1f331.svg","a":"audio/fa-tr/9b0fc6812f97.mp3"}],"phrases":[{"id":"p01","t":"هوا چطور است؟","s":"Hava nasıl?","pr":"Havâ çetor ast?","a":"audio/fa-tr/48d39fd71710.mp3"},{"id":"p02","t":"هوا خیلی خوب است!","s":"Hava çok güzel!","pr":"Havâ xeyli xub ast!","a":"audio/fa-tr/819e61a2ac07.mp3"},{"id":"p03","t":"باران می‌آید.","s":"Yağmur yağıyor.","pr":"Bârân miâyad.","a":"audio/fa-tr/b3ef9a312c47.mp3"},{"id":"p04","t":"برف می‌آید.","s":"Kar yağıyor.","pr":"Barf miâyad.","a":"audio/fa-tr/a6830fde6e74.mp3"},{"id":"p05","t":"خیلی سرد است!","s":"Çok soğuk!","pr":"Xeyli sard ast!","a":"audio/fa-tr/260fd7d35f21.mp3"},{"id":"p06","t":"نوروز مبارک!","s":"Nevruzunuz kutlu olsun!","pr":"Nowruz mobârak!","a":"audio/fa-tr/150026bbd98a.mp3"},{"id":"p07","t":"سال نو مبارک!","s":"Yeni yılınız kutlu olsun!","pr":"Sâl-e no mobârak!","a":"audio/fa-tr/534b0731a038.mp3"},{"id":"p08","t":"کدام فصل را دوست داری؟","s":"Hangi mevsimi seversin?","pr":"Kodâm fasl râ dust dâri?","a":"audio/fa-tr/cb99b9a7eee3.mp3"}],"dialogue":{"title":{"t":"هوای تهران چطور است؟","s":"Tahran'da hava nasıl?","pr":"Havâ-ye Tehrân çetor ast?","a":"audio/fa-tr/8031bac43df4.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Emre","voice":"m"}},"lines":[{"sp":"B","t":"سلام سارا! هوای تهران چطور است؟","s":"Merhaba Sara! Tahran'da hava nasıl?","pr":"Salâm Sârâ! Havâ-ye Tehrân çetor ast?","a":"audio/fa-tr/73870a8d147a.mp3"},{"sp":"A","t":"سلام امره! امروز هوا آفتابی و گرم است.","s":"Merhaba Emre! Bugün hava güneşli ve sıcak.","pr":"Salâm Emre! Emruz havâ âftâbi va garm ast.","a":"audio/fa-tr/c09bb86b801b.mp3"},{"sp":"B","t":"خوش به حالت! در استانبول باران می‌آید.","s":"Ne mutlu sana! İstanbul'da yağmur yağıyor.","pr":"Xoş be hâlat! Dar Estânbol bârân miâyad.","a":"audio/fa-tr/ef3a44804cd5.mp3"},{"sp":"A","t":"هوا سرد است؟","s":"Hava soğuk mu?","pr":"Havâ sard ast?","a":"audio/fa-tr/31e903699ecd.mp3"},{"sp":"B","t":"نه خیلی، ولی ابری است.","s":"Çok değil, ama bulutlu.","pr":"Na xeyli, vali abri ast.","a":"audio/fa-tr/bfae290c7e30.mp3"},{"sp":"A","t":"تهران در بهار خیلی قشنگ است. کی به ایران می‌آیی؟","s":"Tahran ilkbaharda çok güzel. İran'a ne zaman geliyorsun?","pr":"Tehrân dar bahâr xeyli ğaşang ast. Key be İrân miâyi?","a":"audio/fa-tr/78d1223cd953.mp3"},{"sp":"B","t":"در فروردین، برای نوروز!","s":"Farvardin'de, Nevruz için!","pr":"Dar farvardin, barâye nowruz!","a":"audio/fa-tr/ec1d481d5c15.mp3"},{"sp":"A","t":"عالی است! نوروز در ایران خیلی شاد است.","s":"Harika! İran'da Nevruz çok neşeli geçer.","pr":"Âli ast! Nowruz dar İrân xeyli şâd ast.","a":"audio/fa-tr/a98853961c46.mp3"},{"sp":"B","t":"پس تا فروردین!","s":"O zaman Farvardin'de görüşürüz!","pr":"Pas tâ farvardin!","a":"audio/fa-tr/5190d61ca071.mp3"},{"sp":"A","t":"خداحافظ!","s":"Hoşça kal!","pr":"Xodâhâfez!","a":"audio/fa-tr/da9bd4f87bfe.mp3"}]},"grammar":[{"id":"g01","title":{"t":"هوا آفتابی است. باران می‌آید.","s":"Havayı anlatmak","pr":"Havâ âftâbi ast. Bârân miâyad."},"explain":"Havayı anlatmanın iki yolu var.\n1) **havâ** + sıfat + **ast**: Havâ **garm** ast = Hava sıcak. Havâ **sard / abri / âftâbi** ast. Türkçedeki *hava* kelimesiyle aynı!\n2) Yağmur ve kar için Farslar **\"gelmek\"** fiilini kullanır: **bârân miâyad** = yağmur yağıyor (kelimesi kelimesine: yağmur geliyor), **barf miâyad** = kar yağıyor. Olumsuz: **bârân nemiâyad** = yağmur yağmıyor.\n**-i** eki isimden sıfat yapar, Türkçedeki **-li** gibi: **âftâb** (güneş) → **âftâbi** (güneşli), **abr** (bulut) → **abri** (bulutlu).\nSoru: **Havâ çetor ast?** = Hava nasıl?","table":[["هوا آفتابی است.","Havâ âftâbi ast.","☀️"],["هوا ابری است.","Havâ abri ast.","☁️"],["باران می‌آید.","Bârân miâyad.","🌧️"],["برف می‌آید.","Barf miâyad.","❄️"],["هوا گرم است.","Havâ garm ast.","🌡️"],["هوا سرد است.","Havâ sard ast.","🥶"]],"examples":[{"t":"هوا چطور است؟ هوا ابری است.","s":"Hava nasıl? Hava bulutlu.","pr":"Havâ çetor ast? Havâ abri ast.","a":"audio/fa-tr/0b8dd04a1862.mp3"},{"t":"در تبریز زمستان برف می‌آید.","s":"Tebriz'de kışın kar yağar.","pr":"Dar Tabriz zemestân barf miâyad.","a":"audio/fa-tr/eeb3b1768155.mp3"},{"t":"امروز باران می‌آید.","s":"Bugün yağmur yağıyor.","pr":"Emruz bârân miâyad.","a":"audio/fa-tr/166b644b2c2c.mp3"},{"t":"تابستان در شیراز هوا خیلی گرم است.","s":"Şiraz'da yazın hava çok sıcak.","pr":"Tâbestân dar Şirâz havâ xeyli garm ast.","a":"audio/fa-tr/8000e7ce947a.mp3"},{"t":"باران نمی‌آید.","s":"Yağmur yağmıyor.","pr":"Bârân nemiâyad.","a":"audio/fa-tr/4a29e29974fc.mp3"}],"exercises":[{"type":"choice","t":"امروز هوا ___ است.","options":["آفتابی","باران","برف"],"answer":0,"s":"Bugün hava güneşli.","pr":"Emruz havâ âftâbi ast.","full":"امروز هوا آفتابی است.","a":"audio/fa-tr/4328cbd39150.mp3"},{"type":"choice","t":"باران ___.","options":["است","می‌آید","هستم"],"answer":1,"s":"Yağmur yağıyor.","pr":"Bârân miâyad.","full":"باران می‌آید.","a":"audio/fa-tr/b3ef9a312c47.mp3"},{"type":"choice","t":"زمستان هوا ___ است.","options":["گرم","آفتابی","سرد"],"answer":2,"s":"Kışın hava soğuk.","pr":"Zemestân havâ sard ast.","full":"زمستان هوا سرد است.","a":"audio/fa-tr/ba488fd7a984.mp3"},{"type":"choice","t":"هوا ___ است؟","options":["چطور","کجا","چند"],"answer":0,"s":"Hava nasıl?","pr":"Havâ çetor ast?","full":"هوا چطور است؟","a":"audio/fa-tr/48d39fd71710.mp3"},{"type":"type","t":"برف ___.","answer":["می‌آید","میآید"],"s":"Kar yağıyor.","pr":"Barf miâyad.","full":"برف می‌آید.","a":"audio/fa-tr/a6830fde6e74.mp3"},{"type":"type","t":"هوا ___ است.","answer":["ابری"],"s":"Hava bulutlu.","pr":"Havâ abri ast.","full":"هوا ابری است.","a":"audio/fa-tr/90e96af193a8.mp3"},{"type":"order","t":"امروز هوا خیلی سرد است.","s":"Bugün hava çok soğuk.","pr":"Emruz havâ xeyli sard ast.","full":"امروز هوا خیلی سرد است.","a":"audio/fa-tr/dc9838ef5c1a.mp3"},{"type":"order","t":"در تبریز برف می‌آید.","s":"Tebriz'de kar yağıyor.","pr":"Dar Tabriz barf miâyad.","full":"در تبریز برف می‌آید.","a":"audio/fa-tr/43edfd5c8d55.mp3"}]},{"id":"g02","title":{"t":"فصل‌ها و ماه‌ها","s":"Mevsimler, İran ayları ve Nevruz","pr":"faslhâ va mâhhâ"},"explain":"İran'da resmî takvim **güneş takvimi**dir. Yıl, ilkbaharın ilk günü (20–21 Mart) **Nowruz** (Nevruz) ile başlar: **avval-e farvardin** = 1 Farvardin.\nHer mevsimin üç ayı var. **Bahâr**: farvardin, ordibeheşt, xordâd. **Tâbestân**: tir, mordâd, şahrivar. **Pâyiz**: mehr, âbân, âzar. **Zemestân**: dey, bahman, esfand. İlk altı ay 31 gün, sonraki beş ay 30 gün, esfand ise 29 (artık yılda 30) gündür.\nNevruz'da aileler **haftsin** sofrası kurar: \"s\" sesiyle başlayan yedi şey (sabze, sib, sir, sekke, sonbol…). Büyükler çocuklara **eydi** (bayram harçlığı) verir. 13 Farvardin'de (**sizdah bedar**) herkes pikniğe, doğaya çıkar.\n\"… ayında\" demek için **dar** kullanılır: **dar mehr** = Mehr ayında. Mevsimlerde edat çoğu zaman düşer: **zemestân barf miâyad** = kışın kar yağar.","table":[["بهار","فروردین، اردیبهشت، خرداد","bahâr: farvardin, ordibeheşt, xordâd"],["تابستان","تیر، مرداد، شهریور","tâbestân: tir, mordâd, şahrivar"],["پاییز","مهر، آبان، آذر","pâyiz: mehr, âbân, âzar"],["زمستان","دی، بهمن، اسفند","zemestân: dey, bahman, esfand"]],"examples":[{"t":"نوروز اول فروردین است.","s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","a":"audio/fa-tr/98203290c65d.mp3"},{"t":"مدرسه‌ها در مهر باز می‌شوند.","s":"Okullar Mehr ayında açılır.","pr":"Madresehâ dar mehr bâz mişavand.","a":"audio/fa-tr/a1ba87d16f9f.mp3"},{"t":"تولد من در آبان است.","s":"Doğum günüm Âbân ayında.","pr":"Tavallod-e man dar âbân ast.","a":"audio/fa-tr/2f7f1b965ce4.mp3"},{"t":"دی و بهمن ماه‌های سرد هستند.","s":"Dey ve Bahman soğuk aylardır.","pr":"Dey va bahman mâhhâ-ye sard hastand.","a":"audio/fa-tr/1879237c25d9.mp3"},{"t":"در نوروز به خانه‌ی پدربزرگ می‌رویم.","s":"Nevruz'da büyükbabamın evine gideriz.","pr":"Dar nowruz be xâne-ye pedarbozorg miravim.","a":"audio/fa-tr/5915d37a1296.mp3"}],"exercises":[{"type":"choice","t":"نوروز اول ___ است.","options":["فروردین","مهر","دی"],"answer":0,"s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","full":"نوروز اول فروردین است.","a":"audio/fa-tr/98203290c65d.mp3"},{"type":"choice","t":"مهر در ___ است.","options":["بهار","پاییز","تابستان"],"answer":1,"s":"Mehr ayı sonbahardadır.","pr":"Mehr dar pâyiz ast.","full":"مهر در پاییز است.","a":"audio/fa-tr/39d3d7d9672e.mp3"},{"type":"choice","t":"سال چهار ___ دارد.","options":["ماه","روز","فصل"],"answer":2,"s":"Yılın dört mevsimi var.","pr":"Sâl çahâr fasl dârad.","full":"سال چهار فصل دارد.","a":"audio/fa-tr/c1607783da21.mp3"},{"type":"choice","t":"دی و بهمن ماه‌های ___ هستند.","options":["سرد","گرم","سبز"],"answer":0,"s":"Dey ve Bahman soğuk aylardır.","pr":"Dey va bahman mâhhâ-ye sard hastand.","full":"دی و بهمن ماه‌های سرد هستند.","a":"audio/fa-tr/1879237c25d9.mp3"},{"type":"type","t":"تابستان هوا ___ است.","answer":["گرم"],"s":"Yazın hava sıcak.","pr":"Tâbestân havâ garm ast.","full":"تابستان هوا گرم است.","a":"audio/fa-tr/db4dcc7f708e.mp3"},{"type":"type","t":"___ مبارک!","answer":["نوروز"],"s":"Nevruzunuz kutlu olsun!","pr":"Nowruz mobârak!","full":"نوروز مبارک!","a":"audio/fa-tr/150026bbd98a.mp3"},{"type":"order","t":"نوروز اول فروردین است.","s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","full":"نوروز اول فروردین است.","a":"audio/fa-tr/98203290c65d.mp3"},{"type":"order","t":"من بهار را دوست دارم.","s":"Ben ilkbaharı severim.","pr":"Man bahâr râ dust dâram.","full":"من بهار را دوست دارم.","a":"audio/fa-tr/ea4ca892cd64.mp3"}]}],"reading":{"title":{"t":"نوروز در خانه‌ی ما","s":"Bizim evde Nevruz","pr":"Nowruz dar xâne-ye mâ","a":"audio/fa-tr/1852927028b4.mp3"},"text":[{"t":"من مریم هستم و در شیراز زندگی می‌کنم.","s":"Ben Maryam, Şiraz'da yaşıyorum.","pr":"Man Maryam hastam va dar Şirâz zendegi mikonam.","a":"audio/fa-tr/8d5f8b2fae29.mp3"},{"t":"من بهار را خیلی دوست دارم.","s":"İlkbaharı çok severim.","pr":"Man bahâr râ xeyli dust dâram.","a":"audio/fa-tr/a23ecc2ad0f2.mp3"},{"t":"در بهار هوا نه سرد است، نه گرم.","s":"İlkbaharda hava ne soğuk ne sıcak.","pr":"Dar bahâr havâ na sard ast, na garm.","a":"audio/fa-tr/822cc9afbb96.mp3"},{"t":"نوروز اول فروردین است.","s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","a":"audio/fa-tr/98203290c65d.mp3"},{"t":"ما سفره‌ی هفت‌سین می‌چینیم.","s":"Haft-sin sofrasını kuruyoruz.","pr":"Mâ sofre-ye haftsin miçinim.","a":"audio/fa-tr/6fc258e72827.mp3"},{"t":"بچه‌ها از پدربزرگ عیدی می‌گیرند.","s":"Çocuklar büyükbabadan bayram harçlığı alıyor.","pr":"Baççehâ az pedarbozorg eydi migirand.","a":"audio/fa-tr/94d37e94905f.mp3"},{"t":"سیزده فروردین همه به پارک می‌روند.","s":"13 Farvardin'de herkes parka gidiyor.","pr":"Sizdah-e farvardin hame be pârk miravand.","a":"audio/fa-tr/ecb9fb2ccdba.mp3"},{"t":"گاهی باران می‌آید، ولی ما خوشحال هستیم.","s":"Bazen yağmur yağıyor ama biz mutluyuz.","pr":"Gâhi bârân miâyad, vali mâ xoşhâl hastim.","a":"audio/fa-tr/9287d6eec668.mp3"}],"questions":[{"q":{"t":"مریم کدام فصل را دوست دارد؟","s":"Maryam hangi mevsimi seviyor?","pr":"Maryam kodâm fasl râ dust dârad?","a":"audio/fa-tr/c58ccb76da5f.mp3"},"options":["زمستان","بهار","تابستان"],"answer":1},{"q":{"t":"نوروز کی است؟","s":"Nevruz ne zaman?","pr":"Nowruz key ast?","a":"audio/fa-tr/e37368b40808.mp3"},"options":["اول فروردین","اول مهر","سیزده فروردین"],"answer":0},{"q":{"t":"بچه‌ها از پدربزرگ چه می‌گیرند؟","s":"Çocuklar büyükbabadan ne alıyor?","pr":"Baççehâ az pedarbozorg çe migirand?","a":"audio/fa-tr/76303cf27c78.mp3"},"options":["کیف","کتاب","عیدی"],"answer":2},{"q":{"t":"سیزده فروردین همه کجا می‌روند؟","s":"13 Farvardin'de herkes nereye gidiyor?","pr":"Sizdah-e farvardin hame kocâ miravand?","a":"audio/fa-tr/0319e574a8e5.mp3"},"options":["به مدرسه","به پارک","به بانک"],"answer":1}]},"sentences":[{"t":"هوا چطور است؟","s":"Hava nasıl?","pr":"Havâ çetor ast?","a":"audio/fa-tr/48d39fd71710.mp3"},{"t":"امروز هوا ابری است.","s":"Bugün hava bulutlu.","pr":"Emruz havâ abri ast.","a":"audio/fa-tr/dfc8053e03b7.mp3"},{"t":"در زمستان برف می‌آید.","s":"Kışın kar yağar.","pr":"Dar zemestân barf miâyad.","a":"audio/fa-tr/dc3d1fd0ad27.mp3"},{"t":"تابستان هوا خیلی گرم است.","s":"Yazın hava çok sıcak.","pr":"Tâbestân havâ xeyli garm ast.","a":"audio/fa-tr/75e3951c2bd0.mp3"},{"t":"مدرسه‌ها اول مهر باز می‌شوند.","s":"Okullar 1 Mehr'de açılır.","pr":"Madresehâ avval-e mehr bâz mişavand.","a":"audio/fa-tr/b8bcd3686df2.mp3"},{"t":"نوروز مبارک!","s":"Nevruzunuz kutlu olsun!","pr":"Nowruz mobârak!","a":"audio/fa-tr/150026bbd98a.mp3"},{"t":"من پاییز را دوست دارم.","s":"Sonbaharı severim.","pr":"Man pâyiz râ dust dâram.","a":"audio/fa-tr/76598ce0cf54.mp3"},{"t":"اسفند آخرین ماه سال است.","s":"Esfand yılın son ayıdır.","pr":"Esfand âxarin mâh-e sâl ast.","a":"audio/fa-tr/35fb32706b9c.mp3"}],"img":"img/e/1f326.svg"}