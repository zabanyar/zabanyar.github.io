{"id":"u09","level":"A1","emoji":"🌦️","title":{"t":"هوا، ماه‌ها و فصل‌ها","s":"Hava, aylar ve mevsimler","pr":"Havâ, mâhhâ va faslhâ","a":"audio/fa-tr/995cd88fbf64.mp3"},"goals":["Havanın nasıl olduğunu sorup anlatabilirim.","Dört mevsimi ve İran takvimindeki 12 ayı söyleyebilirim.","Nevruz hakkında birkaç basit cümle kurabilirim."],"words":[{"id":"w01","t":"هوا","s":"hava","pr":"havâ","emoji":"🌤️","ex":{"t":"امروز هوا خوب است.","s":"Bugün hava güzel.","pr":"Emruz havâ xub ast.","a":"audio/fa-tr/d0f4e16f367f.mp3"},"img":"img/e/1f324.svg","a":"audio/fa-tr/0a44d8a24555.mp3"},{"id":"w02","t":"آفتابی","s":"güneşli","pr":"âftâbi","emoji":"☀️","ex":{"t":"امروز هوا آفتابی است.","s":"Bugün hava güneşli.","pr":"Emruz havâ âftâbi ast.","a":"audio/fa-tr/4c78f35fc2a9.mp3"},"img":"img/e/2600.svg","a":"audio/fa-tr/a278eeedc426.mp3"},{"id":"w03","t":"باران","s":"yağmur","pr":"bârân","emoji":"🌧️","ex":{"t":"باران می‌آید.","s":"Yağmur yağıyor.","pr":"Bârân miâyad.","a":"audio/fa-tr/b7f6d010c67d.mp3"},"img":"img/e/1f327.svg","a":"audio/fa-tr/2f6c75e4d0a6.mp3"},{"id":"w04","t":"برف","s":"kar","pr":"barf","emoji":"❄️","ex":{"t":"در زمستان برف می‌آید.","s":"Kışın kar yağar.","pr":"Dar zemestân barf miâyad.","a":"audio/fa-tr/368fda7658e5.mp3"},"img":"img/e/2744.svg","a":"audio/fa-tr/d758e4fa3b43.mp3"},{"id":"w05","t":"گرم","s":"sıcak","pr":"garm","emoji":"🌡️","ex":{"t":"تابستان هوا گرم است.","s":"Yazın hava sıcak.","pr":"Tâbestân havâ garm ast.","a":"audio/fa-tr/4782db0cf994.mp3"},"img":"img/e/1f321.svg","a":"audio/fa-tr/ad05975c8b01.mp3"},{"id":"w06","t":"سرد","s":"soğuk","pr":"sard","emoji":"🥶","ex":{"t":"امروز هوا خیلی سرد است.","s":"Bugün hava çok soğuk.","pr":"Emruz havâ xeyli sard ast.","a":"audio/fa-tr/f2f924d983bc.mp3"},"img":"img/e/1f976.svg","a":"audio/fa-tr/68f6ad2031a9.mp3"},{"id":"w07","t":"ابری","s":"bulutlu","pr":"abri","emoji":"☁️","ex":{"t":"امروز هوا ابری است.","s":"Bugün hava bulutlu.","pr":"Emruz havâ abri ast.","a":"audio/fa-tr/1ad90f6124d4.mp3"},"img":"img/e/2601.svg","a":"audio/fa-tr/3b5b9afe82d6.mp3"},{"id":"w08","t":"بهار","s":"ilkbahar","pr":"bahâr","emoji":"🌸","ex":{"t":"بهار فصل گل است.","s":"İlkbahar çiçek mevsimidir.","pr":"Bahâr fasl-e gol ast.","a":"audio/fa-tr/d312bcd41537.mp3"},"img":"img/e/1f338.svg","a":"audio/fa-tr/62e478bae2f5.mp3"},{"id":"w09","t":"تابستان","s":"yaz","pr":"tâbestân","emoji":"🏖️","ex":{"t":"تابستان به دریا می‌رویم.","s":"Yazın denize gidiyoruz.","pr":"Tâbestân be daryâ miravim.","a":"audio/fa-tr/ab60e6f9f074.mp3"},"img":"img/e/1f3d6.svg","a":"audio/fa-tr/d3d599003b20.mp3"},{"id":"w10","t":"پاییز","s":"sonbahar","pr":"pâyiz","emoji":"🍂","ex":{"t":"پاییز برگ‌ها زرد می‌شوند.","s":"Sonbaharda yapraklar sararır.","pr":"Pâyiz barghâ zard mişavand.","a":"audio/fa-tr/09a89daa1df9.mp3"},"img":"img/e/1f342.svg","a":"audio/fa-tr/8a07b4470937.mp3"},{"id":"w11","t":"زمستان","s":"kış","pr":"zemestân","emoji":"⛄","ex":{"t":"من زمستان را دوست دارم.","s":"Kışı severim.","pr":"Man zemestân râ dust dâram.","a":"audio/fa-tr/54d2a74494d4.mp3"},"img":"img/e/26c4.svg","a":"audio/fa-tr/f9d30760261e.mp3"},{"id":"w12","t":"فصل","s":"mevsim","pr":"fasl","emoji":"","ex":{"t":"سال چهار فصل دارد.","s":"Yılın dört mevsimi var.","pr":"Sâl çahâr fasl dârad.","a":"audio/fa-tr/f54171b56727.mp3"},"img":null,"a":"audio/fa-tr/80085e262c4c.mp3"},{"id":"w13","t":"ماه","s":"ay","pr":"mâh","emoji":"🗓️","ex":{"t":"سال دوازده ماه دارد.","s":"Yılın on iki ayı var.","pr":"Sâl davâzdah mâh dârad.","a":"audio/fa-tr/c5634109b004.mp3"},"img":"img/e/1f5d3.svg","a":"audio/fa-tr/4f15296ef5fc.mp3"},{"id":"w14","t":"نوروز","s":"Nevruz (İran'da yılbaşı)","pr":"nowruz","emoji":"🌱","ex":{"t":"نوروز جشن سال نو است.","s":"Nevruz yeni yıl bayramıdır.","pr":"Nowruz caşn-e sâl-e now ast.","a":"audio/fa-tr/739f5090eb88.mp3"},"img":"img/e/1f331.svg","a":"audio/fa-tr/411c48a970c9.mp3"}],"phrases":[{"id":"p01","t":"هوا چطور است؟","s":"Hava nasıl?","pr":"Havâ çetor ast?","a":"audio/fa-tr/72410f16a86b.mp3"},{"id":"p02","t":"هوا خیلی خوب است!","s":"Hava çok güzel!","pr":"Havâ xeyli xub ast!","a":"audio/fa-tr/7645bc8c7a66.mp3"},{"id":"p03","t":"باران می‌آید.","s":"Yağmur yağıyor.","pr":"Bârân miâyad.","a":"audio/fa-tr/b7f6d010c67d.mp3"},{"id":"p04","t":"برف می‌آید.","s":"Kar yağıyor.","pr":"Barf miâyad.","a":"audio/fa-tr/b59810cbfbfb.mp3"},{"id":"p05","t":"خیلی سرد است!","s":"Çok soğuk!","pr":"Xeyli sard ast!","a":"audio/fa-tr/eaa902d73da8.mp3"},{"id":"p06","t":"نوروز مبارک!","s":"Nevruzunuz kutlu olsun!","pr":"Nowruz mobârak!","a":"audio/fa-tr/12dd1e5348cb.mp3"},{"id":"p07","t":"سال نو مبارک!","s":"Yeni yılınız kutlu olsun!","pr":"Sâl-e now mobârak!","a":"audio/fa-tr/9d4c8ef678b0.mp3"},{"id":"p08","t":"کدام فصل را دوست داری؟","s":"Hangi mevsimi seversin?","pr":"Kodâm fasl râ dust dâri?","a":"audio/fa-tr/ed50972c4f75.mp3"}],"dialogue":{"title":{"t":"هوای تهران چطور است؟","s":"Tahran'da hava nasıl?","pr":"Havâ-ye Tehrân çetor ast?","a":"audio/fa-tr/94dab97ba818.mp3"},"speakers":{"A":{"name":"Sara","voice":"f"},"B":{"name":"Emre","voice":"m"}},"lines":[{"sp":"B","t":"سلام سارا! هوای تهران چطور است؟","s":"Merhaba Sara! Tahran'da hava nasıl?","pr":"Salâm Sârâ! Havâ-ye Tehrân çetor ast?","a":"audio/fa-tr/46ae1d0087c2.mp3"},{"sp":"A","t":"سلام امره! امروز هوا آفتابی و گرم است.","s":"Merhaba Emre! Bugün hava güneşli ve sıcak.","pr":"Salâm Emre! Emruz havâ âftâbi va garm ast.","a":"audio/fa-tr/1a090e930b39.mp3"},{"sp":"B","t":"خوش به حالت! در استانبول باران می‌آید.","s":"Ne mutlu sana! İstanbul'da yağmur yağıyor.","pr":"Xoş be hâlat! Dar Estânbol bârân miâyad.","a":"audio/fa-tr/03561db92849.mp3"},{"sp":"A","t":"هوا سرد است؟","s":"Hava soğuk mu?","pr":"Havâ sard ast?","a":"audio/fa-tr/4e27806464ee.mp3"},{"sp":"B","t":"نه خیلی، ولی ابری است.","s":"Çok değil, ama bulutlu.","pr":"Na xeyli, vali abri ast.","a":"audio/fa-tr/5401636f5dec.mp3"},{"sp":"A","t":"تهران در بهار خیلی قشنگ است. کی به ایران می‌آیی؟","s":"Tahran ilkbaharda çok güzel. İran'a ne zaman geliyorsun?","pr":"Tehrân dar bahâr xeyli ğaşang ast. Key be İrân miâyi?","a":"audio/fa-tr/b1c635093fa3.mp3"},{"sp":"B","t":"در فروردین، برای نوروز!","s":"Farvardin'de, Nevruz için!","pr":"Dar farvardin, barâye nowruz!","a":"audio/fa-tr/7d2789808800.mp3"},{"sp":"A","t":"عالی است! نوروز در ایران خیلی شاد است.","s":"Harika! İran'da Nevruz çok neşeli geçer.","pr":"Âli ast! Nowruz dar İrân xeyli şâd ast.","a":"audio/fa-tr/740bd98b8c8c.mp3"},{"sp":"B","t":"پس تا فروردین!","s":"O zaman Farvardin'de görüşürüz!","pr":"Pas tâ farvardin!","a":"audio/fa-tr/858e4bb32f41.mp3"},{"sp":"A","t":"خداحافظ!","s":"Hoşça kal!","pr":"Xodâhâfez!","a":"audio/fa-tr/bcb2e33eb6fa.mp3"}]},"grammar":[{"id":"g01","title":{"t":"هوا آفتابی است. باران می‌آید.","s":"Havayı anlatmak","pr":"Havâ âftâbi ast. Bârân miâyad."},"explain":"Havayı anlatmanın iki yolu var.\n1) **havâ** + sıfat + **ast**: Havâ **garm** ast = Hava sıcak. Havâ **sard / abri / âftâbi** ast. Türkçedeki *hava* kelimesiyle aynı!\n2) Yağmur ve kar için Farslar **\"gelmek\"** fiilini kullanır: **bârân miâyad** = yağmur yağıyor (kelimesi kelimesine: yağmur geliyor), **barf miâyad** = kar yağıyor. Olumsuz: **bârân nemiâyad** = yağmur yağmıyor.\n**-i** eki isimden sıfat yapar, Türkçedeki **-li** gibi: **âftâb** (güneş) → **âftâbi** (güneşli), **abr** (bulut) → **abri** (bulutlu).\nSoru: **Havâ çetor ast?** = Hava nasıl?","table":[["هوا آفتابی است.","Havâ âftâbi ast.","☀️"],["هوا ابری است.","Havâ abri ast.","☁️"],["باران می‌آید.","Bârân miâyad.","🌧️"],["برف می‌آید.","Barf miâyad.","❄️"],["هوا گرم است.","Havâ garm ast.","🌡️"],["هوا سرد است.","Havâ sard ast.","🥶"]],"examples":[{"t":"هوا چطور است؟ هوا ابری است.","s":"Hava nasıl? Hava bulutlu.","pr":"Havâ çetor ast? Havâ abri ast.","a":"audio/fa-tr/9f6ee2909a6b.mp3"},{"t":"در تبریز زمستان برف می‌آید.","s":"Tebriz'de kışın kar yağar.","pr":"Dar Tabriz zemestân barf miâyad.","a":"audio/fa-tr/b17d32e1f650.mp3"},{"t":"امروز باران می‌آید.","s":"Bugün yağmur yağıyor.","pr":"Emruz bârân miâyad.","a":"audio/fa-tr/49368dcd5f87.mp3"},{"t":"تابستان در شیراز هوا خیلی گرم است.","s":"Şiraz'da yazın hava çok sıcak.","pr":"Tâbestân dar Şirâz havâ xeyli garm ast.","a":"audio/fa-tr/3ac627ce2068.mp3"},{"t":"باران نمی‌آید.","s":"Yağmur yağmıyor.","pr":"Bârân nemiâyad.","a":"audio/fa-tr/8efbd0d21233.mp3"}],"exercises":[{"type":"choice","t":"امروز هوا ___ است.","options":["آفتابی","باران","برف"],"answer":0,"s":"Bugün hava güneşli.","pr":"Emruz havâ âftâbi ast.","full":"امروز هوا آفتابی است.","a":"audio/fa-tr/4c78f35fc2a9.mp3"},{"type":"choice","t":"باران ___.","options":["است","می‌آید","هستم"],"answer":1,"s":"Yağmur yağıyor.","pr":"Bârân miâyad.","full":"باران می‌آید.","a":"audio/fa-tr/b7f6d010c67d.mp3"},{"type":"choice","t":"زمستان هوا ___ است.","options":["گرم","آفتابی","سرد"],"answer":2,"s":"Kışın hava soğuk.","pr":"Zemestân havâ sard ast.","full":"زمستان هوا سرد است.","a":"audio/fa-tr/d887bd4c8170.mp3"},{"type":"choice","t":"هوا ___ است؟","options":["چطور","کجا","چند"],"answer":0,"s":"Hava nasıl?","pr":"Havâ çetor ast?","full":"هوا چطور است؟","a":"audio/fa-tr/72410f16a86b.mp3"},{"type":"type","t":"برف ___.","answer":["می‌آید","میآید"],"s":"Kar yağıyor.","pr":"Barf miâyad.","full":"برف می‌آید.","a":"audio/fa-tr/b59810cbfbfb.mp3"},{"type":"type","t":"هوا ___ است.","answer":["ابری"],"s":"Hava bulutlu.","pr":"Havâ abri ast.","full":"هوا ابری است.","a":"audio/fa-tr/dabc13bf50cf.mp3"},{"type":"order","t":"امروز هوا خیلی سرد است.","s":"Bugün hava çok soğuk.","pr":"Emruz havâ xeyli sard ast.","alts":["هوا امروز خیلی سرد است."],"full":"امروز هوا خیلی سرد است.","a":"audio/fa-tr/f2f924d983bc.mp3"},{"type":"order","t":"در تبریز برف می‌آید.","s":"Tebriz'de kar yağıyor.","pr":"Dar Tabriz barf miâyad.","full":"در تبریز برف می‌آید.","a":"audio/fa-tr/41e8d8b4a663.mp3"}]},{"id":"g02","title":{"t":"فصل‌ها و ماه‌ها","s":"Mevsimler, İran ayları ve Nevruz","pr":"faslhâ va mâhhâ"},"explain":"İran'da resmî takvim **güneş takvimi**dir. Yıl, ilkbaharın ilk günü (20–21 Mart) **Nowruz** (Nevruz) ile başlar: **avval-e farvardin** = 1 Farvardin.\nHer mevsimin üç ayı var. **Bahâr**: farvardin, ordibeheşt, xordâd. **Tâbestân**: tir, mordâd, şahrivar. **Pâyiz**: mehr, âbân, âzar. **Zemestân**: dey, bahman, esfand. İlk altı ay 31 gün, sonraki beş ay 30 gün, esfand ise 29 (artık yılda 30) gündür.\nNevruz'da aileler **haftsin** sofrası kurar: \"s\" sesiyle başlayan yedi şey (sabze, sib, sir, sekke, sonbol…). Büyükler çocuklara **eydi** (bayram harçlığı) verir. 13 Farvardin'de (**sizdah bedar**) herkes pikniğe, doğaya çıkar.\n\"… ayında\" demek için **dar** kullanılır: **dar mehr** = Mehr ayında. Mevsimlerde edat çoğu zaman düşer: **zemestân barf miâyad** = kışın kar yağar.","table":[["بهار","فروردین، اردیبهشت، خرداد","bahâr: farvardin, ordibeheşt, xordâd"],["تابستان","تیر، مرداد، شهریور","tâbestân: tir, mordâd, şahrivar"],["پاییز","مهر، آبان، آذر","pâyiz: mehr, âbân, âzar"],["زمستان","دی، بهمن، اسفند","zemestân: dey, bahman, esfand"]],"examples":[{"t":"نوروز اول فروردین است.","s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","a":"audio/fa-tr/0d7a85f8487a.mp3"},{"t":"مدرسه‌ها در مهر باز می‌شوند.","s":"Okullar Mehr ayında açılır.","pr":"Madresehâ dar mehr bâz mişavand.","a":"audio/fa-tr/bc2aee111566.mp3"},{"t":"تولد من در آبان است.","s":"Doğum günüm Âbân ayında.","pr":"Tavallod-e man dar âbân ast.","a":"audio/fa-tr/ea85d81c75f6.mp3"},{"t":"دی و بهمن ماه‌های سرد هستند.","s":"Dey ve Bahman soğuk aylardır.","pr":"Dey va bahman mâhhâ-ye sard hastand.","a":"audio/fa-tr/aff3735d3f1f.mp3"},{"t":"در نوروز به خانه‌ی پدربزرگ می‌رویم.","s":"Nevruz'da büyükbabamın evine gideriz.","pr":"Dar nowruz be xâne-ye pedarbozorg miravim.","a":"audio/fa-tr/136fc1204241.mp3"}],"exercises":[{"type":"choice","t":"نوروز اول ___ است.","options":["فروردین","مهر","دی"],"answer":0,"s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","full":"نوروز اول فروردین است.","a":"audio/fa-tr/0d7a85f8487a.mp3"},{"type":"choice","t":"مهر در ___ است.","options":["بهار","پاییز","تابستان"],"answer":1,"s":"Mehr ayı sonbahardadır.","pr":"Mehr dar pâyiz ast.","full":"مهر در پاییز است.","a":"audio/fa-tr/29f10073370c.mp3"},{"type":"choice","t":"سال چهار ___ دارد.","options":["ماه","روز","فصل"],"answer":2,"s":"Yılın dört mevsimi var.","pr":"Sâl çahâr fasl dârad.","full":"سال چهار فصل دارد.","a":"audio/fa-tr/f54171b56727.mp3"},{"type":"choice","t":"دی و بهمن ماه‌های ___ هستند.","options":["سرد","گرم","سبز"],"answer":0,"s":"Dey ve Bahman soğuk aylardır.","pr":"Dey va bahman mâhhâ-ye sard hastand.","full":"دی و بهمن ماه‌های سرد هستند.","a":"audio/fa-tr/aff3735d3f1f.mp3"},{"type":"type","t":"تابستان هوا ___ است.","answer":["گرم"],"s":"Yazın hava sıcak.","pr":"Tâbestân havâ garm ast.","full":"تابستان هوا گرم است.","a":"audio/fa-tr/4782db0cf994.mp3"},{"type":"type","t":"___ مبارک!","answer":["نوروز"],"s":"Nevruzunuz kutlu olsun!","pr":"Nowruz mobârak!","full":"نوروز مبارک!","a":"audio/fa-tr/12dd1e5348cb.mp3"},{"type":"order","t":"نوروز اول فروردین است.","s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","full":"نوروز اول فروردین است.","a":"audio/fa-tr/0d7a85f8487a.mp3"},{"type":"order","t":"من بهار را دوست دارم.","s":"Ben ilkbaharı severim.","pr":"Man bahâr râ dust dâram.","full":"من بهار را دوست دارم.","a":"audio/fa-tr/84138b1fa6ff.mp3"}]}],"reading":{"title":{"t":"نوروز در خانه‌ی ما","s":"Bizim evde Nevruz","pr":"Nowruz dar xâne-ye mâ","a":"audio/fa-tr/4b17fce4b4b3.mp3"},"text":[{"t":"من مریم هستم و در شیراز زندگی می‌کنم.","s":"Ben Maryam, Şiraz'da yaşıyorum.","pr":"Man Maryam hastam va dar Şirâz zendegi mikonam.","a":"audio/fa-tr/84262c47e56e.mp3"},{"t":"من بهار را خیلی دوست دارم.","s":"İlkbaharı çok severim.","pr":"Man bahâr râ xeyli dust dâram.","a":"audio/fa-tr/3aea5b3a7263.mp3"},{"t":"در بهار هوا نه سرد است، نه گرم.","s":"İlkbaharda hava ne soğuk ne sıcak.","pr":"Dar bahâr havâ na sard ast, na garm.","a":"audio/fa-tr/7bc579a046e0.mp3"},{"t":"نوروز اول فروردین است.","s":"Nevruz 1 Farvardin'de.","pr":"Nowruz avval-e farvardin ast.","a":"audio/fa-tr/0d7a85f8487a.mp3"},{"t":"ما سفره‌ی هفت‌سین می‌چینیم.","s":"Haft-sin sofrasını kuruyoruz.","pr":"Mâ sofre-ye haftsin miçinim.","a":"audio/fa-tr/9fddae2be57e.mp3"},{"t":"بچه‌ها از پدربزرگ عیدی می‌گیرند.","s":"Çocuklar büyükbabadan bayram harçlığı alıyor.","pr":"Baççehâ az pedarbozorg eydi migirand.","a":"audio/fa-tr/a9d3f319b72a.mp3"},{"t":"سیزده فروردین همه به پارک می‌روند.","s":"13 Farvardin'de herkes parka gidiyor.","pr":"Sizdah-e farvardin hame be pârk miravand.","a":"audio/fa-tr/57105e8efcb5.mp3"},{"t":"گاهی باران می‌آید، ولی ما خوشحال هستیم.","s":"Bazen yağmur yağıyor ama biz mutluyuz.","pr":"Gâhi bârân miâyad, vali mâ xoşhâl hastim.","a":"audio/fa-tr/4dc190e4fc2e.mp3"}],"questions":[{"q":{"t":"مریم کدام فصل را دوست دارد؟","s":"Maryam hangi mevsimi seviyor?","pr":"Maryam kodâm fasl râ dust dârad?","a":"audio/fa-tr/3cb8db79621c.mp3"},"options":["زمستان","بهار","تابستان"],"answer":1},{"q":{"t":"نوروز کی است؟","s":"Nevruz ne zaman?","pr":"Nowruz key ast?","a":"audio/fa-tr/cd8ee01a2106.mp3"},"options":["اول فروردین","اول مهر","سیزده فروردین"],"answer":0},{"q":{"t":"بچه‌ها از پدربزرگ چه می‌گیرند؟","s":"Çocuklar büyükbabadan ne alıyor?","pr":"Baççehâ az pedarbozorg çe migirand?","a":"audio/fa-tr/1bd71e625663.mp3"},"options":["کیف","کتاب","عیدی"],"answer":2},{"q":{"t":"سیزده فروردین همه کجا می‌روند؟","s":"13 Farvardin'de herkes nereye gidiyor?","pr":"Sizdah-e farvardin hame kocâ miravand?","a":"audio/fa-tr/8a3126874294.mp3"},"options":["به مدرسه","به پارک","به بانک"],"answer":1}]},"sentences":[{"t":"هوا چطور است؟","s":"Hava nasıl?","pr":"Havâ çetor ast?","a":"audio/fa-tr/72410f16a86b.mp3"},{"t":"امروز هوا ابری است.","s":"Bugün hava bulutlu.","pr":"Emruz havâ abri ast.","a":"audio/fa-tr/1ad90f6124d4.mp3"},{"t":"در زمستان برف می‌آید.","s":"Kışın kar yağar.","pr":"Dar zemestân barf miâyad.","a":"audio/fa-tr/368fda7658e5.mp3"},{"t":"تابستان هوا خیلی گرم است.","s":"Yazın hava çok sıcak.","pr":"Tâbestân havâ xeyli garm ast.","a":"audio/fa-tr/036b6ef17bf5.mp3"},{"t":"مدرسه‌ها اول مهر باز می‌شوند.","s":"Okullar 1 Mehr'de açılır.","pr":"Madresehâ avval-e mehr bâz mişavand.","a":"audio/fa-tr/4d472408ef54.mp3"},{"t":"نوروز مبارک!","s":"Nevruzunuz kutlu olsun!","pr":"Nowruz mobârak!","a":"audio/fa-tr/12dd1e5348cb.mp3"},{"t":"من پاییز را دوست دارم.","s":"Sonbaharı severim.","pr":"Man pâyiz râ dust dâram.","a":"audio/fa-tr/7359d6b08ebc.mp3"},{"t":"اسفند آخرین ماه سال است.","s":"Esfand yılın son ayıdır.","pr":"Esfand âxarin mâh-e sâl ast.","a":"audio/fa-tr/b5375411ccfd.mp3"}],"img":"img/e/1f326.svg"}