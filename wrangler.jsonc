{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "PROGRESS", "id": "aeb18e6728da4189bb4041d6cc7c7e2f" }
  ],
  "routes": [
    { "pattern": "zabanyar.dpdns.org", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": false }
}
